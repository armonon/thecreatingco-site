/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# --- thecreateco suite kit (wave 4) — added 2026-10-06; rules above unchanged ---
/suite/v1/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex

/locker/bridge.html
  Content-Security-Policy: frame-ancestors 'self' https://thecreatingco.com https://*.thecreatingco.com https://sattarimusic.com https://www.sattarimusic.com https://*.netlify.app http://localhost:*
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/locker/core.js
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache

/locker/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /locker/

# --- content-hashed JS bundles (wave 5) — added 2026-10-18; rules above unchanged ---
# These filenames embed a SHA-256 content hash so they are safe to cache for 1 year.
# Browsers that have an old hash will fetch the new file; repeat visitors get it free.
/momentium-*.js
  Cache-Control: public, max-age=31536000, immutable

/site-navigation-*.js
  Cache-Control: public, max-age=31536000, immutable

/audit-fixes-*.js
  Cache-Control: public, max-age=31536000, immutable

/site-*.js
  Cache-Control: public, max-age=31536000, immutable

/momentium-motion-*.js
  Cache-Control: public, max-age=31536000, immutable

/start/motion-*.js
  Cache-Control: public, max-age=31536000, immutable

# content-hashed CSS bundle (wave 3)
/assets/styles/global-*.css
  Cache-Control: public, max-age=31536000, immutable
