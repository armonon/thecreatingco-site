/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 0
  X-DNS-Prefetch-Control: off

# --- thecreateco suite kit (wave 4) — added 2026-10-06; rules above unchanged ---
/suite/v1/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex

/locker/bridge.html
  Content-Security-Policy: frame-ancestors 'self' https://thecreatingco.com https://*.thecreatingco.com https://sattarimusic.com https://www.sattarimusic.com https://*.netlify.app http://localhost:*
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/locker/core.js
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache

/locker/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /locker/

# --- autopilot run 18 — immutable caching for hashed bundles + /learn/ — 2026-10-18 ---
# Content-addressed assets (filename includes hash) → 1-year immutable cache
/learn/form/workshops/assets/*
  Cache-Control: public, max-age=31536000, immutable

/learn/luma/workshops/assets/*
  Cache-Control: public, max-age=31536000, immutable

/learn/scenepilot/workshops/assets/*
  Cache-Control: public, max-age=31536000, immutable

/learn/stemdeck/workshops/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Top-level static JS/CSS with version query strings — short TTL, always fresh on deploy
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
