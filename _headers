/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 0

# --- thecreateco suite kit (wave 4) — added 2026-10-06; rules above unchanged ---
/suite/v1/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex

/locker/bridge.html
  Content-Security-Policy: frame-ancestors 'self' https://thecreatingco.com https://*.thecreatingco.com https://sattarimusic.com https://www.sattarimusic.com https://*.netlify.app http://localhost:*
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/locker/core.js
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache

/locker/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /locker/

# --- autopilot perf (2026-10-18): content-hashed bundles never change in place ---
/assets/styles/*
  Cache-Control: public, max-age=31536000, immutable

# --- autopilot security + cache (2026-10-18) ---
# Immutable cache for content-hashed JS assets under /assets/
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/product-artwork/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/team/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/after-hours/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
