    { "src": "/locker/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/locker/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
