@@ -0,0 +1,36 @@
+import './collections.css';
+import './collections-detail.css';
+import { loadPdfjs } from './pdfjs.js';
+import QRCode from 'qrcode';
+
+const app=document.querySelector('#app'), FN='/.netlify/functions', KEY='librarian.collections.session.v1';
+const query=new URLSearchParams(location.search);let cfg,session=loadSession(),rows=[],active=null,books=[],message='',reader=null,filter='',qrData='';
+function loadSession(){try{return JSON.parse(localStorage.getItem(KEY))}catch{return null}}
+function saveSession(s){session=s;if(s)localStorage.setItem(KEY,JSON.stringify(s));else localStorage.removeItem(KEY)}
+function esc(x=''){return String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function slug(s){return s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,60)}
+function authHeaders(){return {apikey:cfg.publishableKey,authorization:`Bearer ${session?.access_token||cfg.publishableKey}`}}
+async function call(path,options={}){let r=await fetch(`${FN}/${path}`,{...options,headers:{...authHeaders(),...(options.headers||{})}});if(r.status===401&&session?.refresh_token){const next=await fetch(`${cfg.supabaseUrl}/auth/v1/token?grant_type=refresh_token`,{method:'POST',headers:{apikey:cfg.publishableKey,'content-type':'application/json'},body:JSON.stringify({refresh_token:session.refresh_token})});if(next.ok){saveSession(await next.json());r=await fetch(`${FN}/${path}`,{...options,headers:{...authHeaders(),...(options.headers||{})}})}else saveSession(null)}let data={};try{data=await r.json()}catch{};if(!r.ok)throw Error(data.error||'Could not complete that action.');return data}
+async function account(path,body){const r=await fetch(`${cfg.supabaseUrl}/auth/v1/${path}`,{method:'POST',headers:{apikey:cfg.publishableKey,'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw Error(d.msg||d.message||'Account request failed.');return d}
+function say(text){message=text;render()}
+async function open(slug){const d=await call(`collections?slug=${encodeURIComponent(slug)}`);active=d.collection;books=d.books||[];document.title=`${active.title} — Librarian`}
