diff --git a/tests/caption-words.test.mjs b/tests/caption-words.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0bcef940715cf441906638eed99e7384b987ae63
--- /dev/null
+++ b/tests/caption-words.test.mjs
@@ -0,0 +1,105 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  CAPTION_PRESETS, activeLine, activeWordIndex, groupCaptionLines, layoutCaption, lineText, linesToCutFile, linesToSrt, linesToTitleCues, linesToVtt,
+  normalizeWords, presetById, retimeLine, tidyLines, wordVisual,
+} from "../lib/caption-words.ts";
+import { parseCaptions } from "../lib/captions.ts";
+import { parseCutFile } from "../lib/project-store.ts";
+
+const ASR = [
+  { text: " Hello", start: 0.1, end: 0.4 },
+  { text: "world.", start: 0.35, end: 0.35 },
+  { text: "", start: 0.9, end: 1 },
+  { text: "This is", start: 1.5, end: 2.1 },
+  { text: "a", start: 2.1, end: 2.2 },
+  { text: "test,", start: 2.2, end: 2.6 },
+  { text: "okay?", start: 2.7, end: 3 },
+  { text: "bad", start: Number.NaN, end: 4 },
+];
+
+test("normalizeWords repairs overlaps, zero lengths, blanks and segment-level chunks", () => {
+  const words = normalizeWords(ASR);
+  assert.deepEqual(words.map((word) => word.text), ["Hello", "world.", "This", "is", "a", "test,", "okay?"]);
+  for (let i = 1; i < words.length; i++) assert.ok(words[i].start >= words[i - 1].end - 1e-9, `word ${i} overlaps`);
+  assert.ok(words.every((word) => word.end - word.start >= 0.08 - 1e-9));
+  assert.equal(words[0].end, 0.35, "trimmed at the next word's start");
+  assert.equal(words[2].start, 1.5);
+  assert.ok(words[3].end <= 2.1 + 1e-9, "segment words stay inside their segment");
+  assert.ok(normalizeWords([{ text: "late", start: 9, end: 12 }], 10)[0].end <= 10);
+  const glued = normalizeWords([{ text: "on", start: 1, end: 1.2 }, { text: "-device", start: 1.2, end: 1.6 }, { text: "don", start: 2, end: 2.2 }, { text: "'t", start: 2.2, end: 2.3 }, { text: "-", start: 5, end: 5.1 }]);
+  assert.deepEqual(glued.map((word) => [word.text, word.start, word.end]), [["on-device", 1, 1.6], ["don't", 2, 2.3], ["-", 5, 5.1]]);
+});
+
+test("grouping breaks on sentence ends, pauses and length", () => {
+  const lines = groupCaptionLines(normalizeWords(ASR));
+  assert.deepEqual(lines.map(lineText), ["Hello world.", "This is a test,", "okay?"]);
+  const long = normalizeWords(Array.from({ length: 20 }, (_, i) => ({ text: `word${i}`, start: i * 0.3, end: i * 0.3 + 0.25 })));
+  const grouped = groupCaptionLines(long, { maxChars: 20 });
+  assert.ok(grouped.every((line) => lineText(line).length <= 20 + 7));
+  assert.equal(grouped.flatMap((line) => line.words).length, 20);
+  assert.ok(groupCaptionLines(long, { maxWords: 3 }).every((line) => line.words.length <= 3));
+});
+
+test("editing text keeps word timing when counts match, otherwise respreads the line", () => {
+  const [line] = groupCaptionLines(normalizeWords(ASR));
+  const fixed = retimeLine(line, "Hullo world!");
+  assert.deepEqual(fixed.words.map((w) => [w.text, w.start, w.end]), [["Hullo", line.words[0].start, line.words[0].end], ["world!", line.words[1].start, line.words[1].end]]);
+  const longer = retimeLine(line, "Hello there big world.");
+  assert.equal(longer.words.length, 4);
+  assert.equal(longer.words[0].start, line.start);
+  assert.ok(Math.abs(longer.words.at(-1).end - line.end) < 0.01);
+  assert.equal(tidyLines([retimeLine(line, "   ")]).length, 0);
+});
+
+test("active line and word follow the playhead, with a short read-out hold", () => {
+  const lines = groupCaptionLines(normalizeWords(ASR));
+  assert.equal(activeLine(lines, 0.05), null);
+  assert.equal(lineText(activeLine(lines, 0.2)), "Hello world.");
+  assert.equal(lineText(activeLine(lines, 0.9)), "Hello world.", "held after the last word");
+  assert.equal(activeLine(lines, 1.3), null);
+  const line = lines[1];
+  assert.equal(activeWordIndex(line, 1.4), -1);
+  assert.equal(activeWordIndex(line, 1.6), 0);
+  assert.equal(activeWordIndex(line, 2.3), 3);
+  assert.equal(activeWordIndex(line, 9), 3);
+});
+
+test("highlight modes: karaoke fills spoken words, reveal hides unspoken, box marks only the current", () => {
+  const line = groupCaptionLines(normalizeWords(ASR))[1];
+  assert.equal(wordVisual(line, 0, 2.3, "color").highlighted, true);
+  assert.equal(wordVisual(line, 3, 1.6, "color").highlighted, false);
+  assert.equal(wordVisual(line, 3, 1.6, "reveal").alpha, 0);
+  assert.equal(wordVisual(line, 0, 2.3, "reveal").alpha, 1);
+  assert.equal(wordVisual(line, 0, 2.3, "box").highlighted, false);
+  assert.equal(wordVisual(line, 3, 2.3, "box").highlighted, true);
+  assert.ok(wordVisual(line, 3, 2.3, "pop").scale > 1);
+  assert.equal(wordVisual(line, 0, 2.3, "none").highlighted, false);
+});
+
+test("layout wraps to the width and centres each row", () => {
+  const laid = layoutCaption(["aaaa", "bbbb", "cccc"], (text) => text.length * 10, { maxWidth: 95, centerX: 100, centerY: 50, lineHeight: 20, spaceWidth: 5 });
+  assert.deepEqual(laid.map((word) => [word.x, word.y]), [[57.5, 40], [102.5, 40], [80, 60]]);
+});
+
+test("SRT, word-timed VTT and title cues round-trip through ScenePilot's parsers", () => {
+  const lines = groupCaptionLines(normalizeWords(ASR));
+  const srt = linesToSrt(lines);
+  const cues = parseCaptions(srt);
+  assert.deepEqual(cues.map((cue) => cue.text), ["Hello world.", "This is a test,", "okay?"]);
+  assert.ok(cues[0].end <= cues[1].start);
+  const vtt = linesToVtt(lines);
+  assert.match(vtt, /^WEBVTT/);
+  assert.match(vtt, /This <00:00:01\.875>is/);
+  assert.deepEqual(parseCaptions(vtt).map((cue) => cue.text), ["Hello world.", "This is a test,", "okay?"]);
+  assert.match(linesToVtt([retimeLine(lines[0], "a<b & c")], false), /a&lt;b &amp; c/);
+  const preset = presetById("bold-pop");
+  const titles = linesToTitleCues(lines, preset);
+  assert.equal(titles[0].text, "HELLO WORLD.");
+  assert.equal(titles[0].style, "pop");
+  assert.match(titles[0].id, /^caption-/);
+  const cut = parseCutFile(JSON.stringify(linesToCutFile(lines, preset, { project: "clip captions", duration: 4, mainAsset: { name: "clip.mp4", kind: "video" } })));
+  assert.equal(cut.titles.length, 3);
+  assert.equal(cut.mainAsset.name, "clip.mp4");
+  assert.equal(presetById("missing").id, CAPTION_PRESETS[0].id);
+});
diff --git a/tests/color-transfer.test.mjs b/tests/color-transfer.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4750def25e99f262cda2a33d1f599aeafc14902a
--- /dev/null
+++ b/tests/color-transfer.test.mjs
@@ -0,0 +1,111 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  bakeLut3d, buildColorTransfer, dominantPalette, labToRgb, lutToRgba8, measureLabStats, mergeLabStats, neutralLabStats, rgbToLab, serializeCubeLut,
+} from "../lib/color-transfer.ts";
+import { parseCubeLut, sampleCubeLut } from "../lib/lut.ts";
+
+/** RGBA pixels from a function of (x, y) over a small grid. */
+function image(width, height, fn) {
+  const data = new Uint8ClampedArray(width * height * 4);
+  for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
+    const [r, g, b] = fn(x / (width - 1), y / (height - 1));
+    const i = (y * width + x) * 4;
+    data[i] = r * 255; data[i + 1] = g * 255; data[i + 2] = b * 255; data[i + 3] = 255;
+  }
+  return data;
+}
+
+const near = (a, b, tolerance) => Math.abs(a - b) <= tolerance;
+
+test("sRGB ↔ CIELAB round-trips and hits the D65 anchors", () => {
+  const white = rgbToLab(1, 1, 1);
+  assert.ok(near(white[0], 100, 1e-3) && near(white[1], 0, 1e-3) && near(white[2], 0, 1e-3));
+  assert.deepEqual(rgbToLab(0, 0, 0).map((v) => Math.round(v * 1000) / 1000), [0, 0, 0]);
+  for (const rgb of [[0.2, 0.5, 0.8], [0.9, 0.1, 0.3], [0.5, 0.5, 0.5]]) {
+    const back = labToRgb(...rgbToLab(...rgb));
+    rgb.forEach((value, c) => assert.ok(near(back[c], value, 1e-6), `channel ${c}`));
+  }
+});
+
+test("statistics ignore transparent pixels and merge by pixel count", () => {
+  const warm = image(8, 8, () => [0.8, 0.5, 0.3]);
+  const stats = measureLabStats(warm);
+  assert.equal(stats.count, 64);
+  assert.ok(stats.mean[2] > 20, "warm image has positive b*");
+  assert.ok(stats.std[0] < 1e-6, "flat image has no lightness spread");
+  const holed = warm.slice();
+  holed[3] = 0;
+  assert.equal(measureLabStats(holed).count, 63);
+  const cool = measureLabStats(image(8, 8, () => [0.3, 0.5, 0.8]));
+  const merged = mergeLabStats([stats, cool]);
+  assert.equal(merged.count, 128);
+  assert.ok(near(merged.mean[2], (stats.mean[2] + cool.mean[2]) / 2, 1e-9));
+  assert.ok(merged.std[2] > 20, "merged spread covers both casts");
+  assert.ok(near(merged.cdf[0][255], 1, 1e-9));
+  assert.throws(() => measureLabStats(new Uint8ClampedArray(4)), /No visible pixels/);
+});
+
+test("a transfer from an image onto itself is (near) identity for every method", () => {
+  const stats = measureLabStats(image(24, 24, (x, y) => [x, y * 0.8 + 0.1, 1 - x * 0.7]));
+  for (const method of ["reinhard", "histogram", "balanced"]) {
+    const transfer = buildColorTransfer(stats, stats, { method });
+    const [r, g, b] = transfer(0.4, 0.5, 0.6);
+    assert.ok(near(r, 0.4, 0.03) && near(g, 0.5, 0.03) && near(b, 0.6, 0.03), `${method}: ${r} ${g} ${b}`);
+  }
+});
+
+test("Reinhard transfer moves a neutral source toward the reference cast; intensity 0 is untouched", () => {
+  const source = measureLabStats(image(16, 16, (x, y) => [x * 0.8 + 0.1, x * 0.8 + 0.1, y * 0.8 + 0.1]));
+  const reference = measureLabStats(image(16, 16, (x) => [0.3 + x * 0.6, 0.35 + x * 0.3, 0.2 + x * 0.1])); // warm/orange
+  const full = buildColorTransfer(source, reference, { method: "reinhard" });
+  const [r, , b] = full(0.5, 0.5, 0.5);
+  assert.ok(r > b + 0.1, `grey should turn warm, got r=${r} b=${b}`);
+  const none = buildColorTransfer(source, reference, { method: "reinhard", intensity: 0 });
+  const kept = none(0.5, 0.5, 0.5);
+  kept.forEach((value) => assert.ok(near(value, 0.5, 1e-6)));
+  const half = buildColorTransfer(source, reference, { method: "reinhard", intensity: 0.5 })(0.5, 0.5, 0.5);
+  assert.ok(half[0] > 0.5 && half[0] < r, "half intensity lands between");
+});
+
+test("histogram matching reproduces the reference lightness distribution", () => {
+  const dark = measureLabStats(image(32, 32, (x) => [x * 0.4, x * 0.4, x * 0.4]));
+  const bright = measureLabStats(image(32, 32, (x) => [0.5 + x * 0.5, 0.5 + x * 0.5, 0.5 + x * 0.5]));
+  const transfer = buildColorTransfer(dark, bright, { method: "histogram" });
+  const mid = rgbToLab(...transfer(0.2, 0.2, 0.2))[0];
+  assert.ok(mid > rgbToLab(0.6, 0.6, 0.6)[0] && mid < rgbToLab(0.9, 0.9, 0.9)[0], `mid-tone L=${mid}`);
+});
+
+test("a baked LUT serialises to a .cube that ScenePilot's parser reads back exactly", () => {
+  const identity = (r, g, b) => [r, g, b];
+  const table = bakeLut3d(identity, 5);
+  assert.equal(table.length, 5 * 5 * 5 * 3);
+  const text = serializeCubeLut(table, 5, 'Test "Look"\nInjected');
+  assert.match(text, /^TITLE "Test LookInjected"/);
+  const parsed = parseCubeLut(text);
+  assert.equal(parsed.size, 5);
+  assert.equal(parsed.dimensions, 3);
+  const sample = sampleCubeLut(parsed, 0.3, 0.6, 0.9);
+  assert.ok(near(sample[0], 0.3, 1e-6) && near(sample[1], 0.6, 1e-6) && near(sample[2], 0.9, 1e-6));
+  // r fastest: entry 1 is (r=0.25, g=0, b=0).
+  assert.deepEqual([...table.slice(3, 6)], [0.25, 0, 0]);
+  assert.throws(() => bakeLut3d(identity, 1), /between 2 and 65/);
+  assert.throws(() => serializeCubeLut(table, 4), /does not match/);
+  const rgba = lutToRgba8(table);
+  assert.equal(rgba.length, 125 * 4);
+  assert.deepEqual([...rgba.slice(4, 8)], [64, 0, 0, 255]);
+});
+
+test("the neutral fallback is broad and roughly grey", () => {
+  const stats = neutralLabStats();
+  assert.ok(Math.abs(stats.mean[1]) < 2 && Math.abs(stats.mean[2]) < 2);
+  assert.ok(stats.std[0] > 15);
+});
+
+test("dominant palette finds the main colours by share", () => {
+  const pixels = image(20, 20, (x) => (x < 0.7 ? [1, 0, 0] : [0, 0, 1]));
+  const palette = dominantPalette(pixels, 3, 1);
+  assert.equal(palette[0].hex, "#ff0000");
+  assert.equal(palette[1].hex, "#0000ff");
+  assert.ok(palette[0].share > palette[1].share);
+});
diff --git a/tests/film-tools.test.mjs b/tests/film-tools.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8be860dca9ed6d9d7b93a7a9ad16542656f74df1
--- /dev/null
+++ b/tests/film-tools.test.mjs
@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import { access, readFile } from "node:fs/promises";
+import test from "node:test";
+
+const read = (path) => readFile(new URL(`../${path}`, import.meta.url), "utf8");
+const TOOLS = ["captions", "board", "grade"];
+
+test("the site links every film tool and the tool pages are published under site/tools", async () => {
+  const landing = await read("site/index.html");
+  assert.match(landing, /href="#film-tools"/);
+  assert.match(landing, /FILM TOOLS · ALPHA/);
+  for (const tool of TOOLS) {
+    assert.match(landing, new RegExp(`href="tools/${tool}/"`));
+    await access(new URL(`../site/tools/${tool}/index.html`, import.meta.url));
+    const built = await read(`site/tools/${tool}/index.html`);
+    assert.match(built, /src="\/tools\/assets\//, `${tool} page loads its bundle from /tools/`);
+  }
+  await access(new URL("../site/tools/index.html", import.meta.url));
+});
+
+test("every tool page is labelled alpha and lists its limits", async () => {
+  const shell = await read("tools/src/shell.tsx");
+  assert.match(shell, />ALPHA</);
+  assert.match(shell, /what works and what doesn’t yet/);
+  for (const tool of TOOLS) {
+    const source = await read(`tools/src/${tool}/main.tsx`);
+    assert.match(source, /<ToolShell tool="/);
+    assert.match(source, /const LIMITS = \[/);
+  }
+});
+
+test("the embedded editor links to the film tools, the build keeps them out of the editor bundle", async () => {
+  const topbar = await read("app/studio-topbar.tsx");
+  assert.match(topbar, /props\.embedded && <a className="icon-button" href="\.\.\/tools\/"/);
+  const config = await read("vite.tools.config.ts");
+  assert.match(config, /base: "\/tools\/"/);
+  assert.match(config, /site\/tools/);
+  const pkg = JSON.parse(await read("package.json"));
+  assert.match(pkg.scripts["build:tools"], /vite\.tools\.config\.ts/);
+  assert.match(pkg.scripts.lint, /--ignore-pattern site\/tools/);
+});
+
+test("on-device ASR stays opt-in, CDN-loaded and license-compatible", async () => {
+  const worker = await read("app/transcribe.worker.ts");
+  assert.match(worker, /@huggingface\/transformers@3\.0\.2/);
+  assert.match(worker, /device === "webgpu"/);
+  const captions = await read("tools/src/captions/main.tsx");
+  for (const model of ["Xenova/whisper-tiny.en", "Xenova/whisper-base.en", "Xenova/whisper-tiny"]) assert.ok(captions.includes(model));
+  assert.match(captions, /MIT/);
+  assert.match(captions, /Apache-2\.0/);
+});
diff --git a/tests/storyboard.test.mjs b/tests/storyboard.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c7f20c6b4d683d376395cdc883ec09483c02b1ed
--- /dev/null
+++ b/tests/storyboard.test.mjs
@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  boardDuration, boardToCsv, boardToCutFile, boardToMarkers, createBoard, estimateDuration, guessShotType, makeIdFactory, moveShot, parseBoardJson, parseScript, shotNumber,
+} from "../lib/storyboard.ts";
+import { parseCutFile } from "../lib/project-store.ts";
+
+const SCREENPLAY = `Title: Last Order
+
+INT. DINER - NIGHT
+
+Rain streaks the window. MAYA stirs a coffee she hasn't touched.
+
+CLOSE ON her hand — a pale band where a ring used to be.
+
+JONAH
+(out of breath)
+You kept the place.
+
+MAYA
+I kept the coffee.
+
+CUT TO:
+
+EXT. PARKING LOT - CONTINUOUS
+
+A wide, empty lot. Neon hums. Maya walks to her car alone.
+
+INSERT - her phone screen: 3 missed calls.`;
+
+test("screenplay: scene headings, action, explicit shots, dialogue coverage, transitions dropped", () => {
+  const scenes = parseScript(SCREENPLAY, makeIdFactory("t"));
+  assert.deepEqual(scenes.map((scene) => scene.heading), ["INT. DINER - NIGHT", "EXT. PARKING LOT - CONTINUOUS"]);
+  const [diner, lot] = scenes;
+  assert.equal(diner.shots.length, 4);
+  assert.equal(diner.shots[0].shotType, "WS");
+  assert.equal(diner.shots[1].shotType, "CU");
+  assert.match(diner.shots[1].description, /pale band/);
+  assert.equal(diner.shots[2].character, "JONAH");
+  assert.equal(diner.shots[2].dialogue, "You kept the place.");
+  assert.match(diner.shots[2].description, /out of breath/);
+  assert.equal(diner.shots[2].shotType, "MCU");
+  assert.ok(!diner.shots.some((shot) => /CUT TO/.test(shot.description)));
+  assert.equal(lot.shots[0].shotType, "EWS");
+  assert.equal(lot.shots[1].shotType, "INSERT");
+  assert.equal(lot.shots[1].lens, "100mm macro");
+});
+
+test("prose and bullet lists become scenes of sentence/bullet shots", () => {
+  const scenes = parseScript("Opening\nA skater drops into an empty pool at dawn. Slow motion of the wheels. She lands and grins.\n\n- Crowd cheering\n- Close up on the trophy\n- Aerial of the city", makeIdFactory("p"));
+  assert.equal(scenes.length, 2);
+  assert.equal(scenes[0].heading, "OPENING");
+  assert.equal(scenes[0].shots.length, 3);
+  assert.equal(scenes[1].heading, "SCENE 2");
+  assert.deepEqual(scenes[1].shots.map((shot) => shot.shotType), ["WS", "CU", "AERIAL"]);
+  assert.deepEqual(parseScript("   \n\n "), []);
+});
+
+test("shot type, duration and numbering heuristics", () => {
+  assert.equal(guessShotType("we see it from his POV", { firstInScene: false, hasDialogue: false }), "POV");
+  assert.equal(guessShotType("tears in her eyes", { firstInScene: false, hasDialogue: false }), "CU");
+  assert.equal(guessShotType("they argue", { firstInScene: false, hasDialogue: false }), "MS");
+  assert.equal(estimateDuration("", "one two three four five six seven eight nine ten"), 4.6);
+  assert.equal(estimateDuration("short"), 2);
+  assert.equal(estimateDuration(Array(90).fill("w").join(" ")), 12);
+  assert.equal(shotNumber(0, 0), "1A");
+  assert.equal(shotNumber(2, 25), "3Z");
+  assert.equal(shotNumber(0, 26), "1AA");
+});
+
+test("moveShot reorders within and across scenes without losing shots", () => {
+  const scenes = parseScript(SCREENPLAY, makeIdFactory("m"));
+  const [diner, lot] = scenes;
+  const moved = moveShot(scenes, diner.shots[0].id, diner.id, 2);
+  assert.equal(moved[0].shots[2].id, diner.shots[0].id);
+  const across = moveShot(scenes, diner.shots[3].id, lot.id, 0);
+  assert.equal(across[0].shots.length, 3);
+  assert.equal(across[1].shots[0].id, diner.shots[3].id);
+  assert.equal(moveShot(scenes, "missing", lot.id, 0), scenes);
+});
+
+test("markers lay shots end to end and the cut file imports through ScenePilot's parser", () => {
+  const board = createBoard("Last Order", parseScript(SCREENPLAY, makeIdFactory("c")));
+  const markers = boardToMarkers(board);
+  const shots = markers.filter((marker) => marker.kind === "marker");
+  assert.equal(markers.filter((marker) => marker.kind === "chapter").length, 2);
+  assert.equal(shots.length, 6);
+  for (let i = 1; i < shots.length; i++) assert.ok(Math.abs(shots[i].time - (shots[i - 1].time + shots[i - 1].duration)) < 1e-6);
+  assert.match(shots[0].label, /^1A WS · Rain/);
+  assert.ok(markers.every((marker) => marker.label.length <= 80));
+  const cut = parseCutFile(JSON.stringify(boardToCutFile(board)));
+  assert.equal(cut.project, "Last Order");
+  assert.ok(Math.abs(cut.duration - boardDuration(board)) < 1e-6);
+  assert.equal(cut.proState.markers.length, markers.length);
+  assert.match(cut.storyBrief, /SCENE 1: INT\. DINER - NIGHT/);
+  assert.match(cut.storyBrief, /1C {2}MCU/);
+});
+
+test("CSV quotes commas, quotes and newlines", () => {
+  const board = createBoard("x", [{ id: "s", heading: "INT. A, B", shots: [{ id: "a", description: 'He says "hi"\nthen leaves', shotType: "MS", lens: "35mm", duration: 2, notes: "" }] }]);
+  const csv = boardToCsv(board);
+  assert.match(csv, /^Shot,Scene,Type/);
+  assert.match(csv, /1A,"INT\. A, B",MS,35mm,2,"He says ""hi""\nthen leaves"/);
+});
+
+test("board JSON round-trips and repairs hostile input", () => {
+  const board = createBoard("Saved", parseScript(SCREENPLAY, makeIdFactory("j")), "2.39:1");
+  board.scenes[0].shots[0].frame = "data:image/jpeg;base64,AAAA";
+  const loaded = parseBoardJson(JSON.stringify(board));
+  assert.deepEqual(JSON.parse(JSON.stringify(loaded)), JSON.parse(JSON.stringify(board)));
+  const repaired = parseBoardJson(JSON.stringify({ format: "scenepilot-board", aspect: "weird", scenes: [{ shots: [{ shotType: "NOPE", duration: -4, frame: "javascript:alert(1)" }, null] }] }));
+  assert.equal(repaired.aspect, "16:9");
+  assert.equal(repaired.scenes[0].shots[0].shotType, "MS");
+  assert.equal(repaired.scenes[0].shots[0].duration, 0.1);
+  assert.equal(repaired.scenes[0].shots[0].frame, undefined);
+  assert.equal(repaired.scenes[0].shots.length, 2);
+  assert.throws(() => parseBoardJson("{"), /valid JSON/);
+  assert.throws(() => parseBoardJson("{}"), /board file/);
+});
