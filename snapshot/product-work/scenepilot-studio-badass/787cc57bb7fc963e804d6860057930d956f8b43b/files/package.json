{
  "name": "scenepilot-studio",
  "version": "0.1.15",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:tools": "vite --config vite.tools.config.ts",
    "build:app": "vite build --config vite.site.config.ts",
    "build:tools": "vite build --config vite.tools.config.ts",
    "deploy": "npm run build:app && npm run build:tools && netlify deploy --prod --dir=site --no-build --message \"Deploy $(date -u +%Y-%m-%dT%H:%MZ)\"",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:renderer": "vite build --config vite.desktop.config.ts",
    "desktop:stage-media-tools": "node scripts/stage-media-tools.mjs && node scripts/stage-ai-models.mjs && node scripts/stage-sam2-models.mjs && node scripts/build-native-roto.mjs && node scripts/stage-neural-inpaint.mjs",
    "desktop:stage-neural-inpaint": "node scripts/stage-neural-inpaint.mjs",
    "desktop:stage-sam2": "node scripts/stage-sam2-models.mjs",
    "desktop:build-native-roto": "node scripts/build-native-roto.mjs",
    "desktop:dev": "npm run desktop:stage-media-tools && npm run desktop:renderer && electron .",
    "desktop:dist": "npm run desktop:stage-media-tools && npm run desktop:renderer && electron-builder --projectDir electron --mac dmg --arm64 --publish never",
    "desktop:dist:arm64": "npm run desktop:dist",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:quick": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && npm run lint",
    "verify": "npm run check && npm run test:quick && npm run qa:project-intelligence && npm run qa:worker-stream && npm run qa:pcm-worker && npm run qa:native-pixels && npm run qa:neural-inpaint && npm run qa:neural-inpaint-model && npm run qa:roto-memory && npm run qa:performance && npm run qa:accessibility",
    "verify:full": "npm run check && npm test && npm run qa:project-intelligence && npm run qa:worker-stream && npm run qa:pcm-worker && npm run qa:native-pixels && npm run qa:neural-inpaint && npm run qa:neural-inpaint-model && npm run qa:roto-memory && npm run qa:performance && npm run qa:accessibility",
    "qa:media": "node scripts/certify-real-media.mjs",
    "qa:main-source": "node scripts/certify-main-source.mjs",
    "qa:native-pixels": "node scripts/certify-native-pixels.mjs",
    "qa:neural-inpaint": "node --test tests/neural-inpaint.test.mjs",
    "qa:neural-inpaint-model": "node scripts/certify-neural-inpaint-model.mjs",
    "qa:worker-stream": "electron scripts/certify-worker-stream.mjs",
    "qa:pcm-worker": "node scripts/certify-pcm-worker.mjs",
    "qa:roto": "node --experimental-strip-types scripts/certify-roto.mjs",
    "qa:native-roto": "node scripts/certify-native-roto.mjs",
    "qa:native-roto-sequence": "node scripts/certify-native-roto-sequence.mjs",
    "qa:roto-memory": "node --experimental-strip-types scripts/certify-roto-memory.mjs",
    "qa:performance": "node --experimental-strip-types scripts/benchmark-editor.mjs",
    "qa:accessibility": "node scripts/audit-accessibility.mjs",
    "qa:project-intelligence": "node --experimental-strip-types scripts/certify-project-intelligence.mjs",
    "qa:bundle": "node scripts/audit-bundle.mjs",
    "qa:product": "node --experimental-strip-types scripts/certify-product.mjs",
    "qa:product:release": "node --experimental-strip-types scripts/certify-product.mjs --require-review",
    "qa:blind-review": "node --experimental-strip-types scripts/prepare-blind-review.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern electron/renderer --ignore-pattern electron/inpaint-provider --ignore-pattern release --ignore-pattern outputs --ignore-pattern site/app --ignore-pattern site/tools --ignore-pattern public/mediapipe",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "mediabunny": "^1.51.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "5.20260721.1",
    "@electron/notarize": "^2.5.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "^0.5.34",
    "axe-core": "^4.11.4",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "openvino-node": "2026.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "8.0.16",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion@1.x": "1.1.18",
    "brace-expansion@5.x": "5.0.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.1"
  },
  "type": "module"
}
