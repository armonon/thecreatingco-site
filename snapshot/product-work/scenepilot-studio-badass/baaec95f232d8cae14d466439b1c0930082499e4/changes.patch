+    sourceDims: { w: dimension(source.w, 1280), h: dimension(source.h, 720) },
+    exportFrameRate: [24, 25, 30, 50, 60].includes(Number(v.exportFrameRate)) ? Number(v.exportFrameRate) as ProjectSettings["exportFrameRate"] : 30,
