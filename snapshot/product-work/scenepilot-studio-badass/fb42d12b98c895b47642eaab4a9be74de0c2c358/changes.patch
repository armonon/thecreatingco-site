+    const owner = slot.current;
+    return () => owner?.clear();
+  }, []);
+  return {
+    download,
+    ready(blob: Blob, name: string) { setDownload(slot.current!.replace(blob, name)); },
+    dismiss() { slot.current!.clear(); setDownload(null); },
+  };
+}
diff --git a/app/use-composition-documents.ts b/app/use-composition-documents.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d6ead0901d1d83615fc1e1c0ea4830fa354767fc
