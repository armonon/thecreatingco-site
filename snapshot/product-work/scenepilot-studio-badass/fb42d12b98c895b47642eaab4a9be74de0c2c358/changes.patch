index 0000000000000000000000000000000000000000..26c534fcd1899d371f8d641d42f9afe2d587b860
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/AdjacentEditing.swift
@@ -0,0 +1,80 @@
+import Foundation
+
+extension Edit {
+    /// Move the selected clip's out-point and the following clip's in-point together.
+    /// Outer boundaries and every other track stay fixed. No implicit ripple/linking.
+    public static func roll(_ project: Project, sequenceId: String, clipId: String, by frames: Int) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let (indices, selected) = try adjacentLane(sequence, clipId)
+            guard selected + 1 < indices.count else { throw ProjectError.invalid("Roll needs an adjacent clip after the selected clip.") }
+            let left = indices[selected], right = indices[selected + 1]
+            try requireTouching(sequence.videoClips[left], sequence.videoClips[right])
+            let delta = Double(frames) / Double(sequence.frameRate)
+            guard delta != 0 else { return }
+            sequence.videoClips[left].duration += delta
+            sequence.videoClips[right].start += delta
+            sequence.videoClips[right].sourceStart += delta * sequence.videoClips[right].rate
+            sequence.videoClips[right].duration -= delta
+            sequence.videoClips[right].motion?.offset += delta
+            sequence.videoClips[right].maskAnimation?.offset += delta
+            resetTrimFades(&sequence.videoClips[left]); resetTrimFades(&sequence.videoClips[right])
+            try requireSourceHandles(project, sequence.videoClips[left]); try requireSourceHandles(project, sequence.videoClips[right])
+        }
+    }
+
+    /// Slide a clip without changing its source window or duration. Trim its two
+    /// neighbors to fill the space; neither the sequence length nor other tracks move.
+    public static func slide(_ project: Project, sequenceId: String, clipId: String, by frames: Int) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let (indices, selected) = try adjacentLane(sequence, clipId)
+            guard selected > 0 && selected + 1 < indices.count else { throw ProjectError.invalid("Slide needs adjacent clips on both sides.") }
+            let left = indices[selected - 1], middle = indices[selected], right = indices[selected + 1]
+            try requireTouching(sequence.videoClips[left], sequence.videoClips[middle])
+            try requireTouching(sequence.videoClips[middle], sequence.videoClips[right])
+            let delta = Double(frames) / Double(sequence.frameRate)
+            guard delta != 0 else { return }
+            sequence.videoClips[left].duration += delta
+            sequence.videoClips[middle].start += delta
+            sequence.videoClips[right].start += delta
+            sequence.videoClips[right].sourceStart += delta * sequence.videoClips[right].rate
+            sequence.videoClips[right].duration -= delta
+            sequence.videoClips[right].motion?.offset += delta
+            sequence.videoClips[right].maskAnimation?.offset += delta
+            resetTrimFades(&sequence.videoClips[left]); resetTrimFades(&sequence.videoClips[right])
+            try requireSourceHandles(project, sequence.videoClips[left]); try requireSourceHandles(project, sequence.videoClips[right])
+        }
+    }
+
+    private static func adjacentLane(_ sequence: Sequence, _ id: String) throws -> ([Int], Int) {
+        let clipIndex = try editableClip(sequence, id)
+        let trackId = sequence.videoClips[clipIndex].trackId
+        let indices = sequence.videoClips.indices.filter { sequence.videoClips[$0].trackId == trackId }.sorted {
+            let a = sequence.videoClips[$0], b = sequence.videoClips[$1]
+            return a.start == b.start ? a.id < b.id : a.start < b.start
+        }
+        for pair in zip(indices, indices.dropFirst()) {
+            let a = sequence.videoClips[pair.0], b = sequence.videoClips[pair.1]
+            guard a.start + a.duration <= b.start + 0.00001 else { throw ProjectError.invalid("Roll and slide require a non-overlapping track.") }
+        }
+        return (indices, indices.firstIndex(of: clipIndex)!)
+    }
+
+    private static func requireTouching(_ left: Clip, _ right: Clip) throws {
+        guard abs(left.start + left.duration - right.start) < 0.00001 else { throw ProjectError.invalid("Roll and slide require touching clip edges, without a gap.") }
+    }
+
+    private static func resetTrimFades(_ clip: inout Clip) {
+        clip.fadeWindow = nil
+        clip.fadeIn = min(clip.fadeIn, max(0, clip.duration))
+        clip.fadeOut = min(clip.fadeOut, max(0, clip.duration - clip.fadeIn))
+    }
+
+    private static func requireSourceHandles(_ project: Project, _ clip: Clip) throws {
+        let duration = clip.assetId.flatMap { id in project.media.first { $0.id == id }?.duration }
+            ?? clip.compositionId.flatMap { id in project.sequences.first { $0.id == id }?.duration }
+        guard let duration, clip.sourceStart >= 0,
+              clip.sourceStart + clip.duration * clip.rate <= duration + 0.00001 else {
+            throw ProjectError.invalid("Not enough source handles for this edit.")
+        }
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/AudioEnvelope.swift b/native-macos/Sources/ScenePilotCore/AudioEnvelope.swift
new file mode 100644
index 0000000000000000000000000000000000000000..0c1a47a18acba337b738b67b8cd17c29cea8ec64
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/AudioEnvelope.swift
@@ -0,0 +1,52 @@
+import Foundation
+
+/// One clip/group envelope mapped into root sequence seconds.
+public struct AudioFadeEnvelope: Equatable, Sendable {
+    public var start: Double, duration: Double, fadeIn: Double, fadeOut: Double
+    public init(start: Double, duration: Double, fadeIn: Double, fadeOut: Double) { self.start = start; self.duration = duration; self.fadeIn = fadeIn; self.fadeOut = fadeOut }
+    public func value(at t: Double) -> Double {
+        let incoming = fadeIn > 0 ? min(1,max(0,(t-start)/fadeIn)) : 1
+        let outgoing = fadeOut > 0 ? min(1,max(0,(start+duration-t)/fadeOut)) : 1
+        return incoming * outgoing
+    }
+}
+public struct AudioVolumeRamp: Equatable, Sendable {
+    public let start: Double, end: Double, from: Double, to: Double
+}
+public enum AudioEnvelope {
+    /// AVAudioMix accepts linear ramps. Products of nested fades are nonlinear.
+    /// Partition at every knee, then bound linear-interpolation error using
+    /// max|f''| * h²/8. Unlike midpoint sampling this cannot miss an interior peak.
+    /// Error is <=1e-5 absolute gain before Float/CMTime conversion. Fail rather
+    /// than allocate unbounded automation on pathological gain/depth inputs.
+    public static func ramps(_ envelopes: [AudioFadeEnvelope], gain: Double, from start: Double, to end: Double, tolerance: Double = 0.00001) throws -> [AudioVolumeRamp] {
+        guard start.isFinite, end.isFinite, end > start, gain.isFinite, gain >= 0, tolerance.isFinite, tolerance > 0, envelopes.count <= 32 else { throw ProjectError.invalid("Invalid native audio envelope.") }
+        var points = [start,end]
+        for e in envelopes {
+            guard [e.start,e.duration,e.fadeIn,e.fadeOut].allSatisfy(\.isFinite), e.duration > 0, e.fadeIn >= 0, e.fadeOut >= 0, e.fadeIn+e.fadeOut <= e.duration+0.00001 else { throw ProjectError.invalid("Invalid nested fade window.") }
+            points += [e.start,e.start+e.fadeIn,e.start+e.duration-e.fadeOut,e.start+e.duration].filter { $0 > start && $0 < end }
+        }
+        points = Array(Set(points)).sorted()
+        func value(_ t: Double) -> Double { envelopes.reduce(gain) { $0 * $1.value(at:t) } }
+        var result: [AudioVolumeRamp] = []
+        for (a,b) in zip(points,points.dropFirst()) {
+            let slopes = envelopes.flatMap { e -> [Double] in
+                func incoming(_ t: Double) -> Double { e.fadeIn > 0 ? min(1,max(0,(t-e.start)/e.fadeIn)) : 1 }
+                func outgoing(_ t: Double) -> Double { e.fadeOut > 0 ? min(1,max(0,(e.start+e.duration-t)/e.fadeOut)) : 1 }
+                return [(incoming(b)-incoming(a))/(b-a),(outgoing(b)-outgoing(a))/(b-a)]
+            }
+            var curvature = 0.0
+            for i in slopes.indices { for j in slopes.indices where i != j { curvature += abs(slopes[i]*slopes[j]) } }
+            let needed = ceil((b-a) * sqrt(gain * curvature / (8*tolerance)))
+            guard needed.isFinite, needed <= 100_000, result.count + Int(needed) <= 100_000 else { throw ProjectError.invalid("Nested audio fade automation exceeds its safety limit. Reduce nesting or gain.") }
+            let count = max(1,Int(needed))
+            for i in 0..<count {
+                let x = a+(b-a)*Double(i)/Double(count), y = a+(b-a)*Double(i+1)/Double(count)
+                let v0 = value(x), v1 = value(y)
+                guard Float(v0).isFinite, Float(v1).isFinite else { throw ProjectError.invalid("Nested audio gain exceeds native float range.") }
+                result.append(AudioVolumeRamp(start:x,end:y,from:v0,to:v1))
+            }
+        }
+        return result
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/ClipMask.swift b/native-macos/Sources/ScenePilotCore/ClipMask.swift
new file mode 100644
index 0000000000000000000000000000000000000000..8b81507500d9cfa81c28999847773137e23fbfa6
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/ClipMask.swift
@@ -0,0 +1,77 @@
+import Foundation
+
+/// Normalized composition-space shape, applied before animated placement. Y is down.
+public struct ClipMask: Codable, Equatable, Sendable {
+    public enum Shape: String, Codable, CaseIterable, Sendable { case rectangle, ellipse, bezier }
+    public var shape: Shape
+    public var x: Double = 0.5
+    public var y: Double = 0.5
+    public var width: Double = 0.75
+    public var height: Double = 0.75
+    public var feather: Double = 0
+    public var inverted = false
+    public var points: [BezierVertex]?
+    public init(shape: Shape) { self.shape = shape }
+    public func validate() throws {
+        if shape == .bezier {
+            guard let points, (3...128).contains(points.count) else { throw ProjectError.invalid("A closed Bezier mask needs 3–128 vertices.") }
+            for point in points { try point.validate() }
+        } else if points != nil { throw ProjectError.invalid("Only Bezier masks may contain path vertices.") }
+        guard [x,y,width,height,feather].allSatisfy(\.isFinite), (-8...8).contains(x), (-8...8).contains(y),
+              (0.001...16).contains(width), (0.001...16).contains(height), (0...200).contains(feather) else {
+            throw ProjectError.invalid("Invalid mask bounds or feather. Width and height must be positive; feather is 0–200 pixels.")
+        }
+    }
+}
+
+/// Sibling clip pixels supply coverage. Providers are matte-only visually; audio is unchanged.
+public struct ClipMatte: Codable, Equatable, Sendable {
+    public enum Mode: String, Codable, CaseIterable, Sendable { case alpha, luma }
+    public var sourceClipId: String
+    public var mode: Mode
+    public var inverted: Bool
+    public init(sourceClipId: String, mode: Mode = .alpha, inverted: Bool = false) {
+        self.sourceClipId = sourceClipId; self.mode = mode; self.inverted = inverted
+    }
+}
+
+extension Project {
+    func validateMattes(in sequence: Sequence) throws {
+        let clips = Dictionary(uniqueKeysWithValues: sequence.videoClips.map { ($0.id, $0) })
+        let video = Set(media.filter(\.hasVideo).map(\.id))
+        func visual(_ clip: Clip) -> Bool { clip.compositionId != nil || clip.assetId.map(video.contains) == true }
+        var depths: [String: Int] = [:]
+        func visit(_ clip: Clip, parents: Set<String>) throws -> Int {
+            guard !parents.contains(clip.id), parents.count < 32 else { throw ProjectError.invalid("Matte dependency cycle or excessive nesting.") }
+            if let depth = depths[clip.id] { return depth }
+            var depth = 1
+            if let matte = clip.matte {
+                guard let source = clips[matte.sourceClipId], visual(clip), visual(source) else {
+                    throw ProjectError.invalid("A matte must reference a video clip or composition in the same sequence. Remove its matte link before deleting a provider.")
+                }
+                depth += try visit(source, parents: parents.union([clip.id]))
+            }
+            guard depth <= 32 else { throw ProjectError.invalid("Matte dependency chain exceeds 32 clips.") }
+            depths[clip.id] = depth; return depth
+        }
+        for clip in sequence.videoClips { _ = try visit(clip, parents: []) }
+    }
+}
+
+extension Edit {
+    public static func mask(_ project: Project, sequenceId: String, clipId: String, value: ClipMask?, at time: Double? = nil) throws -> Project {
+        if value != nil, project.sequences.first(where: { $0.id == sequenceId })?.videoClips.first(where: { $0.id == clipId })?.maskAnimation != nil {
+            guard let time else { throw ProjectError.invalid("Supply a playhead time when editing an animated mask.") }
+            return try maskKey(project, sequenceId: sequenceId, clipId: clipId, at: time, value: value)
+        }
+        return try transact(project, sequenceId: sequenceId) { sequence in
+            let index = try editableClip(sequence, clipId); sequence.videoClips[index].mask = value
+            if value == nil { sequence.videoClips[index].maskAnimation = nil }
+        }
+    }
+    public static func matte(_ project: Project, sequenceId: String, clipId: String, value: ClipMatte?) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let index = try editableClip(sequence, clipId); sequence.videoClips[index].matte = value
+        }
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/ClipMotion.swift b/native-macos/Sources/ScenePilotCore/ClipMotion.swift
new file mode 100644
index 0000000000000000000000000000000000000000..637b74c77d0a6b772859702933293627e6b7b2d8
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/ClipMotion.swift
@@ -0,0 +1,139 @@
+import Foundation
+
+public enum MotionEasing: String, Codable, CaseIterable, Sendable {
+    case linear, smooth, easeIn, easeOut, hold
+    public func progress(_ t: Double) -> Double {
+        switch self {
+        case .linear: return t
+        case .smooth: return t * t * (3 - 2 * t)
+        case .easeIn: return t * t
+        case .easeOut: return t * (2 - t)
+        case .hold: return 0
+        }
+    }
+}
+
+/// Continuous picture channels. Fit/fill and flips remain clip-wide settings.
+public struct MotionValue: Codable, Equatable, Sendable {
+    public var x: Double, y: Double, scale: Double, rotation: Double, opacity: Double
+    public init(x: Double = 0, y: Double = 0, scale: Double = 1, rotation: Double = 0, opacity: Double = 1) {
+        self.x = x; self.y = y; self.scale = scale; self.rotation = rotation; self.opacity = opacity
+    }
+    public func validate() throws {
+        var t = ClipTransform(); t.x = x; t.y = y; t.scale = scale; t.rotation = rotation
+        try t.validate()
+        guard opacity.isFinite, (0...1).contains(opacity) else { throw ProjectError.invalid("Keyframe opacity must be between 0 and 1.") }
+    }
+    public func applying(to base: ClipTransform) -> ClipTransform {
+        var t = base; t.x = x; t.y = y; t.scale = scale; t.rotation = rotation; return t
+    }
+    fileprivate func interpolated(to b: Self, progress t: Double) -> Self {
+        func mix(_ a: Double, _ b: Double) -> Double { a + (b - a) * t }
+        return Self(x: mix(x,b.x), y: mix(y,b.y), scale: mix(scale,b.scale), rotation: mix(rotation,b.rotation), opacity: mix(opacity,b.opacity))
+    }
+}
+
+public struct MotionKeyframe: Codable, Equatable, Sendable {
+    public var time: Double
+    public var value: MotionValue
+    /// Easing belongs to the outgoing segment. Hold switches exactly at the next key.
+    public var easing: MotionEasing
+    public init(time: Double, value: MotionValue, easing: MotionEasing = .linear) {
+        self.time = time; self.value = value; self.easing = easing
+    }
+}
+
+public struct ClipMotion: Codable, Equatable, Sendable {
+    public var keyframes: [MotionKeyframe]
+    /// Original animation clock at the current clip head, in timeline seconds.
+    /// Signed offsets allow extending a trimmed clip before its original first key.
+    public var offset: Double
+    public init(keyframes: [MotionKeyframe], offset: Double = 0) { self.keyframes = keyframes; self.offset = offset }
+    public func validate() throws {
+        guard offset.isFinite, abs(offset) <= 86400, !keyframes.isEmpty, keyframes.count <= 4096 else { throw ProjectError.invalid("Invalid motion clock or keyframe count (maximum 4096).") }
+        var previous = -Double.infinity
+        for key in keyframes {
+            guard key.time.isFinite, abs(key.time) <= 86400, key.time - previous > 0.000001 else { throw ProjectError.invalid("Motion keys must have distinct, increasing finite times.") }
+            try key.value.validate(); previous = key.time
+        }
+    }
+    /// O(log n), deterministic, with endpoint holding. Never sorts on the render thread.
+    public func value(atLocalTime local: Double) -> MotionValue? {
+        guard let first = keyframes.first, let last = keyframes.last, local.isFinite else { return nil }
+        let time = local + offset
+        if time <= first.time { return first.value }
+        if time >= last.time { return last.value }
+        var low = 0, high = keyframes.count - 1
+        while high - low > 1 {
+            let mid = (low + high) / 2
+            if keyframes[mid].time <= time { low = mid } else { high = mid }
+        }
+        let a = keyframes[low], b = keyframes[high]
+        return a.value.interpolated(to: b.value, progress: a.easing.progress((time - a.time) / (b.time - a.time)))
+    }
+}
+
+extension Clip {
+    public func motionValue(atLocalTime time: Double) -> MotionValue {
+        let t = transform ?? ClipTransform()
+        return motion?.value(atLocalTime: time) ?? MotionValue(x: t.x, y: t.y, scale: t.scale, rotation: t.rotation, opacity: opacity)
+    }
+    public func motionKeyTime(at timelineTime: Double, frameRate: Int) -> Double {
+        (timelineTime * Double(frameRate)).rounded() / Double(frameRate) - start + (motion?.offset ?? 0)
+    }
+}
+
+extension Edit {
+    /// Move one key on the sequence frame grid. Refuse collisions rather than
+    /// silently replacing another pose; preserve all values and outgoing easing.
+    public static func moveMotionKey(_ project: Project, sequenceId: String, clipId: String, keyTime: Double, to time: Double) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let i = try editableClip(sequence, clipId), clip = sequence.videoClips[i]
+            guard time.isFinite, keyTime.isFinite, var motion = clip.motion,
+                  let keyIndex = motion.keyframes.firstIndex(where: { abs($0.time - keyTime) < 0.00001 }) else { throw ProjectError.invalid("Select an existing motion key.") }
+            let target = clip.motionKeyTime(at: time, frameRate: sequence.frameRate)
+            let local = target - motion.offset
+            guard local >= -0.00001, local < clip.duration - 0.00001 else { throw ProjectError.invalid("Keep motion keys on frames inside this clip.") }
+            guard !motion.keyframes.enumerated().contains(where: { $0.offset != keyIndex && abs($0.element.time - target) < 0.00001 }) else { throw ProjectError.invalid("Another motion key already occupies that frame. Both keys were preserved.") }
+            motion.keyframes[keyIndex].time = target
+            motion.keyframes.sort { $0.time < $1.time }
+            sequence.videoClips[i].motion = motion
+        }
+    }
+    /// One undoable update; edits on the same sequence frame replace, not duplicate, a key.
+    public static func motionKey(_ project: Project, sequenceId: String, clipId: String, at time: Double, value: MotionValue? = nil, easing: MotionEasing? = nil, remove: Bool = false) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let i = try editableClip(sequence, clipId)
+            var clip = sequence.videoClips[i]
+            guard time.isFinite, clip.compositionId != nil || project.media.contains(where: { $0.id == clip.assetId && $0.hasVideo }) else { throw ProjectError.invalid("Motion keys require a video clip or composition.") }
+            let keyTime = clip.motionKeyTime(at: time, frameRate: sequence.frameRate)
+            let local = keyTime - (clip.motion?.offset ?? 0)
+            guard local >= -0.00001, local < clip.duration - 0.00001 else { throw ProjectError.invalid("Place the playhead on a frame inside the selected clip.") }
+            var motion = clip.motion ?? ClipMotion(keyframes: [])
+            let index = motion.keyframes.firstIndex { abs($0.time - keyTime) < 0.00001 }
+            if remove {
+                guard let index else { throw ProjectError.invalid("There is no keyframe at the playhead.") }
+                let held = clip.motionValue(atLocalTime: local)
+                motion.keyframes.remove(at: index)
+                if motion.keyframes.isEmpty {
+                    clip.transform = held.applying(to: clip.transform ?? ClipTransform()); clip.opacity = held.opacity
+                }
+            } else {
+                let key = MotionKeyframe(time: keyTime, value: value ?? clip.motionValue(atLocalTime: local), easing: easing ?? index.map { motion.keyframes[$0].easing } ?? .linear)
+                if let index { motion.keyframes[index] = key } else { motion.keyframes.append(key); motion.keyframes.sort { $0.time < $1.time } }
+            }
+            clip.motion = motion.keyframes.isEmpty ? nil : motion
+            sequence.videoClips[i] = clip
+        }
+    }
+    /// Disable animation without a picture jump: bake the currently evaluated pose.
+    public static func clearMotion(_ project: Project, sequenceId: String, clipId: String, at time: Double) throws -> Project {
+        guard time.isFinite else { throw ProjectError.invalid("Motion time must be finite.") }
+        return try transact(project, sequenceId: sequenceId) { sequence in
+            let i = try editableClip(sequence, clipId)
+            let value = sequence.videoClips[i].motionValue(atLocalTime: time - sequence.videoClips[i].start)
+            sequence.videoClips[i].transform = value.applying(to: sequence.videoClips[i].transform ?? ClipTransform())
+            sequence.videoClips[i].opacity = value.opacity; sequence.videoClips[i].motion = nil
+        }
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/ClipPresentation.swift b/native-macos/Sources/ScenePilotCore/ClipPresentation.swift
new file mode 100644
index 0000000000000000000000000000000000000000..166e223e814fd4073ac3d5f1b22db5d78e6f810a
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/ClipPresentation.swift
@@ -0,0 +1,22 @@
+import Foundation
+
+public struct ClipTransform: Codable, Equatable, Sendable {
+    public var x = 0.0
+    public var y = 0.0
+    public var scale = 1.0
+    public var rotation = 0.0
+    public var fill = false
+    public var flipH = false
+    public var flipV = false
+    public init() {}
+    public func validate() throws {
+        guard [x,y,scale,rotation].allSatisfy(\.isFinite), abs(x) <= 8, abs(y) <= 8, (0.01...16).contains(scale), abs(rotation) <= 3600 else { throw ProjectError.invalid("Invalid clip transform.") }
+    }
+}
+
+/// The unsplit fade envelope. Offset is in timeline seconds, not source seconds.
+public struct FadeWindow: Codable, Equatable {
+    public var offset: Double
+    public var duration: Double
+    public init(offset: Double, duration: Double) { self.offset = offset; self.duration = duration }
+}
diff --git a/native-macos/Sources/ScenePilotCore/Editing.swift b/native-macos/Sources/ScenePilotCore/Editing.swift
new file mode 100644
index 0000000000000000000000000000000000000000..36c837c9c5f1c6caadac3398d7fcfc06eacead6f
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/Editing.swift
@@ -0,0 +1,81 @@
+import Foundation
+
+public enum Edit {
+    /// Every mutation is validated before becoming the authoritative document.
+    public static func transact(_ project: Project, sequenceId: String, _ body: (inout Sequence) throws -> Void) throws -> Project {
+        var next = project
+        guard let index = next.sequences.firstIndex(where: { $0.id == sequenceId }) else { throw ProjectError.invalid("No active sequence.") }
+        try body(&next.sequences[index]); return try next.validated()
+    }
+    public static func split(_ project: Project, sequenceId: String, clipId: String, at time: Double) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            guard let i = sequence.videoClips.firstIndex(where: { $0.id == clipId }), let track = sequence.tracks.first(where: { $0.id == sequence.videoClips[i].trackId }), !track.locked else { throw ProjectError.invalid("Select an unlocked clip.") }
+            var left = sequence.videoClips[i], right = left
+            guard !sequence.videoClips.contains(where: { $0.matte?.sourceClipId == clipId }) else { throw ProjectError.invalid("This clip supplies a matte. Remove its matte links before splitting, or split the media inside its composition.") }
+            let local = (time * Double(sequence.frameRate)).rounded() / Double(sequence.frameRate) - left.start
+            guard local >= 1 / Double(sequence.frameRate), left.duration - local >= 1 / Double(sequence.frameRate) else { throw ProjectError.invalid("Place the playhead inside the selected clip.") }
+            right.id = UUID().uuidString; right.start = left.start + local
+            right.sourceStart += local * left.rate; right.duration -= local
+            right.motion?.offset += local
+            right.maskAnimation?.offset += local
+            let window = left.fadeWindow ?? FadeWindow(offset: 0, duration: left.duration)
+            left.fadeWindow = window
+            right.fadeWindow = FadeWindow(offset: window.offset + local, duration: window.duration)
+            left.duration = local
+            sequence.videoClips.replaceSubrange(i...i, with: [left, right])
+        }
+    }
+    public static func moveTrack(_ project: Project, sequenceId: String, trackId: String, by delta: Int) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            guard let index = sequence.tracks.firstIndex(where: { $0.id == trackId }) else { throw ProjectError.invalid("Select a track.") }
+            let destination = index + min(sequence.tracks.count - 1 - index, max(-index, delta))
+            guard !sequence.tracks[min(index, destination)...max(index, destination)].contains(where: { $0.locked }) else {
+                throw ProjectError.invalid("Unlock affected tracks before reordering them.")
+            }
+            let track = sequence.tracks.remove(at: index); sequence.tracks.insert(track, at: destination)
+        }
+    }
+    public static func removeTrack(_ project: Project, sequenceId: String, trackId: String) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            guard sequence.tracks.count > 1, let track = sequence.tracks.first(where: { $0.id == trackId }), !track.locked else { throw ProjectError.invalid("Keep at least one track; unlock before removal.") }
+            guard !sequence.videoClips.contains(where: { $0.trackId == trackId }) else { throw ProjectError.invalid("Move or remove clips before deleting this track.") }
+            sequence.tracks.removeAll { $0.id == trackId }
+        }
+    }
+}
+
+public struct DocumentHistory {
+    public private(set) var project: Project
+    public private(set) var saved: Project
+    private var past: [Project] = [], future: [Project] = []
+    public var dirty: Bool { project != saved }
+    public var canUndo: Bool { !past.isEmpty }
+    public var canRedo: Bool { !future.isEmpty }
+    public init(_ project: Project) { self.project = project; saved = project }
+    public mutating func apply(_ next: Project) throws {
+        _ = try next.validated(); guard next != project else { return }
+        past.append(project); if past.count > 100 { past.removeFirst() }
+        future.removeAll(); project = next
+    }
+    public mutating func undo() { guard let previous = past.popLast() else { return }; future.append(project); project = previous }
+    public mutating func redo() { guard let next = future.popLast() else { return }; past.append(project); project = next }
+    public mutating func markSaved(_ snapshot: Project) { saved = snapshot }
+}
+
+public enum ProjectStore {
+    public static func save(_ project: Project, to url: URL) throws {
+        guard url.isFileURL else { throw ProjectError.invalid("Save to a local file.") }
+        // A migration preview must never replace legacy projects or source assets.
+        if FileManager.default.fileExists(atPath: url.path) {
+            do { _ = try load(url) }
+            catch { throw ProjectError.invalid("This is not a valid native project. Choose a new filename; the existing file was preserved.") }
+        }
+        // Foundation's atomic write uses an adjacent temporary file and rename.
+        try ProjectCollection.encode(project, relativeTo: url.deletingLastPathComponent()).write(to: url, options: .atomic)
+    }
+    public static func load(_ url: URL) throws -> Project {
+        let info = try url.resourceValues(forKeys: [.fileSizeKey])
+        guard (info.fileSize ?? Int.max) <= 64 * 1024 * 1024 else { throw ProjectError.invalid("Project exceeds the document size limit.") }
+        return try Project.decode(ProjectCollection.resolve(Data(contentsOf: url), relativeTo: url.deletingLastPathComponent()))
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/LatestSeek.swift b/native-macos/Sources/ScenePilotCore/LatestSeek.swift
new file mode 100644
index 0000000000000000000000000000000000000000..347c3dbae23782e98f43913b6922942031ff6d37
