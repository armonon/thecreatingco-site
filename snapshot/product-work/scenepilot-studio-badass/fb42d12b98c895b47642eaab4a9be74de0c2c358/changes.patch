+struct NativeNode: Sendable {
+    let id: String
+    let layer: NativeLayer
+    let children: [NativeNode]
+    let matte: ClipMatte?
+    let matteOnly: Bool
+    var trackIDs: [CMPersistentTrackID] {
+        (layer.trackID == kCMPersistentTrackID_Invalid ? [] : [layer.trackID]) + children.flatMap(\.trackIDs)
+    }
