diff --git a/tests/autocut-clips-align.test.mjs b/tests/autocut-clips-align.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3a3f4a0d4176a83ea59df9ce21428ed32383600f
--- /dev/null
+++ b/tests/autocut-clips-align.test.mjs
@@ -0,0 +1,186 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { detectSceneCuts, frameIssue, profileClip, usableCoverage, windowQuality } from "../lib/autocut-clips.ts";
+import { alignEnvelopes, alignTake, crossCorrelate, fft, isSynced, onsetEnvelope, overlapCorrelation } from "../lib/autocut-align.ts";
+import { noiseSource, synthSong } from "./helpers/autocut-synth.mjs";
+
+// ---- Clip analysis --------------------------------------------------------
+
+/** 4 samples/s. `scene(t)` returns a [brightness, sharpness] look; changes between looks are hard cuts. */
+function samplesFor(duration, scene, { motion = 0.03, rate = 4 } = {}) {
+  const out = [];
+  let previous = null;
+  for (let t = 0; t < duration; t += 1 / rate) {
+    const look = scene(t);
+    const changed = previous && previous.id !== look.id;
+    out.push({
+      time: t, brightness: look.brightness, sharpness: look.sharpness, contrast: look.contrast ?? 0.3,
+      motion: changed ? 0.45 : previous ? (look.motion ?? motion) : 0,
+      histogramDistance: changed ? 0.7 : previous ? 0.02 : 0,
+      faces: look.faces, faceX: look.faceX,
+    });
+    previous = look;
+  }
+  return out;
+}
+
+const day = { id: "day", brightness: 0.5, sharpness: 0.3 };
+const night = { id: "night", brightness: 0.3, sharpness: 0.25 };
+const black = { id: "black", brightness: 0.01, sharpness: 0, contrast: 0 };
+
+test("frame issues: black, blown, blank, soft", () => {
+  assert.equal(frameIssue({ brightness: 0.02, sharpness: 0.3, contrast: 0.3 }), "black");
+  assert.equal(frameIssue({ brightness: 0.99, sharpness: 0.3, contrast: 0.3 }), "white");
+  assert.equal(frameIssue({ brightness: 0.5, sharpness: 0.001, contrast: 0.01 }), "blank");
+  assert.equal(frameIssue({ brightness: 0.5, sharpness: 0.05, contrast: 0.3 }, 0.1), "soft");
+  assert.equal(frameIssue({ brightness: 0.5, sharpness: 0.3, contrast: 0.3 }, 0.1), null);
+});
+
+test("usable segments skip black frames and split at internal scene cuts", () => {
+  // 0–2 s black (slate/fade-in), 2–6 s day, 6–10 s night (hard cut at 6).
+  const samples = samplesFor(10, (t) => (t < 2 ? black : t < 6 ? day : night));
+  const cuts = detectSceneCuts(samples);
+  assert.ok(cuts.some((time) => Math.abs(time - 6) < 0.3), `cut near 6 s: ${cuts}`);
+  const profile = profileClip("c1", "clip.mp4", 10, samples);
+  assert.equal(profile.segments.length, 2, JSON.stringify(profile.segments));
+  const [first, second] = profile.segments;
+  assert.ok(first.start >= 1.8 && first.start <= 2.2, `first starts after the black: ${first.start}`);
+  assert.ok(first.end <= 6.0 && first.end >= 5.6);
+  assert.ok(second.start >= 5.8 && second.end <= 10);
+  assert.ok(Math.abs(profile.usable - 8) < 0.6, `usable ${profile.usable}`);
+  assert.ok(profile.hero > 0.4);
+});
+
+test("an all-black clip has nothing usable and says so", () => {
+  const profile = profileClip("b", "black.mp4", 5, samplesFor(5, () => black));
+  assert.equal(profile.segments.length, 0);
+  assert.ok(profile.notes.includes("mostly black"));
+  assert.ok(profile.notes.some((note) => note.includes("skipped")));
+});
+
+test("a focus miss inside an otherwise sharp clip is cut out; static clips are flagged and rank lower", () => {
+  const soft = { id: "day", brightness: 0.5, sharpness: 0.05 };
+  const samples = samplesFor(8, (t) => (t >= 3 && t < 5 ? soft : day));
+  const profile = profileClip("f", "focus.mp4", 8, samples);
+  assert.ok(profile.segments.every((segment) => segment.end <= 3.2 || segment.start >= 4.8), JSON.stringify(profile.segments));
+  const still = profileClip("s", "still.mp4", 8, samplesFor(8, () => day, { motion: 0 }));
+  const moving = profileClip("m", "moving.mp4", 8, samplesFor(8, () => day, { motion: 0.05 }));
+  assert.ok(still.notes.includes("static"));
+  assert.ok(still.segments[0].quality < moving.segments[0].quality);
+  assert.ok(moving.energy > still.energy);
+});
+
+test("faces raise hero score and steer the crop focus", () => {
+  const face = { ...day, faces: 1, faceX: 0.7 };
+  const withFace = profileClip("w", "face.mp4", 6, samplesFor(6, () => face));
+  const without = profileClip("n", "noface.mp4", 6, samplesFor(6, () => day));
+  assert.ok(withFace.hero > without.hero);
+  assert.ok(Math.abs(withFace.focusX - 0.7) < 1e-6);
+  assert.equal(without.focusX, 0.5);
+});
+
+test("window coverage and quality", () => {
+  const segments = [{ start: 0, end: 4, quality: 1 }, { start: 6, end: 10, quality: 0.5 }];
+  assert.equal(usableCoverage(segments, 2, 8), 4 / 6);
+  assert.ok(Math.abs(windowQuality(segments, 2, 8) - (2 * 1 + 2 * 0.5) / 6) < 1e-9);
+});
+
+// ---- Performance alignment -------------------------------------------------
+
+test("FFT and cross-correlation match brute force", () => {
+  const re = Float64Array.from([1, 2, 3, 4, 0, -1, 0.5, 2]);
+  const im = new Float64Array(8);
+  const copy = Float64Array.from(re);
+  fft(re, im);
+  fft(re, im, true);
+  for (let i = 0; i < 8; i++) assert.ok(Math.abs(re[i] - copy[i]) < 1e-9);
+  const a = [0, 1, 0, 0, 2, 0, 0, 1, 0];
+  const b = [1, 0, 0, 2];
+  const { values, minLag } = crossCorrelate(a, b);
+  for (let lag = -(b.length - 1); lag < a.length; lag++) {
+    let sum = 0;
+    for (let n = 0; n < b.length; n++) if (n + lag >= 0 && n + lag < a.length) sum += a[n + lag] * b[n];
+    assert.ok(Math.abs(values[lag - minLag] - sum) < 1e-9, `lag ${lag}`);
+  }
+  assert.ok(Math.abs(overlapCorrelation([1, 2, 3, 4], [2, 4, 6], 1).r - 1) < 1e-9);
+});
+
+const master = synthSong({
+  bpm: 112,
+  sampleRate: 16000,
+  seed: 3,
+  melody: true,
+  sections: [{ bars: 4, level: 0.4, busy: false }, { bars: 6, level: 0.8, busy: true }, { bars: 4, level: 0.5, busy: true }, { bars: 4, level: 1, busy: true }],
+});
+
+/** A phone-mic "take": a slice of the master, quieter, with room echo, hiss and a different start. */
+function recordTake(start, length, { lead = 0, seed = 11 } = {}) {
+  const rate = master.sampleRate;
+  const noise = noiseSource(seed);
+  const total = Math.round((length + lead) * rate);
+  const out = new Float32Array(total);
+  const delay = Math.round(0.031 * rate);
+  for (let i = 0; i < total; i++) {
+    const songIndex = Math.round((start - lead) * rate) + i;
+    const dry = songIndex >= 0 && songIndex < master.samples.length ? master.samples[songIndex] : 0;
+    const wet = songIndex - delay >= 0 && songIndex - delay < master.samples.length ? master.samples[songIndex - delay] : 0;
+    out[i] = 0.45 * dry + 0.2 * wet + 0.05 * noise();
+  }
+  return out;
+}
+
+test("aligns a noisy, echoey take to the master within 10 ms", () => {
+  const take = recordTake(12.34, 14);
+  const alignment = alignTake(master.samples, master.sampleRate, take, master.sampleRate);
+  assert.ok(Math.abs(alignment.offset - 12.34) < 0.01, `offset ${alignment.offset}`);
+  assert.ok(isSynced(alignment), JSON.stringify(alignment));
+  assert.ok(alignment.overlap > 13);
+});
+
+test("a take that starts before the song gets a negative offset", () => {
+  // Phone started recording 2.5 s before the song began (silence + hiss first).
+  const take = recordTake(0, 12, { lead: 2.5, seed: 5 });
+  const alignment = alignTake(master.samples, master.sampleRate, take, master.sampleRate);
+  assert.ok(Math.abs(alignment.offset + 2.5) < 0.01, `offset ${alignment.offset}`);
+  assert.ok(isSynced(alignment));
+});
+
+test("unrelated audio is not reported as synced", () => {
+  const other = synthSong({ bpm: 87, sampleRate: 16000, seed: 99, sections: [{ bars: 6, level: 0.7, busy: true }] });
+  const alignment = alignTake(master.samples, master.sampleRate, other.samples, other.sampleRate);
+  assert.ok(!isSynced(alignment), JSON.stringify(alignment));
+  const noise = noiseSource(4);
+  const hiss = new Float32Array(16000 * 8).map(() => 0.1 * noise());
+  assert.ok(!isSynced(alignTake(master.samples, master.sampleRate, hiss, 16000)));
+});
+
+test("envelope alignment ignores gain", () => {
+  const env = onsetEnvelope(master.samples, master.sampleRate);
+  const slice = env.slice(800, 1800).map((value) => value * 0.1);
+  const alignment = alignEnvelopes(env, slice);
+  assert.ok(Math.abs(alignment.offset - 8) < 0.011, `offset ${alignment.offset}`);
+});
+
+test("resampling keeps alignment: a 48 kHz take aligns to a 16 kHz master", async () => {
+  const { resampleMono } = await import("../lib/autocut-align.ts");
+  const take16 = recordTake(20.5, 10, { seed: 21 });
+  // Upsample the take to 48 kHz (as a camera would record), then bring it back down.
+  const take48 = resampleMono(take16, 16000, 48000);
+  assert.equal(take48.length, take16.length * 3);
+  const back = resampleMono(take48, 48000, 16000);
+  const alignment = alignTake(master.samples, 16000, back, 16000);
+  assert.ok(Math.abs(alignment.offset - 20.5) < 0.012, `offset ${alignment.offset}`);
+});
+
+test("a cut from a detailed scene to a plain one is not called out of focus", () => {
+  const plain = { id: "plain", brightness: 0.4, sharpness: 0.08 };
+  const profile = profileClip("p", "cut.mp4", 10, samplesFor(10, (t) => (t < 5 ? day : plain)));
+  assert.ok(!profile.notes.includes("often out of focus"), profile.notes.join());
+  assert.ok(profile.usable > 9, `usable ${profile.usable}`);
+});
+
+test("continuous change (a pan or colour sweep) is not a scene cut", () => {
+  const samples = [];
+  for (let t = 0; t < 8; t += 0.25) samples.push({ time: t, brightness: 0.5, sharpness: 0.3, contrast: 0.3, motion: t ? 0.2 + 0.05 * Math.sin(t * 3) : 0, histogramDistance: t ? 0.3 + 0.1 * Math.cos(t * 2) : 0 });
+  assert.deepEqual(detectSceneCuts(samples), []);
+});
diff --git a/tests/autocut-cut.test.mjs b/tests/autocut-cut.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b544050852ace609258950c49d05343e2d111406
--- /dev/null
+++ b/tests/autocut-cut.test.mjs
@@ -0,0 +1,224 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { assignClip, cutEnergy, generateCut, holdBeats, PRESETS, shotAt, slipShot, summarizeCut, swapShot } from "../lib/autocut-cut.ts";
+import { fakeClip, fakeMusic } from "./helpers/autocut-synth.mjs";
+
+const music = fakeMusic();
+const pool = [
+  fakeClip("calm-a", { energy: 0.1, hero: 0.3 }),
+  fakeClip("calm-b", { energy: 0.2, hero: 0.4 }),
+  fakeClip("mid-a", { energy: 0.5, hero: 0.5 }),
+  fakeClip("mid-b", { energy: 0.55, hero: 0.5 }),
+  fakeClip("hot-a", { energy: 0.9, hero: 0.6 }),
+  fakeClip("hot-b", { energy: 0.95, hero: 0.95 }),
+  fakeClip("dead", { energy: 0.5, segments: [] }), // nothing usable
+];
+const request = (overrides = {}) => ({ music, clips: pool, preset: "music-video", density: 0.5, seed: 1, ...overrides });
+const onGrid = (time, range = [0, music.duration]) => music.beats.some((beat) => Math.abs(beat - time) < 1e-6) || range.some((edge) => Math.abs(edge - time) < 1e-6);
+const meanLength = (shots, from, to) => {
+  const inside = shots.filter((shot) => shot.start >= from && shot.start < to);
+  return inside.reduce((sum, shot) => sum + shot.duration, 0) / inside.length;
+};
+
+function assertContiguous(shots, start, end) {
+  assert.ok(Math.abs(shots[0].start - start) < 1e-6, `starts at ${shots[0].start}`);
+  for (let index = 1; index < shots.length; index++) {
+    const previousEnd = shots[index - 1].start + shots[index - 1].duration;
+    assert.ok(Math.abs(previousEnd - shots[index].start) < 1e-6, `gap/overlap before shot ${index}: ${previousEnd} vs ${shots[index].start}`);
+  }
+  const last = shots.at(-1);
+  assert.ok(Math.abs(last.start + last.duration - end) < 1e-6, `ends at ${last.start + last.duration}`);
+}
+
+test("covers the song with contiguous shots that cut on beats", () => {
+  const shots = generateCut(request());
+  assertContiguous(shots, 0, music.duration);
+  for (const shot of shots) assert.ok(onGrid(shot.start), `cut at ${shot.start} is on a beat`);
+  assert.ok(shots.length > 15);
+});
+
+test("cut density follows energy: long shots in the intro, fast on the chorus", () => {
+  const shots = generateCut(request());
+  const intro = meanLength(shots, 0, 16);
+  const chorus = meanLength(shots, 32, 48);
+  assert.ok(intro >= 2.5 * chorus, `intro ${intro.toFixed(2)} s vs chorus ${chorus.toFixed(2)} s`);
+  assert.ok(chorus <= 1.25, `chorus shots ${chorus}`);
+});
+
+test("section starts and the drop get a fresh, hero-flagged cut", () => {
+  const shots = generateCut(request());
+  for (const time of [16, 32, 48]) {
+    const shot = shots.find((item) => Math.abs(item.start - time) < 1e-6);
+    assert.ok(shot, `cut at section start ${time}`);
+    assert.ok(shot.hero, `hero at ${time}`);
+  }
+  // The best hero clip opens the chorus most of the time across seeds.
+  let hotOpeners = 0;
+  for (let seed = 1; seed <= 12; seed++) {
+    const opener = generateCut(request({ seed })).find((shot) => Math.abs(shot.start - 32) < 1e-6);
+    if (opener.clipId === "hot-b" || opener.clipId === "hot-a") hotOpeners++;
+  }
+  assert.ok(hotOpeners >= 8, `${hotOpeners}/12 chorus openers are the high-energy hero clips`);
+});
+
+test("never the same clip back-to-back, never unusable footage, sources stay inside usable segments", () => {
+  for (let seed = 1; seed <= 20; seed++) {
+    const shots = generateCut(request({ seed, preset: "hype", density: 0.9 }));
+    assert.equal(summarizeCut(shots).backToBack, 0, `seed ${seed}`);
+    for (const shot of shots) {
+      assert.notEqual(shot.clipId, "dead");
+      const clip = pool.find((item) => item.id === shot.clipId);
+      assert.ok(clip.segments.some((segment) => shot.sourceStart >= segment.start - 1e-6 && shot.sourceStart + shot.duration <= segment.end + 1e-6), `shot ${shot.id} inside a segment`);
+    }
+  }
+});
+
+test("energy matching: calm clips in the intro, hot clips in the chorus", () => {
+  let calmIntro = 0, hotChorus = 0, introCount = 0, chorusCount = 0;
+  for (let seed = 1; seed <= 10; seed++) {
+    for (const shot of generateCut(request({ seed }))) {
+      if (shot.start < 16) { introCount++; if (shot.clipId.startsWith("calm")) calmIntro++; }
+      if (shot.start >= 32 && shot.start < 48) { chorusCount++; if (shot.clipId.startsWith("hot") || shot.clipId.startsWith("mid")) hotChorus++; }
+    }
+  }
+  assert.ok(calmIntro / introCount > 0.5, `calm in intro ${calmIntro}/${introCount}`);
+  assert.ok(hotChorus / chorusCount > 0.6, `hot/mid in chorus ${hotChorus}/${chorusCount}`);
+});
+
+test("deterministic per seed; re-roll gives a different variation", () => {
+  assert.deepEqual(generateCut(request({ seed: 42 })), generateCut(request({ seed: 42 })));
+  const a = generateCut(request({ seed: 1 })).map((shot) => `${shot.clipId}@${shot.start}`).join();
+  const b = generateCut(request({ seed: 2 })).map((shot) => `${shot.clipId}@${shot.start}`).join();
+  assert.notEqual(a, b);
+});
+
+test("density slider and presets change the pace in the right order", () => {
+  const count = (overrides) => generateCut(request(overrides)).length;
+  assert.ok(count({ density: 1 }) > count({ density: 0.5 }) * 1.4);
+  assert.ok(count({ density: 0 }) < count({ density: 0.5 }) * 0.75);
+  const chill = count({ preset: "chill" });
+  const video = count({ preset: "music-video" });
+  const hype = count({ preset: "hype" });
+  assert.ok(chill < video && video < hype, `chill ${chill} < music video ${video} < hype ${hype}`);
+});
+
+test("hype stutters on the chorus at high density with half-beat cuts", () => {
+  const shots = generateCut(request({ preset: "hype", density: 1 }));
+  const halves = shots.filter((shot) => Math.abs(shot.duration - 0.25) < 1e-6);
+  assert.ok(halves.length > 4, `${halves.length} half-beat shots`);
+  assert.ok(halves.every((shot) => shot.label === "chorus" || shot.label === "verse"));
+});
+
+test("trailer accelerates toward the end", () => {
+  const flat = fakeMusic({ sections: [{ start: 0, end: 64, energy: 0.5, label: "verse" }] });
+  const shots = generateCut({ music: { ...flat, dropStrength: 0 }, clips: pool, preset: "trailer", density: 0.5, seed: 3 });
+  assert.ok(meanLength(shots, 0, 20) > 2.5 * meanLength(shots, 44, 64), "first third much slower than the last");
+});
+
+test("holds of a bar or more end on downbeats", () => {
+  const shots = generateCut(request({ preset: "chill" }));
+  const long = shots.filter((shot) => shot.duration >= 2 - 1e-6);
+  const onOne = long.filter((shot) => music.downbeats.some((time) => Math.abs(time - (shot.start + shot.duration)) < 1e-6) || Math.abs(shot.start + shot.duration - music.duration) < 1e-6);
+  assert.ok(onOne.length / long.length > 0.9, `${onOne.length}/${long.length}`);
+});
+
+test("locked shots survive a re-roll exactly", () => {
+  const first = generateCut(request({ seed: 5 }));
+  const keep = [first[3], first[10]].map((shot) => ({ ...shot, locked: true }));
+  const reroll = generateCut(request({ seed: 6, locked: keep }));
+  for (const shot of keep) {
+    const found = reroll.find((item) => Math.abs(item.start - shot.start) < 1e-6);
+    assert.ok(found, "locked shot present");
+    assert.equal(found.clipId, shot.clipId);
+    assert.equal(found.duration, shot.duration);
+    assert.equal(found.sourceStart, shot.sourceStart);
+    assert.ok(found.locked);
+  }
+  assertContiguous(reroll, 0, music.duration);
+});
+
+test("a range (best 30 s) cuts only inside it", () => {
+  const shots = generateCut(request({ range: { start: 16, end: 46 } }));
+  assertContiguous(shots, 16, 46);
+  for (const shot of shots) assert.ok(onGrid(shot.start, [16, 46]));
+});
+
+test("clips too short for the slot end the shot early instead of freezing", () => {
+  const shorts = ["s1", "s2", "s3"].map((id) => fakeClip(id, { duration: 0.8, energy: 0.2 }));
+  const shots = generateCut({ music, clips: shorts, preset: "chill", density: 0, seed: 1 });
+  assertContiguous(shots, 0, music.duration);
+  for (const shot of shots) assert.ok(shot.duration <= 0.8 + 1e-6, `shot ${shot.duration}`);
+});
+
+// ---- Performance mode ---------------------------------------------------------
+
+const takes = [
+  fakeClip("take-1", { duration: 64, offset: 0, energy: 0.6, hero: 0.8 }),
+  fakeClip("take-2", { duration: 58, offset: 4, energy: 0.6, hero: 0.7 }),
+  fakeClip("take-3", { duration: 70, offset: -3, energy: 0.6, hero: 0.75 }),
+];
+const broll = [fakeClip("broll-1", { energy: 0.3 }), fakeClip("broll-2", { energy: 0.8 })];
+
+test("performance: synced takes keep the song's time so lip sync holds", () => {
+  const shots = generateCut({ music, clips: [...takes, ...broll], preset: "music-video", density: 0.5, seed: 9, performance: true, brollMix: 0 });
+  assertContiguous(shots, 0, music.duration);
+  const synced = shots.filter((shot) => shot.synced);
+  assert.ok(synced.length / shots.length > 0.9, `${synced.length}/${shots.length} synced`);
+  for (const shot of synced) {
+    const take = takes.find((item) => item.id === shot.clipId);
+    assert.ok(Math.abs(shot.sourceStart - (shot.start - take.offset)) < 1e-6, `${shot.id} in sync`);
+  }
+  assert.equal(summarizeCut(shots).backToBack, 0);
+  // take-2 only starts at 4 s on the song: it never appears before that.
+  assert.ok(shots.filter((shot) => shot.clipId === "take-2").every((shot) => shot.start >= 4));
+  assert.ok(new Set(synced.map((shot) => shot.clipId)).size === 3, "cuts between all takes");
+});
+
+test("performance: B-roll mix brings in cutaways, more of them in quiet sections", () => {
+  const shots = generateCut({ music, clips: [...takes, ...broll], preset: "music-video", density: 0.5, seed: 4, performance: true, brollMix: 0.5 });
+  const brollShots = shots.filter((shot) => !shot.synced);
+  assert.ok(brollShots.length > 2);
+  assert.ok(brollShots.every((shot) => shot.clipId.startsWith("broll")));
+  const all = generateCut({ music, clips: [...takes, ...broll], preset: "music-video", density: 0.5, seed: 4, performance: true, brollMix: 1 });
+  assert.ok(all.filter((shot) => !shot.synced).length > brollShots.length);
+});
+
+// ---- Editing ------------------------------------------------------------------
+
+test("swap replaces a shot with a different clip, same timing", () => {
+  const shots = generateCut(request({ seed: 7 }));
+  const index = 5;
+  const swapped = swapShot(request({ seed: 7 }), shots, index, 99);
+  assert.ok(swapped);
+  assert.notEqual(swapped[index].clipId, shots[index].clipId);
+  assert.notEqual(swapped[index].clipId, shots[index - 1].clipId);
+  assert.notEqual(swapped[index].clipId, shots[index + 1].clipId);
+  assert.equal(swapped[index].start, shots[index].start);
+  assert.equal(swapped[index].duration, shots[index].duration);
+  assert.deepEqual(swapped.filter((_, i) => i !== index), shots.filter((_, i) => i !== index));
+});
+
+test("assign a specific clip, slip a shot, find the shot at a time", () => {
+  const shots = generateCut(request({ seed: 7 }));
+  const assigned = assignClip(request(), shots, 2, "hot-b");
+  assert.equal(assigned[2].clipId, "hot-b");
+  assert.equal(assignClip(request(), shots, 2, "dead"), null);
+  const slipped = slipShot(shots, 2, 12, 100);
+  assert.equal(slipped[2].sourceStart, 12 - shots[2].duration);
+  const middle = shots[4].start + shots[4].duration / 2;
+  assert.equal(shotAt(shots, middle).id, shots[4].id);
+  assert.equal(shotAt(shots, 999), undefined);
+});
+
+test("hold and energy helpers", () => {
+  assert.equal(holdBeats(PRESETS["music-video"], 0, 0.5, 4), 8);
+  assert.equal(holdBeats(PRESETS["music-video"], 1, 0.5, 4), 2);
+  assert.equal(holdBeats(PRESETS.hype, 1, 1, 4, 0, 0.5), 0.5);
+  assert.ok(cutEnergy(music, 40, "drop", 0.2) >= 0.9);
+  assert.ok(cutEnergy(music, 40, "intro", 1) <= 0.35);
+});
+
+test("empty inputs give an empty cut", () => {
+  assert.deepEqual(generateCut(request({ clips: [] })), []);
+  assert.deepEqual(generateCut(request({ range: { start: 10, end: 10 } })), []);
+});
diff --git a/tests/autocut-export.test.mjs b/tests/autocut-export.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..66839bd1fa407072e2203c7b827859eef59aa052
--- /dev/null
+++ b/tests/autocut-export.test.mjs
@@ -0,0 +1,73 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { generateCut } from "../lib/autocut-cut.ts";
+import { autocutToCutFile, coverCrop, outputSize, shotsToCsv } from "../lib/autocut-export.ts";
+import { diagnoseCutFile, parseCutFile } from "../lib/project-store.ts";
+import { fakeClip, fakeMusic } from "./helpers/autocut-synth.mjs";
+
+const music = fakeMusic();
+const clips = ["a", "b", "c"].map((id, index) => fakeClip(id, { energy: index / 2 }));
+const shots = generateCut({ music, clips, preset: "music-video", density: 0.5, seed: 3 });
+const refs = clips.map((clip) => ({ id: clip.id, name: `${clip.id}.mp4`, size: 1000 + clip.id.charCodeAt(0), lastModified: 1 }));
+const settings = { preset: "music-video", density: 0.5, seed: 3, performance: false, brollMix: 0.25, aspect: "9:16" };
+
+test("the cut file opens in ScenePilot's importer with every clip linked", () => {
+  const file = autocutToCutFile({ project: "My video", music, shots, song: { name: "song.mp3", kind: "audio", size: 5 }, clips: refs, settings });
+  const parsed = parseCutFile(JSON.stringify(file));
+  assert.equal(parsed.format, "scenepilot-cut");
+  assert.equal(parsed.version, 2);
+  assert.equal(parsed.baseCuts.length, shots.length);
+  assert.equal(parsed.beats.length, music.beats.length);
+  assert.equal(parsed.mainAsset.name, "song.mp3");
+  assert.equal(parsed.mainAsset.kind, "audio");
+  assert.equal(parsed.effects.transitionType, "none");
+  assert.equal(parsed.effects.lookPreset, "none");
+  const errors = diagnoseCutFile(parsed).filter((item) => item.severity === "error");
+  assert.deepEqual(errors, []);
+  const sectionIds = new Set(parsed.sections.map((section) => section.id));
+  for (const cut of parsed.baseCuts) {
+    assert.ok(sectionIds.has(cut.sectionId), `section ${cut.sectionId} exists`);
+    assert.ok(refs.some((ref) => ref.id === cut.assetId));
+  }
+  assert.ok(parsed.proState.markers.length >= music.sections.length);
+  assert.equal(parsed.proState.timelineRange, undefined, "full-song cut has no in/out range");
+  assert.equal(file.autocut.shots.length, shots.length);
+});
+
+test("a partial cut keeps song time and sets the timeline in/out range", () => {
+  const partialShots = generateCut({ music, clips, preset: "hype", density: 0.5, seed: 3, range: { start: 16, end: 46 } });
+  const file = autocutToCutFile({ project: "Teaser", music, shots: partialShots, song: { name: "song.mp3", kind: "audio" }, clips: refs, settings, range: { start: 16, end: 46 } });
+  const parsed = parseCutFile(JSON.stringify(file));
+  assert.deepEqual(parsed.proState.timelineRange, { inPoint: 16, outPoint: 46 });
+  assert.equal(parsed.baseCuts[0].start, 16);
+  assert.match(parsed.storyBrief, /16\.00–46\.00/);
+});
+
+test("only used clips are listed as project media", () => {
+  const onlyA = shots.map((shot) => ({ ...shot, clipId: "a" }));
+  const file = autocutToCutFile({ project: "x", music, shots: onlyA, song: { name: "s.wav", kind: "audio" }, clips: refs, settings });
+  assert.deepEqual(file.assets.map((asset) => asset.id), ["a"]);
+});
+
+test("CSV shot list", () => {
+  const csv = shotsToCsv(shots.slice(0, 3), (id) => `${id}, "quoted".mp4`);
+  const lines = csv.trim().split("\r\n");
+  assert.equal(lines.length, 4);
+  assert.match(lines[0], /^#,Start,End,Length,Section,Clip/);
+  assert.match(lines[1], /"a|b|c, ""quoted""\.mp4"/);
+});
+
+test("output sizes and cover crop", () => {
+  assert.deepEqual(outputSize("9:16"), { width: 1080, height: 1920 });
+  assert.deepEqual(outputSize("16:9", 0.5), { width: 960, height: 540 });
+  const vertical = coverCrop(1920, 1080, 1080, 1920);
+  assert.ok(Math.abs(vertical.width - 607.5) < 1e-9 && vertical.height === 1080);
+  assert.ok(Math.abs(vertical.x - (1920 - 607.5) / 2) < 1e-9);
+  const leftFace = coverCrop(1920, 1080, 1080, 1920, 0.1);
+  assert.equal(leftFace.x, 0);
+  const rightFace = coverCrop(1920, 1080, 1080, 1920, 0.95);
+  assert.ok(Math.abs(rightFace.x + rightFace.width - 1920) < 1e-9);
+  const wide = coverCrop(1080, 1920, 1920, 1080);
+  assert.equal(wide.width, 1080);
+  assert.ok(Math.abs(wide.y - (1920 - 607.5) / 2) < 1e-9);
+});
diff --git a/tests/autocut-music.test.mjs b/tests/autocut-music.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ead726562dee27934f35fec02c76a6f64c2c21fb
--- /dev/null
+++ b/tests/autocut-music.test.mjs
@@ -0,0 +1,112 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { analyzeMusic, bestWindow, energyAt, labelSections, mixToMono, rescaleTempo, sectionAt } from "../lib/autocut-music.ts";
+import { synthSong } from "./helpers/autocut-synth.mjs";
+
+const song = synthSong({
+  bpm: 120,
+  sections: [
+    { bars: 8, level: 0.25, busy: false }, // 0–16 s quiet intro
+    { bars: 8, level: 0.5, busy: true }, // 16–32 verse
+    { bars: 8, level: 1, busy: true }, // 32–48 chorus
+    { bars: 6, level: 0.2, busy: false }, // 48–60 outro
+  ],
+});
+const music = analyzeMusic(song.samples, song.sampleRate);
+
+const nearestDistance = (values, time) => values.reduce((best, value) => Math.min(best, Math.abs(value - time)), Infinity);
+
+test("finds the tempo and a beat grid on the real transients", () => {
+  assert.ok(Math.abs(music.bpm - 120) <= 2, `bpm ${music.bpm}`);
+  assert.ok(music.reliable, "rhythm is reliable");
+  const interior = music.beats.filter((beat) => beat > 1 && beat < 58);
+  const onTarget = interior.filter((beat) => nearestDistance(song.truth.beats, beat) < 0.05).length;
+  assert.ok(onTarget / interior.length > 0.9, `${onTarget}/${interior.length} beats within 50 ms of a drum hit`);
+  const gaps = interior.slice(1).map((beat, index) => beat - interior[index]).sort((a, b) => a - b);
+  assert.ok(Math.abs(gaps[Math.floor(gaps.length / 2)] - 0.5) < 0.03, "median beat gap is 0.5 s");
+});
+
+test("bars: 4/4 with downbeats on the accented 1", () => {
+  assert.equal(music.beatsPerBar, 4);
+  const interior = music.downbeats.filter((time) => time > 1 && time < 58);
+  const onOne = interior.filter((time) => nearestDistance(song.truth.downbeats, time) < 0.06).length;
+  assert.ok(onOne / interior.length >= 0.7, `${onOne}/${interior.length} downbeats on bar starts`);
+});
+
+test("energy curve and sections follow the arrangement", () => {
+  assert.ok(energyAt(music, 40) > energyAt(music, 8) + 0.3, "chorus louder than intro");
+  assert.ok(music.sections.length >= 3, `${music.sections.length} sections`);
+  assert.equal(music.sections[0].start, 0);
+  assert.ok(Math.abs(music.sections.at(-1).end - music.duration) < 1e-6);
+  const loud = sectionAt(music, 40);
+  assert.ok(loud.label === "chorus" || loud.label === "drop", `section at 40 s is ${loud.label}`);
+  assert.equal(sectionAt(music, 2).label, "intro");
+  for (const section of music.sections.slice(1)) {
+    assert.ok(nearestDistance(music.downbeats, section.start) < 0.01, `section at ${section.start} starts on a downbeat`);
+  }
+  assert.ok(music.dropTime > 26 && music.dropTime < 44, `drop at ${music.dropTime}`);
+});
+
+test("best window lands on the loud part and starts on a downbeat", () => {
+  const window = bestWindow(music, 15);
+  assert.ok(window.end - window.start > 12 && window.end - window.start < 18, `length ${window.end - window.start}`);
+  assert.ok(window.start >= 20 && window.start <= 40, `starts at ${window.start}`);
+  assert.ok(music.downbeats.some((time) => Math.abs(time - window.start) < 1e-6));
+  assert.deepEqual(bestWindow(music, 999), { start: 0, end: music.duration });
+});
+
+test("half/double tempo fix", () => {
+  const doubled = rescaleTempo(music, 2);
+  assert.equal(doubled.bpm, music.bpm * 2);
+  assert.ok(Math.abs(doubled.beats.length - music.beats.length * 2) <= 2);
+  const halved = rescaleTempo(music, 0.5);
+  assert.equal(halved.bpm, Math.round(music.bpm / 2));
+  assert.ok(Math.abs(halved.beats.length - music.beats.length / 2) <= 1);
+  assert.ok(halved.downbeats.every((time) => halved.beats.some((beat) => Math.abs(beat - time) < 1e-6)), "downbeats stay on the halved grid");
+});
+
+test("audio with no rhythm falls back to an honest, unreliable 120 BPM grid", () => {
+  const sampleRate = 22050;
+  const tone = new Float32Array(sampleRate * 12).map((_, i) => 0.3 * Math.sin((2 * Math.PI * 220 * i) / sampleRate));
+  const flat = analyzeMusic(tone, sampleRate);
+  assert.equal(flat.reliable, false);
+  assert.equal(flat.bpm, 120);
+  assert.ok(flat.beats.length >= 20);
+  const silent = analyzeMusic(new Float32Array(sampleRate * 4), sampleRate);
+  assert.equal(silent.reliable, false);
+});
+
+test("section labelling rules", () => {
+  const spans = [
+    { start: 0, end: 10, energy: 0.1 },
+    { start: 10, end: 20, energy: 0.4 },
+    { start: 20, end: 30, energy: 0.5 },
+    { start: 30, end: 40, energy: 0.95 },
+    { start: 40, end: 50, energy: 0.2 },
+    { start: 50, end: 60, energy: 0.8 },
+    { start: 60, end: 70, energy: 0.15 },
+  ];
+  const labels = labelSections(spans, { time: 31, strength: 0.6 }).map((section) => section.label);
+  assert.equal(labels[0], "intro");
+  assert.equal(labels[3], "drop");
+  assert.equal(labels[2], "build");
+  assert.equal(labels[4], "break");
+  assert.equal(labels[5], "chorus");
+  assert.equal(labels[6], "outro");
+  // A flat track doesn't invent choruses.
+  const flat = labelSections(spans.map((span) => ({ ...span, energy: 0.5 })), { time: 31, strength: 0.6 }).map((section) => section.label);
+  assert.ok(!flat.includes("chorus") && !flat.includes("drop"));
+});
+
+test("mixToMono averages channels", () => {
+  const mono = mixToMono([new Float32Array([1, 0, 0.5]), new Float32Array([0, 1, 0.5])]);
+  assert.deepEqual([...mono], [0.5, 0.5, 0.5]);
+});
+
+test("other tempos: 95 and 140 BPM", () => {
+  for (const bpm of [95, 140]) {
+    const other = synthSong({ bpm, sampleRate: 22050, melody: true, sections: [{ bars: 6, level: 0.5, busy: true }, { bars: 6, level: 1, busy: true }] });
+    const result = analyzeMusic(other.samples, other.sampleRate);
+    assert.ok(Math.abs(result.bpm - bpm) <= 3, `${bpm} BPM read as ${result.bpm}`);
+  }
+});
