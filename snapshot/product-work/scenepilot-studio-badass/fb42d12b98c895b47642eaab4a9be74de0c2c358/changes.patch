+        alert.accessoryView = IsolationReviewImage(rendered)
+        alert.addButton(withTitle:"Continue Tracking"); alert.addButton(withTitle:"Cancel and Reselect")
+        return alert.runModal() == .alertFirstButtonReturn
+    }
+}
