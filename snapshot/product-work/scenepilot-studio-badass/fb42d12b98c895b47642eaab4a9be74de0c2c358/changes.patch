--- /dev/null
+++ b/app/mobile-timeline-ruler.tsx
@@ -0,0 +1,24 @@
+import { useTimelineScrub } from "./use-timeline-scrub";
+import { formatTime } from "../lib/format";
+
+type Props = { duration: number; time: number; disabled: boolean; onSeek(time: number): void; onPause(): void };
+
+/** Uses the same captured-pointer/frame-coalesced scrubbing as the desktop ruler. */
+export function MobileTimelineRuler({ duration, time, disabled, onSeek, onPause }: Props) {
+  const scrub = useTimelineScrub({ duration, frameRate: 30,
+    bounds: target => disabled ? undefined : target.getBoundingClientRect(), onSeek, onStart: onPause });
+  return <div className="ms-ruler" role="slider" aria-label="Timeline position" aria-disabled={disabled}
+    aria-valuemin={0} aria-valuemax={duration} aria-valuenow={time} aria-valuetext={formatTime(time)}
+    tabIndex={disabled ? -1 : 0} {...scrub} onKeyDown={event => {
+      if (disabled) return;
+      const offset = event.shiftKey ? 1 : 1 / 30;
+      const next = event.key === "Home" ? 0 : event.key === "End" ? duration
+        : event.key === "ArrowRight" || event.key === "ArrowUp" ? time + offset
+        : event.key === "ArrowLeft" || event.key === "ArrowDown" ? time - offset : null;
+      if (next === null) return;
+      event.preventDefault(); event.stopPropagation(); onPause(); onSeek(Math.max(0, Math.min(duration, next)));
+    }}>
+    {[0, .25, .5, .75, 1].map(fraction => <span key={fraction}>{formatTime(duration * fraction)}</span>)}
+    <i aria-hidden="true" style={{ left: `${Math.max(0, Math.min(100, time / Math.max(.01, duration) * 100))}%` }} />
+  </div>;
+}
diff --git a/app/native-audio-preparation.ts b/app/native-audio-preparation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..580c9c4c07bbf866ce23b04ce885e71ea3efc104
--- /dev/null
+++ b/app/native-audio-preparation.ts
@@ -0,0 +1,38 @@
+import type { ScenePilotDesktopBridge } from "./desktop-media";
+import type { RenderAudioClip } from "../lib/render-engine";
+import type { StreamTargetChunk } from "mediabunny";
+import { renderAudioInWorker } from "./render-client";
+
+/** Transferable backpressured output: the UI never stores the full PCM master. */
+export async function prepareNativeAudio(bridge: ScenePilotDesktopBridge, clips: RenderAudioClip[], duration: number, signal: AbortSignal, onProgress: (value: number, message: string) => void) {
+  signal.throwIfAborted();
+  if (!Number.isFinite(duration) || duration <= 0 || Math.ceil(duration * 48000) * 6 + 65536 > 4_000_000_000) throw new Error("Native PCM staging supports masters up to approximately 3 hours 51 minutes. Split this delivery range into shorter masters.");
+  const { token } = await bridge.beginPcmMix();
+  let handle: ReturnType<typeof renderAudioInWorker> | undefined;
+  const abort = () => handle?.cancel();
+  signal.addEventListener("abort", abort, { once: true });
+  try {
+    signal.throwIfAborted();
+    const output = new WritableStream<StreamTargetChunk>({
+      async write(chunk) {
+        signal.throwIfAborted();
+        if (chunk.type !== "write") throw new Error("Unsupported PCM stream operation.");
+        for (let offset = 0; offset < chunk.data.byteLength; offset += 1024 * 1024) {
+          signal.throwIfAborted();
+          await bridge.writePcmMix({ token, position: chunk.position + offset, data: chunk.data.slice(offset, offset + 1024 * 1024) });
+        }
+      },
+    }, { highWaterMark: 1 });
+    handle = renderAudioInWorker({ clips, duration }, onProgress, output);
+    if (signal.aborted) handle.cancel();
+    await handle.result;
+    signal.throwIfAborted();
+    await bridge.finishPcmMix(token);
+    signal.throwIfAborted();
+    return token;
+  } catch (error) {
+    handle?.cancel();
+    await bridge.releasePcmMix(token).catch(() => undefined);
+    throw error;
+  } finally { signal.removeEventListener("abort", abort); }
+}
