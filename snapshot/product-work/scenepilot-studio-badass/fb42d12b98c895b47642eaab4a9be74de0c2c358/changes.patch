+/// One native pixel implementation is used by AVPlayer and AVAssetExportSession.
+/// Core Image renders on Metal when available. No browser, canvas, or JS fallback.
+public final class NativeCompositor: NSObject, AVVideoCompositing {
+    public var sourcePixelBufferAttributes: [String: any Sendable]? { [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA] }
+    public var requiredPixelBufferAttributesForRenderContext: [String: any Sendable] { [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA, kCVPixelBufferMetalCompatibilityKey as String: true] }
+    private let queue = DispatchQueue(label: "studio.scenepilot.native.compositor")
+    /// The working color space is where every blend and filter happens. Linear light
+    /// is the native default; the gamma context blends encoded sRGB like a canvas.
+    private let contexts: [BlendSpace: CIContext]
+    private let maskCache = NativeMaskCache()
+    private let cancellationLock = NSLock()
+    private var generation = 0
+    private func currentGeneration() -> Int { cancellationLock.lock(); defer { cancellationLock.unlock() }; return generation }
+    public override init() {
+        let device = MTLCreateSystemDefaultDevice()
+        func make(_ space: CFString) -> CIContext {
+            let options: [CIContextOption: Any] = [.workingColorSpace: CGColorSpace(name: space)!, .cacheIntermediates: false]
+            return device.map { CIContext(mtlDevice: $0, options: options) } ?? CIContext(options: options)
+        }
+        contexts = [.linear: make(CGColorSpace.linearSRGB), .gamma: make(CGColorSpace.sRGB)]
+        super.init()
+    }
+    public func renderContextChanged(_ newRenderContext: AVVideoCompositionRenderContext) {}
+    public func startRequest(_ request: AVAsynchronousVideoCompositionRequest) {
+        let requestedGeneration = currentGeneration()
+        queue.async { [self] in
+            autoreleasepool {
+                guard requestedGeneration == currentGeneration() else { request.finishCancelledRequest(); return }
+                guard let instruction = request.videoCompositionInstruction as? NativeInstruction,
+                      let output = request.renderContext.newPixelBuffer() else {
+                    request.finish(with: NSError(domain: "ScenePilotNative", code: 1, userInfo: [NSLocalizedDescriptionKey: "Native compositor could not allocate an output frame."])); return
+                }
+                let size = request.renderContext.size
+                let bounds = CGRect(origin: .zero, size: size)
+                do {
+                    var frame = try NativeSceneRenderer.render(instruction.nodes, time: request.compositionTime, bounds: bounds, maskSource: { try self.maskCache.image($0,bounds:$1) }) { id in
+                        guard let buffer = request.sourceFrame(byTrackID: id) else {
+                            throw ProjectError.invalid("A required source frame is unavailable at \(request.compositionTime.seconds)s. Export stopped rather than substituting black.")
+                        }
+                        return CIImage(cvPixelBuffer: buffer)
+                    }.composited(over: CIImage(color: .black).cropped(to: bounds))
+                    if let look = instruction.look {
+                        frame = NativeLookRenderer.apply(frame, look: look, time: request.compositionTime.seconds, bounds: bounds, encoded: instruction.blendSpace == .gamma)
+                    }
+                    contexts[instruction.blendSpace]!.render(frame, to: output, bounds: bounds, colorSpace: CGColorSpace(name: CGColorSpace.sRGB))
+                } catch { request.finish(with: error); return }
+                guard requestedGeneration == currentGeneration() else { request.finishCancelledRequest(); return }
+                request.finish(withComposedVideoFrame: output)
+            }
+        }
+    }
+    public func cancelAllPendingVideoCompositionRequests() {
+        cancellationLock.lock(); generation &+= 1; cancellationLock.unlock()
+        queue.sync {} // Drain old requests; each completes or acknowledges cancellation.
+    }
+}
diff --git a/native-macos/Sources/ScenePilotMedia/NativeLookRenderer.swift b/native-macos/Sources/ScenePilotMedia/NativeLookRenderer.swift
new file mode 100644
index 0000000000000000000000000000000000000000..efe36bfcc0cb37b8353764054b0738ef8c7cdace
--- /dev/null
+++ b/native-macos/Sources/ScenePilotMedia/NativeLookRenderer.swift
@@ -0,0 +1,88 @@
+import CoreImage
+import ScenePilotCore
+
+/// The sequence look, ported line for line from Pro's grade fragment shader
+/// (GRADE_FRAGMENT_SHADER in lib/grade.ts): mirror fold, chromatic aberration,
+/// anamorphic streak, bloom, exposure with beat kick, contrast, temperature, tint,
+/// saturation, vignette and film grain, in that order, on display-encoded values.
+/// Coordinates are Pro's texture space (origin top-left, 0...1).
+enum NativeLookRenderer {
+    private static let source = """
+    vec2 px(vec2 p, vec2 size) { return vec2(p.x * size.x, (1.0 - p.y) * size.y); }
+    float grainHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+    kernel vec4 scenepilotLook(sampler scene, vec2 size, vec4 tone, vec4 texture, vec4 clock, vec4 fold) {
+        vec2 dc = destCoord();
+        vec2 uv = vec2(dc.x / size.x, 1.0 - dc.y / size.y);
+        vec2 suv = uv;
+        if (fold.x > 0.5) {
+            if (fold.x < 1.5 || fold.x > 2.5) suv.x = 0.5 - abs(suv.x - 0.5);
+            if (fold.x > 1.5) suv.y = 0.5 - abs(suv.y - 0.5);
+        }
+        float beat = clock.y;
+        float aberration = texture.z * (1.0 + beat * 2.0);
+        vec2 dir = suv - 0.5;
+        vec3 color = vec3(sample(scene, samplerTransform(scene, px(suv - dir * aberration, size))).r,
+                          sample(scene, samplerTransform(scene, px(suv, size))).g,
+                          sample(scene, samplerTransform(scene, px(suv + dir * aberration, size))).b);
+        if (fold.y > 0.0) {
+            vec3 streak = vec3(0.0);
+            float texel = 1.0 / size.x;
+            for (int i = 1; i <= 8; i++) {
+                float off = float(i) * texel * 9.0;
+                streak += max(sample(scene, samplerTransform(scene, px(suv + vec2(off, 0.0), size))).rgb - 0.62, 0.0);
+                streak += max(sample(scene, samplerTransform(scene, px(suv - vec2(off, 0.0), size))).rgb - 0.62, 0.0);
+            }
+            color += streak / 16.0 * fold.y * 2.4;
+        }
+        if (texture.y > 0.0) {
+            vec3 bloom = vec3(0.0);
+            float texel = 1.5 / size.y;
+            for (int i = -2; i <= 2; i++) {
+                for (int j = -2; j <= 2; j++) {
+                    vec3 s = sample(scene, samplerTransform(scene, px(suv + vec2(float(i), float(j)) * texel * 2.0, size))).rgb;
+                    bloom += max(s - 0.6, 0.0);
+                }
+            }
+            color += bloom / 25.0 * texture.y * (1.0 + beat);
+        }
+        color *= tone.x * (1.0 + beat * 0.25);
+        color = (color - 0.5) * tone.y + 0.5;
+        color.r += tone.w * 0.08;
+        color.b -= tone.w * 0.08;
+        color.r += texture.x * 0.04;
+        color.g -= texture.x * 0.08;
+        color.b += texture.x * 0.04;
+        float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
+        color = mix(vec3(luma), color, tone.z);
+        vec2 d = uv - 0.5;
+        float edge = clamp((dot(d, d) * 2.2 - 0.8) / (0.2 - 0.8), 0.0, 1.0);
+        color *= mix(1.0, edge * edge * (3.0 - 2.0 * edge), texture.w);
+        if (clock.x > 0.0) {
+            color += (grainHash(uv * size + clock.z) - 0.5) * clock.x;
+        }
+        return vec4(clamp(color, 0.0, 1.0), 1.0);
+    }
+    """
+    // Core Image kernel language is deprecated in favour of precompiled Metal kernels,
+    // which SwiftPM cannot build; this source compiles to Metal at runtime.
+    private static let kernel: CIKernel = {
+        guard let kernel = CIKernel(source: source) else { fatalError("Sequence look kernel failed to compile.") }
+        return kernel
+    }()
+
+    /// `encoded` is true when the working space already holds sRGB-encoded values.
+    static func apply(_ image: CIImage, look: NativeLook, time: Double, bounds: CGRect, encoded: Bool) -> CIImage {
+        var l = look.look
+        if let energy = look.rhythm?.energy(at: time) { l = l.at(energy: energy) }
+        let beat = l.pulse.map { look.rhythm?.envelope(at: time, $0) ?? 0 } ?? 0
+        let input = (encoded ? image : image.applyingFilter("CILinearToSRGBToneCurve")).clampedToExtent()
+        let arguments: [Any] = [input, CIVector(x: bounds.width, y: bounds.height),
+                                CIVector(x: l.exposure, y: l.contrast, z: l.saturation, w: l.temperature),
+                                CIVector(x: l.tint, y: l.bloom, z: l.aberration, w: l.vignette),
+                                CIVector(x: l.grain, y: beat, z: time * 60, w: 0),
+                                CIVector(x: Double(l.mirror), y: l.streak, z: 0, w: 0)]
+        // A mirror fold can read anywhere in the frame; streak and bloom read nearby.
+        guard let graded = kernel.apply(extent: bounds, roiCallback: { _, _ in bounds.insetBy(dx: -96, dy: -96) }, arguments: arguments) else { return image }
+        return encoded ? graded : graded.applyingFilter("CISRGBToneCurveToLinear")
+    }
+}
diff --git a/native-macos/Sources/ScenePilotMedia/NativeMaskPath.swift b/native-macos/Sources/ScenePilotMedia/NativeMaskPath.swift
new file mode 100644
index 0000000000000000000000000000000000000000..96740f975fed4f0e2c8c624ed7ff8ac977bbae88
--- /dev/null
+++ b/native-macos/Sources/ScenePilotMedia/NativeMaskPath.swift
@@ -0,0 +1,55 @@
+import CoreGraphics
+import CoreImage
+import ScenePilotCore
+
+public enum NativeMaskPath {
+    /// Shared cubic geometry for the native path editor and final frame rendering.
+    public static func path(_ mask: ClipMask, size: CGSize) -> CGPath {
+        let path = CGMutablePath()
+        guard let points = mask.points, let first = points.first else { return path }
+        func point(_ p: MaskPoint) -> CGPoint { CGPoint(x: (mask.x + (p.x-0.5)*mask.width)*size.width, y: (1-mask.y-(p.y-0.5)*mask.height)*size.height) }
+        path.move(to: point(first.anchor))
+        for i in points.indices {
+            let a = points[i], b = points[(i+1)%points.count]
+            path.addCurve(to: point(b.anchor), control1: point(a.outgoing), control2: point(b.incoming))
+        }
+        path.closeSubpath(); return path
+    }
+    static func image(_ mask: ClipMask, bounds: CGRect) throws -> CIImage {
+        // Feather padding includes off-canvas path coverage. One-channel raster keeps
+        // allocation bounded even at 8K, and is released with the frame's CI graph.
+        let padding = Int(ceil(mask.feather*4))+2
+        let width = Int(bounds.width)+padding*2, height = Int(bounds.height)+padding*2
+        guard width > 0, height > 0, width*height <= 90_000_000,
+              let context = CGContext(data:nil,width:width,height:height,bitsPerComponent:8,bytesPerRow:width,space:CGColorSpaceCreateDeviceGray(),bitmapInfo:CGImageAlphaInfo.none.rawValue) else {
+            throw ProjectError.invalid("Cannot allocate native Bezier mask coverage.")
+        }
+        context.setFillColor(gray:0,alpha:1); context.fill(CGRect(x:0,y:0,width:width,height:height))
+        context.translateBy(x:CGFloat(padding),y:CGFloat(padding)); context.setFillColor(gray:1,alpha:1)
+        context.addPath(path(mask,size:bounds.size)); context.drawPath(using:.eoFill)
+        guard let image = context.makeImage() else { throw ProjectError.invalid("Cannot rasterize native Bezier mask.") }
+        return CIImage(cgImage:image,options:[.colorSpace:NSNull()]).transformed(by:CGAffineTransform(translationX:-CGFloat(padding),y:-CGFloat(padding)))
+            .composited(over:CIImage(color:.black))
+    }
+}
+
+/// Render-queue confined, bounded LRU. Static paths do not rasterize on every frame.
+final class NativeMaskCache {
+    private struct Entry { let mask:ClipMask; let bounds:CGRect; let image:CIImage; let bytes:Int }
+    private var entries:[Entry] = []
+    private(set) var byteCount = 0
+    private(set) var rasterizations = 0
+    let budget:Int
+    init(budget:Int = 32*1024*1024) { self.budget = max(0,budget) }
+    func image(_ mask:ClipMask,bounds:CGRect) throws -> CIImage {
+        guard mask.shape == .bezier else { return try NativeSceneRenderer.maskImage(mask,bounds:bounds) }
+        if let i = entries.firstIndex(where: { $0.mask == mask && $0.bounds == bounds }) { let entry = entries.remove(at:i); entries.append(entry); return entry.image }
+        let image = try NativeSceneRenderer.maskImage(mask,bounds:bounds); rasterizations += 1
+        let padding = Int(ceil(mask.feather*4))+2, bytes = (Int(bounds.width)+padding*2)*(Int(bounds.height)+padding*2)
+        if bytes <= budget {
+            while !entries.isEmpty && (entries.count >= 16 || byteCount+bytes > budget) { byteCount -= entries.removeFirst().bytes }
+            entries.append(Entry(mask:mask,bounds:bounds,image:image,bytes:bytes)); byteCount += bytes
+        }
+        return image
+    }
+}
diff --git a/native-macos/Sources/ScenePilotMedia/NativeObjectIsolation.swift b/native-macos/Sources/ScenePilotMedia/NativeObjectIsolation.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e2d53aa136ee1d905f414da9ce8970cfbc1c434d
--- /dev/null
