+            ("motion.range", editClip(2) { var k = $0["transformKeyframes"] as! [[String: Any]]; k[1]["x"] = 50; $0["transformKeyframes"] = k }),
+            ("clip.composition", editClip(2) { $0["overlay"] = ["scale": 100, "opacity": 100, "compositionId": "comp-1"] }),
