diff --git a/lib/pwa-client.ts b/lib/pwa-client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9009a5a1451be1f8fad695e814b049803e0e1aeb
--- /dev/null
+++ b/lib/pwa-client.ts
@@ -0,0 +1,96 @@
+// Registers the ScenePilot service worker (/sw.js, scope /) for the editor and
+// the film tools, and reports two events to the UI:
+//   "offline-ready"    first install finished: the app now works offline.
+//   "update-available" a new version is installed and waiting. It only takes
+//                      over when the user accepts (applyUpdate) — never mid-edit.
+// Older builds registered the same script with scope /app/; that registration
+// is removed so one worker serves both /app/ and /tools/.
+
+export type PwaState = { offlineReady: boolean; updateAvailable: boolean };
+type Listener = (state: PwaState) => void;
+
+let state: PwaState = { offlineReady: false, updateAvailable: false };
+let registration: ServiceWorkerRegistration | null = null;
+let started = false;
+const listeners = new Set<Listener>();
+
+const emit = (patch: Partial<PwaState>) => {
+  state = { ...state, ...patch };
+  listeners.forEach((listener) => listener(state));
+};
+
+export function subscribePwa(listener: Listener) {
+  listeners.add(listener);
+  listener(state);
+  return () => { listeners.delete(listener); };
+}
+
+export function pwaSupported() {
+  if (typeof window === "undefined" || !("serviceWorker" in navigator)) return false;
+  if (window.location.protocol !== "https:" && !["localhost", "127.0.0.1"].includes(window.location.hostname)) return false;
+  return !navigator.userAgent.includes("ScenePilotDesktop/");
+}
+
+/** Call once per page. `allowLocalhost` lets tests exercise the worker locally. */
+export async function registerPwa(options: { allowLocalhost?: boolean } = {}) {
+  if (started || !pwaSupported()) return;
+  const local = ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);
+  // Local dev servers skip the worker unless a test opts in (?pwa once per origin).
+  if (local && new URLSearchParams(window.location.search).has("pwa")) { try { localStorage.setItem("scenepilot:pwa", "1"); } catch { /* private mode */ } }
+  const optedIn = (() => { try { return localStorage.getItem("scenepilot:pwa") === "1"; } catch { return false; } })();
+  if (local && !options.allowLocalhost && !optedIn) return;
+  started = true;
+  const container = navigator.serviceWorker;
+  const hadController = Boolean(container.controller);
+  try {
+    let legacy = false;
+    for (const existing of await container.getRegistrations()) {
+      if (new URL(existing.scope).pathname === "/app/") { legacy = true; await existing.unregister(); }
+    }
+    // The old worker keeps filling its cache while it still controls this page;
+    // drop that cache on the first load it no longer controls.
+    if (!legacy && "caches" in window) void caches.delete("scenepilot-standalone-v3").catch(() => undefined);
+    registration = await container.register("/sw.js", { scope: "/", updateViaCache: "none" });
+  } catch {
+    return;
+  }
+  if (!registration) return; // blocked by policy / automation: run as a plain web page
+  const watch = (worker: ServiceWorker | null) => {
+    if (!worker) return;
+    const check = () => {
+      if (worker.state !== "installed") return;
+      // Waiting behind an active worker of this registration = an update.
+      if (registration?.active && registration.active !== worker) emit({ updateAvailable: true });
+      else emit({ offlineReady: true });
+    };
+    worker.addEventListener("statechange", check);
+    check();
+  };
+  if (registration.waiting && registration.active) emit({ updateAvailable: true });
+  watch(registration.installing);
+  registration.addEventListener("updatefound", () => watch(registration?.installing ?? null));
+  if (!hadController) {
+    container.ready.then(() => { if (!state.updateAvailable) emit({ offlineReady: true }); }).catch(() => undefined);
+  }
+  // Re-check for a new deploy when the tab comes back to the foreground.
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "visible") void registration?.update().catch(() => undefined);
+  });
+}
+
+/** Activate the waiting worker and reload once it controls the page. */
+export function applyUpdate() {
+  const waiting = registration?.waiting;
+  if (!waiting) { window.location.reload(); return; }
+  let reloaded = false;
+  navigator.serviceWorker.addEventListener("controllerchange", () => {
+    if (reloaded) return;
+    reloaded = true;
+    window.location.reload();
+  });
+  waiting.postMessage({ type: "SKIP_WAITING" });
+}
+
+export function dismissOfflineReady() {
+  emit({ offlineReady: false });
+}
diff --git a/lib/reframe-crop.ts b/lib/reframe-crop.ts
new file mode 100644
index 0000000000000000000000000000000000000000..35fa241256087b59d6128c1c14b582a167e3dce5
--- /dev/null
+++ b/lib/reframe-crop.ts
@@ -0,0 +1,56 @@
+// Crop-window geometry for Reframe: given a source frame size and a target
+// aspect, where does the (as-large-as-possible, no extra zoom) crop window
+// sit when it's centred on a normalized (0..1) subject position? Clamped so
+// it never leaves the source frame. Also letterbox math for the per-segment
+// "letterbox instead" option. Pure, no DOM.
+export const REFRAME_ASPECTS = {
+  "9:16": 9 / 16,
+  "4:5": 4 / 5,
+  "1:1": 1,
+} as const;
+export type ReframeAspectId = keyof typeof REFRAME_ASPECTS;
+export const REFRAME_ASPECT_IDS = Object.keys(REFRAME_ASPECTS) as ReframeAspectId[];
+
+export type CropRect = { x: number; y: number; width: number; height: number };
+
+/**
+ * Crop rectangle in source pixels for `aspect`, centred on (`centerX`,
+ * `centerY`) (each 0..1, fraction of source width/height), clamped so the
+ * rectangle is always fully inside the source. Uses the largest crop that
+ * fits the target aspect inside the source (no zoom beyond what the aspect
+ * change requires).
+ */
+export function cropBounds(sourceWidth: number, sourceHeight: number, aspect: ReframeAspectId, centerX = 0.5, centerY = 0.5): CropRect {
+  if (sourceWidth <= 0 || sourceHeight <= 0) return { x: 0, y: 0, width: Math.max(0, sourceWidth), height: Math.max(0, sourceHeight) };
+  const targetAspect = REFRAME_ASPECTS[aspect];
+  const sourceAspect = sourceWidth / sourceHeight;
+  let width: number;
+  let height: number;
+  if (sourceAspect > targetAspect) {
+    height = sourceHeight;
+    width = height * targetAspect;
+  } else {
+    width = sourceWidth;
+    height = width / targetAspect;
+  }
+  const x = Math.min(sourceWidth - width, Math.max(0, centerX * sourceWidth - width / 2));
+  const y = Math.min(sourceHeight - height, Math.max(0, centerY * sourceHeight - height / 2));
+  return { x, y, width, height };
+}
+
+/** Even output pixel size for an aspect; the longer side is `longSide` (default 1080, so 9:16 → 608x1080-ish rounded even). */
+export function outputSize(aspect: ReframeAspectId, longSide = 1080) {
+  const targetAspect = REFRAME_ASPECTS[aspect];
+  const even = (value: number) => Math.max(2, Math.round(value / 2) * 2);
+  if (targetAspect <= 1) return { width: even(longSide * targetAspect), height: even(longSide) };
+  return { width: even(longSide), height: even(longSide / targetAspect) };
+}
+
+/** Letterbox/pillarbox placement: the whole source fits inside the output canvas, centred, bars on the short axis. */
+export function letterboxRect(sourceWidth: number, sourceHeight: number, outWidth: number, outHeight: number): CropRect {
+  if (sourceWidth <= 0 || sourceHeight <= 0) return { x: 0, y: 0, width: outWidth, height: outHeight };
+  const scale = Math.min(outWidth / sourceWidth, outHeight / sourceHeight);
+  const width = sourceWidth * scale;
+  const height = sourceHeight * scale;
+  return { x: (outWidth - width) / 2, y: (outHeight - height) / 2, width, height };
+}
diff --git a/lib/reframe-path.ts b/lib/reframe-path.ts
new file mode 100644
index 0000000000000000000000000000000000000000..76307972fe8ecbc58eaec48c5c4a393ef24ed6a0
--- /dev/null
+++ b/lib/reframe-path.ts
@@ -0,0 +1,113 @@
+// Reframe's virtual camera path: turns a sparse sequence of detected subject
+// centers (one face track, a kept-together pair, or a motion-saliency
+// fallback) into a smooth crop path a human operator would plausibly pull —
+// a dead zone so small jitter doesn't move the camera at all, a capped pan
+// speed so it never whips, exponential-style easing for the motion that does
+// happen, and a hard reset on a scene cut so a new shot starts framed on its
+// own subject instead of swinging across the old one. Pure and DOM-free so it
+// can run identically in analysis, preview and export.
+export { detectSceneCuts } from "./autocut-clips.ts";
+
+export type SubjectTarget = { time: number; x: number; y: number; weight?: number };
+export type PathPoint = { time: number; x: number; y: number; cut: boolean };
+
+export type PathOptions = {
+  /** Fraction of frame width/height the subject can drift before the camera follows at all, 0..0.5. */
+  deadZone?: number;
+  /** Max camera movement per second, as a fraction of frame width/height, 0..2. */
+  maxPanSpeed?: number;
+  /** 0..1: how much of the remaining distance (beyond the dead zone) closes per update. Lower = lazier/smoother. */
+  ease?: number;
+  /** Scene cut times (seconds). A target at or after a cut snaps the camera straight there instead of panning. */
+  cutTimes?: number[];
+};
+
+export const DEFAULT_PATH_OPTIONS: Required<Pick<PathOptions, "deadZone" | "maxPanSpeed" | "ease">> = {
+  deadZone: 0.08,
+  maxPanSpeed: 0.6,
+  ease: 0.35,
+};
+
+const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
+
+/** One axis of dead-zone + eased + speed-capped pursuit over `dt` seconds. */
+function pursue(current: number, target: number, dt: number, deadZone: number, maxPanSpeed: number, ease: number): number {
+  const raw = target - current;
+  const sign = Math.sign(raw);
+  const beyondDeadZone = sign * Math.max(0, Math.abs(raw) - deadZone);
+  if (beyondDeadZone === 0) return current;
+  const eased = beyondDeadZone * clamp01(ease);
+  const maxStep = Math.max(0, maxPanSpeed) * Math.max(0, dt);
+  const capped = Math.sign(eased) * Math.min(Math.abs(eased), maxStep);
+  return current + capped;
+}
+
+/**
+ * Build a smooth camera path from sparse subject targets (sorted by time).
+ * Between two targets that straddle a scene cut, the path jumps directly to
+ * the new target — no pan, no dead zone, no speed cap — because panning
+ * across a hard cut reads as a whip-pan rather than a deliberate move.
+ */
+export function buildCameraPath(targets: SubjectTarget[], options: PathOptions = {}): PathPoint[] {
+  if (!targets.length) return [];
+  const { deadZone, maxPanSpeed, ease } = { ...DEFAULT_PATH_OPTIONS, ...options };
+  const cuts = [...(options.cutTimes ?? [])].sort((a, b) => a - b);
+  const sorted = [...targets].sort((a, b) => a.time - b.time);
+
+  const path: PathPoint[] = [];
+  let x = sorted[0].x;
+  let y = sorted[0].y;
+  let lastTime = sorted[0].time;
+  let cutCursor = 0;
+
+  sorted.forEach((target, index) => {
+    const dt = Math.max(0, target.time - lastTime);
+    let crossedCut = false;
+    while (cutCursor < cuts.length && cuts[cutCursor] <= target.time + 1e-9) {
+      if (cuts[cutCursor] > lastTime - 1e-9) crossedCut = true;
+      cutCursor++;
+    }
+    const isFirst = index === 0;
+    if (crossedCut && !isFirst) {
+      x = target.x;
+      y = target.y;
+    } else if (!isFirst) {
+      x = pursue(x, target.x, dt, deadZone, maxPanSpeed, ease);
+      y = pursue(y, target.y, dt, deadZone, maxPanSpeed, ease);
+    }
+    path.push({ time: target.time, x: clamp01(x), y: clamp01(y), cut: crossedCut && !isFirst });
+    lastTime = target.time;
+  });
+  return path;
+}
+
+/** The path's position at an arbitrary time, holding at the ends and never interpolating across a cut's hard edge. */
+export function pathAt(path: PathPoint[], time: number): { x: number; y: number } {
+  if (!path.length) return { x: 0.5, y: 0.5 };
+  if (time <= path[0].time) return { x: path[0].x, y: path[0].y };
+  const last = path[path.length - 1];
+  if (time >= last.time) return { x: last.x, y: last.y };
+  for (let i = 1; i < path.length; i++) {
+    if (path[i].time < time) continue;
+    const a = path[i - 1];
+    const b = path[i];
+    if (b.cut) return time < b.time ? { x: a.x, y: a.y } : { x: b.x, y: b.y };
+    const f = (time - a.time) / Math.max(1e-6, b.time - a.time);
+    return { x: a.x + (b.x - a.x) * f, y: a.y + (b.y - a.y) * f };
+  }
+  return { x: last.x, y: last.y };
+}
+
+/**
+ * Apply manual keyframe overrides (from a user dragging the timeline) on top
+ * of the automatic path: each override pins the path exactly at that time,
+ * and automatic points within `snapWindow` seconds of an override are dropped
+ * so the pin doesn't get immediately re-smoothed away.
+ */
+export function applyManualOverrides(path: PathPoint[], overrides: SubjectTarget[], snapWindow = 0.15): PathPoint[] {
+  if (!overrides.length) return path;
+  const pins = [...overrides].sort((a, b) => a.time - b.time);
+  const kept = path.filter((point) => !pins.some((pin) => Math.abs(pin.time - point.time) <= snapWindow));
+  const pinned: PathPoint[] = pins.map((pin) => ({ time: pin.time, x: clamp01(pin.x), y: clamp01(pin.y), cut: true }));
+  return [...kept, ...pinned].sort((a, b) => a.time - b.time);
+}
diff --git a/lib/reframe-subjects.ts b/lib/reframe-subjects.ts
