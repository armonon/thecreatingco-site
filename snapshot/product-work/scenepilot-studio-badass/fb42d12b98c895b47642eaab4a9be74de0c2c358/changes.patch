+const bundle = await build({
+  stdin: { contents: 'export { WorkspaceModebar } from "./app/workspace-modebar"; export { TimelineToolbar } from "./app/timeline-toolbar"; export { StudioTopbar } from "./app/studio-topbar";', resolveDir: process.cwd(), loader: "tsx" },
+  bundle: true, write: false, platform: "node", format: "esm", jsx: "automatic", logLevel: "silent",
+  plugins: [{ name: "workspace-preferences", setup(builder) {
+    builder.onResolve({ filter: /^\.\/studio-shell$/ }, () => ({ path: "shell", namespace: "test" }));
+    builder.onLoad({ filter: /.*/, namespace: "test" }, () => ({ contents: "export const useFullWorkspaceControls=()=>globalThis.__simple.full; export const useTimelineVisibility=()=>globalThis.__simple.visibility; export const WorkspaceLayoutControls=()=>null;" }));
+  } }],
+});
+const { WorkspaceModebar, TimelineToolbar, StudioTopbar } = await import(`data:text/javascript;base64,${Buffer.from(bundle.outputFiles[0].contents).toString("base64")}`);
+function nodes(value) {
+  if (!value || typeof value !== "object") return [];
+  if (Array.isArray(value)) return value.flatMap(nodes);
+  return [value, ...nodes(value.props?.children)];
+}
+function text(value) {
+  if (value == null || typeof value === "boolean") return "";
+  if (Array.isArray(value)) return value.map(text).join("");
+  return typeof value === "object" ? text(value.props?.children) : String(value);
+}
+const button = (tree, label) => nodes(tree).find(n => n.type === "button" && text(n).trim() === label);
+
+test("Simple navigation keeps every studio reachable with the same callbacks", () => {
+  const opened = [];
+  globalThis.__simple = { full: false };
+  const props = { workspace: "edit", isPro: true, guide: {}, onOpen: id => opened.push(id) };
+  const simple = WorkspaceModebar(props);
+  const menu = nodes(simple).find(n => n.props?.className === "workspace-more");
+  assert.equal(menu.props.label, "Tools");
+  for (const id of ["composition", "color", "audio", "deliver"]) {
+    const action = nodes(menu).find(n => n.type === "button" && n.props.onClick && n.props.title === ({ composition:"Compositions + keyframes", color:"Grade + scopes", audio:"Mix + automate", deliver:"Queue + export" })[id]);
+    assert.ok(action); action.props.onClick();
+  }
+  assert.deepEqual(opened, ["composition", "color", "audio", "deliver"]);
+  globalThis.__simple.full = true;
+  assert.equal(nodes(WorkspaceModebar(props)).filter(n => n.props?.className === "workspace-more").length, 0);
+  globalThis.__simple.full = false;
+  const liteMenu = nodes(WorkspaceModebar({ ...props, isPro:false })).find(n => n.props?.className === "workspace-more");
+  assert.ok(nodes(liteMenu).filter(n => n.type === "button").every(n => n.props.disabled));
+  delete globalThis.__simple;
+});
+
+test("Add track reveals unused lanes before creating a track; edit commands stay wired", () => {
+  const calls = [];
+  globalThis.__simple = { full:false, visibility:{ showEmpty:false, reveal:()=>calls.push("reveal"), toggle:()=>calls.push("toggle") } };
+  const tree = TimelineToolbar({ isPro:true, capabilities:{timelineEditModes:true}, tool:"select", range:{inPoint:null,outPoint:null}, onAddVideoTrack:()=>calls.push("video"), onAddAudioTrack:()=>calls.push("audio"), onGroup:()=>calls.push("group"), onNest:()=>calls.push("nest"), canGroup:true, canNest:true });
+  button(tree,"Video track").props.onClick(); button(tree,"Audio track").props.onClick();
+  button(tree,"Show unused tracks").props.onClick(); button(tree,"Group").props.onClick(); button(tree,"Nest").props.onClick();
+  assert.deepEqual(calls,["reveal","video","reveal","audio","toggle","group","nest"]);
+  for (const label of ["Slip","Slide","Rolling edit","Rate Stretch","Hand","Zoom"]) assert.ok(nodes(tree).some(n=>n.type === "button" && n.props["aria-label"]?.startsWith(`${label} tool`)));
+  delete globalThis.__simple;
+});
+
+test("Pro Export opens settings, while Lite retains its existing render action", () => {
+  const calls=[];
+  const props={capabilities:{},projects:[],isPro:true,onOpenQueue:()=>calls.push("settings"),onExport:()=>calls.push("render"),renderableSequence:true,selectedProfileSupported:true};
+  button(StudioTopbar(props),"Export").props.onClick();
+  button(StudioTopbar({...props,isPro:false}),"Render MP4").props.onClick();
+  assert.deepEqual(calls,["settings","render"]);
+  assert.equal(button(StudioTopbar({...props,isPro:false,renderableSequence:false}),"Render MP4").props.disabled,true);
+});
diff --git a/tests/song-sync.test.mjs b/tests/song-sync.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2a6cf89d70f7b98888212705306197d13366450a
--- /dev/null
+++ b/tests/song-sync.test.mjs
@@ -0,0 +1,92 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { adjustMeasuredBeats, editSongBeat, editSongTempo, planSongSync, beatPosition, beatTime, warpedSourceTime, simplifyGainCurve } from "../lib/song-beat-map.ts";
+import { tempoFromTrackedBeats } from "../lib/tempo.ts";
+import { PcmStretchReader } from "../lib/pcm-stretch.ts";
+import { applyAudioCrossfade } from "../lib/audio-crossfade.ts";
+import { clipGainAt } from "../lib/pro-editor.ts";
+import { stutterTime } from "../lib/stutter.ts";
+import { speedRampTime } from "../lib/speed.ts";
+
+const map = (bpm, count = 256) => {
+  const beats = Array.from({length:count}, (_, i) => i * 60 / bpm);
+  return {version:1,bpm,confidence:.9,beats,downbeats:beats.filter((_,i)=>i%4===0),beatsPerBar:4};
+};
+const clip = (overrides = {}) => ({id:"a",assetId:"a",trackId:"music",name:"song",start:0,sourceStart:0,duration:64,gain:1,pan:0,fadeIn:0,fadeOut:0,muted:false,...overrides});
+
+test("measured offset retains irregular spacing and fractional tempo", () => {
+  const beats = [.1, .62, 1.11, 1.65];
+  const moved = adjustMeasuredBeats(beats, 119.72, 119.72, .025);
+  for (let i=1;i<beats.length;i++) assert.ok(Math.abs((moved[i]-moved[i-1])-(beats[i]-beats[i-1]))<1e-12);
+  const changed = editSongTempo(map(119.72), 120.25, .01);
+  assert.equal(changed.bpm,120.25); assert.ok(changed.downbeats.every(t=>changed.beats.includes(t)));
+  assert.throws(()=>editSongBeat(map(120),2,.1,false),/increasing/);
+  assert.throws(()=>editSongTempo(map(120),NaN),/Tempo/);
+});
+
+test("fractional tempo refines quantized onset frames and automation is compact",()=>{
+  const beats=Array.from({length:100},(_,i)=>Math.round(i*60/128/(1024/48000))*(1024/48000));
+  assert.ok(Math.abs(tempoFromTrackedBeats(beats,126)-128)<.15);
+  const points=Array.from({length:10000},(_,i)=>({time:i*.01,gain:.5+i*.00005}));
+  assert.equal(simplifyGainCurve(points).length,2);
+});
+
+test("aligns every incoming beat to a drifting master, not just average BPM",()=>{
+  const master = map(120);
+  master.beats = master.beats.map((t,i)=>t + i*i*.0001);
+  master.downbeats = master.beats.filter((_,i)=>i%4===0);
+  const plan = planSongSync({...clip(),beatMap:master}, {...clip(),duration:50,beatMap:map(128)},16,0);
+  const origin = Math.round(beatPosition(master.beats,plan.start));
+  plan.warp.slice(0,-1).forEach((point,i)=>{
+    assert.ok(Math.abs(plan.start + point.time - beatTime(master.beats,origin+i))<1e-8);
+    assert.ok(Math.abs(point.sourceTime-i*60/128)<1e-8);
+    assert.ok(Math.abs(warpedSourceTime(plan.warp,point.time)-point.sourceTime)<1e-8);
+  });
+  assert.doesNotThrow(()=>structuredClone(plan));
+});
+
+test("4/8/16 bar handoffs land at selected downbeat, reject missing handles and meters",()=>{
+  for (const bars of [4,8,16]) {
+    const plan=planSongSync({...clip(),duration:100,beatMap:map(120)}, {...clip(),duration:100,beatMap:map(128)},40,bars);
+    assert.equal(plan.transitionEnd,40); assert.equal(plan.transitionDuration,bars*2);
+    assert.equal(plan.start,40-bars*2);
+  }
+  assert.throws(()=>planSongSync({...clip(),beatMap:map(120)}, {...clip(),beatMap:map(128)},2,16),/Not enough/);
+  assert.throws(()=>planSongSync({...clip(),beatMap:map(120)}, {...clip(),beatMap:{...map(128),beatsPerBar:3}},16,4),/meters/);
+});
+
+test("full existing overlap has constant power, no full-volume plateau",()=>{
+  const pair=applyAudioCrossfade(clip({duration:10}),clip({id:"b",start:8,duration:10}),.5);
+  assert.ok(pair);assert.equal(pair[0].fadeOut,2);assert.equal(pair[1].fadeIn,2);
+  for(let t=8;t<10;t+=.025) assert.ok(Math.abs(clipGainAt(pair[0],t)**2+clipGainAt(pair[1],t)**2-1)<1e-8);
+  assert.equal(applyAudioCrossfade(clip(),clip({start:5,duration:3}),.5),null);
+});
+
+test("stutter and speed cycle boundaries follow variable beat timestamps",()=>{
+  const beats=[0,.5,1.1,1.8,2.6,3.5,4.5,5.6,6.8];
+  const speed={pattern:"ramp-in",every:4,strength:2};
+  assert.equal(speedRampTime(2.6,.5,speed,0,beats),2.6);
+  assert.equal(speedRampTime(6.8,.5,speed,0,beats),6.8);
+  const stutter={pattern:"hold",division:1,window:4,every:4};
+  assert.equal(stutterTime(3.8,.5,stutter,0,beats),3.5);
+});
+
+test("worker-safe stretch preserves 440 Hz and stereo phase at ½×, 1.067× and 2×",async()=>{
+  const sampleRate=48000;
+  const read=async(time,frames,l,r)=>{for(let i=0;i<frames;i++){const value=Math.sin(2*Math.PI*440*(time+i/sampleRate));l[i]=value;r[i]=value*.5;}};
+  for(const rate of [.5,128/120,2]) {
+    const stretch=new PcmStretchReader(read,sampleRate,0,rate);
+    const l=new Float32Array(sampleRate*2),r=new Float32Array(l.length);
+    for(let offset=0;offset<l.length;offset+=777) {const n=Math.min(777,l.length-offset);const a=new Float32Array(n),b=new Float32Array(n);await stretch.fill(n,a,b);l.set(a,offset);r.set(b,offset);}
+    let crossings=0;
+    for(let i=sampleRate;i<l.length-1;i++){if(l[i]<=0&&l[i+1]>0)crossings++;assert.ok(Math.abs(r[i]-l[i]*.5)<1e-6);}
+    assert.ok(Math.abs(crossings-440)<=3,`${rate}× yielded ${crossings} Hz`);
+  }
+});
+
+test("stretch cancellation is honored and invalid warps cannot hang",async()=>{
+  const controller=new AbortController();controller.abort();
+  const s=new PcmStretchReader(async()=>{},48000,0,1);
+  await assert.rejects(s.fill(100,new Float32Array(100),new Float32Array(100),controller.signal),/abort/i);
+  assert.throws(()=>new PcmStretchReader(async()=>{},48000,0,1,[{time:0,sourceTime:1},{time:0,sourceTime:2}]),/Invalid/);
+});
diff --git a/tests/source-edit.test.mjs b/tests/source-edit.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a2f0a6eb00284077dea7938e3be952472549331e
--- /dev/null
+++ b/tests/source-edit.test.mjs
@@ -0,0 +1,133 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { planSourceEdit, sliceEditorialAudio, retimeLinkedAudio, planLinkedRazor } from "../lib/source-edit.ts";
+import { applyAudioCrossfade, audioFadeGainAt } from "../lib/audio-crossfade.ts";
+import { clipGainAt } from "../lib/pro-editor.ts";
+import { pcmFadeGainAt } from "../lib/pcm-audio.ts";
+import { applySplitEdit } from "../lib/pro-workflows.ts";
+import { exportOtioProject, importOtio } from "../lib/interchange.ts";
+import { placeBaseCut } from "../lib/timeline-edit.ts";
+import { audioPlaybackRate, audioSourceTime } from "../lib/audio-timing.ts";
+
+const cut = { id: "picture", assetId: "source", sectionId: "manual", start: 0, duration: 10, sourceStart: 2 };
+const audio = { id: "sound", assetId: "source", trackId: "a1", name: "Sound", start: 0, duration: 10, sourceStart: 2, gain: 1, pan: 0, fadeIn: 1, fadeOut: 1, muted: false, linkedVideoId: "picture", automation: [{ id: "low", time: 0, gain: 0 }, { id: "high", time: 10, gain: 1 }] };
+const incoming = { ...cut, id: "incoming", assetId: "second", start: 3, duration: 2, sourceStart: 0 };
+const incomingAudio = { ...audio, id: "new-sound", assetId: "second", start: 3, duration: 2, sourceStart: 0, linkedVideoId: "incoming" };
+const input = { cuts: [cut], audioClips: [audio], audioTracks: [{ id: "a1", locked: false }, { id: "a2", locked: true }], incoming, incomingAudio };
+
+test("Source Insert splits crossing picture/audio without lost footage or overlap", () => {
+  const result = planSourceEdit({ ...input, mode: "insert" });
+  assert.equal(result.error, undefined);
+  assert.deepEqual(result.cuts.map(c => [c.start, c.duration, c.sourceStart]), [[0, 3, 2], [3, 2, 0], [5, 7, 5]]);
+  assert.deepEqual(result.audioClips.map(c => [c.start, c.duration, c.sourceStart]), [[0, 3, 2], [3, 2, 0], [5, 7, 5]]);
+  assert.equal(result.audioClips[2].linkedVideoId, result.cuts[2].id);
+  assert.equal(result.audioClips[0].fadeOut, 0);
+  assert.equal(result.audioClips[2].fadeIn, 0);
+  assert.equal(result.audioClips[2].fadeOut, 1);
+  assert.equal(result.audioClips[2].automation[0].gain, .3);
+  assert.equal(result.audioClips[2].automation.at(-1).time, 7);
+  assert.equal(input.cuts[0].duration, 10, "planning must not mutate undo's source state");
+});
+
+test("Source Overwrite keeps audio head/tail and unrelated tracks", () => {
+  const unrelated = { ...audio, id: "music", trackId: "a2", linkedVideoId: undefined };
+  const result = planSourceEdit({ ...input, audioClips: [audio, unrelated], mode: "overwrite" });
+  assert.equal(result.error, undefined);
+  assert.equal(result.audioClips.find(c => c.id === "music"), unrelated);
+  const pieces = result.audioClips.filter(c => c.trackId === "a1");
+  assert.deepEqual(pieces.map(c => [c.start, c.duration, c.sourceStart]), [[0, 3, 2], [3, 2, 0], [5, 5, 7]]);
+  assert.equal(pieces[2].linkedVideoId, result.cuts[2].id);
+  assert.equal(pieces[2].automation[0].gain, .5);
+});
+
+test("locked linked audio blocks the complete transaction, unrelated locked audio stays put", () => {
+  assert.match(planSourceEdit({ ...input, audioTracks: [{ id: "a1", locked: true }], mode: "insert" }).error, /Unlock the linked audio/);
+  assert.match(planSourceEdit({ ...input, cuts: [{ ...cut, locked: true }], mode: "overwrite" }).error, /Unlock the affected picture/);
+  const music = { ...audio, id: "music", trackId: "a2", linkedVideoId: undefined };
+  const result = planSourceEdit({ ...input, audioClips: [audio, music], mode: "insert" });
+  assert.equal(result.audioClips.find(c => c.id === "music"), music);
+});
+
+test("source insert respects sync-excluded unrelated audio but carries linked picture sound", () => {
+  const music = { ...audio, id: "music", linkedVideoId: undefined };
+  const result = planSourceEdit({ ...input, audioClips: [audio, music], audioTracks: [{ id: "a1", locked: false, syncLock: false }], mode: "insert" });
+  assert.equal(result.audioClips.find(c => c.id === "music"), music);
+  assert.equal(result.audioClips.filter(c => c.linkedVideoId && c.id !== incomingAudio.id).length, 2);
+});
+
+test("linked razor preserves reversed picture, linked audio fades, unique IDs and lock atomicity", () => {
+  const picture = { ...cut, reversed: true, playbackRate: 2 };
+  const sound = { ...audio, playbackRate: 2, fadeIn: 6 };
+  const result = planLinkedRazor([picture], [sound], input.audioTracks, picture.id, 3);
+  assert.deepEqual(result.cuts.map(c => [c.sourceStart, c.duration]), [[16, 3], [2, 7]]);
+  assert.equal(result.audioClips[1].linkedVideoId, result.selectedId);
+  assert.equal(result.audioClips[1].sourceStart, 8);
+  for (let t = 0; t < 10; t += .1) {
+    const piece = result.audioClips.find(c => t >= c.start && t < c.start + c.duration);
+    assert.ok(Math.abs(clipGainAt(piece, t) - clipGainAt(sound, t)) < 1e-10);
+  }
+  assert.match(planLinkedRazor([picture], [sound], [{ id: "a1", locked: true }], picture.id, 3).error, /Unlock/);
+  assert.equal(planLinkedRazor([picture], [sound], [{ id: "a1", locked: true }], picture.id, 3, false).audioClips[0], sound);
+  assert.match(planLinkedRazor([{ ...picture, locked: true }], [], [], picture.id, 3).error, /Unlock/);
+});
+
+test("repeated insert generates unique piece IDs and retains reversed source continuity", () => {
+  let cuts = [{ ...cut, reversed: true, playbackRate: 2 }];
+  cuts = placeBaseCut(cuts, incoming, "insert");
+  assert.equal(cuts[0].sourceStart, 16);
+  assert.equal(cuts[2].sourceStart, 2);
+  cuts = placeBaseCut(cuts, { ...incoming, id: "again", start: 1 }, "insert");
+  assert.equal(new Set(cuts.map(c => c.id)).size, cuts.length);
+  for (let i = 1; i < cuts.length; i++) assert.ok(cuts[i - 1].start + cuts[i - 1].duration <= cuts[i].start);
+});
+
+test("varispeed slices use source seconds while automation remains in timeline seconds", () => {
+  const slice = sliceEditorialAudio({ ...audio, playbackRate: 2 }, 3, 8, "piece");
+  assert.equal(slice.sourceStart, 8);
+  assert.equal(slice.duration, 5);
+  assert.equal(slice.playbackRate, 2);
+  assert.equal(audioSourceTime(slice, 1.5), 11);
+  assert.equal(slice.automation[0].gain, .3);
+  assert.equal(slice.automation.at(-1).gain, .8);
+  assert.equal(audioPlaybackRate({}), 1);
+  assert.equal(audioPlaybackRate({ playbackRate: NaN }), 1);
+});
+
+test("linked retime preserves J/L source offsets and scales fades and automation", () => {
+  const before = { ...cut, start: 5, duration: 10, sourceStart: 4 };
+  const after = { ...before, start: 8, duration: 5, playbackRate: 2 };
+  const result = retimeLinkedAudio({ ...audio, start: 4, duration: 12, sourceStart: 3 }, before, after);
+  assert.deepEqual([result.start, result.duration, result.sourceStart, result.playbackRate], [7.5, 6, 3, 2]);
+  assert.equal(result.fadeIn, .5);
+  assert.equal(result.automation.at(-1).time, 5);
+  assert.equal(audioSourceTime(result, after.start - result.start), after.sourceStart);
+});
+
+test("varispeed J cuts are idempotent and crossfades respect source handles", () => {
+  const original = { ...audio, start: 3, duration: 4, sourceStart: 2, playbackRate: 2 };
+  const j = applySplitEdit(original, 3, 4, "j-cut", .5);
+  assert.deepEqual([j.start, j.sourceStart], [2.5, 1]);
+  assert.deepEqual(applySplitEdit(j, 3, 4, "j-cut", .5), j);
+  const pair = applyAudioCrossfade({ ...audio, duration: 3 }, original, 1);
+  assert.deepEqual([pair[1].start, pair[1].sourceStart, pair[1].duration], [2, 0, 5]);
+});
+
+test("overlapping fades use the identical envelope in preview and PCM", () => {
+  for (const fadeShape of ["linear", "equalPower", "exponential"]) for (const time of [0, .25, .5, .75, 1]) {
+    const clip = { ...audio, start: 0, duration: 1, fadeIn: .8, fadeOut: .8, fadeShape, automation: [] };
+    const expected = audioFadeGainAt(time, 1, .8, .8, fadeShape);
+    assert.equal(clipGainAt(clip, time), expected);
+    assert.equal(pcmFadeGainAt(time, 1, .8, .8, fadeShape), expected);
+  }
+});
+
+test("standard OTIO audio timewarp retains timeline duration without ScenePilot metadata", () => {
+  const document = JSON.parse(exportOtioProject({ project: "Speed", frameRate: 24, assets: [{ id: "source", name: "source.mov", kind: "video", sourcePath: "/media/source.mov" }], videoClips: [{ ...cut, trackId: "__base__" }], videoTracks: [{ id: "__base__", name: "Picture" }], audioTracks: [{ id: "a1", name: "Audio" }], audioClips: [{ ...audio, duration: 3, playbackRate: 2 }] }));
+  const audioItem = document.tracks.children.find(track => track.kind === "Audio").children.find(item => item.OTIO_SCHEMA === "Clip.2");
+  audioItem.metadata.scenepilot_audio.fadeShape = "exponential";
+  assert.equal(importOtio(JSON.stringify(document)).audioClips[0].fadeShape, "exponential");
+  const stripMetadata = value => { if (!value || typeof value !== "object") return; delete value.metadata; for (const child of Object.values(value)) stripMetadata(child); };
+  stripMetadata(document);
+  const imported = importOtio(JSON.stringify(document));
+  assert.deepEqual(imported.audioClips.map(c => [c.duration, c.sourceStart, c.playbackRate]), [[3, 2, 2]]);
+});
diff --git a/tests/storyboard.test.mjs b/tests/storyboard.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c7f20c6b4d683d376395cdc883ec09483c02b1ed
--- /dev/null
+++ b/tests/storyboard.test.mjs
@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  boardDuration, boardToCsv, boardToCutFile, boardToMarkers, createBoard, estimateDuration, guessShotType, makeIdFactory, moveShot, parseBoardJson, parseScript, shotNumber,
+} from "../lib/storyboard.ts";
+import { parseCutFile } from "../lib/project-store.ts";
+
+const SCREENPLAY = `Title: Last Order
+
+INT. DINER - NIGHT
+
+Rain streaks the window. MAYA stirs a coffee she hasn't touched.
+
+CLOSE ON her hand — a pale band where a ring used to be.
+
+JONAH
+(out of breath)
+You kept the place.
+
+MAYA
+I kept the coffee.
+
+CUT TO:
+
+EXT. PARKING LOT - CONTINUOUS
+
+A wide, empty lot. Neon hums. Maya walks to her car alone.
+
+INSERT - her phone screen: 3 missed calls.`;
+
+test("screenplay: scene headings, action, explicit shots, dialogue coverage, transitions dropped", () => {
+  const scenes = parseScript(SCREENPLAY, makeIdFactory("t"));
+  assert.deepEqual(scenes.map((scene) => scene.heading), ["INT. DINER - NIGHT", "EXT. PARKING LOT - CONTINUOUS"]);
+  const [diner, lot] = scenes;
+  assert.equal(diner.shots.length, 4);
+  assert.equal(diner.shots[0].shotType, "WS");
+  assert.equal(diner.shots[1].shotType, "CU");
+  assert.match(diner.shots[1].description, /pale band/);
+  assert.equal(diner.shots[2].character, "JONAH");
+  assert.equal(diner.shots[2].dialogue, "You kept the place.");
+  assert.match(diner.shots[2].description, /out of breath/);
+  assert.equal(diner.shots[2].shotType, "MCU");
+  assert.ok(!diner.shots.some((shot) => /CUT TO/.test(shot.description)));
+  assert.equal(lot.shots[0].shotType, "EWS");
+  assert.equal(lot.shots[1].shotType, "INSERT");
+  assert.equal(lot.shots[1].lens, "100mm macro");
+});
+
+test("prose and bullet lists become scenes of sentence/bullet shots", () => {
+  const scenes = parseScript("Opening\nA skater drops into an empty pool at dawn. Slow motion of the wheels. She lands and grins.\n\n- Crowd cheering\n- Close up on the trophy\n- Aerial of the city", makeIdFactory("p"));
+  assert.equal(scenes.length, 2);
+  assert.equal(scenes[0].heading, "OPENING");
+  assert.equal(scenes[0].shots.length, 3);
+  assert.equal(scenes[1].heading, "SCENE 2");
+  assert.deepEqual(scenes[1].shots.map((shot) => shot.shotType), ["WS", "CU", "AERIAL"]);
+  assert.deepEqual(parseScript("   \n\n "), []);
+});
+
+test("shot type, duration and numbering heuristics", () => {
+  assert.equal(guessShotType("we see it from his POV", { firstInScene: false, hasDialogue: false }), "POV");
+  assert.equal(guessShotType("tears in her eyes", { firstInScene: false, hasDialogue: false }), "CU");
+  assert.equal(guessShotType("they argue", { firstInScene: false, hasDialogue: false }), "MS");
+  assert.equal(estimateDuration("", "one two three four five six seven eight nine ten"), 4.6);
+  assert.equal(estimateDuration("short"), 2);
+  assert.equal(estimateDuration(Array(90).fill("w").join(" ")), 12);
+  assert.equal(shotNumber(0, 0), "1A");
+  assert.equal(shotNumber(2, 25), "3Z");
+  assert.equal(shotNumber(0, 26), "1AA");
+});
+
+test("moveShot reorders within and across scenes without losing shots", () => {
+  const scenes = parseScript(SCREENPLAY, makeIdFactory("m"));
+  const [diner, lot] = scenes;
+  const moved = moveShot(scenes, diner.shots[0].id, diner.id, 2);
+  assert.equal(moved[0].shots[2].id, diner.shots[0].id);
+  const across = moveShot(scenes, diner.shots[3].id, lot.id, 0);
+  assert.equal(across[0].shots.length, 3);
+  assert.equal(across[1].shots[0].id, diner.shots[3].id);
+  assert.equal(moveShot(scenes, "missing", lot.id, 0), scenes);
+});
+
+test("markers lay shots end to end and the cut file imports through ScenePilot's parser", () => {
+  const board = createBoard("Last Order", parseScript(SCREENPLAY, makeIdFactory("c")));
+  const markers = boardToMarkers(board);
+  const shots = markers.filter((marker) => marker.kind === "marker");
+  assert.equal(markers.filter((marker) => marker.kind === "chapter").length, 2);
+  assert.equal(shots.length, 6);
+  for (let i = 1; i < shots.length; i++) assert.ok(Math.abs(shots[i].time - (shots[i - 1].time + shots[i - 1].duration)) < 1e-6);
+  assert.match(shots[0].label, /^1A WS · Rain/);
+  assert.ok(markers.every((marker) => marker.label.length <= 80));
+  const cut = parseCutFile(JSON.stringify(boardToCutFile(board)));
+  assert.equal(cut.project, "Last Order");
+  assert.ok(Math.abs(cut.duration - boardDuration(board)) < 1e-6);
+  assert.equal(cut.proState.markers.length, markers.length);
+  assert.match(cut.storyBrief, /SCENE 1: INT\. DINER - NIGHT/);
+  assert.match(cut.storyBrief, /1C {2}MCU/);
+});
+
+test("CSV quotes commas, quotes and newlines", () => {
+  const board = createBoard("x", [{ id: "s", heading: "INT. A, B", shots: [{ id: "a", description: 'He says "hi"\nthen leaves', shotType: "MS", lens: "35mm", duration: 2, notes: "" }] }]);
+  const csv = boardToCsv(board);
+  assert.match(csv, /^Shot,Scene,Type/);
+  assert.match(csv, /1A,"INT\. A, B",MS,35mm,2,"He says ""hi""\nthen leaves"/);
+});
+
+test("board JSON round-trips and repairs hostile input", () => {
+  const board = createBoard("Saved", parseScript(SCREENPLAY, makeIdFactory("j")), "2.39:1");
+  board.scenes[0].shots[0].frame = "data:image/jpeg;base64,AAAA";
+  const loaded = parseBoardJson(JSON.stringify(board));
+  assert.deepEqual(JSON.parse(JSON.stringify(loaded)), JSON.parse(JSON.stringify(board)));
+  const repaired = parseBoardJson(JSON.stringify({ format: "scenepilot-board", aspect: "weird", scenes: [{ shots: [{ shotType: "NOPE", duration: -4, frame: "javascript:alert(1)" }, null] }] }));
+  assert.equal(repaired.aspect, "16:9");
+  assert.equal(repaired.scenes[0].shots[0].shotType, "MS");
+  assert.equal(repaired.scenes[0].shots[0].duration, 0.1);
+  assert.equal(repaired.scenes[0].shots[0].frame, undefined);
