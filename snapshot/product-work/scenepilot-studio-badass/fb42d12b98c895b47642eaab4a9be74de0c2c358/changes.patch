--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/PreviewInputs.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+/// Compare validated documents without rebuilding decoders for editor-only
+/// metadata or unused library imports. This is not a file-content cache: explicit
+/// relink/retry/open must still force a rebuild, even for the same media path.
+public struct PreviewInputs: Equatable {
+    private var sequenceId: String
+    private var sequences: [Sequence]
+    private var media: [Media]
+    public init(_ project: Project, sequenceId: String) {
+        self.sequenceId = sequenceId
+        let byID = Dictionary(uniqueKeysWithValues: project.sequences.map { ($0.id,$0) })
+        var visited: Set<String> = [], assets: Set<String> = []
+        func visit(_ id: String) {
+            guard visited.insert(id).inserted, let sequence = byID[id] else { return }
+            for clip in sequence.videoClips {
+                if let asset = clip.assetId { assets.insert(asset) }
+                if let child = clip.compositionId { visit(child) }
+            }
+        }
+        visit(sequenceId)
+        sequences = project.sequences.filter { visited.contains($0.id) }.map { value in
+            var sequence = value; sequence.name = ""
+            sequence.tracks = value.tracks.map { value in var track = value; track.name = ""; track.locked = false; return track }
+            return sequence
+        }.sorted { $0.id < $1.id }
+        media = project.media.filter { assets.contains($0.id) }.map { value in var asset = value; asset.name = ""; return asset }.sorted { $0.id < $1.id }
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/Project.swift b/native-macos/Sources/ScenePilotCore/Project.swift
new file mode 100644
index 0000000000000000000000000000000000000000..df570e71c0bc0ecfb5d8d406a843e2b471302615
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/Project.swift
@@ -0,0 +1,204 @@
+import Foundation
+import CoreFoundation
+
+public enum ProjectError: LocalizedError {
+    case invalid(String)
+    public var errorDescription: String? { if case .invalid(let reason) = self { return reason }; return nil }
+}
+
+public struct Media: Codable, Equatable, Identifiable {
+    public var id: String
+    public var path: String
+    public var name: String
+    public var duration: Double
+    public var hasVideo: Bool
+    public var hasAudio: Bool
+    public init(path: String, duration: Double, hasVideo: Bool, hasAudio: Bool, id: String = UUID().uuidString) {
+        self.id = id; self.path = path; self.name = URL(fileURLWithPath: path).lastPathComponent
+        self.duration = duration; self.hasVideo = hasVideo; self.hasAudio = hasAudio
+    }
+}
+
+public struct Track: Codable, Equatable, Identifiable {
+    public var id: String
+    public var name: String
+    public var enabled = true
+    public var locked = false
+    public var gain = 1.0
+    /// Clips on this track zoom with the sequence's beat punch.
+    public var followsBeat: Bool?
+    public init(name: String, id: String = UUID().uuidString) { self.name = name; self.id = id }
+}
+
+public struct Clip: Codable, Equatable, Identifiable {
+    public var id: String
+    public var assetId: String?
+    public var compositionId: String?
+    public var trackId: String
+    public var start: Double
+    public var sourceStart = 0.0
+    public var duration: Double
+    public var rate = 1.0
+    public var opacity = 1.0
+    public var gain = 1.0
+    public var fadeIn = 0.0
+    public var fadeOut = 0.0
+    public var exposure = 0.0
+    public var saturation = 1.0
+    public var blur = 0.0
+    public var transform: ClipTransform?
+    public var fadeWindow: FadeWindow?
+    public var motion: ClipMotion?
+    public var mask: ClipMask?
+    public var maskAnimation: MaskAnimation?
+    public var matte: ClipMatte?
+    /// Plays into the clip at its first frame.
+    public var transitionIn: CutTransition?
+    /// Warps which source frame is shown, on the sequence clock (media clips only).
+    public var speedRamp: SpeedRamp?
+    public init(assetId: String? = nil, compositionId: String? = nil, trackId: String, start: Double, duration: Double, id: String = UUID().uuidString) {
+        self.id = id; self.assetId = assetId; self.compositionId = compositionId
+        self.trackId = trackId; self.start = start; self.duration = duration
+    }
+}
+
+public struct Sequence: Codable, Equatable, Identifiable {
+    public var id: String
+    public var name: String
+    public var width: Int
+    public var height: Int
+    public var frameRate: Int
+    /// Topmost track is first. A single canonical array owns all clips.
+    public var tracks: [Track]
+    public var videoClips: [Clip] = []
+    /// Music timing that drives `punch` and the look's beat pulse.
+    public var rhythm: SequenceRhythm?
+    public var punch: BeatPunch?
+    /// Applied to this sequence's finished frame when it is the one being played.
+    public var look: SequenceLook?
+    public var duration: Double { videoClips.map { $0.start + $0.duration }.max() ?? 0 }
+    public init(name: String, width: Int = 1920, height: Int = 1080, frameRate: Int = 30, id: String = UUID().uuidString) {
+        self.id = id; self.name = name; self.width = width; self.height = height; self.frameRate = frameRate
+        self.tracks = [Track(name: "Track 2"), Track(name: "Track 1")]
+    }
+}
+
+/// Where partial transparency is blended. Native work defaults to physically correct
+/// linear light; `gamma` blends encoded sRGB values the way a browser canvas does, so
+/// scenes translated from Pro render the same (compare After Effects' "Blend Colors
+/// Using 1.0 Gamma" project setting, which toggles the same choice).
+public enum BlendSpace: String, Codable, Equatable, Sendable { case linear, gamma }
+
+public struct Project: Codable, Equatable {
+    public var format = "scenepilot-native"
+    public var version = 7
+    public var id = UUID().uuidString
+    public var name: String
+    public var mainSequenceId: String
+    public var media: [Media] = []
+    public var sequences: [Sequence]
+    public var legacyArchive: LegacyArchive?
+    /// Which translator produced this scene from `legacyArchive`, so a newer one can re-translate exactly.
+    public var translation: SceneTranslationStamp?
+    /// Absent means linear. Applies to every sequence rendered from this project.
+    public var blendSpace: BlendSpace?
+    public init(name: String = "Untitled") {
+        self.name = name
+        let main = Sequence(name: "Main Sequence")
+        self.mainSequenceId = main.id; self.sequences = [main]
+    }
+    public func validated() throws -> Project {
+        func require(_ value: Bool, _ reason: String) throws { if !value { throw ProjectError.invalid(reason) } }
+        try require(format == "scenepilot-native" && version == 7, "This document is not a supported native project. Review existing Pro projects using File > Review Existing Pro Project.")
+        try require(!name.isEmpty && !id.isEmpty, "The project needs an identity and name.")
+        if let stamp = translation {
+            try require(!stamp.translator.isEmpty && stamp.translator.count <= 64 && (1...10_000).contains(stamp.version), "Invalid scene translation record.")
+            try require(legacyArchive != nil, "A translated scene must retain its original source document.")
+        }
+        try require(!sequences.isEmpty && sequences.count <= 256 && media.count <= 100_000, "Invalid project size.")
+        try require(Set(sequences.map(\.id)).count == sequences.count && Set(media.map(\.id)).count == media.count, "Duplicate project identifiers.")
+        try require(sequences.contains { $0.id == mainSequenceId }, "Main sequence is missing.")
+        let byMedia = Dictionary(uniqueKeysWithValues: media.map { ($0.id, $0) })
+        let bySequence = Dictionary(uniqueKeysWithValues: sequences.map { ($0.id, $0) })
+        for asset in media {
+            try require(!asset.id.isEmpty && asset.path.hasPrefix("/") && !asset.path.contains("\0"), "Media must have a valid absolute local path.")
+            try require(asset.duration.isFinite && asset.duration > 0 && (asset.hasVideo || asset.hasAudio), "Invalid media duration or stream type.")
+        }
+        for sequence in sequences {
+            try require(!sequence.id.isEmpty && !sequence.name.isEmpty, "A sequence needs an identity and name.")
+            try require(sequence.width >= 16 && sequence.height >= 16 && sequence.width <= 7680 && sequence.height <= 7680 && sequence.width % 2 == 0 && sequence.height % 2 == 0, "Invalid even output dimensions.")
+            try require([24,25,30,50,60].contains(sequence.frameRate), "Unsupported frame rate.")
+            try require(!sequence.tracks.isEmpty && sequence.tracks.count <= 128 && sequence.videoClips.count <= 100_000, "Invalid track or clip count.")
+            try require(Set(sequence.tracks.map(\.id)).count == sequence.tracks.count && Set(sequence.videoClips.map(\.id)).count == sequence.videoClips.count, "Duplicate track or clip identifiers.")
+            try sequence.rhythm?.validate(); try sequence.punch?.validate(); try sequence.look?.validate()
+            for track in sequence.tracks { try require(!track.id.isEmpty && !track.name.isEmpty && track.gain.isFinite && (0...4).contains(track.gain), "Invalid track identity or volume.") }
+            for clip in sequence.videoClips {
+                try require(!clip.id.isEmpty, "A clip needs an identity.")
+                try clip.transform?.validate()
+                try clip.motion?.validate()
+                try clip.mask?.validate()
+                try clip.maskAnimation?.validate()
+                try clip.transitionIn?.validate()
+                try clip.speedRamp?.validate()
+                try require(clip.speedRamp == nil || clip.assetId != nil, "Speed ramps apply to media clips.")
+                try require(clip.maskAnimation == nil || clip.mask != nil, "Animated masks need a base mask.")
+                try require(sequence.tracks.contains { $0.id == clip.trackId }, "Clip references a missing track.")
+                try require([clip.start,clip.sourceStart,clip.duration,clip.rate,clip.opacity,clip.gain,clip.fadeIn,clip.fadeOut,clip.exposure,clip.saturation,clip.blur].allSatisfy(\.isFinite), "Clip values must be finite.")
+                try require(clip.start >= 0 && clip.sourceStart >= 0 && clip.duration >= 1 / Double(sequence.frameRate) - 0.00001 && clip.start + clip.duration <= 86400 && (0.1...8).contains(clip.rate), "Invalid clip timing.")
+                try require((0...1).contains(clip.opacity) && (0...4).contains(clip.gain) && (-4...4).contains(clip.exposure) && (0...3).contains(clip.saturation) && (0...100).contains(clip.blur), "Invalid effect values.")
+                let fadeDuration = clip.fadeWindow?.duration ?? clip.duration
+                if let window = clip.fadeWindow {
+                    try require(window.offset.isFinite && window.duration.isFinite && window.offset >= 0 && window.duration > 0 && window.offset + clip.duration <= window.duration + 0.00001, "Invalid preserved fade envelope.")
+                }
+                try require(clip.fadeIn >= 0 && clip.fadeOut >= 0 && clip.fadeIn + clip.fadeOut <= fadeDuration + 0.00001, "Fades must fit inside the clip envelope.")
+                try require((clip.assetId == nil) != (clip.compositionId == nil), "A clip must reference exactly one media item or composition.")
+                let sourceDuration: Double
+                if let assetId = clip.assetId {
+                    guard let asset = byMedia[assetId] else { throw ProjectError.invalid("Clip media is missing from the project.") }
+                    sourceDuration = asset.duration
+                    try require(clip.motion == nil || asset.hasVideo, "Motion animation requires video media.")
+                    try require((clip.mask == nil && clip.matte == nil) || asset.hasVideo, "Masks and mattes require video or a composition.")
+                } else {
+                    guard let nested = bySequence[clip.compositionId!] else { throw ProjectError.invalid("Nested composition is missing.") }
+                    try require(nested.id != sequence.id, "A composition cannot contain itself.")
+                    try require(nested.width == sequence.width && nested.height == sequence.height, "Nested compositions currently require matching dimensions.")
+                    sourceDuration = nested.duration
+                }
+                try require(clip.sourceStart + clip.duration * clip.rate <= sourceDuration + 0.05, "Clip extends beyond its source. Trim or relink the source.")
+            }
+            try validateMattes(in: sequence)
+        }
+        var depths: [String: Int] = [:]
+        func visit(_ id: String, _ parents: Set<String>) throws -> Int {
+            try require(!parents.contains(id) && parents.count < 32, "Composition dependency cycle or excessive nesting.")
+            if let depth = depths[id] { return depth }
+            var next = parents; next.insert(id)
+            var depth = 1
+            // Reused comps form a DAG: validate each dependency once, not every path.
+            for child in Set(bySequence[id]!.videoClips.compactMap(\.compositionId)) { depth = max(depth, 1 + (try visit(child, next))) }
+            try require(depth <= 32, "Composition dependency cycle or excessive nesting.")
+            depths[id] = depth; return depth
+        }
+        for sequence in sequences { _ = try visit(sequence.id, []) }
+        return self
+    }
+    public func encoded() throws -> Data {
+        _ = try validated()
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        let data = try encoder.encode(self)
+        guard data.count <= 64 * 1024 * 1024 else { throw ProjectError.invalid("Encoded project exceeds the 64 MB safety limit. Your existing file was preserved.") }
+        return data
+    }
+    public static func decode(_ data: Data) throws -> Project {
+        guard data.count <= 64 * 1024 * 1024 else { throw ProjectError.invalid("Project document exceeds the 64 MB safety limit.") }
+        let header = try JSONSerialization.jsonObject(with: data) as? [String: Any]
+        guard header?["format"] as? String == "scenepilot-native", let version = header?["version"] as? NSNumber, CFGetTypeID(version) != CFBooleanGetTypeID(), [1,2,3,4,5,6,7].contains(version.doubleValue) else {
+            throw ProjectError.invalid("This is not a supported native project. Use File > Review Existing Pro Project for a migration report. Your file has not been changed.")
+        }
+        var project = try JSONDecoder().decode(Project.self, from: data)
+        // Older documents lack optional path animation and translation records;
+        // upgrade in memory and never silently downgrade a newer document.
+        project.version = 7
+        return try project.validated()
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/ProjectCollection.swift b/native-macos/Sources/ScenePilotCore/ProjectCollection.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b3b945f2ef790738b228c90b91fff711745c7122
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/ProjectCollection.swift
@@ -0,0 +1,67 @@
+import Foundation
+
+public enum ProjectCollection {
+    /// New folder only. Publish the folder after every source and the document are safely copied.
+    public static func collect(_ project: Project, to destination: URL) throws -> URL {
+        _ = try project.validated(); try Task.checkCancellation()
+        guard destination.isFileURL, !FileManager.default.fileExists(atPath: destination.path) else { throw ProjectError.invalid("Choose a new collection folder. Existing folders are never overwritten.") }
+        let parent = destination.deletingLastPathComponent()
+        let staging = parent.appendingPathComponent(".scenepilot-collect-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: staging, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: staging) }
+        let mediaRoot = staging.appendingPathComponent("Media")
+        try FileManager.default.createDirectory(at: mediaRoot, withIntermediateDirectories: false)
+        var next = project
+        var copied: [String: String] = [:]
+        for i in next.media.indices {
+            try Task.checkCancellation()
+            let source = URL(fileURLWithPath: next.media[i].path).resolvingSymlinksInPath().standardizedFileURL
+            let values = try source.resourceValues(forKeys: [.isRegularFileKey])
+            guard values.isRegularFile == true else { throw ProjectError.invalid("Relink missing media before collecting: \(next.media[i].name)") }
+            let name: String
+            if let existing = copied[source.path] { name = existing }
+            else {
+                name = "\(i)-" + source.lastPathComponent
+                let output = mediaRoot.appendingPathComponent(name)
+                guard FileManager.default.createFile(atPath: output.path, contents: nil) else { throw ProjectError.invalid("Cannot create collected media.") }
+                let input = try FileHandle(forReadingFrom: source), writer = try FileHandle(forWritingTo: output)
+                defer { try? input.close(); try? writer.close() }
+                while let chunk = try input.read(upToCount: 1024 * 1024), !chunk.isEmpty {
+                    try Task.checkCancellation(); try writer.write(contentsOf: chunk)
+                }
+                try writer.synchronize()
+                copied[source.path] = name
+            }
+            // Relative resolution occurs only in ProjectStore.load; canonical in-memory paths stay absolute.
+            next.media[i].path = destination.appendingPathComponent("Media").appendingPathComponent(name).path
+        }
+        try Task.checkCancellation()
+        let filename = "Project.scenepilot-native.json"
+        try encode(next, relativeTo: destination).write(to: staging.appendingPathComponent(filename), options: .withoutOverwriting)
+        try Task.checkCancellation()
+        try FileManager.default.moveItem(at: staging, to: destination)
+        return destination.appendingPathComponent(filename)
+    }
+    static func encode(_ project: Project, relativeTo directory: URL) throws -> Data {
+        var json = try JSONSerialization.jsonObject(with: project.encoded()) as! [String: Any]
+        var media = json["media"] as! [[String: Any]]
+        let localMedia = directory.appendingPathComponent("Media").standardizedFileURL
+        for i in media.indices {
+            let url = URL(fileURLWithPath: project.media[i].path).standardizedFileURL
+            if url.deletingLastPathComponent() == localMedia { media[i]["path"] = "Media/" + url.lastPathComponent }
+        }
+        json["media"] = media
+        return try JSONSerialization.data(withJSONObject: json, options: [.prettyPrinted,.sortedKeys])
+    }
+    static func resolve(_ data: Data, relativeTo directory: URL) throws -> Data {
+        guard var json = try JSONSerialization.jsonObject(with: data) as? [String: Any], var media = json["media"] as? [[String: Any]] else { return data }
+        for i in media.indices {
+            guard let path = media[i]["path"] as? String, !path.hasPrefix("/") else { continue }
+            let parts = path.split(separator: "/", omittingEmptySubsequences: false)
+            guard parts.count == 2, parts[0] == "Media", !parts[1].isEmpty, parts[1] != ".", parts[1] != "..", !path.contains("\0") else { throw ProjectError.invalid("Unsafe relative project media path.") }
+            media[i]["path"] = directory.appendingPathComponent(path).path
+        }
+        json["media"] = media
+        return try JSONSerialization.data(withJSONObject: json)
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/SequenceRhythm.swift b/native-macos/Sources/ScenePilotCore/SequenceRhythm.swift
new file mode 100644
index 0000000000000000000000000000000000000000..49e54b35b65c1a0ea0e232afd32e3157eca80b25
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/SequenceRhythm.swift
@@ -0,0 +1,172 @@
+import Foundation
+
+// Music-driven picture: beat punch, cut transitions, the drop ramp and the sequence
+// look. Every formula matches the Pro compositor term for term (lib/motion.ts,
+// lib/transitions.ts, lib/speed.ts, lib/grade.ts), so a translated scene renders
+// the same frames; scripts/certify-engine-parity.mjs measures that claim.
+
+/// A span of the song with its intensity, 0 (calm) to 1 (hottest).
+public struct EnergySection: Codable, Equatable, Sendable {
+    public var start: Double
+    public var end: Double
+    public var energy: Double
+    public init(start: Double, end: Double, energy: Double) { self.start = start; self.end = end; self.energy = energy }
+}
+
+/// The song's timing: beats, accented beats (downbeats) and energy sections, all in
+/// sequence seconds. Drives punch, the look's beat pulse and section intensity.
+public struct SequenceRhythm: Codable, Equatable, Sendable {
+    public var beats: [Double]
+    /// A subset of `beats` that hit harder.
+    public var accents: [Double]
+    /// Sorted by start. Empty means every section is full intensity.
+    public var sections: [EnergySection]
+    public init(beats: [Double], accents: [Double] = [], sections: [EnergySection] = []) { self.beats = beats; self.accents = accents; self.sections = sections }
+
+    public func validate() throws {
+        func sorted(_ list: [Double], _ what: String) throws {
+            guard list.count <= 100_000, list.allSatisfy({ $0.isFinite && $0 >= 0 && $0 <= 86400 }), zip(list, list.dropFirst()).allSatisfy({ $0 <= $1 }) else {
+                throw ProjectError.invalid("Rhythm \(what) must be sorted, finite times (at most 100,000).")
+            }
+        }
+        try sorted(beats, "beats"); try sorted(accents, "accents")
+        guard sections.count <= 10_000, sections.allSatisfy({ [$0.start, $0.end, $0.energy].allSatisfy(\.isFinite) }),
+              zip(sections, sections.dropFirst()).allSatisfy({ $0.start <= $1.start }) else { throw ProjectError.invalid("Energy sections must be finite and sorted by start.") }
+    }
+
+    /// Section intensity at `time`, clamped to 0...1; nil when there are no sections.
+    public func energy(at time: Double) -> Double? {
+        guard let first = sections.first, let last = sections.last else { return nil }
+        let value = time < first.start ? first.energy : sections.first(where: { time >= $0.start && time < $0.end })?.energy ?? last.energy
+        return min(1, max(0, value))
+    }
+
+    /// Strength of the most recent beat at `time`: 0 at rest, 1 at a plain beat's
+    /// peak, `accentBoost` at an accented beat's peak.
+    public func envelope(at time: Double, _ shape: BeatEnvelope) -> Double {
+        guard let index = Self.lastIndex(beats, atOrBefore: time) else { return 0 }
+        let beat = beats[index], value = shape.value(elapsed: time - beat)
+        guard value > 0 else { return 0 }
+        let accented = Self.lastIndex(accents, atOrBefore: beat + 1e-4).map { abs(accents[$0] - beat) < 1e-3 } ?? false
+        return value * (accented ? shape.accentBoost : 1)
+    }
+
+    static func lastIndex(_ times: [Double], atOrBefore time: Double) -> Int? {
+        var low = 0, high = times.count - 1, found: Int?
+        while low <= high {
+            let mid = (low + high) / 2
+            if times[mid] <= time { found = mid; low = mid + 1 } else { high = mid - 1 }
+        }
+        return found
+    }
+}
+
+/// How one beat hit rises and settles: a linear attack, then an exponential decay.
+public struct BeatEnvelope: Codable, Equatable, Sendable {
+    public var attack: Double
+    public var decay: Double
+    public var accentBoost: Double
+    public init(attack: Double, decay: Double, accentBoost: Double) { self.attack = attack; self.decay = decay; self.accentBoost = accentBoost }
+    public func value(elapsed: Double) -> Double {
+        if elapsed < 0 { return 0 }
+        if attack > 0 && elapsed < attack { return elapsed / attack }
+        return exp(-(elapsed - max(0, attack)) / max(1e-3, decay))
+    }
+    func validate() throws {
+        guard attack.isFinite, decay.isFinite, accentBoost.isFinite, (0...1).contains(attack), (0...5).contains(decay), (0...5).contains(accentBoost) else {
+            throw ProjectError.invalid("Beat envelope values are out of range.")
+        }
+    }
+}
+
+/// A zoom kick on every beat, applied to clips on tracks that follow the beat. Its
+/// size scales with section energy (0.4× in the calmest passage up to 1.25×).
+public struct BeatPunch: Codable, Equatable, Sendable {
+    /// Extra zoom at a plain beat's peak, as a fraction (0.06 = +6%).
+    public var amount: Double
+    public var envelope: BeatEnvelope
+    public init(amount: Double, envelope: BeatEnvelope) { self.amount = amount; self.envelope = envelope }
+    public func scale(at time: Double, rhythm: SequenceRhythm) -> Double {
+        let size = amount * (rhythm.energy(at: time).map { 0.4 + 0.85 * $0 } ?? 1)
+        guard !rhythm.beats.isEmpty, size > 0 else { return 1 }
+        return 1 + size * rhythm.envelope(at: time, envelope)
+    }
+    func validate() throws {
+        try envelope.validate()
+        guard amount.isFinite, (0...1).contains(amount) else { throw ProjectError.invalid("Beat punch amount must be between 0 and 1.") }
+    }
+}
+
+/// What plays into a clip at its first frame. Zoom starts 18% in and settles to rest.
+public struct CutTransition: Codable, Equatable, Sendable {
+    public enum Kind: String, Codable, Sendable { case zoom }
+    public var kind: Kind
+    public var duration: Double
+    public init(kind: Kind, duration: Double) { self.kind = kind; self.duration = duration }
+    /// Extra zoom `elapsed` seconds after the clip starts.
+    public func scale(elapsed: Double) -> Double {
+        guard duration > 0, elapsed >= 0, elapsed < duration else { return 1 }
+        let remaining = 1 - elapsed / duration
+        return 1 + remaining * remaining * 0.18
+    }
+    func validate() throws {
+        guard duration.isFinite, duration > 0, duration <= 2 else { throw ProjectError.invalid("Transition duration must be between 0 and 2 seconds.") }
+    }
+}
+
+/// A one-shot slow motion into `end`: across [start, end] (sequence seconds) the
+/// source runs ahead, then decelerates to a standstill exactly at `end`, where it is
+/// back in sync. Identity outside the window.
+public struct SpeedRamp: Codable, Equatable, Sendable {
+    public var start: Double
+    public var end: Double
+    /// 1 is no warp; higher bends harder.
+    public var strength: Double
+    public init(start: Double, end: Double, strength: Double) { self.start = start; self.end = end; self.strength = strength }
+    public func warp(_ time: Double) -> Double {
+        guard time > start, time < end else { return time }
+        let span = end - start, progress = (time - start) / span
+        return start + (1 - pow(1 - progress, max(1e-3, strength))) * span
+    }
+    func validate() throws {
+        guard start.isFinite, end.isFinite, strength.isFinite, start >= -86400, end <= 86400, end > start, (0.001...20).contains(strength) else {
+            throw ProjectError.invalid("Invalid speed ramp window or strength.")
+        }
+    }
+}
+
+/// A film look applied to the finished frame, on display-encoded (sRGB) values.
+public struct SequenceLook: Codable, Equatable, Sendable {
+    public var exposure = 1.0, contrast = 1.0, saturation = 1.0
+    /// Warm (+) / cool (−) and magenta (+) / green (−), each −1...1.
+    public var temperature = 0.0, tint = 0.0
+    public var bloom = 0.0, aberration = 0.0, vignette = 0.0, grain = 0.0, streak = 0.0
+    /// Kaleidoscope fold: 0 off, 1 horizontal, 2 vertical, 3 both.
+    public var mirror = 0
+    /// When set, bloom, aberration and exposure pulse with this beat envelope.
+    public var pulse: BeatEnvelope?
+    public init() {}
+
+    /// Strength follows section energy: calm passages ease toward neutral (0.55×),
+    /// the hottest push past full (1.25×).
+    public func at(energy: Double) -> SequenceLook {
+        let strength = 0.55 + 0.7 * min(1, max(0, energy))
+        func mul(_ v: Double) -> Double { max(0, 1 + (v - 1) * strength) }
+        func add(_ v: Double, _ upper: Double) -> Double { min(upper, max(0, v * strength)) }
+        var l = self
+        l.exposure = mul(exposure); l.contrast = mul(contrast); l.saturation = mul(saturation)
+        l.temperature = min(1, max(-1, temperature * strength)); l.tint = min(1, max(-1, tint * strength))
+        l.bloom = add(bloom, 3); l.aberration = add(aberration, 0.05); l.vignette = add(vignette, 1); l.grain = add(grain, 1)
+        l.streak = max(0, streak * strength)
+        return l
+    }
+    func validate() throws {
+        let values = [exposure, contrast, saturation, temperature, tint, bloom, aberration, vignette, grain, streak]
+        guard values.allSatisfy(\.isFinite), (0...10).contains(exposure), (0...10).contains(contrast), (0...10).contains(saturation),
+              (-1...1).contains(temperature), (-1...1).contains(tint), (0...3).contains(bloom), (0...0.05).contains(aberration),
+              (0...1).contains(vignette), (0...1).contains(grain), (0...10).contains(streak), (0...3).contains(mirror) else {
+            throw ProjectError.invalid("Sequence look values are out of range.")
+        }
+        try pulse?.validate()
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/SourceEditing.swift b/native-macos/Sources/ScenePilotCore/SourceEditing.swift
new file mode 100644
index 0000000000000000000000000000000000000000..501522c07c941a4f051202d1e417949682774508
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/SourceEditing.swift
@@ -0,0 +1,71 @@
+import Foundation
+
+/// Out is exclusive. Marks live in source seconds; edits quantize duration to the destination frame grid.
+public struct SourceRange: Equatable {
+    public var start: Double
+    public var end: Double
+    public init(start: Double = 0, end: Double) { self.start = start; self.end = end }
+    public func validate(duration: Double, frameRate: Int) throws {
+        guard start.isFinite, end.isFinite, duration.isFinite, frameRate > 0,
+              start >= 0, end <= duration + 0.000001, end - start >= 1 / Double(frameRate) - 0.000001 else {
+            throw ProjectError.invalid("Source Out must follow In by at least one sequence frame and stay inside the media.")
+        }
+    }
+}
+
+public enum SourceEditMode { case insert, overwrite }
+
+extension Edit {
+    /// Explicitly track-local: other tracks do not ripple. Never silently break a matte dependency.
+    public static func placeSource(_ project: Project, sequenceId: String, assetId: String,
+                                   trackId: String, range: SourceRange, at time: Double,
+                                   mode: SourceEditMode, clipId: String = UUID().uuidString) throws -> Project {
+        guard let media = project.media.first(where: { $0.id == assetId }) else { throw ProjectError.invalid("Source media is no longer in this project.") }
+        return try transact(project, sequenceId: sequenceId) { sequence in
+            guard sequence.tracks.contains(where: { $0.id == trackId && !$0.locked }), time.isFinite, time >= 0 else {
+                throw ProjectError.invalid("Choose an unlocked destination track and a valid edit time.")
+            }
+            try range.validate(duration: media.duration, frameRate: sequence.frameRate)
+            let fps = Double(sequence.frameRate)
+            let start = (time * fps).rounded() / fps
+            let duration = floor((range.end - range.start) * fps + 0.000001) / fps
+            let end = start + duration
+            let providers = Set(sequence.videoClips.compactMap { $0.matte?.sourceClipId })
+            var result: [Clip] = []
+            func portion(_ original: Clip, from: Double, to: Double, id: String) throws -> Clip {
+                guard to - from >= 1 / fps - 0.000001 else { throw ProjectError.invalid("This edit would leave a sub-frame fragment. Align the existing clip edges first.") }
+                var clip = original
+                let offset = from - original.start
+                clip.id = id; clip.start = from; clip.duration = to - from
+                clip.sourceStart += offset * clip.rate
+                clip.motion?.offset += offset; clip.maskAnimation?.offset += offset
+                let fade = clip.fadeWindow ?? FadeWindow(offset: 0, duration: original.duration)
+                clip.fadeWindow = FadeWindow(offset: fade.offset + offset, duration: fade.duration)
+                return clip
+            }
+            for clip in sequence.videoClips {
+                guard clip.trackId == trackId else { result.append(clip); continue }
+                let tail = clip.start + clip.duration
+                let affected = mode == .insert ? tail > start + 0.000001 : tail > start + 0.000001 && clip.start < end - 0.000001
+                guard affected else { result.append(clip); continue }
+                guard clip.matte == nil, !providers.contains(clip.id) else {
+                    throw ProjectError.invalid("This edit affects a linked matte. Edit inside its composition or remove the matte link first.")
+                }
+                if mode == .insert {
+                    if clip.start >= start - 0.000001 { var shifted = clip; shifted.start += duration; result.append(shifted) }
+                    else {
+                        result.append(try portion(clip, from: clip.start, to: start, id: clip.id))
+                        var right = try portion(clip, from: start, to: tail, id: UUID().uuidString)
+                        right.start += duration; result.append(right)
+                    }
+                } else {
+                    if clip.start < start - 0.000001 { result.append(try portion(clip, from: clip.start, to: start, id: clip.id)) }
+                    if tail > end + 0.000001 { result.append(try portion(clip, from: end, to: tail, id: clip.start < start ? UUID().uuidString : clip.id)) }
+                }
+            }
+            var placed = Clip(assetId: assetId, trackId: trackId, start: start, duration: duration, id: clipId)
+            placed.sourceStart = range.start
+            result.append(placed); sequence.videoClips = result
+        }
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/TimelineEditing.swift b/native-macos/Sources/ScenePilotCore/TimelineEditing.swift
new file mode 100644
index 0000000000000000000000000000000000000000..af1c5e92d15f9a4802f6675ed15d199966509726
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/TimelineEditing.swift
@@ -0,0 +1,73 @@
+import Foundation
+
+public enum TrimEdge { case head, tail }
+
+extension Edit {
+    /// Non-ripple trim: the opposite edge and source-to-timeline mapping stay fixed.
+    public static func trim(_ project: Project, sequenceId: String, clipId: String, edge: TrimEdge, to time: Double) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let index = try editableClip(sequence, clipId)
+            var clip = sequence.videoClips[index]
+            guard time.isFinite else { throw ProjectError.invalid("Trim time must be finite.") }
+            let target = (time * Double(sequence.frameRate)).rounded() / Double(sequence.frameRate)
+            if edge == .head {
+                let delta = target - clip.start
+                clip.start = target; clip.sourceStart += delta * clip.rate; clip.duration -= delta
+                clip.motion?.offset += delta
+                clip.maskAnimation?.offset += delta
+            } else { clip.duration = target - clip.start }
+            // Explicit trim adjusts edge-relative fades; split preserves their envelope.
+            clip.fadeWindow = nil
+            guard clip.duration > 0 else { throw ProjectError.invalid("Keep at least one frame in the clip.") }
+            clip.fadeIn = min(clip.fadeIn, clip.duration)
+            clip.fadeOut = min(clip.fadeOut, clip.duration - clip.fadeIn)
+            sequence.videoClips[index] = clip
+        }
+    }
+    public static func slip(_ project: Project, sequenceId: String, clipId: String, by frames: Int) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let index = try editableClip(sequence, clipId)
+            sequence.videoClips[index].sourceStart += Double(frames) / Double(sequence.frameRate) * sequence.videoClips[index].rate
+        }
+    }
+    public static func duplicate(_ project: Project, sequenceId: String, clipId: String) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let index = try editableClip(sequence, clipId)
+            var copy = sequence.videoClips[index]
+            copy.id = UUID().uuidString; copy.start += copy.duration
+            guard !sequence.videoClips.contains(where: { $0.trackId == copy.trackId && $0.start < copy.start + copy.duration - 0.00001 && $0.start + $0.duration > copy.start + 0.00001 }) else {
+                throw ProjectError.invalid("There is not enough empty space after this clip to duplicate it.")
+            }
+            sequence.videoClips.insert(copy, at: index + 1)
+        }
+    }
+    /// Track-local ripple. Refuse overlaps rather than shifting unrelated layers.
+    public static func rippleDelete(_ project: Project, sequenceId: String, clipId: String) throws -> Project {
+        try transact(project, sequenceId: sequenceId) { sequence in
+            let index = try editableClip(sequence, clipId), clip = sequence.videoClips[index]
+            guard !sequence.videoClips.contains(where: { $0.id != clip.id && $0.trackId == clip.trackId && $0.start < clip.start + clip.duration - 0.00001 && $0.start + $0.duration > clip.start + 0.00001 }) else {
+                throw ProjectError.invalid("Ripple delete requires a non-overlapping clip on this track.")
+            }
+            sequence.videoClips.remove(at: index)
+            for i in sequence.videoClips.indices where sequence.videoClips[i].trackId == clip.trackId && sequence.videoClips[i].start >= clip.start + clip.duration - 0.00001 {
+                sequence.videoClips[i].start -= clip.duration
+            }
+        }
+    }
+    static func editableClip(_ sequence: Sequence, _ id: String) throws -> Int {
+        guard let i = sequence.videoClips.firstIndex(where: { $0.id == id }),
+              sequence.tracks.contains(where: { $0.id == sequence.videoClips[i].trackId && !$0.locked }) else { throw ProjectError.invalid("Select an unlocked clip.") }
+        return i
+    }
+}
+
+public enum TimelineSnap {
+    /// Deterministic nearest edge; includes either end of the moving clip.
+    public static func start(_ proposed: Double, duration: Double, anchors: [Double], tolerance: Double, frameRate: Int) -> Double {
+        guard proposed.isFinite, duration.isFinite, frameRate > 0 else { return 0 }
+        let rounded = max(0, (proposed * Double(frameRate)).rounded() / Double(frameRate))
+        let candidates = anchors.filter(\.isFinite).flatMap { [$0, $0 - duration] }.filter { $0 >= 0 && abs($0 - rounded) <= tolerance }
+        let chosen = candidates.min { a, b in abs(a - rounded) == abs(b - rounded) ? a < b : abs(a - rounded) < abs(b - rounded) } ?? rounded
+        return max(0, (chosen * Double(frameRate)).rounded() / Double(frameRate))
+    }
+}
diff --git a/native-macos/Sources/ScenePilotCore/WorkspaceLayout.swift b/native-macos/Sources/ScenePilotCore/WorkspaceLayout.swift
new file mode 100644
index 0000000000000000000000000000000000000000..001f35d301c44ec32bb88b5528c0bbd12a2ff2fc
--- /dev/null
+++ b/native-macos/Sources/ScenePilotCore/WorkspaceLayout.swift
@@ -0,0 +1,26 @@
+import Foundation
+
+public struct WorkspaceLayout: Codable, Equatable {
+    public var version = 1
+    public var mediaWidth = 240.0
+    public var inspectorWidth = 278.0
+    public var upperFraction = 0.64
+    public init() {}
+    public static func restore(_ data: Data?) -> WorkspaceLayout {
+        guard let data, let value = try? JSONDecoder().decode(Self.self, from: data), value.version == 1,
+              [value.mediaWidth,value.inspectorWidth,value.upperFraction].allSatisfy(\.isFinite) else { return Self() }
+        var repaired = value
+        repaired.mediaWidth = max(218, min(400, value.mediaWidth))
+        repaired.inspectorWidth = max(264, min(290, value.inspectorWidth))
+        repaired.upperFraction = max(0.35, min(0.8, value.upperFraction))
+        return repaired
+    }
+    public func positions(width: Double, height: Double) -> (left: Double, right: Double, top: Double) {
+        let width = width.isFinite ? max(800, width) : 1000
+        let height = height.isFinite ? max(530, height) : 700
+        let inspector = max(264, min(290, inspectorWidth))
+        let left = max(218, min(400, min(mediaWidth, width - inspector - 310)))
+        let top = max(300, min(height - 230, height * max(0.35, min(0.8, upperFraction))))
+        return (left, width - inspector, top)
+    }
+}
diff --git a/native-macos/Sources/ScenePilotMedia/MediaEngine.swift b/native-macos/Sources/ScenePilotMedia/MediaEngine.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4eeb0134dfdcbb1b38684e839d8098e95a24b359
--- /dev/null
+++ b/native-macos/Sources/ScenePilotMedia/MediaEngine.swift
@@ -0,0 +1,238 @@
+import AVFoundation
+import ScenePilotCore
+
+public struct BuiltSequence {
+    public let composition: AVMutableComposition
+    public let videoComposition: AVMutableVideoComposition?
+    public let audioMix: AVMutableAudioMix
+    public let duration: Double
+    public func playerItem() -> AVPlayerItem {
+        let item = AVPlayerItem(asset: composition)
+        item.videoComposition = videoComposition; item.audioMix = audioMix; return item
+    }
+}
+
+public enum NativeMedia {
+    public static func inspect(_ url: URL) async throws -> Media {
+        guard url.isFileURL, FileManager.default.isReadableFile(atPath: url.path) else { throw ProjectError.invalid("Media is unavailable: \(url.lastPathComponent)") }
+        let asset = AVURLAsset(url: url)
+        let duration = try await asset.load(.duration).seconds
+        let videos = try await asset.loadTracks(withMediaType: .video)
+        let audio = try await asset.loadTracks(withMediaType: .audio)
+        guard duration.isFinite, duration > 0, !videos.isEmpty || !audio.isEmpty else { throw ProjectError.invalid("No supported audio or video stream in \(url.lastPathComponent).") }
+        return Media(path: url.path, duration: duration, hasVideo: !videos.isEmpty, hasAudio: !audio.isEmpty)
+    }
+
+    private struct Leaf {
+        let clip: Clip
+        let media: Media?
+        let children: [Int]
+        let matteOnly: Bool
+        let start: Double
+        let duration: Double
+        let sourceStart: Double
+        let rate: Double
+        let gain: Double
+        let audioEnvelopes: [AudioFadeEnvelope]
+        let originalStart: Double
+        let originalDuration: Double
+        let fadeIn: Double
+        let fadeOut: Double
+        let motionLocalStart: Double
+        let motionRate: Double
+        let followsBeat: Bool
+        /// Sequence time inside the clip's own sequence at root time `time`.
+        func local(_ time: Double) -> Double { clip.start + motionLocalStart + (time - start) * motionRate }
+    }
+    public static func build(_ project: Project, sequenceId: String) async throws -> BuiltSequence {
+        _ = try project.validated()
+        guard let sequence = project.sequences.first(where: { $0.id == sequenceId }), sequence.duration > 0 else { throw ProjectError.invalid("Add a clip to this sequence before playback or export.") }
