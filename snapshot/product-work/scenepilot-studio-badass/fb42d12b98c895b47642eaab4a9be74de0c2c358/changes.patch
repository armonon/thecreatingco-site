+
+// ---- Measure with one decoder ----
+async function frames(file) {
+  const { stdout } = await run(ffmpeg, ["-hide_banner", "-loglevel", "error", "-i", file, "-an", "-f", "rawvideo", "-pix_fmt", "rgb24", "pipe:1"], { encoding: "buffer", maxBuffer: 1_000_000_000 });
