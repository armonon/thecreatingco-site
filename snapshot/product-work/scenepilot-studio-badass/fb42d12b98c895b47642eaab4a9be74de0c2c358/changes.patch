diff --git a/scripts/pwa-upgrade-check.mjs b/scripts/pwa-upgrade-check.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a7a6df7a2701dca32a94315a91d5924389a8bb9c
--- /dev/null
+++ b/scripts/pwa-upgrade-check.mjs
@@ -0,0 +1,89 @@
+// Proves the opt-in update path: v1 worker installs and controls the page, a
+// new /sw.js is published at the same URL (as an overlay deploy would), the page
+// shows "Update available — reload", nothing switches until the user clicks, and
+// after the click the new worker controls the page. Also proves migration from
+// the old live worker (scenepilot-standalone-v3, scope /app/).
+//   node scripts/pwa-upgrade-check.mjs   (needs a built site/: npm run build:site)
+import { createServer } from "node:http";
+import { existsSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+import { chromium } from "playwright";
+
+const root = path.resolve(import.meta.dirname, "..", "site");
+const chrome = process.env.CHROME ?? "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
+const TYPES = { ".html": "text/html; charset=utf-8", ".js": "text/javascript", ".css": "text/css", ".json": "application/json", ".webmanifest": "application/manifest+json", ".png": "image/png", ".wasm": "application/wasm" };
+const current = readFileSync(path.join(root, "sw.js"), "utf8");
+// The worker that is live before wave 4 (auto-activating, /app/ scope).
+const legacy = `const CACHE_NAME = "scenepilot-standalone-v3";
+self.addEventListener("install", (event) => event.waitUntil(caches.open(CACHE_NAME).then((cache) => cache.add("/app/")).then(() => self.skipWaiting())));
+self.addEventListener("activate", (event) => event.waitUntil(self.clients.claim()));
+self.addEventListener("fetch", (event) => { if (new URL(event.request.url).pathname.startsWith("/app/")) event.respondWith(fetch(event.request).catch(() => caches.match("/app/"))); });`;
+let swBody = legacy;
+const server = createServer((request, response) => {
+  const pathname = decodeURIComponent(new URL(request.url, "http://x").pathname);
+  if (pathname === "/sw.js") { response.writeHead(200, { "content-type": "text/javascript", "cache-control": "no-cache" }); response.end(swBody); return; }
+  let file = path.join(root, pathname);
+  if (existsSync(file) && statSync(file).isDirectory()) file = path.join(file, "index.html");
+  if (!existsSync(file)) { response.writeHead(404).end(); return; }
+  response.writeHead(200, { "content-type": TYPES[path.extname(file)] ?? "application/octet-stream", "cache-control": "no-cache" });
+  response.end(readFileSync(file));
+});
+await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+const origin = `http://127.0.0.1:${server.address().port}`;
+const results = [];
+const check = (name, ok, detail = "") => { results.push(ok); console.log(`${ok ? "PASS" : "FAIL"}  ${name}${detail ? ` — ${detail}` : ""}`); };
+const browser = await chromium.launch({ executablePath: chrome, headless: true });
+const page = await browser.newPage();
+const errors = [];
+page.on("pageerror", (error) => errors.push(error.message));
+try {
+  // 0. A returning visitor controlled by the old /app/-scoped worker.
+  await page.goto(`${origin}/tools/`, { waitUntil: "load" });
+  await page.evaluate(async () => {
+    const registration = await navigator.serviceWorker.register("/sw.js", { scope: "/app/" });
+    const worker = registration.installing || registration.waiting || registration.active;
+    if (worker && worker.state !== "activated") await new Promise((resolve) => worker.addEventListener("statechange", () => worker.state === "activated" && resolve(undefined)));
+  });
+  await page.goto(`${origin}/app/`, { waitUntil: "load" });
+  console.log("  legacy:", JSON.stringify(await page.evaluate(async () => (await navigator.serviceWorker.getRegistrations()).map((r) => [r.scope, r.active?.state]))));
+  await page.waitForFunction(() => Boolean(navigator.serviceWorker.controller), undefined, { timeout: 20000 });
+  check("legacy /app/ worker controls the page", true);
+
+  // 1. New build is deployed: the page migrates to the single / worker.
+  swBody = current;
+  await page.goto(`${origin}/app/?pwa`, { waitUntil: "load" });
+  await page.waitForFunction(async () => {
+    const registrations = await navigator.serviceWorker.getRegistrations();
+    return registrations.length === 1 && new URL(registrations[0].scope).pathname === "/" && registrations[0].active;
+  }, undefined, { timeout: 30000, polling: 500 });
+  await page.reload({ waitUntil: "load" });
+  const scope = await page.evaluate(async () => (await navigator.serviceWorker.getRegistration())?.scope);
+  const caches1 = await page.evaluate(() => caches.keys());
+  check("migrated to one worker at scope /, legacy cache dropped", scope === `${origin}/` && !caches1.includes("scenepilot-standalone-v3"), `${scope} · ${caches1.join(", ")}`);
+
+  // 2. Another deploy: same URL, new bytes. No silent swap; the toast appears.
+  swBody = current.replace(/const BUILD_ID = "([^"]+)";/, 'const BUILD_ID = "$1-next";');
+  await page.waitForFunction(() => Boolean(navigator.serviceWorker.controller), undefined, { timeout: 20000 });
+  const before = await page.evaluate(() => navigator.serviceWorker.controller?.scriptURL);
+  await page.evaluate(async () => (await navigator.serviceWorker.getRegistration())?.update());
+  const toast = await page.waitForSelector('[data-pwa="update"]', { timeout: 30000 }).then(() => true).catch(() => false);
+  check("update toast appears", toast);
+  await page.waitForTimeout(2000);
+  const stillOld = await page.evaluate(async () => {
+    const registration = await navigator.serviceWorker.getRegistration();
+    return Boolean(registration?.waiting) && navigator.serviceWorker.controller?.state === "activated";
+  });
+  const detail = await page.evaluate(async () => { const r = await navigator.serviceWorker.getRegistration(); return JSON.stringify({ waiting: r?.waiting?.state, active: r?.active?.state, installing: r?.installing?.state, controller: navigator.serviceWorker.controller?.state }); });
+  check("new worker waits (no silent takeover)", stillOld && Boolean(before), detail);
+  await Promise.all([page.waitForNavigation({ timeout: 30000 }), page.getByRole("button", { name: "Update available — reload" }).click()]);
+  await page.waitForFunction(() => Boolean(navigator.serviceWorker.controller), undefined, { timeout: 20000 });
+  const caches2 = await page.evaluate(() => caches.keys());
+  const waiting = await page.evaluate(async () => Boolean((await navigator.serviceWorker.getRegistration())?.waiting));
+  check("after the click the new version controls the page", !waiting && caches2.some((key) => key.endsWith("-next")), caches2.join(", "));
+  check("no page errors", errors.length === 0, errors.slice(0, 3).join(" | "));
+} finally {
+  await browser.close();
+  server.close();
+  console.log(`\n${results.filter(Boolean).length}/${results.length} checks passed`);
+  process.exitCode = results.every(Boolean) ? 0 : 1;
+}
diff --git a/scripts/qualification-process.mjs b/scripts/qualification-process.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e0efb6311358205bf69ddedba2403b78105aaa21
--- /dev/null
+++ b/scripts/qualification-process.mjs
@@ -0,0 +1,26 @@
+import { spawn } from "node:child_process";
+
+/** A timed-out npm parent must not strand its compiler/encoder and pipe handles. */
+export function runQualificationCommand(command, args, { cwd, timeoutMs = 20 * 60_000, env = process.env } = {}) {
+  return new Promise((resolve) => {
+    const started = Date.now(), stdout = [], stderr = [];
+    const grouped = process.platform !== "win32";
+    const child = spawn(command, args, { cwd, env, detached: grouped, windowsHide: true, stdio: ["ignore", "pipe", "pipe"] });
+    let finished = false;
+    const finish = (exitCode, signal, detail = "") => {
+      if (finished) return;
+      finished = true;
+      clearTimeout(timer);
+      resolve({ exitCode, signal, elapsedMs: Date.now() - started, stdout: Buffer.concat(stdout).toString("utf8"), stderr: Buffer.concat(stderr).toString("utf8") + detail });
+    };
+    const timer = setTimeout(() => {
+      try { if (grouped && child.pid) process.kill(-child.pid, "SIGKILL"); else child.kill("SIGKILL"); } catch { /* Already exited. */ }
+      child.stdout.destroy(); child.stderr.destroy(); child.unref();
+      finish(null, "SIGKILL", `\nQualification command exceeded ${timeoutMs}ms and was terminated. This is not a passing result.\n`);
+    }, timeoutMs);
+    child.stdout.on("data", (chunk) => stdout.push(chunk));
+    child.stderr.on("data", (chunk) => stderr.push(chunk));
+    child.once("error", (error) => finish(null, null, error.message));
+    child.once("close", (code, signal) => finish(code, signal));
+  });
+}
diff --git a/scripts/release-evidence.mjs b/scripts/release-evidence.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..992b00ed90fd8913b49b1d09c0d38887103df7ef
--- /dev/null
+++ b/scripts/release-evidence.mjs
@@ -0,0 +1,51 @@
+import { createHash } from "node:crypto";
+import { execFileSync } from "node:child_process";
+import { readFile, stat, realpath } from "node:fs/promises";
+import path from "node:path";
+
+/** Exclude human review/docs so committing a completed review does not change
+ * the reviewed program. Include tracked runtime, lockfiles and build scripts. */
+export async function releaseSourceDigest(root) {
+  const tracked = execFileSync("git", ["ls-files", "-z", "--cached", "--others", "--exclude-standard"], { cwd: root, encoding: "utf8" });
+  const files = [...new Set(tracked.split("\0").filter(Boolean))].filter((file) => !file.startsWith("docs/") && !file.endsWith(".md")).sort();
+  const digest = createHash("sha256");
+  for (const file of files) {
+    let bytes;
+    try { bytes = await readFile(path.join(root, file)); }
+    catch (error) {
+      // Rebuilds remove old, tracked hashed assets before a release commit.
+      // Bind their absence into the candidate identity instead of crashing or
+      // silently ignoring deletions. Other I/O failures must still fail closed.
+      if (error.code !== "ENOENT") throw error;
+      digest.update(`${file}\0missing\0`);
+      continue;
+    }
+    digest.update(`${file}\0${bytes.length}\0`).update(bytes);
+  }
+  return digest.digest("hex");
+}
+
+export async function verifyReviewEvidence(submission, { sourceSha256, baseDirectory }) {
+  const issues = [];
+  if (!submission || submission.appSourceSha256 !== sourceSha256) issues.push("Review must name the exact candidate appSourceSha256.");
+  if (!submission || typeof submission.reviewer !== "string" || !submission.reviewer.trim()) issues.push("A named reviewer is required.");
+  if (!Array.isArray(submission?.responses)) return [...issues, "Review responses are missing."];
+  const ids = new Set();
+  for (const response of submission.responses) {
+    if (!response || typeof response.taskId !== "string" || ids.has(response.taskId)) { issues.push("Review task IDs must be unique strings."); continue; }
+    ids.add(response.taskId);
+    if (!Array.isArray(response.evidence) || !response.evidence.length) { issues.push(`${response.taskId}: evidence is missing.`); continue; }
+    for (const relative of response.evidence) {
+      if (typeof relative !== "string" || !relative.trim() || path.isAbsolute(relative)) { issues.push(`${response.taskId}: evidence must be a relative file path.`); continue; }
+      const file = path.resolve(baseDirectory, relative);
+      if (!file.startsWith(`${path.resolve(baseDirectory)}${path.sep}`)) { issues.push(`${response.taskId}: evidence must stay inside the review folder.`); continue; }
+      try {
+        const actual = await realpath(file);
+        if (!actual.startsWith(`${await realpath(baseDirectory)}${path.sep}`)) { issues.push(`${response.taskId}: evidence symlink leaves the review folder.`); continue; }
+        const info = await stat(file); if (!info.isFile() || !info.size) issues.push(`${response.taskId}: evidence is empty or not a file.`);
+      }
+      catch { issues.push(`${response.taskId}: evidence file is unavailable: ${relative}`); }
+    }
+  }
+  return issues;
+}
diff --git a/scripts/render-marketing-effects-electron.mjs b/scripts/render-marketing-effects-electron.mjs
