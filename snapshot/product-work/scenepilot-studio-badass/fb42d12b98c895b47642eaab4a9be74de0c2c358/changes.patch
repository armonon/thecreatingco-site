+import { StrictMode, useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { createRoot } from "react-dom/client";
+import { ArrowUpRight, Download, FileJson, Loader2, Pause, Play, Plus, Trash2, Upload } from "lucide-react";
+import { CURRENT_CUT_FILE_VERSION, CUT_FILE_FORMAT, DEFAULT_EFFECTS } from "../../../lib/project-store.ts";
+import { applyManualOverrides, buildCameraPath, type PathPoint, type SubjectTarget } from "../../../lib/reframe-path.ts";
+import { REFRAME_ASPECT_IDS, type ReframeAspectId } from "../../../lib/reframe-crop.ts";
+import { ToolShell, baseName, downloadFile } from "../shell.tsx";
+import { analyzeVideo } from "./analyze.ts";
+import { createFaceFinder, type FaceFinder } from "../autocut/faces.ts";
+import { ReframePlayer, type LetterboxSegment } from "./player.ts";
+import { pathToJson, renderReframe, type RenderResult } from "./render.ts";
+import { ReframeTimeline } from "./timeline.tsx";
+import "../tools.css";
+
+const LIMITS = [
+  "Subject tracking is per-frame, not real tracking: it re-detects faces on each sampled frame (about 6/s) and falls back to a simple motion-saliency centroid when no face is found. A subject that moves fast between samples, turns away, or is small/backlit can be lost; the camera then drifts toward whatever has the most frame-to-frame motion instead.",
+  "Face detection reuses AutoCut's self-hosted BlazeFace (Google, Apache-2.0) — the same model, same on-device run, same graceful “no faces” fallback if it can't load.",
+  "Multiple-subject mode keeps the two most prominent faces together only when they both fit inside the crop at the current aspect; with three or more faces it only ever considers the two largest, and a third subject can be left out of frame entirely.",
+  "Scene-cut detection is the same histogram/motion-spike heuristic AutoCut uses for clip analysis — tuned for hard cuts, not whip pans, dissolves, or flashes, any of which can be misread as a cut (snapping the crop) or missed (causing a pan across a real cut).",
+  "The camera path only ever pans and re-centres; it never zooms. A subject that moves toward or away from the camera can still leave a tight crop.",
+  "Manual keyframe overrides are pins at a point in time, not editable curves — drag a dot to move the crop there, double-click to remove it. There's no keyframe easing control beyond the global dead zone / speed settings.",
+  "Letterbox ranges are entered as start/end times, not drawn on the timeline by dragging a selection.",
+  "Video export uses WebCodecs when this browser can encode it (MP4 H.264/AAC, otherwise WebM); without a WebCodecs encoder it falls back to a real-time MediaRecorder capture (WebM only, takes as long as the clip, and the tab must stay visible).",
+  "“Open in AutoCut” / “Open in editor” just open that tool in a new tab — they don't carry the file over automatically. Drop the exported clip in yourself (editor hand-off also downloads a .scenepilot.json; use New project with this clip as the main media, then Import cut).",
+  "Alpha: tested so far on short, ffmpeg-generated synthetic clips (a moving bright square, a synthetic face image), not on a broad range of real footage.",
+];
+
+const fmt = (seconds: number) => `${Math.floor(seconds / 60)}:${(seconds % 60).toFixed(1).padStart(4, "0")}`;
+
+function reframeToCutFile(options: { name: string; duration: number; exportName: string }) {
+  return {
+    format: CUT_FILE_FORMAT,
+    version: CURRENT_CUT_FILE_VERSION,
+    project: options.name || "Reframe",
+    duration: Math.max(1, options.duration),
+    bpm: 120,
+    beatOffset: 0,
+    beats: [] as number[],
+    sections: [] as unknown[],
+    videoClips: [] as unknown[],
+    placements: [] as unknown[],
+    compositions: [] as unknown[],
+    tracks: [] as unknown[],
+    baseCuts: [] as unknown[],
+    titles: [] as unknown[],
+    assets: [] as unknown[],
+    effects: DEFAULT_EFFECTS,
+    mainAsset: { name: options.exportName, kind: "video" as const },
+    savedAt: Date.now(),
+  };
+}
+
+function ReframeApp() {
+  const [file, setFile] = useState<File | null>(null);
+  const [aspect, setAspect] = useState<ReframeAspectId>("9:16");
+  const [useFaces, setUseFaces] = useState(true);
+  const [deadZone, setDeadZone] = useState(0.08);
+  const [maxPanSpeed, setMaxPanSpeed] = useState(0.6);
+  const [ease, setEase] = useState(0.35);
+  const [analyzing, setAnalyzing] = useState(false);
+  const [analyzeProgress, setAnalyzeProgress] = useState(0);
+  const [autoTargets, setAutoTargets] = useState<SubjectTarget[]>([]);
+  const [cutTimes, setCutTimes] = useState<number[]>([]);
+  const [overrides, setOverrides] = useState<SubjectTarget[]>([]);
+  const [letterboxSegments, setLetterboxSegments] = useState<LetterboxSegment[]>([]);
+  const [duration, setDuration] = useState(0);
+  const [time, setTime] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const [status, setStatus] = useState({ text: "Drop a horizontal video to start.", error: false });
+  const [rendering, setRendering] = useState<{ fraction: number; message: string } | null>(null);
+  const [result, setResult] = useState<(RenderResult & { url: string; name: string }) | null>(null);
+  const [usedFaces, setUsedFaces] = useState(false);
+
+  const sourceCanvasRef = useRef<HTMLCanvasElement | null>(null);
+  const outputCanvasRef = useRef<HTMLCanvasElement | null>(null);
+  const playerRef = useRef<ReframePlayer | null>(null);
+  const faceFinderRef = useRef<Promise<FaceFinder | null> | null>(null);
+  const fileInput = useRef<HTMLInputElement | null>(null);
+
+  // One PathPoint path combines the automatic targets (smoothed) with manual pins.
+  const path: PathPoint[] = useMemo(() => {
+    if (!autoTargets.length) return [];
+    const base = buildCameraPath(autoTargets, { deadZone, maxPanSpeed, ease, cutTimes });
+    return applyManualOverrides(base, overrides);
+  }, [autoTargets, cutTimes, overrides, deadZone, maxPanSpeed, ease]);
+
+  useEffect(() => {
+    if (!sourceCanvasRef.current || !outputCanvasRef.current) return;
+    const player = new ReframePlayer(sourceCanvasRef.current, outputCanvasRef.current);
+    player.onTime = setTime;
+    player.onEnded = () => setPlaying(false);
+    playerRef.current = player;
+    return () => player.dispose();
+  }, []);
+
+  useEffect(() => {
+    const player = playerRef.current;
+    if (!player) return;
+    player.path = path;
+    player.aspect = aspect;
+    player.letterboxSegments = letterboxSegments;
+    void player.drawStill();
+  }, [path, aspect, letterboxSegments]);
+
+  const getFaceFinder = useCallback(async (): Promise<FaceFinder | null> => {
+    if (!useFaces) return null;
+    faceFinderRef.current ??= createFaceFinder().catch((error) => {
+      console.warn("Face model unavailable, falling back to motion saliency.", error);
+      return null;
+    });
+    return faceFinderRef.current;
+  }, [useFaces]);
+
+  const loadFile = useCallback(async (incoming: File) => {
+    setFile(incoming);
+    setResult(null);
+    setOverrides([]);
+    setLetterboxSegments([]);
+    setStatus({ text: `Loaded ${incoming.name}. Analysing…`, error: false });
+    const player = playerRef.current;
+    if (player) await player.load(incoming).catch((error) => setStatus({ text: String(error.message ?? error), error: true }));
+    setAnalyzing(true);
+    setAnalyzeProgress(0);
+    try {
+      const faces = await getFaceFinder();
+      const analysis = await analyzeVideo(incoming, { faces, onProgress: (p) => setAnalyzeProgress(p.fraction) });
+      setDuration(analysis.duration);
+      setCutTimes(analysis.cutTimes);
+      setUsedFaces(analysis.usedFaces);
+      setAutoTargets(analysis.targets);
+      const coverage = Math.round(analysis.faceCoverage * 100);
+      setStatus({
+        text: analysis.usedFaces
+          ? `Analysed: faces found on ${coverage}% of sampled frames, ${analysis.cutTimes.length} scene cut${analysis.cutTimes.length === 1 ? "" : "s"} detected.`
+          : `Analysed: no faces found — following motion instead. ${analysis.cutTimes.length} scene cut${analysis.cutTimes.length === 1 ? "" : "s"} detected.`,
+        error: false,
+      });
+    } catch (error) {
+      setStatus({ text: error instanceof Error ? error.message : "Could not analyse this video.", error: true });
+    } finally {
+      setAnalyzing(false);
+    }
+  }, [getFaceFinder]);
+
+  const onPickFiles = (list: FileList | null) => {
+    const picked = list?.[0];
+    if (picked) void loadFile(picked);
+  };
+
+  const togglePlay = async () => {
+    const player = playerRef.current;
+    if (!player) return;
+    if (playing) { player.pause(); setPlaying(false); }
+    else { await player.play(); setPlaying(true); }
+  };
+
+  const seek = (target: number) => { void playerRef.current?.seek(target); };
+
+  const addLetterboxSegment = () => {
+    const start = Math.max(0, time - 1);
+    const end = Math.min(duration || time + 1, time + 1);
+    setLetterboxSegments((current) => [...current, { start, end }].sort((a, b) => a.start - b.start));
+  };
+  const updateSegment = (index: number, field: "start" | "end", value: number) => {
+    setLetterboxSegments((current) => current.map((segment, i) => (i === index ? { ...segment, [field]: value } : segment)));
+  };
+  const removeSegment = (index: number) => setLetterboxSegments((current) => current.filter((_, i) => i !== index));
+
+  const onOverride = (overrideTime: number, x: number, y: number) => {
+    setOverrides((current) => [...current.filter((item) => Math.abs(item.time - overrideTime) > 1e-6), { time: overrideTime, x, y }]);
+  };
+  const onRemoveOverride = (overrideTime: number) => {
+    setOverrides((current) => current.filter((item) => Math.abs(item.time - overrideTime) > 1e-6));
+  };
+
+  const exportVideo = async () => {
+    if (!file || !path.length) return;
+    setRendering({ fraction: 0, message: "Starting…" });
+    try {
+      const render = await renderReframe({
+        file, path, aspect, letterboxSegments,
+        onProgress: (fraction, message) => setRendering({ fraction, message }),
+      });
+      const url = URL.createObjectURL(render.blob);
+      const name = `${baseName(file.name)}-reframe-${aspect.replace(":", "x")}.${render.extension}`;
+      setResult({ ...render, url, name });
+      setStatus({ text: `Exported ${name} via ${render.method === "webcodecs" ? "WebCodecs" : "MediaRecorder (real-time fallback)"} in ${render.seconds.toFixed(1)}s.`, error: false });
+    } catch (error) {
+      setStatus({ text: error instanceof Error ? error.message : "Export failed.", error: true });
+    } finally {
+      setRendering(null);
+    }
+  };
+
+  const exportPathJson = () => {
+    if (!file) return;
+    const json = pathToJson({ fileName: file.name, width: 0, height: 0, duration, aspect, path, cutTimes, letterboxSegments });
+    downloadFile(`${baseName(file.name)}-crop-path.json`, JSON.stringify(json, null, 2), "application/json");
+  };
+
+  const openInEditor = () => {
+    if (!file) return;
+    const cutFile = reframeToCutFile({ name: baseName(file.name), duration, exportName: result?.name ?? file.name });
+    downloadFile(`${baseName(file.name)}-reframe.scenepilot.json`, JSON.stringify(cutFile, null, 2), "application/json");
+    setStatus({ text: "Saved the ScenePilot project file. In the editor: new project with the exported clip as the main media, then Import cut → this file.", error: false });
+    window.open("../../app/", "_blank", "noopener");
+  };
+
+  const openInAutoCut = () => {
+    if (result) downloadFile(result.name, result.blob, result.mime);
+    window.open("../autocut/", "_blank", "noopener");
+    setStatus({ text: "Downloaded the reframed clip and opened AutoCut — drop it in there as a clip.", error: false });
+  };
+
+  return (
+    <ToolShell
+      tool="reframe"
+      limits={LIMITS}
+      onOpenFile={(opened) => { if (opened.type.startsWith("video/")) void loadFile(opened); }}
+      actions={file ? <button type="button" className="btn ghost" onClick={() => fileInput.current?.click()}>Change video</button> : undefined}
+    >
+      <input ref={fileInput} type="file" accept="video/*" style={{ display: "none" }} onChange={(e) => onPickFiles(e.target.files)} />
+      {!file ? (
+        <div
+          className="dropzone"
+          onDragOver={(e) => e.preventDefault()}
+          onDrop={(e) => { e.preventDefault(); onPickFiles(e.dataTransfer.files); }}
+          onClick={() => fileInput.current?.click()}
+          role="button"
+          tabIndex={0}
+        >
+          <Upload size={28} />
+          <p>Drop a horizontal video here, or click to choose one.</p>
+          <p className="note">Nothing is uploaded — it stays in this browser tab.</p>
+        </div>
+      ) : (
+        <div className="reframe-layout">
+          <div className="reframe-controls">
+            <label>
+              Output aspect
+              <select value={aspect} onChange={(e) => setAspect(e.target.value as ReframeAspectId)}>
+                {REFRAME_ASPECT_IDS.map((id) => <option key={id} value={id}>{id}</option>)}
+              </select>
+            </label>
+            <label className="checkbox">
+              <input type="checkbox" checked={useFaces} onChange={(e) => { setUseFaces(e.target.checked); if (file) void loadFile(file); }} />
+              Follow faces {usedFaces ? "(found)" : ""}
+            </label>
+            <label>
+              Dead zone <span className="note">{Math.round(deadZone * 100)}%</span>
+              <input type="range" min={0} max={0.3} step={0.01} value={deadZone} onChange={(e) => setDeadZone(Number(e.target.value))} />
+            </label>
+            <label>
+              Max pan speed <span className="note">{maxPanSpeed.toFixed(2)}/s</span>
+              <input type="range" min={0.1} max={1.5} step={0.05} value={maxPanSpeed} onChange={(e) => setMaxPanSpeed(Number(e.target.value))} />
+            </label>
+            <label>
+              Ease <span className="note">{ease.toFixed(2)}</span>
+              <input type="range" min={0.05} max={1} step={0.05} value={ease} onChange={(e) => setEase(Number(e.target.value))} />
+            </label>
+            {analyzing && <p className="note"><Loader2 className="spin" size={14} /> Analysing… {Math.round(analyzeProgress * 100)}%</p>}
+          </div>
+
+          <div className="reframe-preview">
+            <canvas ref={sourceCanvasRef} width={640} height={360} aria-label="Source with crop window" />
+            <canvas ref={outputCanvasRef} width={304} height={540} aria-label="Cropped output preview" />
+          </div>
+
+          <div className="reframe-transport">
+            <button type="button" className="btn" onClick={togglePlay} disabled={!duration}>{playing ? <Pause size={14} /> : <Play size={14} />}</button>
+            <input type="range" min={0} max={duration || 1} step={0.01} value={time} onChange={(e) => seek(Number(e.target.value))} />
+            <span className="note">{fmt(time)} / {fmt(duration)}</span>
+          </div>
+
+          <ReframeTimeline
+            duration={duration}
+            path={path}
+            cutTimes={cutTimes}
+            overrides={overrides}
+            letterboxSegments={letterboxSegments}
+            time={time}
+            zoom={Math.max(20, Math.min(120, 900 / Math.max(1, duration)))}
+            onSeek={seek}
+            onOverride={onOverride}
+            onRemoveOverride={onRemoveOverride}
+          />
+
+          <div className="reframe-letterbox">
+            <div className="row-head">
+              <strong>Letterbox instead</strong>
+              <button type="button" className="btn ghost" onClick={addLetterboxSegment} disabled={!duration}><Plus size={14} /> Add segment at playhead</button>
+            </div>
+            {letterboxSegments.length === 0 && <p className="note">No letterboxed segments — the whole clip is cropped.</p>}
+            {letterboxSegments.map((segment, index) => (
+              <div key={index} className="segment-row">
+                <input type="number" min={0} max={duration} step={0.1} value={segment.start.toFixed(1)} onChange={(e) => updateSegment(index, "start", Number(e.target.value))} />
+                <span>to</span>
+                <input type="number" min={0} max={duration} step={0.1} value={segment.end.toFixed(1)} onChange={(e) => updateSegment(index, "end", Number(e.target.value))} />
+                <span>s — show the whole frame, letterboxed, instead of cropping</span>
+                <button type="button" className="btn ghost" onClick={() => removeSegment(index)}><Trash2 size={14} /></button>
+              </div>
+            ))}
+          </div>
+
+          <div className="reframe-actions">
+            <button type="button" className="btn primary" onClick={() => void exportVideo()} disabled={!path.length || Boolean(rendering)}>
+              {rendering ? <Loader2 className="spin" size={14} /> : <Download size={14} />} Export video
+            </button>
+            <button type="button" className="btn" onClick={exportPathJson} disabled={!path.length}><FileJson size={14} /> Export crop path JSON</button>
+            {result && <a className="btn" href={result.url} download={result.name}><Download size={14} /> Download {result.name}</a>}
+            <button type="button" className="btn ghost" onClick={openInAutoCut} disabled={!result}>Open in AutoCut <ArrowUpRight size={14} /></button>
+            <button type="button" className="btn ghost" onClick={openInEditor} disabled={!file}>Open in editor <ArrowUpRight size={14} /></button>
+          </div>
+          {rendering && <p className="note">{rendering.message} ({Math.round(rendering.fraction * 100)}%)</p>}
+        </div>
+      )}
+      <p className={status.error ? "status-line error" : "status-line"}>{status.text}</p>
+    </ToolShell>
+  );
+}
+
+createRoot(document.getElementById("root")!).render(<StrictMode><ReframeApp /></StrictMode>);
diff --git a/tools/src/reframe/player.ts b/tools/src/reframe/player.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62511ea5d8c2f6efcc6b6af52711911781815312
--- /dev/null
+++ b/tools/src/reframe/player.ts
@@ -0,0 +1,125 @@
+// Reframe preview: a single <video> (it has its own audio, so no separate Web
+// Audio clock is needed, unlike AutoCut's multi-clip player) drives two
+// canvases every animation frame — the source with the live crop window drawn
+// on it, and the actual cropped (or letterboxed) result at the output aspect.
+import { cropBounds, letterboxRect, type ReframeAspectId } from "../../../lib/reframe-crop.ts";
+import { pathAt, type PathPoint } from "../../../lib/reframe-path.ts";
+
+export type LetterboxSegment = { start: number; end: number };
+
+export function isLetterboxed(segments: LetterboxSegment[], time: number): boolean {
+  return segments.some((segment) => time >= segment.start && time < segment.end);
+}
+
+export class ReframePlayer {
+  readonly video: HTMLVideoElement;
+  path: PathPoint[] = [];
+  aspect: ReframeAspectId = "9:16";
+  letterboxSegments: LetterboxSegment[] = [];
+  playing = false;
+  onTime: (time: number) => void = () => {};
+  onEnded: () => void = () => {};
+  private frame = 0;
+
+  constructor(private sourceCanvas: HTMLCanvasElement, private outputCanvas: HTMLCanvasElement) {
+    this.video = document.createElement("video");
+    this.video.playsInline = true;
+    this.video.preload = "auto";
+    this.video.addEventListener("ended", () => { this.playing = false; this.onEnded(); });
+  }
+
+  async load(file: File): Promise<void> {
+    this.video.src = URL.createObjectURL(file);
+    await new Promise<void>((resolve, reject) => {
+      this.video.addEventListener("loadedmetadata", () => resolve(), { once: true });
+      this.video.addEventListener("error", () => reject(new Error("The browser couldn't decode this video for preview.")), { once: true });
+    });
+    await this.drawStill();
+  }
+
+  async play() {
+    if (this.playing) return;
+    await this.video.play();
+    this.playing = true;
+    this.tick();
+  }
+
+  pause() {
+    this.playing = false;
+    this.video.pause();
+    cancelAnimationFrame(this.frame);
+  }
+
+  async seek(time: number) {
+    const wasPlaying = this.playing;
+    if (wasPlaying) this.pause();
+    await new Promise<void>((resolve) => {
+      const done = () => { this.video.removeEventListener("seeked", done); resolve(); };
+      this.video.addEventListener("seeked", done);
+      this.video.currentTime = Math.min(this.video.duration || time, Math.max(0, time));
+      window.setTimeout(done, 1000);
+    });
+    this.onTime(this.video.currentTime);
+    await this.drawStill();
+    if (wasPlaying) await this.play();
+  }
+
+  async drawStill() {
+    this.draw();
+  }
+
+  private tick = () => {
+    if (!this.playing) return;
+    this.draw();
+    this.onTime(this.video.currentTime);
+    this.frame = requestAnimationFrame(this.tick);
+  };
+
+  private draw() {
+    const video = this.video;
+    if (!video.videoWidth) return;
+    const time = video.currentTime;
+    const letterboxed = isLetterboxed(this.letterboxSegments, time);
+    const { x: centerX, y: centerY } = pathAt(this.path, time);
+
+    // Source canvas: the full frame, scaled to fit, with the crop window drawn on it.
+    const source = this.sourceCanvas.getContext("2d")!;
+    const scale = Math.min(this.sourceCanvas.width / video.videoWidth, this.sourceCanvas.height / video.videoHeight);
+    const drawWidth = video.videoWidth * scale;
+    const drawHeight = video.videoHeight * scale;
+    const offsetX = (this.sourceCanvas.width - drawWidth) / 2;
+    const offsetY = (this.sourceCanvas.height - drawHeight) / 2;
+    source.fillStyle = "#000";
+    source.fillRect(0, 0, this.sourceCanvas.width, this.sourceCanvas.height);
+    source.drawImage(video, offsetX, offsetY, drawWidth, drawHeight);
+    if (!letterboxed) {
+      const crop = cropBounds(video.videoWidth, video.videoHeight, this.aspect, centerX, centerY);
+      source.strokeStyle = "#5ce3a8";
+      source.lineWidth = 2;
+      source.strokeRect(offsetX + crop.x * scale, offsetY + crop.y * scale, crop.width * scale, crop.height * scale);
+    } else {
+      source.strokeStyle = "#f4c96b";
+      source.lineWidth = 2;
+      source.strokeRect(offsetX + 1, offsetY + 1, drawWidth - 2, drawHeight - 2);
+    }
+
+    // Output canvas: the actual export framing at the chosen aspect.
+    const output = this.outputCanvas.getContext("2d")!;
+    output.fillStyle = "#000";
+    output.fillRect(0, 0, this.outputCanvas.width, this.outputCanvas.height);
+    if (letterboxed) {
+      const rect = letterboxRect(video.videoWidth, video.videoHeight, this.outputCanvas.width, this.outputCanvas.height);
+      output.drawImage(video, rect.x, rect.y, rect.width, rect.height);
+    } else {
+      const crop = cropBounds(video.videoWidth, video.videoHeight, this.aspect, centerX, centerY);
+      output.drawImage(video, crop.x, crop.y, crop.width, crop.height, 0, 0, this.outputCanvas.width, this.outputCanvas.height);
+    }
+  }
+
+  dispose() {
+    this.pause();
+    URL.revokeObjectURL(this.video.src);
+    this.video.removeAttribute("src");
+    this.video.load();
+  }
+}
diff --git a/tools/src/reframe/render.ts b/tools/src/reframe/render.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d41ea61ca28f8b4ab7984645aecc2c288cef38c7
--- /dev/null
+++ b/tools/src/reframe/render.ts
@@ -0,0 +1,206 @@
+// Reframe export. Faster-than-real-time path first: WebCodecs via mediabunny
+// (MPL-2.0, already the editor's media engine) decodes the source in order
+// and re-encodes each frame cropped (or letterboxed) to the chosen aspect,
+// MP4 (H.264/AAC) where the browser can encode it, otherwise WebM. When this
+// browser has no WebCodecs video+audio encoder at all, falls back to a
+// real-time capture: play the source, draw each frame to a canvas, and record
+// canvas.captureStream() + the video's own audio with MediaRecorder.
+import { cropBounds, letterboxRect, outputSize, type ReframeAspectId } from "../../../lib/reframe-crop.ts";
+import { pathAt, type PathPoint } from "../../../lib/reframe-path.ts";
+import { isLetterboxed, type LetterboxSegment } from "./player.ts";
+
+export type RenderOptions = {
+  file: File;
+  path: PathPoint[];
+  aspect: ReframeAspectId;
+  letterboxSegments: LetterboxSegment[];
+  longSide?: number;
+  fps?: number;
+  onProgress?: (fraction: number, message: string) => void;
+  signal?: AbortSignal;
+};
+
+export type RenderResult = { blob: Blob; extension: "mp4" | "webm"; mime: string; method: "webcodecs" | "mediarecorder"; codec: string; seconds: number };
+
+type Plan = { container: "mp4" | "webm"; video: "avc" | "vp9" | "vp8"; audio: "aac" | "opus" };
+
+async function pickEncoding(width: number, height: number): Promise<Plan | null> {
+  const { canEncodeAudio, canEncodeVideo } = await import("mediabunny");
+  const plans: Plan[] = [
+    { container: "mp4", video: "avc", audio: "aac" },
+    { container: "webm", video: "vp9", audio: "opus" },
+    { container: "webm", video: "vp8", audio: "opus" },
+  ];
+  for (const plan of plans) {
+    try {
+      if ((await canEncodeVideo(plan.video, { width, height })) && (await canEncodeAudio(plan.audio, { numberOfChannels: 2, sampleRate: 48000 }))) return plan;
+    } catch { /* try the next */ }
+  }
+  return null;
+}
+
+function frameRect(sourceWidth: number, sourceHeight: number, aspect: ReframeAspectId, letterboxSegments: LetterboxSegment[], path: PathPoint[], outWidth: number, outHeight: number, time: number) {
+  if (isLetterboxed(letterboxSegments, time)) return { rect: letterboxRect(sourceWidth, sourceHeight, outWidth, outHeight), letterboxed: true };
+  const { x, y } = pathAt(path, time);
+  return { rect: cropBounds(sourceWidth, sourceHeight, aspect, x, y), letterboxed: false };
+}
+
+export async function renderReframe(options: RenderOptions): Promise<RenderResult> {
+  const started = performance.now();
+  const { width, height } = outputSize(options.aspect, options.longSide ?? 1080);
+  const plan = await pickEncoding(width, height);
+  if (plan) return renderWithWebCodecs(options, plan, width, height, started);
+  return renderWithMediaRecorder(options, width, height, started);
+}
+
+async function renderWithWebCodecs(options: RenderOptions, plan: Plan, width: number, height: number, started: number): Promise<RenderResult> {
+  const { ALL_FORMATS, AudioBufferSource, BlobSource, BufferTarget, CanvasSource, Input, Mp4OutputFormat, Output, VideoSampleSink, WebMOutputFormat } = await import("mediabunny");
+  const input = new Input({ formats: ALL_FORMATS, source: new BlobSource(options.file) });
+  try {
+    const videoTrack = await input.getPrimaryVideoTrack();
+    if (!videoTrack) throw new Error("No video track to export.");
+    const duration = (await input.getDurationFromMetadata([videoTrack])) ?? (await input.computeDuration([videoTrack]));
+    const sourceWidth = await videoTrack.getDisplayWidth();
+    const sourceHeight = await videoTrack.getDisplayHeight();
+    const fps = options.fps ?? 30;
+
+    const canvas = document.createElement("canvas");
+    canvas.width = width;
+    canvas.height = height;
+    const context = canvas.getContext("2d", { alpha: false })!;
+    context.imageSmoothingQuality = "high";
+
+    const target = new BufferTarget();
+    const output = new Output({ format: plan.container === "mp4" ? new Mp4OutputFormat({ fastStart: "in-memory" }) : new WebMOutputFormat(), target });
+    const bitrate = Math.round(Math.min(12e6, Math.max(2e6, width * height * fps * 0.1)));
+    const videoSource = new CanvasSource(canvas, { codec: plan.video, bitrate });
+    output.addVideoTrack(videoSource, { frameRate: fps });
+
+    const audioTrack = await input.getPrimaryAudioTrack();
+    const audioSource = audioTrack ? new AudioBufferSource({ codec: plan.audio, bitrate: 192_000 }) : null;
+    if (audioSource) output.addAudioTrack(audioSource);
+
+    await output.start();
+    if (audioSource && audioTrack) {
+      options.onProgress?.(0.01, "Encoding the soundtrack");
+      const audioContext = new AudioContext();
+      try {
+        const buffer = await audioContext.decodeAudioData(await options.file.arrayBuffer()).catch(() => null);
+        if (buffer) await audioSource.add(buffer);
+      } finally {
+        void audioContext.close();
+      }
+      audioSource.close();
+    }
+
+    const sink = new VideoSampleSink(videoTrack);
+    const frameCount = Math.max(1, Math.round(duration * fps));
+    const timestamps = Array.from({ length: frameCount }, (_, index) => index / fps);
+    let index = 0;
+    for await (const sample of sink.samplesAtTimestamps(timestamps)) {
+      options.signal?.throwIfAborted();
+      const outTime = timestamps[index];
+      if (sample) {
+        const { rect, letterboxed } = frameRect(sourceWidth, sourceHeight, options.aspect, options.letterboxSegments, options.path, width, height, outTime);
+        context.fillStyle = "#000";
+        context.fillRect(0, 0, width, height);
+        if (letterboxed) sample.draw(context, 0, 0, sourceWidth, sourceHeight, rect.x, rect.y, rect.width, rect.height);
+        else sample.draw(context, rect.x, rect.y, rect.width, rect.height, 0, 0, width, height);
+        sample.close();
+      }
+      await videoSource.add(outTime, 1 / fps, { keyFrame: index === 0 || index % (fps * 2) === 0 });
+      index++;
+      if (index % 15 === 0) options.onProgress?.(0.03 + 0.95 * (index / frameCount), `Rendering frame ${index} of ${frameCount}`);
+    }
+    videoSource.close();
+    options.onProgress?.(0.99, "Finalising the file");
+    await output.finalize();
+    if (!target.buffer) throw new Error("The encoder produced an empty file.");
+    const mime = plan.container === "mp4" ? "video/mp4" : "video/webm";
+    return { blob: new Blob([target.buffer], { type: mime }), extension: plan.container, mime, method: "webcodecs", codec: `${plan.video.toUpperCase()} + ${plan.audio.toUpperCase()}`, seconds: (performance.now() - started) / 1000 };
+  } finally {
+    input.dispose();
+  }
+}
+
+/**
+ * Real-time fallback for browsers with no WebCodecs encoder: play the source
+ * video, draw each frame cropped/letterboxed to a canvas, capture the canvas
+ * as a MediaStream, mix in the video's own audio via Web Audio, and record
+ * with MediaRecorder. Takes as long as the clip itself (the tab must stay
+ * visible/foregrounded), and always produces WebM — no MediaRecorder browser
+ * reliably writes MP4 today.
+ */
+async function renderWithMediaRecorder(options: RenderOptions, width: number, height: number, started: number): Promise<RenderResult> {
+  if (typeof MediaRecorder === "undefined") throw new Error("This browser supports neither WebCodecs nor MediaRecorder video export.");
+  const video = document.createElement("video");
+  video.src = URL.createObjectURL(options.file);
+  video.muted = false;
+  video.playsInline = true;
+  await new Promise<void>((resolve, reject) => {
+    video.addEventListener("loadedmetadata", () => resolve(), { once: true });
+    video.addEventListener("error", () => reject(new Error("The browser couldn't decode this video.")), { once: true });
+  });
+  const sourceWidth = video.videoWidth;
+  const sourceHeight = video.videoHeight;
+  const duration = video.duration;
+
+  const canvas = document.createElement("canvas");
+  canvas.width = width;
+  canvas.height = height;
+  const context = canvas.getContext("2d", { alpha: false })!;
+
+  const audioContext = new AudioContext();
+  const sourceNode = audioContext.createMediaElementSource(video);
+  const destination = audioContext.createMediaStreamDestination();
+  sourceNode.connect(destination);
+  // Keep audio out of the device speakers while recording (it still reaches the recorder via destination).
+
+  const canvasStream = (canvas as HTMLCanvasElement & { captureStream(fps?: number): MediaStream }).captureStream(options.fps ?? 30);
+  const combined = new MediaStream([...canvasStream.getVideoTracks(), ...destination.stream.getAudioTracks()]);
+  const mimeType = ["video/webm;codecs=vp9,opus", "video/webm;codecs=vp8,opus", "video/webm"].find((type) => MediaRecorder.isTypeSupported(type)) ?? "video/webm";
+  const recorder = new MediaRecorder(combined, { mimeType, videoBitsPerSecond: Math.round(Math.min(12e6, Math.max(2e6, width * height * 0.3))) });
+  const chunks: Blob[] = [];
+  recorder.ondataavailable = (event) => { if (event.data.size) chunks.push(event.data); };
+
+  const finished = new Promise<void>((resolve) => { recorder.onstop = () => resolve(); });
+  recorder.start(250);
+
+  let raf = 0;
+  const drawFrame = () => {
+    const time = video.currentTime;
+    const { rect, letterboxed } = frameRect(sourceWidth, sourceHeight, options.aspect, options.letterboxSegments, options.path, width, height, time);
+    context.fillStyle = "#000";
+    context.fillRect(0, 0, width, height);
+    if (letterboxed) context.drawImage(video, rect.x, rect.y, rect.width, rect.height);
+    else context.drawImage(video, rect.x, rect.y, rect.width, rect.height, 0, 0, width, height);
+    options.onProgress?.(Math.min(0.99, time / Math.max(0.1, duration)), `Recording ${time.toFixed(1)}s of ${duration.toFixed(1)}s`);
+    if (!video.ended && !video.paused) raf = requestAnimationFrame(drawFrame);
+  };
+
+  try {
+    await video.play();
+    drawFrame();
+    await new Promise<void>((resolve) => video.addEventListener("ended", () => resolve(), { once: true }));
+  } finally {
+    cancelAnimationFrame(raf);
+    recorder.stop();
+    await finished;
+    video.pause();
+    URL.revokeObjectURL(video.src);
+    void audioContext.close();
+  }
+  return { blob: new Blob(chunks, { type: mimeType }), extension: "webm", mime: mimeType, method: "mediarecorder", codec: mimeType, seconds: (performance.now() - started) / 1000 };
+}
+
+/** The crop/letterbox path as portable JSON, independent of any particular export. */
+export function pathToJson(options: { fileName: string; width: number; height: number; duration: number; aspect: ReframeAspectId; path: PathPoint[]; cutTimes: number[]; letterboxSegments: LetterboxSegment[] }) {
+  return {
+    format: "scenepilot.reframe.v1",
+    source: { name: options.fileName, width: options.width, height: options.height, duration: options.duration },
+    aspect: options.aspect,
+    cutTimes: options.cutTimes,
+    letterboxSegments: options.letterboxSegments,
+    keyframes: options.path.map((point) => ({ time: point.time, x: point.x, y: point.y, cut: point.cut })),
+  };
+}
diff --git a/tools/src/reframe/timeline.tsx b/tools/src/reframe/timeline.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..cd8c92b2e3d7bdcce49d34a0daae991fa6eb0bd4
--- /dev/null
+++ b/tools/src/reframe/timeline.tsx
@@ -0,0 +1,111 @@
+import { useCallback, useMemo, useRef, type PointerEvent } from "react";
+import type { PathPoint, SubjectTarget } from "../../../lib/reframe-path.ts";
+import type { LetterboxSegment } from "./player.ts";
+
+const HEIGHT = 120;
+const RULER = 18;
+const TRACK = HEIGHT - RULER;
+
+type Props = {
+  duration: number;
+  path: PathPoint[];
+  cutTimes: number[];
+  overrides: SubjectTarget[];
+  letterboxSegments: LetterboxSegment[];
+  time: number;
+  zoom: number;
+  onSeek: (time: number) => void;
+  onOverride: (time: number, x: number, y: number) => void;
+  onRemoveOverride: (time: number) => void;
+};
+
+/**
+ * The Reframe timeline: the smoothed camera path's horizontal position as a
+ * line (0 = frame left, 1 = frame right), scene-cut markers, and draggable
+ * diamonds for manual keyframe overrides — drag one vertically to move the
+ * crop's x position at that moment, double-click to remove it. Letterbox
+ * ranges are a separate editable list below (simpler and more precise than
+ * drag-to-select for alpha).
+ */
+export function ReframeTimeline({ duration, path, cutTimes, overrides, letterboxSegments, time, zoom, onSeek, onOverride, onRemoveOverride }: Props) {
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const dragging = useRef<number | null>(null);
+  const width = Math.max(320, Math.round(duration * zoom));
+  const xAt = useCallback((seconds: number) => seconds * zoom, [zoom]);
+  const yFor = useCallback((value: number) => RULER + (1 - value) * (TRACK - 12) + 6, []);
+  const valueFor = useCallback((clientY: number) => {
+    const rect = containerRef.current?.getBoundingClientRect();
+    if (!rect) return 0.5;
+    const local = clientY - rect.top - RULER - 6;
+    return Math.min(1, Math.max(0, 1 - local / (TRACK - 12)));
+  }, []);
+
+  const linePoints = useMemo(() => path.map((point) => `${xAt(point.time)},${yFor(point.x)}`).join(" "), [path, xAt, yFor]);
+
+  const seekFromClick = (event: PointerEvent<HTMLDivElement>) => {
+    const rect = event.currentTarget.getBoundingClientRect();
+    const localX = event.clientX - rect.left + (containerRef.current?.scrollLeft ?? 0);
+    onSeek(Math.min(duration, Math.max(0, localX / zoom)));
+  };
+
+  const overrideAt = (overrideTime: number) => overrides.find((item) => Math.abs(item.time - overrideTime) < 1e-6);
+
+  return (
+    <div className="reframe-timeline">
+      <div ref={containerRef} className="reframe-timeline-scroll" onPointerDown={(event) => { if (dragging.current === null) seekFromClick(event); }}>
+        <svg width={width} height={HEIGHT} role="img" aria-label="Crop path over time">
+          <rect x={0} y={0} width={width} height={HEIGHT} fill="#12181a" />
+          {/* ruler ticks every 5s */}
+          {Array.from({ length: Math.ceil(duration / 5) + 1 }, (_, i) => i * 5).map((t) => (
+            <g key={t}>
+              <line x1={xAt(t)} y1={0} x2={xAt(t)} y2={HEIGHT} stroke="#263033" strokeWidth={1} />
+              <text x={xAt(t) + 3} y={12} fill="#6f7c82" fontSize={10}>{t}s</text>
+            </g>
+          ))}
+          {/* letterbox ranges, shaded */}
+          {letterboxSegments.map((segment, index) => (
+            <rect key={`lb-${index}`} x={xAt(segment.start)} y={RULER} width={Math.max(1, xAt(segment.end - segment.start))} height={TRACK} fill="#f4c96b" opacity={0.12} />
+          ))}
+          {/* scene cuts */}
+          {cutTimes.map((cut) => (
+            <line key={cut} x1={xAt(cut)} y1={RULER} x2={xAt(cut)} y2={HEIGHT} stroke="#ff6f91" strokeWidth={2} strokeDasharray="3,3" />
+          ))}
+          {/* smoothed path (x position over time) */}
+          <polyline points={linePoints} fill="none" stroke="#5ce3a8" strokeWidth={2} />
+          {/* playhead */}
+          <line x1={xAt(time)} y1={0} x2={xAt(time)} y2={HEIGHT} stroke="#fff" strokeWidth={1.5} />
+          {/* draggable override keyframes (automatic path samples double as draggable handles) */}
+          {path.filter((_, index) => index % 3 === 0).map((point) => {
+            const manual = overrideAt(point.time);
+            return (
+              <circle
+                key={point.time}
+                cx={xAt(point.time)}
+                cy={yFor(manual ? manual.x : point.x)}
+                r={manual ? 5 : 3.5}
+                fill={manual ? "#ff8a5c" : "#5ce3a8"}
+                stroke="#0d1211"
+                strokeWidth={1}
+                style={{ cursor: "ns-resize" }}
+                onPointerDown={(event) => { event.stopPropagation(); dragging.current = point.time; (event.target as Element).setPointerCapture(event.pointerId); }}
+                onPointerMove={(event) => {
+                  if (dragging.current !== point.time) return;
+                  const value = valueFor(event.clientY);
+                  onOverride(point.time, value, manual?.y ?? point.y);
+                }}
+                onPointerUp={() => { dragging.current = null; }}
+                onDoubleClick={(event) => { event.stopPropagation(); if (manual) onRemoveOverride(point.time); }}
+              >
+                <title>{manual ? "Manual override — drag to adjust, double-click to remove" : "Automatic — drag to override"}</title>
+              </circle>
+            );
+          })}
+        </svg>
+      </div>
+      <p className="note" style={{ marginTop: 6 }}>
+        Green line: the smoothed crop position (top = frame right, bottom = frame left). Pink dashes: detected scene cuts, where the camera resets instead of panning.
+        Orange dots are your manual overrides — drag any dot vertically to pin the crop there, double-click to remove it.
+      </p>
+    </div>
+  );
+}
