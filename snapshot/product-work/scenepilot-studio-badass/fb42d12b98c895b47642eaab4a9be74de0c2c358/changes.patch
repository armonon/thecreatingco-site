diff --git a/tests/abortable-wait.test.mjs b/tests/abortable-wait.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9f78fa4463e32bbf67c1d2f2a5e7e13704bce2f0
--- /dev/null
+++ b/tests/abortable-wait.test.mjs
@@ -0,0 +1,16 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {abortableWait} from "../lib/abortable-wait.ts";
+test("cancel releases an unresolved picker and ignores a late destination",async()=>{
+  const controller=new AbortController();let select;
+  const pending=new Promise(resolve=>select=resolve);
+  const task=abortableWait(pending,controller.signal);
+  controller.abort();await assert.rejects(task,{name:"AbortError"});
+  select("late-file");await assert.rejects(task,{name:"AbortError"});
+});
+test("picker success, failure and pre-aborted requests remain distinct",async()=>{
+  const controller=new AbortController();
+  assert.equal(await abortableWait(Promise.resolve("file"),controller.signal),"file");
+  await assert.rejects(abortableWait(Promise.reject(new Error("permission denied")),controller.signal),/permission denied/);
+  controller.abort();await assert.rejects(abortableWait(Promise.resolve("file"),controller.signal),{name:"AbortError"});
+});
diff --git a/tests/audio-delay.test.mjs b/tests/audio-delay.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a1e129003f36fb8d93afd791f8a718ba2f6eda5c
--- /dev/null
+++ b/tests/audio-delay.test.mjs
@@ -0,0 +1,14 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {measureAudioDelay} from "../lib/audio-delay.ts";
+const ref=Float32Array.from({length:128},(_,i)=>Math.sin(i*i*1.123));
+test("audio delay is measured rather than assumed, including already-correct timestamps",()=>{
+  for(const lag of [0,21,77,-12]) {
+    const samples=new Float32Array(500);samples.set(ref,100+lag);
+    assert.equal(measureAudioDelay(ref,samples,100,100).delay,lag);
+  }
+});
+test("an uncorrelated or silent timing probe fails closed",()=>{
+  assert.throws(()=>measureAudioDelay(new Float32Array(128),new Float32Array(500),100,100),/silent/);
+  assert.throws(()=>measureAudioDelay(ref,new Float32Array(500),100,100),/inconclusive/);
+});
