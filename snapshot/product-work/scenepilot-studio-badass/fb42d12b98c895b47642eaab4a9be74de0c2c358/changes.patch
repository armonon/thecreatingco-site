index 0000000000000000000000000000000000000000..583d6b865452fedeccad42a0c5ed875a351ad1e3
--- /dev/null
+++ b/tests/reframe-crop.test.mjs
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { cropBounds, letterboxRect, outputSize, REFRAME_ASPECTS } from "../lib/reframe-crop.ts";
+
+test("9:16 crop of a 1920x1080 source is full height, aspect-correct, centered by default", () => {
+  const rect = cropBounds(1920, 1080, "9:16");
+  assert.ok(Math.abs(rect.height - 1080) < 1e-6);
+  assert.ok(Math.abs(rect.width / rect.height - REFRAME_ASPECTS["9:16"]) < 1e-6);
+  assert.ok(Math.abs(rect.x - (1920 - rect.width) / 2) < 1e-6, "centered horizontally when centerX=0.5");
+  assert.equal(rect.y, 0);
+});
+
+test("crop never leaves the source frame when the subject is near an edge", () => {
+  for (const centerX of [0, 0.02, 0.5, 0.98, 1]) {
+    const rect = cropBounds(1920, 1080, "9:16", centerX, 0.5);
+    assert.ok(rect.x >= -1e-6, `x in bounds: ${rect.x}`);
+    assert.ok(rect.x + rect.width <= 1920 + 1e-6, `right edge in bounds: ${rect.x + rect.width}`);
+  }
+});
+
+test("a subject pinned at the left edge shows a crop flush against x=0, not centered", () => {
+  const rect = cropBounds(1920, 1080, "9:16", 0, 0.5);
+  assert.ok(Math.abs(rect.x) < 1e-6, `flush left: ${rect.x}`);
+});
+
+test("1:1 crop of a portrait source is full width, aspect-correct", () => {
+  const rect = cropBounds(1080, 1920, "1:1");
+  assert.ok(Math.abs(rect.width - 1080) < 1e-6);
+  assert.ok(Math.abs(rect.height - 1080) < 1e-6);
+  assert.ok(rect.y >= 0 && rect.y + rect.height <= 1920 + 1e-6);
+});
+
+test("4:5 crop dimensions match the 4/5 aspect ratio exactly", () => {
+  const rect = cropBounds(1920, 1080, "4:5");
+  assert.ok(Math.abs(rect.width / rect.height - 0.8) < 1e-6);
+});
+
+test("degenerate source size doesn't throw and returns a non-negative rect", () => {
+  const rect = cropBounds(0, 0, "9:16");
+  assert.equal(rect.width, 0);
+  assert.equal(rect.height, 0);
+});
+
+test("outputSize returns even dimensions at the requested aspect", () => {
+  for (const aspect of ["9:16", "4:5", "1:1"]) {
+    const size = outputSize(aspect, 1080);
+    assert.equal(size.width % 2, 0);
+    assert.equal(size.height % 2, 0);
+    assert.ok(Math.abs(size.width / size.height - REFRAME_ASPECTS[aspect]) < 0.01);
+  }
+});
+
+test("letterboxRect fits the whole source inside the output, centered, preserving aspect", () => {
+  const rect = letterboxRect(1920, 1080, 1080, 1920); // wide clip into a vertical canvas
+  assert.ok(rect.width <= 1080 + 1e-6 && rect.height <= 1920 + 1e-6);
+  assert.ok(Math.abs(rect.width / rect.height - 1920 / 1080) < 1e-6);
+  assert.ok(Math.abs(rect.x - (1080 - rect.width) / 2) < 1e-6);
+  assert.ok(Math.abs(rect.y - (1920 - rect.height) / 2) < 1e-6);
+});
diff --git a/tests/reframe-cut.test.mjs b/tests/reframe-cut.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..79eb7cb845e7e605937e1c00e7eff70c1e6bccfa
--- /dev/null
+++ b/tests/reframe-cut.test.mjs
@@ -0,0 +1,66 @@
+// Scene-cut detection on synthetic frame samples, and the integration that
+// matters for Reframe: a detected cut must make the camera path reset instead
+// of panning across it. Reuses AutoCut's detectSceneCuts (same histogram +
+// motion heuristic) rather than a second implementation.
+import assert from "node:assert/strict";
+import test from "node:test";
+import { buildCameraPath, detectSceneCuts } from "../lib/reframe-path.ts";
+
+/** Synthetic per-frame samples at `rate` Hz: a hard cut between scenes shows up as one spike in motion + histogram distance. */
+function syntheticFrames(duration, sceneAt, rate = 4) {
+  const out = [];
+  let previousScene = null;
+  for (let t = 0; t < duration; t += 1 / rate) {
+    const scene = sceneAt(t);
+    const changed = previousScene !== null && previousScene !== scene;
+    out.push({
+      time: t,
+      brightness: scene === "a" ? 0.5 : 0.25,
+      sharpness: 0.3,
+      contrast: 0.3,
+      motion: changed ? 0.5 : 0.03,
+      histogramDistance: changed ? 0.75 : 0.02,
+    });
+    previousScene = scene;
+  }
+  return out;
+}
+
+test("detects a single hard cut partway through a clip and nothing else", () => {
+  const samples = syntheticFrames(10, (t) => (t < 5 ? "a" : "b"));
+  const cuts = detectSceneCuts(samples);
+  assert.equal(cuts.length, 1);
+  assert.ok(Math.abs(cuts[0] - 5) < 0.3, `cut near 5s: ${cuts}`);
+});
+
+test("a steady pan (continuous, gradual change) is not mistaken for a cut", () => {
+  const samples = [];
+  for (let t = 0; t < 8; t += 0.25) {
+    samples.push({ time: t, brightness: 0.3 + t * 0.01, sharpness: 0.3, contrast: 0.3, motion: 0.1, histogramDistance: 0.05 });
+  }
+  assert.equal(detectSceneCuts(samples).length, 0);
+});
+
+test("two separated hard cuts are both detected", () => {
+  const samples = syntheticFrames(12, (t) => (t < 4 ? "a" : t < 8 ? "b" : "a"));
+  const cuts = detectSceneCuts(samples);
+  assert.equal(cuts.length, 2);
+  assert.ok(cuts.some((c) => Math.abs(c - 4) < 0.3));
+  assert.ok(cuts.some((c) => Math.abs(c - 8) < 0.3));
+});
+
+test("a detected cut makes the camera path snap instead of pan across it", () => {
+  const samples = syntheticFrames(10, (t) => (t < 5 ? "a" : "b"));
+  const cuts = detectSceneCuts(samples);
+  // Subject is at the left in scene "a", jumps to the right at the cut in scene "b" (new shot, new framing).
+  const targets = [
+    { time: 0, x: 0.15, y: 0.5 },
+    { time: 4.75, x: 0.15, y: 0.5 },
+    { time: 5.25, x: 0.85, y: 0.5 }, // first sample after the cut
+    { time: 9.75, x: 0.85, y: 0.5 },
+  ];
+  const path = buildCameraPath(targets, { deadZone: 0.05, maxPanSpeed: 0.3, ease: 0.3, cutTimes: cuts });
+  const postCut = path.find((p) => Math.abs(p.time - 5.25) < 1e-6);
+  assert.equal(postCut.x, 0.85, "camera is already on the new subject right at the cut, not mid-pan");
+  assert.equal(postCut.cut, true);
+});
diff --git a/tests/reframe-path.test.mjs b/tests/reframe-path.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ac26ca2ce9ea2592ef4de3eee9f9a920d51fec53
--- /dev/null
+++ b/tests/reframe-path.test.mjs
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { applyManualOverrides, buildCameraPath, pathAt } from "../lib/reframe-path.ts";
+
+test("dead zone: small jitter around the start doesn't move the camera", () => {
+  const targets = [
+    { time: 0, x: 0.5, y: 0.5 },
+    { time: 1, x: 0.52, y: 0.49 }, // 2 cm of jitter, well inside an 8% dead zone
+    { time: 2, x: 0.48, y: 0.51 },
+  ];
+  const path = buildCameraPath(targets, { deadZone: 0.08, maxPanSpeed: 0.6, ease: 0.35 });
+  assert.equal(path[1].x, 0.5);
+  assert.equal(path[1].y, 0.5);
+  assert.equal(path[2].x, 0.5);
+});
+
+test("a subject that drifts beyond the dead zone pulls the camera toward it", () => {
+  const targets = [
+    { time: 0, x: 0.5, y: 0.5 },
+    { time: 10, x: 0.9, y: 0.5 }, // way past the dead zone, lots of time to close in
+  ];
+  const path = buildCameraPath(targets, { deadZone: 0.08, maxPanSpeed: 0.6, ease: 0.5 });
+  assert.ok(path[1].x > 0.6, `camera should move toward the subject: ${path[1].x}`);
+  assert.ok(path[1].x < 0.9, `camera should not overshoot past the raw target in one step: ${path[1].x}`);
+});
+
+test("max pan speed caps how far the camera can move per second", () => {
+  const targets = [
+    { time: 0, x: 0.1, y: 0.5 },
+    { time: 1, x: 0.95, y: 0.5 }, // a huge jump in 1 second
+  ];
+  const maxPanSpeed = 0.3; // 30% of frame width per second
+  const path = buildCameraPath(targets, { deadZone: 0.02, maxPanSpeed, ease: 1 });
+  const moved = path[1].x - path[0].x;
+  assert.ok(moved <= maxPanSpeed + 1e-9, `moved ${moved} but cap is ${maxPanSpeed}`);
+});
+
+test("a scene cut resets the path instantly instead of panning across it", () => {
+  const targets = [
+    { time: 0, x: 0.1, y: 0.5 },
+    { time: 1, x: 0.9, y: 0.5 }, // this target is right after a cut
+  ];
+  const path = buildCameraPath(targets, { deadZone: 0.02, maxPanSpeed: 0.3, ease: 0.3, cutTimes: [0.5] });
+  assert.equal(path[1].x, 0.9, "hard reset to the new shot's subject, not a slow pan");
+  assert.equal(path[1].cut, true);
+});
+
+test("a cut before the first target doesn't affect it (nothing to reset from)", () => {
+  const targets = [{ time: 2, x: 0.3, y: 0.4 }];
+  const path = buildCameraPath(targets, { cutTimes: [1] });
+  assert.equal(path[0].x, 0.3);
+  assert.equal(path[0].cut, false);
+});
+
+test("pathAt interpolates smoothly between points but holds across a cut edge", () => {
+  const path = buildCameraPath(
+    [
+      { time: 0, x: 0.2, y: 0.5 },
+      { time: 4, x: 0.2, y: 0.5 },
+    ],
+    { deadZone: 0, maxPanSpeed: 10, ease: 1 },
+  );
+  // Linear case: at t=0 and t=4 we know the values; midpoint should be close to the lerp.
+  const mid = pathAt(path, 2);
+  assert.ok(mid.x >= 0.15 && mid.x <= 0.25, `mid x ${mid.x}`);
+
+  const cutPath = [
+    { time: 0, x: 0.1, y: 0.5, cut: false },
+    { time: 2, x: 0.9, y: 0.5, cut: true },
+  ];
+  const justBefore = pathAt(cutPath, 1.9);
+  const atCut = pathAt(cutPath, 2);
+  assert.equal(justBefore.x, 0.1, "holds the pre-cut value right up to the cut, no interpolation across it");
+  assert.equal(atCut.x, 0.9, "snaps to the post-cut value at the cut's own sample time");
+});
+
+test("pathAt holds at the ends for times outside the path", () => {
+  const path = buildCameraPath([{ time: 5, x: 0.3, y: 0.7 }]);
+  assert.deepEqual(pathAt(path, 0), { x: 0.3, y: 0.7 });
+  assert.deepEqual(pathAt(path, 100), { x: 0.3, y: 0.7 });
+});
+
+test("empty input produces an empty path and a centered default", () => {
+  assert.deepEqual(buildCameraPath([]), []);
+  assert.deepEqual(pathAt([], 3), { x: 0.5, y: 0.5 });
+});
+
+test("manual keyframe overrides pin the path and displace nearby automatic points", () => {
+  const auto = buildCameraPath([
+    { time: 0, x: 0.2, y: 0.5 },
+    { time: 1, x: 0.25, y: 0.5 },
+    { time: 2, x: 0.3, y: 0.5 },
+  ]);
+  const overridden = applyManualOverrides(auto, [{ time: 1, x: 0.8, y: 0.2 }], 0.2);
+  const pinned = overridden.find((point) => Math.abs(point.time - 1) < 1e-6);
+  assert.ok(pinned, "override point present");
+  assert.equal(pinned.x, 0.8);
+  assert.equal(pinned.y, 0.2);
+  assert.equal(overridden.length, auto.length); // one auto point swapped for one pin at the same time
+});
diff --git a/tests/reframe-subjects.test.mjs b/tests/reframe-subjects.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a624b27e556384da9a3d7f2d486e0f79e8ed5cbb
--- /dev/null
+++ b/tests/reframe-subjects.test.mjs
@@ -0,0 +1,80 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { motionCentroid, pickSubjectTarget } from "../lib/reframe-subjects.ts";
+
+test("no faces: no target (caller falls back to motion saliency)", () => {
+  assert.equal(pickSubjectTarget([], 0.4), null);
+});
+
+test("one face: follow it directly", () => {
+  const pick = pickSubjectTarget([{ x: 0.3, y: 0.4, size: 0.1 }], 0.4);
+  assert.deepEqual(pick, { x: 0.3, y: 0.4, multi: false });
+});
+
+test("two close faces that fit in the crop: keep both, follow their centroid", () => {
+  const faces = [{ x: 0.4, y: 0.5, size: 0.08 }, { x: 0.5, y: 0.5, size: 0.08 }];
+  const pick = pickSubjectTarget(faces, 0.6, 0.1); // span 0.18 < fitWidth 0.6
+  assert.equal(pick.multi, true);
+  assert.ok(Math.abs(pick.x - 0.45) < 1e-6);
+});
+
+test("two faces too far apart for the crop: follow the larger one", () => {
+  const faces = [{ x: 0.1, y: 0.5, size: 0.05 }, { x: 0.9, y: 0.5, size: 0.12 }];
+  const pick = pickSubjectTarget(faces, 0.4, 0.1); // span way over fitWidth
+  assert.equal(pick.multi, false);
+  assert.equal(pick.x, 0.9); // the larger/active face
+});
+
+test("three or more faces that don't fit together: follow the single largest", () => {
+  const faces = [
+    { x: 0.2, y: 0.5, size: 0.05 },
+    { x: 0.5, y: 0.5, size: 0.09 }, // largest
+    { x: 0.8, y: 0.5, size: 0.06 },
+  ];
+  const pick = pickSubjectTarget(faces, 0.3, 0.1); // crop too narrow for even the top two to fit
+  assert.equal(pick.multi, false);
+  assert.equal(pick.x, 0.5);
+});
+
+test("three or more faces where the top two by size do fit: still only considers the top two", () => {
+  const faces = [
+    { x: 0.2, y: 0.5, size: 0.02 }, // smallest, ignored even though it would widen the group
+    { x: 0.5, y: 0.5, size: 0.09 },
+    { x: 0.6, y: 0.5, size: 0.08 },
+  ];
+  const pick = pickSubjectTarget(faces, 0.9, 0.1);
+  assert.equal(pick.multi, true);
+  assert.ok(Math.abs(pick.x - 0.55) < 1e-6);
+});
+
+function frame(width, height, fill) {
+  const data = new Uint8Array(width * height);
+  data.fill(fill);
+  return data;
+}
+
+test("motion centroid finds a moving bright region against a static background", () => {
+  const width = 20, height = 20;
+  const previous = frame(width, height, 20);
+  const current = frame(width, height, 20);
+  // A bright 4x4 block near the right edge "moves in" on this frame.
+  for (let y = 12; y < 16; y++) for (let x = 14; x < 18; x++) current[y * width + x] = 220;
+  const result = motionCentroid(previous, current, width, height);
+  assert.ok(result, "motion detected");
+  assert.ok(result.x > 0.6, `centroid x should be near the right: ${result.x}`);
+  assert.ok(result.y > 0.5, `centroid y should be in the lower half: ${result.y}`);
+});
+
+test("a static frame (no change) reports no motion", () => {
+  const width = 10, height = 10;
+  const a = frame(width, height, 50);
+  const b = frame(width, height, 50);
+  assert.equal(motionCentroid(a, b, width, height), null);
+});
+
+test("sensor-noise-level flicker below the noise floor doesn't register as motion", () => {
+  const width = 10, height = 10;
+  const a = frame(width, height, 50);
+  const b = frame(width, height, 53); // +3, under the 8-level noise floor
+  assert.equal(motionCentroid(a, b, width, height), null);
+});
