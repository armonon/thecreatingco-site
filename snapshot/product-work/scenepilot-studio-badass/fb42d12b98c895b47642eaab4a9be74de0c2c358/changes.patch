+  const duration = Math.max(1, ...allEnds);
+  const markers = (timeline.markers ?? [])
+    .filter((marker) => Number.isFinite(marker.time) && marker.time >= 0 && secondsToFrames(marker.time, rate) <= duration)
+    .sort((a, b) => a.time - b.time)
