+                  <button type="button" className="btn" onClick={() => exportPremiere("xml")} disabled={!ready} title="Final Cut Pro 7 XML (xmeml v4): Premiere Pro opens it with File → Import"><Download size={15} /> Export for Premiere</button>
+                  <button type="button" className="btn small" onClick={() => exportPremiere("edl")} disabled={!ready} title="CMX3600 EDL of the same cut">EDL</button>
+                  <LockerSaveButton disabled={!ready} label="XML to Locker" item={() => { const file = premiereFile("xml"); return file ? { name: file.name, type: file.type, blob: new Blob([file.text], { type: file.type }), meta: { format: "xmeml-4", rate: rateId } } : null; }} onSaved={(text) => setStatus({ text })} />
+                </div>
+                <div className="premiere-options">
+                  <label>Frame rate
+                    <select value={premiereRate} onChange={(event) => setPremiereRate(event.target.value as PremiereRateId | "auto")}>
+                      <option value="auto">Auto ({autoRate} from clips)</option>
+                      {PREMIERE_RATES.map((id) => <option key={id} value={id}>{id} fps</option>)}
+                    </select>
+                  </label>
+                  {rateHasDropFrame && <label className="check"><input type="checkbox" checked={dropFrame} onChange={(event) => setDropFrame(event.target.checked)} /> Drop-frame timecode</label>}
+                  <label>Markers
+                    <select value={beatMarkers} onChange={(event) => setBeatMarkers(event.target.value as BeatMarkerMode)}>
+                      <option value="bars">Sections, drop + every bar</option>
+                      <option value="beats">Sections, drop + every beat</option>
+                      <option value="none">Sections + drop only</option>
+                    </select>
+                  </label>
+                  <label className="wide">Media folder on this computer <small>(optional — links media straight away)</small>
+                    <input type="text" value={mediaFolder} placeholder="/Users/you/Movies/Shoot or D:\Footage\Shoot" spellCheck={false} onChange={(event) => rememberFolder(event.target.value)} />
+                  </label>
+                </div>
+                <details className="premiere-note">
+                  <summary>How to open it in Premiere</summary>
+                  <ul>{PREMIERE_RELINK_NOTE.split("\n").map((line) => <li key={line}>{line}</li>)}</ul>
+                </details>
+              </div>
+              {render && (
+                <div style={{ marginTop: 10 }}>
+                  <div className="progress"><i style={{ width: `${Math.round(render.progress * 100)}%` }} /></div>
+                  <p className="note">{render.message}</p>
+                </div>
+              )}
+              {result && (
+                <p className="note ac-result"><LockerSaveButton label="Save video to Locker" item={() => ({ name: result.name, type: result.mime, blob: result.blob, meta: { tool: "autocut", aspect } })} onSaved={(text) => setStatus({ text })} /> <a href={result.url} download={result.name}><Download size={12} /> {result.name}</a> · {result.codec} · {(result.blob.size / 1e6).toFixed(1)} MB · rendered in {result.seconds.toFixed(1)} s</p>
+              )}
+              <div className="handoff">
+                <span className="eyebrow"><Scissors size={12} /> Finish it in ScenePilot</span>
+                <ol>
+                  <li>Download the ScenePilot project.</li>
+                  <li>Open the editor, load the song as the main source and import the same clips.</li>
+                  <li>Import cut → the project file. Shots land on V1 at the same beats; a “Best N s” cut opens as the timeline in/out range.</li>
+                </ol>
+              </div>
+            </div>
+          </section>
+        </div>
+      )}
+      <p className={`status-line${status.error ? " error" : ""}`} role="status">
+        {(pending > 0 || (songFile && !music)) && !status.error ? <Loader2 size={14} className="spin" /> : <Repeat size={14} style={{ opacity: 0.5 }} />}
+        {status.text}
+      </p>
+    </ToolShell>
+  );
+}
+
+createRoot(document.getElementById("root")!).render(<StrictMode><AutoCutApp /></StrictMode>);
diff --git a/tools/src/autocut/media.ts b/tools/src/autocut/media.ts
new file mode 100644
index 0000000000000000000000000000000000000000..98c47b8240080af8c653da8f8d2959c0d5274216
--- /dev/null
+++ b/tools/src/autocut/media.ts
@@ -0,0 +1,204 @@
+// Browser side of AutoCut analysis: decoding audio, sampling clip frames and
+// (optionally) finding faces. The scoring itself is pure and lives in lib/.
+import { frameStats } from "../../../lib/analysis-engine";
+import { resampleMono } from "../../../lib/autocut-align";
+import { profileClip, type ClipProfile, type ClipSample } from "../../../lib/autocut-clips";
+import { mixToMono } from "../../../lib/autocut-music";
+import type { FaceFinder } from "./faces";
+
+export const ALIGN_RATE = 16000;
+
+const VIDEO_EXT = /\.(mp4|m4v|mov|webm|mkv|avi|3gp)$/i;
+const AUDIO_EXT = /\.(mp3|wav|m4a|aac|flac|ogg|oga|opus|aif|aiff|weba)$/i;
+
+export function mediaKind(file: File): "video" | "audio" | null {
+  if (file.type.startsWith("video/") || VIDEO_EXT.test(file.name)) return "video";
+  if (file.type.startsWith("audio/") || AUDIO_EXT.test(file.name)) return "audio";
+  return null;
+}
+
+/** Every file in a drop, recursing into dropped folders. */
+export async function filesFromDrop(dataTransfer: DataTransfer): Promise<File[]> {
+  const entries = [...dataTransfer.items]
+    .map((item) => (typeof item.webkitGetAsEntry === "function" ? item.webkitGetAsEntry() : null))
+    .filter((entry): entry is FileSystemEntry => Boolean(entry));
+  if (!entries.length) return [...dataTransfer.files];
+  const out: File[] = [];
+  const walk = async (entry: FileSystemEntry): Promise<void> => {
+    if (entry.isFile) {
+      out.push(await new Promise<File>((resolve, reject) => (entry as FileSystemFileEntry).file(resolve, reject)));
+      return;
+    }
+    if (!entry.isDirectory) return;
+    const reader = (entry as FileSystemDirectoryEntry).createReader();
+    // readEntries returns batches; keep reading until it returns nothing.
+    for (;;) {
+      const batch = await new Promise<FileSystemEntry[]>((resolve, reject) => reader.readEntries(resolve, reject));
+      if (!batch.length) break;
+      for (const child of batch) await walk(child);
+    }
+  };
+  for (const entry of entries) await walk(entry);
+  return out;
+}
+
+/** Decode a song (audio file, or the soundtrack of a video) for playback, analysis and export. */
+export async function decodeSong(file: File): Promise<AudioBuffer> {
+  const context = new AudioContext();
+  try {
+    try {
+      return await context.decodeAudioData(await file.arrayBuffer());
+    } catch {
+      // Containers the browser's audio decoder rejects: demux with mediabunny.
+      const mono = await decodeTrackMono(file, 0);
+      if (!mono) throw new Error(`No audio could be decoded from ${file.name}.`);
+      const buffer = new AudioBuffer({ length: mono.samples.length, numberOfChannels: 1, sampleRate: mono.sampleRate });
+      buffer.copyToChannel(mono.samples as Float32Array<ArrayBuffer>, 0);
+      return buffer;
+    }
+  } finally {
+    void context.close();
+  }
+}
+
+export function bufferToMono(buffer: AudioBuffer): Float32Array {
+  return mixToMono(Array.from({ length: buffer.numberOfChannels }, (_, index) => buffer.getChannelData(index)), buffer.length);
+}
+
+/**
+ * Decode a file's primary audio track to mono with mediabunny, resampled to
+ * `targetRate` (0 keeps the native rate). Streams, so a long take never needs
+ * its whole file in an ArrayBuffer. Null when the file has no audio.
+ */
+export async function decodeTrackMono(file: File, targetRate = ALIGN_RATE, signal?: AbortSignal): Promise<{ samples: Float32Array; sampleRate: number } | null> {
+  const { ALL_FORMATS, AudioBufferSink, BlobSource, Input } = await import("mediabunny");
+  const input = new Input({ formats: ALL_FORMATS, source: new BlobSource(file) });
+  try {
+    const track = await input.getPrimaryAudioTrack();
+    if (!track) return null;
+    // Place every decoded buffer at its own timestamp (the codec's priming
+    // buffer sits before t=0 and is dropped), then resample the whole take in
+    // one pass — per-chunk resampling drifts and smears the alignment.
+    const chunks: Array<{ at: number; data: Float32Array }> = [];
+    let sampleRate = 0;
+    let total = 0;
+    for await (const wrapped of new AudioBufferSink(track).buffers()) {
+      signal?.throwIfAborted();
+      sampleRate = wrapped.buffer.sampleRate;
+      const mono = bufferToMono(wrapped.buffer);
+      const at = Math.round(wrapped.timestamp * sampleRate);
+      const skip = Math.max(0, -at);
+      if (skip >= mono.length) continue;
+      chunks.push({ at: Math.max(0, at), data: skip ? mono.subarray(skip) : mono });
+      total = Math.max(total, Math.max(0, at) + mono.length - skip);
+    }
+    if (!total) return null;
+    const native = new Float32Array(total);
+    for (const chunk of chunks) native.set(chunk.data.subarray(0, Math.max(0, total - chunk.at)), chunk.at);
+    const samples = targetRate ? resampleMono(native, sampleRate, targetRate) : native;
+    return { samples, sampleRate: targetRate || sampleRate };
+  } finally {
+    input.dispose();
+  }
+}
+
+export type ClipMeta = {
+  duration: number;
+  width: number;
+  height: number;
+  hasAudio: boolean;
+  /** Measured video frame rate (packets per second), when it could be read. */
+  frameRate?: number;
+  thumbnail: string;
+};
+
+const STAT_W = 64;
+const STAT_H = 36;
+const FACE_W = 320;
+const FACE_H = 180;
+
+/**
+ * Sample a clip's frames (≈4 per second, at most ~480 samples), measure each
+ * with the editor's frameStats, optionally run face detection on a sparse
+ * subset, profile the clip and grab a thumbnail of its best moment.
+ */
+export async function analyzeClip(
+  id: string,
+  file: File,
+  options: { faces?: FaceFinder | null; signal?: AbortSignal; onProgress?: (fraction: number) => void } = {},
+): Promise<{ profile: ClipProfile; meta: ClipMeta }> {
+  const { ALL_FORMATS, BlobSource, Input, VideoSampleSink } = await import("mediabunny");
+  const input = new Input({ formats: ALL_FORMATS, source: new BlobSource(file) });
+  try {
+    const track = await input.getPrimaryVideoTrack();
+    if (!track) throw new Error(`${file.name} has no video track.`);
+    const duration = (await input.getDurationFromMetadata([track])) ?? await input.computeDuration([track]);
+    const width = await track.getDisplayWidth();
+    const height = await track.getDisplayHeight();
+    const hasAudio = Boolean(await input.getPrimaryAudioTrack());
+    const frameRate = await track.computePacketStats(120).then((stats) => stats.averagePacketRate || undefined).catch(() => undefined);
+    const sink = new VideoSampleSink(track);
+    const interval = Math.max(0.25, duration / 480);
+    const timestamps: number[] = [];
+    for (let time = 0; time < duration - 0.02; time += interval) timestamps.push(time);
+    if (!timestamps.length) timestamps.push(0);
+
+    const stat = document.createElement("canvas");
+    stat.width = STAT_W; stat.height = STAT_H;
+    const statContext = stat.getContext("2d", { willReadFrequently: true })!;
+    const face = document.createElement("canvas");
+    face.width = FACE_W; face.height = Math.round(FACE_W * (height / Math.max(1, width))) || FACE_H;
+    const faceContext = face.getContext("2d")!;
+    const faceStride = Math.max(1, Math.floor(timestamps.length / 24));
+
+    const samples: ClipSample[] = [];
+    let previousGray: Uint8Array | undefined;
+    let previousHistogram: Float32Array | undefined;
+    let index = 0;
+    for await (const sample of sink.samplesAtTimestamps(timestamps)) {
+      options.signal?.throwIfAborted();
+      const time = timestamps[index];
+      if (sample) {
+        sample.draw(statContext, 0, 0, STAT_W, STAT_H);
+        let faces: number | undefined;
+        let faceX: number | undefined;
+        if (options.faces && index % faceStride === 0) {
+          sample.draw(faceContext, 0, 0, face.width, face.height);
+          const found = await options.faces.detect(face).catch(() => null);
+          if (found) { faces = found.count; faceX = found.centerX ?? undefined; }
+        }
+        sample.close();
+        const stats = frameStats(statContext.getImageData(0, 0, STAT_W, STAT_H).data, previousGray, STAT_W);
+        let histogramDistance = 0;
+        if (previousHistogram) {
+          for (let bin = 0; bin < 16; bin++) histogramDistance += Math.abs(stats.histogram[bin] - previousHistogram[bin]);
+          histogramDistance /= 2;
+        }
+        samples.push({
+          time, brightness: stats.brightness, sharpness: stats.sharpness, contrast: stats.contrast,
+          motion: previousGray ? stats.difference : 0, histogramDistance, faces, faceX,
+        });
+        previousGray = stats.gray;
+        previousHistogram = stats.histogram;
+      }
+      index++;
+      if (index % 16 === 0) options.onProgress?.(index / timestamps.length);
+    }
+    const profile = profileClip(id, file.name, duration, samples);
+
+    // Thumbnail: the middle of the best segment (or the clip's middle).
+    const best = [...profile.segments].sort((a, b) => b.quality - a.quality)[0];
+    const thumbTime = best ? (best.start + best.end) / 2 : duration / 2;
+    const thumbCanvas = document.createElement("canvas");
+    thumbCanvas.width = 160;
+    thumbCanvas.height = Math.max(1, Math.round(160 * (height / Math.max(1, width))));
+    const thumbSample = await sink.getSample(thumbTime);
+    if (thumbSample) {
+      thumbSample.draw(thumbCanvas.getContext("2d")!, 0, 0, thumbCanvas.width, thumbCanvas.height);
+      thumbSample.close();
+    }
+    return { profile, meta: { duration, width, height, hasAudio, frameRate, thumbnail: thumbCanvas.toDataURL("image/jpeg", 0.7) } };
+  } finally {
+    input.dispose();
+  }
+}
diff --git a/tools/src/autocut/player.ts b/tools/src/autocut/player.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2c7eb461446032d0af012141d054a74fd1b1e2c6
--- /dev/null
+++ b/tools/src/autocut/player.ts
@@ -0,0 +1,161 @@
+// Preview playback: the song plays through Web Audio (the master clock); one
+// muted <video> per clip follows it. The upcoming shot's clip is pre-seeked a
+// moment before its cut so switches land on the beat. Each animation frame
+// draws the active clip, cover-cropped to the chosen aspect, onto the canvas.
+import { coverCrop } from "../../../lib/autocut-export";
+import { shotAt, type Shot } from "../../../lib/autocut-cut";
+
+export type PreviewClip = { url: string; focusX: number };
+
+export class PreviewPlayer {
+  private context: AudioContext | null = null;
+  private source: AudioBufferSourceNode | null = null;
+  private startedAt = 0;
+  private offset = 0;
+  private videos = new Map<string, HTMLVideoElement>();
+  private frame = 0;
+  private activeId = "";
+  playing = false;
+  shots: Shot[] = [];
+  clips = new Map<string, PreviewClip>();
+  range = { start: 0, end: 0 };
+  onTime: (time: number) => void = () => {};
+  onEnded: () => void = () => {};
+
+  constructor(private canvas: HTMLCanvasElement, private song: AudioBuffer) {}
+
+  get time() {
+    return this.playing && this.context ? this.offset + (this.context.currentTime - this.startedAt) : this.offset;
+  }
+
+  private video(clipId: string) {
+    let video = this.videos.get(clipId);
+    const clip = this.clips.get(clipId);
+    if (!video && clip) {
+      video = document.createElement("video");
+      video.muted = true;
+      video.playsInline = true;
+      video.preload = "auto";
+      video.src = clip.url;
+      this.videos.set(clipId, video);
+    }
+    return video;
+  }
+
+  private sourceTime(shot: Shot, time: number) {
+    return Math.max(0, shot.sourceStart + (time - shot.start));
+  }
+
+  async play() {
+    if (this.playing) return;
+    if (this.offset >= this.range.end - 0.05) this.offset = this.range.start;
+    this.context ??= new AudioContext();
+    await this.context.resume();
+    const node = this.context.createBufferSource();
+    node.buffer = this.song;
+    node.connect(this.context.destination);
+    this.startedAt = this.context.currentTime + 0.05;
+    node.start(this.startedAt, this.offset, Math.max(0.01, this.range.end - this.offset));
+    this.source = node;
+    this.playing = true;
+    this.activeId = "";
+    this.tick();
+  }
+
+  pause() {
+    if (!this.playing) return;
+    this.offset = this.time;
+    this.playing = false;
+    try { this.source?.stop(); } catch { /* already stopped */ }
+    this.source = null;
+    cancelAnimationFrame(this.frame);
+    for (const video of this.videos.values()) video.pause();
+  }
+
+  async seek(time: number) {
+    const wasPlaying = this.playing;
+    if (wasPlaying) this.pause();
+    this.offset = Math.min(this.range.end, Math.max(this.range.start, time));
+    this.onTime(this.offset);
+    if (wasPlaying) await this.play();
+    else await this.drawStill();
+  }
+
+  /** Draw the frame at the playhead while paused (seek, then paint on `seeked`). */
+  async drawStill() {
+    const shot = shotAt(this.shots, this.offset);
+    if (!shot) { this.clear(); return; }
+    const video = this.video(shot.clipId);
+    if (!video) return;
+    const target = this.sourceTime(shot, this.offset);
+    if (video.readyState < 1) await new Promise((resolve) => video.addEventListener("loadedmetadata", resolve, { once: true }));
+    if (Math.abs(video.currentTime - target) > 0.02) {
+      await new Promise<void>((resolve) => {
+        const done = () => { video.removeEventListener("seeked", done); resolve(); };
+        video.addEventListener("seeked", done);
+        video.currentTime = target;
+        window.setTimeout(done, 1500);
+      });
+    }
+    this.paint(video, shot.clipId);
+  }
+
+  private clear() {
+    const context = this.canvas.getContext("2d")!;
+    context.fillStyle = "#000";
+    context.fillRect(0, 0, this.canvas.width, this.canvas.height);
+  }
+
+  private paint(video: HTMLVideoElement, clipId: string) {
+    const context = this.canvas.getContext("2d")!;
+    if (!video.videoWidth) { this.clear(); return; }
+    const crop = coverCrop(video.videoWidth, video.videoHeight, this.canvas.width, this.canvas.height, this.clips.get(clipId)?.focusX ?? 0.5);
+    context.drawImage(video, crop.x, crop.y, crop.width, crop.height, 0, 0, this.canvas.width, this.canvas.height);
+  }
+
+  private tick = () => {
+    if (!this.playing) return;
+    const time = this.time;
+    if (time >= this.range.end) {
+      this.pause();
+      this.offset = this.range.end;
+      this.onTime(this.offset);
+      this.onEnded();
+      return;
+    }
+    const shot = shotAt(this.shots, time);
+    if (shot) {
+      const video = this.video(shot.clipId);
+      if (video) {
+        const target = this.sourceTime(shot, time);
+        if (this.activeId !== shot.id) {
+          for (const [id, other] of this.videos) if (id !== shot.clipId) other.pause();
+          if (Math.abs(video.currentTime - target) > 0.06) video.currentTime = target;
+          void video.play().catch(() => undefined);
+          this.activeId = shot.id;
+        } else if (Math.abs(video.currentTime - target) > 0.25) {
+          video.currentTime = target; // drifted (slow decode): resync to the music
+        }
+        this.paint(video, shot.clipId);
+      }
+      // Pre-seek the next shot's clip so its first frame is ready on the cut.
+      const index = this.shots.indexOf(shot);
+      const next = this.shots[index + 1];
+      if (next && next.clipId !== shot.clipId && next.start - time < 0.6) {
+        const nextVideo = this.video(next.clipId);
+        if (nextVideo && nextVideo.paused && Math.abs(nextVideo.currentTime - next.sourceStart) > 0.05 && !nextVideo.seeking) nextVideo.currentTime = next.sourceStart;
+      }
+    } else {
+      this.clear();
+    }
+    this.onTime(time);
+    this.frame = requestAnimationFrame(this.tick);
+  };
+
+  dispose() {
+    this.pause();
+    for (const video of this.videos.values()) { video.removeAttribute("src"); video.load(); }
+    this.videos.clear();
+    void this.context?.close();
+  }
+}
diff --git a/tools/src/autocut/render.ts b/tools/src/autocut/render.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4bee55b8af7ffa9bed97b00b84dc10a4eb3197c6
--- /dev/null
+++ b/tools/src/autocut/render.ts
@@ -0,0 +1,165 @@
+// AutoCut export. Faster-than-real-time where the browser has WebCodecs
+// encoders (via mediabunny, MPL-2.0, already the editor's media engine):
+// each shot's source frames are decoded in order, cover-cropped to the output
+// aspect (centred on a detected face when there is one), and encoded with the
+// song as the soundtrack. MP4 (H.264 + AAC) first, WebM (VP9/VP8 + Opus) when
+// the browser can't encode MP4.
+import { coverCrop, outputSize, type AspectId } from "../../../lib/autocut-export";
+import type { Shot } from "../../../lib/autocut-cut";
+
+export type RenderClip = { file: File; focusX: number };
+
+export type RenderOptions = {
+  shots: Shot[];
+  clips: Map<string, RenderClip>;
+  song: AudioBuffer;
+  range: { start: number; end: number };
+  aspect: AspectId;
+  /** 1 = full HD long side, 0.5 = draft. */
+  scale: number;
+  fps?: number;
+  onProgress?: (fraction: number, message: string) => void;
+  signal?: AbortSignal;
+};
+
+export type RenderResult = { blob: Blob; extension: "mp4" | "webm"; mime: string; codec: string; seconds: number };
+
+type Plan = { container: "mp4" | "webm"; video: "avc" | "vp9" | "vp8"; audio: "aac" | "opus" };
+
+export async function pickEncoding(width: number, height: number): Promise<Plan | null> {
+  const { canEncodeAudio, canEncodeVideo } = await import("mediabunny");
+  const plans: Plan[] = [
+    { container: "mp4", video: "avc", audio: "aac" },
+    { container: "webm", video: "vp9", audio: "opus" },
+    { container: "webm", video: "vp8", audio: "opus" },
+  ];
+  for (const plan of plans) {
+    try {
+      if (await canEncodeVideo(plan.video, { width, height }) && await canEncodeAudio(plan.audio, { numberOfChannels: 2, sampleRate: 48000 })) return plan;
+    } catch { /* try the next */ }
+  }
+  return null;
+}
+
+/** The song between `start` and `end`, with 15 ms edge fades when it's an excerpt. */
+export function sliceSong(song: AudioBuffer, start: number, end: number): AudioBuffer {
+  const from = Math.max(0, Math.floor(start * song.sampleRate));
+  const to = Math.min(song.length, Math.ceil(end * song.sampleRate));
+  const length = Math.max(1, to - from);
+  const channels = Math.min(2, song.numberOfChannels);
+  const out = new AudioBuffer({ length, numberOfChannels: channels, sampleRate: song.sampleRate });
+  const fade = Math.round(0.015 * song.sampleRate);
+  for (let channel = 0; channel < channels; channel++) {
+    const data = song.getChannelData(channel).slice(from, to);
+    if (from > 0) for (let i = 0; i < Math.min(fade, data.length); i++) data[i] *= i / fade;
+    if (to < song.length) for (let i = 0; i < Math.min(fade, data.length); i++) data[data.length - 1 - i] *= i / fade;
+    out.copyToChannel(data, channel);
+  }
+  return out;
+}
+
+export async function renderCut(options: RenderOptions): Promise<RenderResult> {
+  const started = performance.now();
+  const fps = options.fps ?? 30;
+  const { width, height } = outputSize(options.aspect, options.scale);
+  const plan = await pickEncoding(width, height);
+  if (!plan) throw new Error("This browser can't encode video with WebCodecs. Use a current Chrome, Edge or Safari, or export the ScenePilot project and render in the editor.");
+  const { ALL_FORMATS, AudioBufferSource, BlobSource, BufferTarget, CanvasSource, Input, Mp4OutputFormat, Output, VideoSampleSink, WebMOutputFormat } = await import("mediabunny");
+
+  const canvas = document.createElement("canvas");
+  canvas.width = width;
+  canvas.height = height;
+  const context = canvas.getContext("2d", { alpha: false })!;
+  context.imageSmoothingQuality = "high";
+
+  const target = new BufferTarget();
+  const output = new Output({ format: plan.container === "mp4" ? new Mp4OutputFormat({ fastStart: "in-memory" }) : new WebMOutputFormat(), target });
+  const bitrate = Math.round(Math.min(12e6, Math.max(2e6, width * height * fps * 0.1)));
+  const videoSource = new CanvasSource(canvas, { codec: plan.video, bitrate });
+  const audioSource = new AudioBufferSource({ codec: plan.audio, bitrate: 192_000 });
+  output.addVideoTrack(videoSource, { frameRate: fps });
+  output.addAudioTrack(audioSource);
+
+  const inputs = new Map<string, { input: InstanceType<typeof Input>; sink: InstanceType<typeof VideoSampleSink>; width: number; height: number }>();
+  const reader = async (clipId: string) => {
+    const existing = inputs.get(clipId);
+    if (existing) return existing;
+    const clip = options.clips.get(clipId);
+    if (!clip) return null;
+    const input = new Input({ formats: ALL_FORMATS, source: new BlobSource(clip.file) });
+    const track = await input.getPrimaryVideoTrack();
+    if (!track) { input.dispose(); return null; }
+    const entry = { input, sink: new VideoSampleSink(track), width: await track.getDisplayWidth(), height: await track.getDisplayHeight() };
+    inputs.set(clipId, entry);
+    return entry;
+  };
+
+  try {
+    await output.start();
+    options.onProgress?.(0.01, "Encoding the soundtrack");
+    await audioSource.add(sliceSong(options.song, options.range.start, options.range.end));
+    audioSource.close();
+
+    const total = options.range.end - options.range.start;
+    const frameCount = Math.max(1, Math.round(total * fps));
+    const shots = options.shots.filter((shot) => shot.start + shot.duration > options.range.start + 1e-6 && shot.start < options.range.end - 1e-6);
+    let frame = 0;
+    for (const shot of shots) {
+      options.signal?.throwIfAborted();
+      const shotEnd = Math.min(options.range.end, shot.start + shot.duration);
+      const times: number[] = [];
+      const outTimes: number[] = [];
+      while (frame < frameCount) {
+        const outTime = frame / fps;
+        const songTime = options.range.start + outTime;
+        if (songTime >= shotEnd - 1e-6 && shot !== shots[shots.length - 1]) break;
+        outTimes.push(outTime);
+        times.push(Math.max(0, shot.sourceStart + (songTime - shot.start)));
+        frame++;
+      }
+      if (!times.length) continue;
+      const source = await reader(shot.clipId);
+      const focusX = options.clips.get(shot.clipId)?.focusX ?? 0.5;
+      const crop = source ? coverCrop(source.width, source.height, width, height, focusX) : null;
+      let index = 0;
+      let last: { close(): void } | null = null;
+      const draw = async (sample: Awaited<ReturnType<InstanceType<typeof VideoSampleSink>["getSample"]>> | null) => {
+        if (sample && crop) {
+          context.fillStyle = "#000";
+          context.fillRect(0, 0, width, height);
+          sample.draw(context, crop.x, crop.y, crop.width, crop.height, 0, 0, width, height);
+          // A repeated frame can come back as the same sample; only close real replacements.
+          if (last && last !== sample) last.close();
+          last = sample;
+        } else if (!last) {
+          context.fillStyle = "#000";
+          context.fillRect(0, 0, width, height);
+        }
+        await videoSource.add(outTimes[index], 1 / fps, { keyFrame: index === 0 || Math.round(outTimes[index] * fps) % (fps * 2) === 0 });
+        index++;
+        if ((frame - times.length + index) % 15 === 0) {
+          options.onProgress?.(0.03 + 0.95 * ((frame - times.length + index) / frameCount), `Rendering frame ${frame - times.length + index} of ${frameCount}`);
+        }
+      };
+      if (source) {
+        for await (const sample of source.sink.samplesAtTimestamps(times)) {
+          options.signal?.throwIfAborted();
+          await draw(sample);
+        }
+      }
+      while (index < times.length) await draw(null);
+      (last as { close(): void } | null)?.close();
+    }
+    videoSource.close();
+    options.onProgress?.(0.99, "Finalising the file");
+    await output.finalize();
+    if (!target.buffer) throw new Error("The encoder produced an empty file.");
+    const mime = plan.container === "mp4" ? "video/mp4" : "video/webm";
+    return { blob: new Blob([target.buffer], { type: mime }), extension: plan.container, mime, codec: `${plan.video.toUpperCase()} + ${plan.audio.toUpperCase()}`, seconds: (performance.now() - started) / 1000 };
+  } catch (error) {
+    if (output.state !== "finalized" && output.state !== "canceled") await output.cancel().catch(() => undefined);
+    throw error;
+  } finally {
+    for (const entry of inputs.values()) entry.input.dispose();
+  }
+}
diff --git a/tools/src/autocut/timeline.tsx b/tools/src/autocut/timeline.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e55ba1bfcbe7b2ba5c1547b21a4a4b96e453e56e
--- /dev/null
+++ b/tools/src/autocut/timeline.tsx
@@ -0,0 +1,166 @@
+import { useEffect, useMemo, useRef, type PointerEvent } from "react";
+import type { Shot } from "../../../lib/autocut-cut";
+import { SECTION_LABELS, type MusicAnalysis, type SectionLabel } from "../../../lib/autocut-music";
+
+export const SECTION_COLORS: Record<SectionLabel, string> = {
+  intro: "#5ca7ff",
+  verse: "#4ee3b0",
+  build: "#f4c96b",
+  chorus: "#ff8a5c",
+  drop: "#ff6f91",
+  break: "#b79cff",
+  outro: "#5ca7ff",
+};
+
+const RULER = 16;
+const SECTIONS = 22;
+const ENERGY = 46;
+const SHOTS = 56;
+const HEIGHT = RULER + SECTIONS + ENERGY + SHOTS + 6;
+
+type Props = {
+  music: MusicAnalysis;
+  shots: Shot[];
+  range: { start: number; end: number };
+  time: number;
+  selected: number;
+  zoom: number;
+  clipColor: (clipId: string) => string;
+  thumbnail: (clipId: string) => HTMLImageElement | undefined;
+  onSeek: (time: number) => void;
+  onSelect: (index: number) => void;
+};
+
+/**
+ * The AutoCut timeline: section guesses, the energy curve over the beat grid
+ * (bar downbeats taller), and the shot strip with thumbnails, hero and lock
+ * marks. Drawn to one canvas; the playhead is a separate element so playback
+ * doesn't redraw thousands of pixels per frame.
+ */
+export function Timeline({ music, shots, range, time, selected, zoom, clipColor, thumbnail, onSeek, onSelect }: Props) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const scrollRef = useRef<HTMLDivElement | null>(null);
+  const width = Math.max(320, Math.round(music.duration * zoom));
+  const x = useMemo(() => (seconds: number) => seconds * zoom, [zoom]);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const ratio = Math.min(2, window.devicePixelRatio || 1);
+    canvas.width = Math.min(32000, Math.round(width * ratio));
+    canvas.height = Math.round(HEIGHT * ratio);
+    const context = canvas.getContext("2d")!;
+    context.setTransform(canvas.width / width, 0, 0, ratio, 0, 0);
+    context.clearRect(0, 0, width, HEIGHT);
+    context.font = "10px SFMono-Regular, Consolas, monospace";
+    context.textBaseline = "middle";
+
+    // Ruler: a label every N seconds.
+    const step = zoom > 60 ? 1 : zoom > 24 ? 5 : zoom > 8 ? 10 : 30;
+    context.fillStyle = "#8994a8";
+    for (let second = 0; second <= music.duration; second += step) {
+      context.fillRect(x(second), 0, 1, 5);
+      context.fillText(`${Math.floor(second / 60)}:${String(Math.floor(second % 60)).padStart(2, "0")}`, x(second) + 3, 9);
+    }
+
+    // Sections.
+    for (const section of music.sections) {
+      const left = x(section.start), w = x(section.end) - left;
+      context.fillStyle = `${SECTION_COLORS[section.label]}33`;
+      context.fillRect(left, RULER, w - 1, SECTIONS - 2);
+      context.fillStyle = SECTION_COLORS[section.label];
+      context.fillRect(left, RULER, 2, SECTIONS - 2);
+      if (w > 44) context.fillText(SECTION_LABELS[section.label].toUpperCase(), left + 6, RULER + SECTIONS / 2);
+    }
+
+    // Beat grid + energy curve.
+    const top = RULER + SECTIONS;
+    const downbeats = new Set(music.downbeats.map((beat) => Math.round(beat * 1000)));
+    for (const beat of music.beats) {
+      const isDown = downbeats.has(Math.round(beat * 1000));
+      if (!isDown && zoom < 14) continue;
+      context.fillStyle = isDown ? "rgba(255,255,255,.22)" : "rgba(255,255,255,.08)";
+      context.fillRect(x(beat), isDown ? top : top + ENERGY * 0.55, 1, isDown ? ENERGY : ENERGY * 0.45);
+    }
+    context.beginPath();
+    music.energy.forEach((value, index) => {
+      const px = x(index * music.energyStep), py = top + ENERGY - 3 - value * (ENERGY - 8);
+      if (index) context.lineTo(px, py); else context.moveTo(px, py);
+    });
+    context.strokeStyle = "#8a7cff";
+    context.lineWidth = 1.5;
+    context.stroke();
+    if (music.dropStrength > 0.15) {
+      context.fillStyle = "#ff6f91";
+      context.fillRect(x(music.dropTime) - 1, top, 2, ENERGY);
+      context.fillText("DROP", x(music.dropTime) + 4, top + 8);
+    }
+
+    // Shots.
+    const shotTop = top + ENERGY + 4;
+    shots.forEach((shot, index) => {
+      const left = x(shot.start), w = Math.max(1, x(shot.duration) - 1);
+      context.fillStyle = clipColor(shot.clipId);
+      context.globalAlpha = 0.85;
+      context.fillRect(left, shotTop, w, SHOTS - 4);
+      context.globalAlpha = 1;
+      const image = thumbnail(shot.clipId);
+      if (image?.complete && w > 26) {
+        const h = SHOTS - 16;
+        const tw = Math.min(w - 4, h * (image.naturalWidth / Math.max(1, image.naturalHeight)));
+        context.drawImage(image, left + 2, shotTop + 2, tw, h);
+      }
+      if (shot.hero) { context.fillStyle = "#f4c96b"; context.fillRect(left, shotTop + SHOTS - 8, Math.min(w, 10), 3); }
+      if (shot.locked) {
+        context.fillStyle = "#ffffff";
+        context.fillRect(left, shotTop, w, 3);
+        if (w > 40) context.fillText("LOCK", left + 3, shotTop + SHOTS - 12);
+      }
+      if (shot.synced && w > 18) { context.fillStyle = "#0d1119"; context.fillText("♪", left + w - 10, shotTop + SHOTS - 12); }
+      if (index === selected) {
+        context.strokeStyle = "#ffffff";
+        context.lineWidth = 2;
+        context.strokeRect(left + 1, shotTop + 1, w - 2, SHOTS - 6);
+      }
+    });
+
+    // Outside the cut range: dim.
+    context.fillStyle = "rgba(8,10,16,.7)";
+    if (range.start > 0) context.fillRect(0, RULER, x(range.start), HEIGHT - RULER);
+    if (range.end < music.duration) context.fillRect(x(range.end), RULER, width - x(range.end), HEIGHT - RULER);
+  }, [music, shots, range, selected, zoom, width, x, clipColor, thumbnail]);
+
+  // Keep the playhead in view while playing.
+  useEffect(() => {
+    const scroller = scrollRef.current;
+    if (!scroller) return;
+    const px = x(time);
+    if (px < scroller.scrollLeft + 20 || px > scroller.scrollLeft + scroller.clientWidth - 40) scroller.scrollLeft = Math.max(0, px - scroller.clientWidth * 0.25);
+  }, [time, x]);
+
+  const pick = (event: PointerEvent<HTMLCanvasElement>) => {
+    const rect = event.currentTarget.getBoundingClientRect();
+    const seconds = ((event.clientX - rect.left) / rect.width) * music.duration;
+    const y = event.clientY - rect.top;
+    if (y >= RULER + SECTIONS + ENERGY) {
+      const index = shots.findIndex((shot) => seconds >= shot.start && seconds < shot.start + shot.duration);
+      if (index >= 0) onSelect(index);
+    }
+    onSeek(seconds);
+  };
+
+  return (
+    <div className="ac-timeline" ref={scrollRef}>
+      <div style={{ position: "relative", width, height: HEIGHT }}>
+        <canvas
+          ref={canvasRef}
+          style={{ width, height: HEIGHT, display: "block", cursor: "pointer" }}
+          onPointerDown={pick}
+          role="img"
+          aria-label={`Timeline: ${music.sections.length} sections, ${shots.length} shots. Click to seek or select a shot.`}
+        />
+        <div className="ac-playhead" style={{ left: x(time) }} aria-hidden="true" />
+      </div>
+    </div>
+  );
+}
