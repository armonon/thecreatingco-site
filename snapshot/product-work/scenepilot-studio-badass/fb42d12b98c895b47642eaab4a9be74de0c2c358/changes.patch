+/* ScenePilot film tools — same tokens as the editor's current visual system
+   (the final :root block in app/globals.css): deep blue-black surfaces,
+   violet→blue accent gradient, mono uppercase labels, 8/12 px radii.
+   Self-contained so the tools don't pull in the editor's 3,500-line stylesheet. */
+:root {
+  color-scheme: dark;
+  --font-sans: Arial, sans-serif;
+  --font-mono: "SFMono-Regular", Consolas, monospace;
+  --ink: #f4f7fb;
+  --muted: #8994a8;
+  --line: rgba(255, 255, 255, .075);
+  --line-strong: rgba(255, 255, 255, .13);
+  --black: #080a10;
+  --surface-1: #0d1119;
+  --surface-2: #121823;
+  --surface-3: #18202d;
+  --field: #0a0d14;
+  --accent: #8a7cff;
+  --accent-2: #5ca7ff;
+  --accent-soft: rgba(138, 124, 255, .12);
+  --positive: #4ee3b0;
+  --warning: #f4c96b;
+  --danger: #ff6f91;
+  --violet: #b79cff;
+  --radius-panel: 12px;
+  --radius-control: 8px;
+  /* Legacy names used below, mapped onto the current palette. */
+  --cyan: var(--accent);
+  --coral: var(--danger);
+  --lime: var(--positive);
+  --yellow: var(--warning);
+}
+* { box-sizing: border-box; }
+html, body { margin: 0; min-height: 100%; background: var(--black); color: var(--ink); }
+body { font-family: var(--font-sans); font-size: 14px; line-height: 1.45; }
+button, input, select, textarea { font: inherit; color: inherit; }
+a { color: inherit; }
+:focus-visible { outline: 2px solid #968cff; outline-offset: 2px; }
+.skip-link { position: fixed; left: 12px; top: -60px; z-index: 100; background: var(--cyan); color: #fff; padding: 8px 12px; }
+.skip-link:focus { top: 10px; }
+[hidden] { display: none !important; }
+
+.tool-page { min-height: 100vh; display: flex; flex-direction: column; }
+.tool-topbar { position: sticky; top: 0; z-index: 30; min-height: 54px; padding: 8px 18px; display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; border-bottom: 1px solid var(--line); background: rgba(8, 10, 16, .86); backdrop-filter: blur(10px); }
+.tool-brand { display: flex; align-items: center; gap: 10px; }
+.tool-brand > div { display: flex; gap: 7px; align-items: baseline; }
+.tool-brand strong { font-size: 13px; }
+.tool-brand span { font: 10px var(--font-mono); color: var(--muted); }
+.tool-back { width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 6px; color: var(--muted); text-decoration: none; }
+.tool-back:hover { border-color: var(--cyan); color: var(--ink); }
+.tool-mark { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.14); border-radius: 9px; color: #fff; background: linear-gradient(145deg, #9b8cff, #536cff 62%, #3ec8d7); box-shadow: 0 7px 22px rgba(100, 91, 255, .28), inset 0 1px rgba(255,255,255,.3); }
+.alpha-badge { padding: 4px 8px; border: 1px solid rgba(244, 201, 107, .32); border-radius: 999px; background: rgba(244, 201, 107, .1); color: var(--warning); font: 8px var(--font-mono); font-weight: 850; letter-spacing: .1em; }
+.tool-switcher { display: flex; justify-content: center; gap: 4px; flex-wrap: wrap; }
+.tool-switcher a { display: inline-flex; align-items: center; gap: 6px; padding: 7px 11px; border: 1px solid transparent; border-radius: 4px; color: #9ba6b9; text-decoration: none; font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
+.tool-switcher a:hover { background: var(--surface-3); color: var(--ink); }
+.tool-switcher a[aria-current="page"] { border-color: var(--accent); background: var(--accent-soft); color: var(--cyan); }
+.tool-actions { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
+.tool-editor-link { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 11px; border: 1px solid #4d4374; background: #171428; color: #d8d1ff; border-radius: 4px; text-decoration: none; font-size: 12px; font-weight: 700; white-space: nowrap; }
+.tool-main { flex: 1; width: min(1360px, 100%); margin: 0 auto; padding: 22px clamp(14px, 3vw, 36px) 36px; }
+.tool-footer { border-top: 1px solid var(--line); padding: 14px clamp(14px, 3vw, 36px); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: start; color: var(--muted); font-size: 12px; }
+.tool-footer p { margin: 0; }
+.tool-limits summary { cursor: pointer; color: var(--warning); font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
+.tool-limits ul { margin: 10px 0 0; padding-left: 18px; max-width: 760px; color: #a7b0c0; }
+.tool-limits li { margin: 4px 0; }
+
+.tool-heading { margin-bottom: 18px; display: flex; justify-content: space-between; gap: 18px; align-items: end; flex-wrap: wrap; }
+.tool-heading h1 { margin: 6px 0 4px; font-size: clamp(28px, 3.4vw, 46px); line-height: 1; letter-spacing: -.5px; }
+.tool-heading p { margin: 0; color: #a7b0c0; max-width: 640px; }
+.eyebrow { display: flex; align-items: center; gap: 7px; color: var(--accent-2); font: 10px var(--font-mono); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
+
+.panel { border: 1px solid var(--line); border-radius: var(--radius-panel); background: var(--surface-1); box-shadow: 0 14px 38px rgba(0, 0, 0, .24), inset 0 1px rgba(255, 255, 255, .025); overflow: hidden; }
+.panel-title { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--line); font: 10px var(--font-mono); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #c3cbd9; }
+.panel-title small { color: var(--muted); font-weight: 400; letter-spacing: .04em; }
+.panel-body { padding: 12px; }
+
+.btn { height: 34px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--line-strong); background: var(--surface-2); color: #e4e9f2; border-radius: var(--radius-control); font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; text-decoration: none; }
+.btn:hover:not(:disabled) { border-color: var(--cyan); }
+.btn:disabled { opacity: .45; cursor: not-allowed; }
+.btn.primary { border-color: transparent; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; box-shadow: 0 8px 22px rgba(138, 124, 255, .28); }
+.btn.primary:hover:not(:disabled) { filter: brightness(1.08); }
+.btn.danger { color: var(--coral); }
+.btn.small { height: 28px; padding: 0 9px; font-size: 11px; }
+.btn.icon { width: 30px; padding: 0; }
+.btn-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+
+.field { display: grid; gap: 5px; }
+.field > span { font: 9px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
+.field input, .field select, .field textarea, .text-input { width: 100%; min-height: 32px; padding: 6px 8px; border: 1px solid var(--line-strong); background: var(--field); border-radius: 4px; color: var(--ink); }
+.field textarea { resize: vertical; line-height: 1.5; }
+input[type="range"] { accent-color: var(--cyan); }
+
+.segmented { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 4px; overflow: hidden; }
+.segmented button { border: 0; border-right: 1px solid var(--line-strong); background: var(--surface-2); padding: 6px 10px; font: 10px var(--font-mono); text-transform: uppercase; cursor: pointer; color: #a7b0c0; }
+.segmented button:last-child { border-right: 0; }
+.segmented button[aria-pressed="true"] { background: var(--accent-soft); color: var(--cyan); }
+
+.dropzone { min-height: 220px; display: grid; place-items: center; text-align: center; gap: 8px; padding: 24px; border: 1px dashed var(--line-strong); background: var(--field); color: var(--muted); cursor: pointer; border-radius: 4px; }
+.dropzone:hover, .dropzone.dragging { border-color: var(--cyan); color: var(--ink); }
+.dropzone strong { display: block; color: var(--ink); font-size: 15px; }
+.dropzone small { display: block; }
+
+.status-line { min-height: 20px; margin: 10px 0 0; color: #a7b0c0; font-size: 12px; display: flex; gap: 8px; align-items: center; }
+.status-line.error { color: var(--coral); }
+.progress { height: 4px; background: var(--surface-3); overflow: hidden; }
+.progress i { display: block; height: 100%; background: var(--cyan); transition: width 160ms linear; }
+.note { color: var(--muted); font-size: 12px; margin: 8px 0 0; }
+.note strong { color: #c3cbd9; }
+.handoff { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 12px; }
+.handoff ol { margin: 6px 0 0; padding-left: 18px; color: #a7b0c0; font-size: 12px; }
+
+/* --- Hub -------------------------------------------------------------- */
+.hub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
