diff --git a/scripts/build-pwa.mjs b/scripts/build-pwa.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b5646c1cef112fb7b30cedd010b12426030725ee
--- /dev/null
+++ b/scripts/build-pwa.mjs
@@ -0,0 +1,66 @@
+// Writes site/sw.js from public/sw.js with the precache list of the CURRENT
+// site/app (editor) and site/tools (film tools) builds, and copies the web app
+// manifest + icons. Run after `npm run build:app` and `npm run build:tools`.
+//
+//   node scripts/build-pwa.mjs            -> site/sw.js, site/manifest.webmanifest
+//   node scripts/build-pwa.mjs --check    -> prints the precache summary only
+//
+// Precached: HTML entry pages, every JS/CSS/worker/font/image the bundles emit,
+// icons and small models. Not precached (cached on first use instead): the
+// ~34 MB MediaPipe WASM runtime under /app/mediapipe/.
+import { createHash } from "node:crypto";
+import { copyFileSync, existsSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+const root = path.resolve(import.meta.dirname, "..");
+const site = path.join(root, "site");
+const checkOnly = process.argv.includes("--check");
+const MAX_PRECACHE_FILE = 2 * 1024 * 1024;
+
+function walk(directory, prefix) {
+  if (!existsSync(directory)) return [];
+  return readdirSync(directory).flatMap((name) => {
+    const full = path.join(directory, name);
+    const url = `${prefix}${name}`;
+    return statSync(full).isDirectory() ? walk(full, `${url}/`) : [{ full, url }];
+  });
+}
+
+const entries = [
+  ...walk(path.join(site, "app"), "/app/").filter(({ url }) => !url.startsWith("/app/mediapipe/")),
+  ...walk(path.join(site, "tools"), "/tools/"),
+].filter(({ full, url }) => !url.endsWith(".map") && !url.endsWith("/NOTICE.txt") && statSync(full).size <= MAX_PRECACHE_FILE);
+
+if (!entries.some(({ url }) => url === "/app/index.html")) throw new Error("site/app/index.html missing: run `npm run build:app` first.");
+if (!entries.some(({ url }) => url === "/tools/index.html")) throw new Error("site/tools/index.html missing: run `npm run build:tools` first.");
+
+const statics = ["manifest.webmanifest", "app-icon-192.png", "app-icon-512.png", "app-icon-maskable-512.png", "app-icon-maskable-192.png"];
+const hash = createHash("sha256");
+const urls = [];
+for (const { full, url } of entries.sort((a, b) => a.url.localeCompare(b.url))) {
+  hash.update(url).update(readFileSync(full));
+  urls.push(url.endsWith("/index.html") ? url.slice(0, -"index.html".length) : url);
+}
+for (const name of statics) {
+  const source = path.join(root, "public", name);
+  if (!existsSync(source)) continue;
+  hash.update(name).update(readFileSync(source));
+  urls.push(`/${name}`);
+}
+const template = readFileSync(path.join(root, "public", "sw.js"), "utf8");
+hash.update(template);
+const buildId = hash.digest("hex").slice(0, 12);
+const bytes = entries.reduce((sum, { full }) => sum + statSync(full).size, 0);
+console.log(`PWA precache: ${urls.length} URLs, ${(bytes / 1e6).toFixed(1)} MB, build ${buildId}`);
+if (checkOnly) process.exit(0);
+
+const output = template
+  .replace(/^const BUILD_ID = "dev";$/m, `const BUILD_ID = ${JSON.stringify(buildId)};`)
+  .replace(/^const PRECACHE = \[\];$/m, `const PRECACHE = ${JSON.stringify(urls, null, 0).replaceAll("\",\"", "\",\n  \"")};`);
+if (output === template) throw new Error("public/sw.js placeholders not found.");
+writeFileSync(path.join(site, "sw.js"), output);
+for (const name of statics) {
+  const source = path.join(root, "public", name);
+  if (existsSync(source)) copyFileSync(source, path.join(site, name));
+}
+console.log("Wrote site/sw.js and copied the manifest + icons.");
diff --git a/scripts/certify-disk-pressure.mjs b/scripts/certify-disk-pressure.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b202e729bd3a6ff1a0f2184ad11544d5a50f8a83
--- /dev/null
+++ b/scripts/certify-disk-pressure.mjs
@@ -0,0 +1,43 @@
+import { execFile } from "node:child_process";
+import { mkdtemp, mkdir, open, readFile, unlink, rm } from "node:fs/promises";
+import { promisify } from "node:util";
+import os from "node:os";
+import path from "node:path";
+import { writeAtomicFile } from "../electron/atomic-file.js";
+
+// Fill only a dedicated 32 MB disk image, never the user's system volume.
+const run = promisify(execFile);
+if (process.platform !== "darwin") throw new Error("This isolated disk-pressure certificate requires macOS hdiutil.");
+const workspace = await mkdtemp(path.join(os.tmpdir(), "scenepilot-disk-pressure-"));
+const mount = path.join(workspace, "volume");
+let mounted = false;
+let passed = false;
+try {
+  await mkdir(mount);
+  await run("hdiutil", ["create", "-size", "32m", "-fs", "HFS+", "-volname", "ScenePilot QA", path.join(workspace, "disk.dmg")], { timeout: 30000 });
+  await run("hdiutil", ["attach", path.join(workspace, "disk.dmg"), "-mountpoint", mount, "-nobrowse"], { timeout: 30000 }); mounted = true;
+  const document = path.join(mount, "project.json");
+  await writeAtomicFile(document, '{"revision":1}');
+  const filler = path.join(mount, "filler");
+  const handle = await open(filler, "wx");
+  let full = false;
+  try {
+    const bytes = Buffer.alloc(1024 * 1024, 1);
+    // Hard upper bound protects against a mount failure or unexpected volume.
+    for (let i = 0; i < 40; i++) await handle.write(bytes);
+  } catch (error) { if (error.code !== "ENOSPC") throw error; full = true; }
+  finally { await handle.close(); }
+  if (!full) throw new Error("Dedicated fixture did not reach ENOSPC within the 40 MB limit.");
+  let code;
+  try { await writeAtomicFile(document, JSON.stringify({ revision: 2, payload: "x".repeat(4 * 1024 * 1024) })); }
+  catch (error) { code = error.code; }
+  if (code !== "ENOSPC" || await readFile(document, "utf8") !== '{"revision":1}') throw new Error("Disk-full save did not safely preserve the previous document.");
+  await unlink(filler);
+  await writeAtomicFile(document, '{"revision":3}');
+  if (await readFile(document, "utf8") !== '{"revision":3}') throw new Error("Save did not recover after space was freed.");
+  passed = true;
+  console.log(JSON.stringify({ schema: "scenepilot-disk-pressure/v1", passed, volumeMegabytes: 32, observedError: code, previousDocumentPreserved: true, retrySucceeded: true }, null, 2));
+} finally {
+  if (mounted) { await run("hdiutil", ["detach", mount], { timeout: 30000 }); mounted = false; }
+  if (!mounted && passed) await rm(workspace, { recursive: true, force: true });
+}
diff --git a/scripts/certify-engine-parity-electron.mjs b/scripts/certify-engine-parity-electron.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..581143211c4df7b631bc3c33dacb78b5f5f099fb
--- /dev/null
+++ b/scripts/certify-engine-parity-electron.mjs
@@ -0,0 +1,19 @@
+// Runs the Pro half of the engine-parity harness in an offscreen Chromium page.
+import { app, BrowserWindow } from "electron";
+import { readFile, writeFile } from "node:fs/promises";
+
+// Mirror the real app: GPU compositing and hardware video paths stay enabled unless
+// PARITY_PRO_SOFTWARE=1 asks for the software-only path.
+if (process.env.PARITY_PRO_SOFTWARE === "1") app.disableHardwareAcceleration();
+const timeout = setTimeout(() => { process.stderr.write("Engine-parity Pro render timed out.\n"); app.exit(1); }, 600_000);
+app.whenReady().then(async () => {
+  const payload = JSON.parse(await readFile(process.argv.at(-1), "utf8"));
+  const window = new BrowserWindow({ show: false, webPreferences: { offscreen: true, sandbox: true, contextIsolation: true } });
+  window.webContents.on("console-message", (event) => process.stderr.write(`${event.message}\n`));
+  await window.loadFile(payload.html);
+  const bundle = await readFile(payload.bundle, "utf8");
+  const input = await readFile(payload.input, "utf8");
+  const results = await window.webContents.executeJavaScript(`${bundle}\n(() => { const i = ${input}; return ScenePilotParity.render(i.cases, i.media); })()`);
+  await writeFile(payload.result, JSON.stringify(results));
+  window.destroy(); clearTimeout(timeout); app.quit();
+}).catch((error) => { process.stderr.write(`${error.stack ?? error}\n`); clearTimeout(timeout); app.exit(1); });
diff --git a/scripts/certify-engine-parity-pro.ts b/scripts/certify-engine-parity-pro.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b237ce8fb3c308dc264ed4994bf958bbea6a6a8
--- /dev/null
+++ b/scripts/certify-engine-parity-pro.ts
@@ -0,0 +1,73 @@
+/* eslint-disable @typescript-eslint/no-explicit-any -- a saved document is untyped JSON; each read below mirrors the app's own coercion. */
+// Pro side of the engine-parity harness: render a saved `scenepilot-cut` document
+// through Pro's real export path (`renderProject`), mapping document → options
+// exactly as the app's loader and delivery do. Each mapping names its source so a
+// change in the app can be mirrored here.
+import { renderProject, type RenderOptions } from "../lib/render-engine";
+import { coerceEffectSettings } from "../lib/project-store";
+import { readProjectSettings } from "../lib/project-settings";
+import { splitUnifiedTimeline, toUnifiedTimeline } from "../lib/video-timeline";
+import { PUNCH_PRESETS, SHAKE_PRESETS } from "../lib/motion";
+import { GRADE_PRESETS, applyGradeAdjust, isNeutralGrade } from "../lib/grade";
+import { applyDisplayTransform, DEFAULT_COLOR_MANAGEMENT, type ColorManagementSettings } from "../lib/color-management";
+import { TRANSITION_PRESETS } from "../lib/transitions";
+import { DROP_RAMP } from "../lib/speed";
+import { beatSecondsFrom } from "../lib/stutter";
+import type { BaseCut } from "../lib/sequencer";
+import { coerceRenderAnalysis } from "../lib/render-analysis";
+
+type Doc = Record<string, any>;
+type Media = Record<string, { name: string; kind: "video" | "audio" | "image"; base64: string }>;
+
+const file = (m: Media[string]) => new File([Uint8Array.from(atob(m.base64), (c) => c.charCodeAt(0))], m.name, { type: m.kind === "audio" ? "audio/wav" : "video/mp4" });
+
+export function renderOptions(doc: Doc, media: Media): RenderOptions {
+  const effects = coerceEffectSettings(doc.effects); // page.tsx applyEffects
+  const settings = readProjectSettings(doc.settings); // page.tsx applyProjectSettings
+  // page.tsx importPlan: canonical videoClips, else the legacy pair.
+  const unified = doc.videoClips?.length ? doc.videoClips : toUnifiedTimeline(doc.baseCuts ?? [], doc.placements ?? [], "__base__");
+  const { baseCuts, placements } = splitUnifiedTimeline(unified);
+  const beats: number[] = doc.beats ?? [];
+  const saved = coerceRenderAnalysis(doc.renderAnalysis); // parseCutFile; page.tsx savedRenderAnalysis
+  // page.tsx energySections
+  const active = (doc.sections ?? []).filter((s: any) => s.enabled !== false).sort((a: any, b: any) => a.start - b.start)
+    .map((s: any) => ({ start: s.start, end: s.end, energy: s.energy }));
+  const colorManagement: ColorManagementSettings = { ...DEFAULT_COLOR_MANAGEMENT, ...(doc.proState?.colorManagement ?? {}) };
+  // page.tsx gradeParams / hasShaderEffect (curves and LUTs are outside this harness)
+  const gradeParams = { ...applyDisplayTransform({ ...applyGradeAdjust(GRADE_PRESETS[effects.lookPreset as keyof typeof GRADE_PRESETS], effects.manualGrade), mirror: effects.mirrorMode, streak: effects.streak }, colorManagement), curveLut: undefined, lut3d: undefined };
+  const hasShaderEffect = effects.lookPreset !== "none" || effects.mirrorMode > 0 || effects.streak > 0 || !isNeutralGrade(effects.manualGrade);
+  // page.tsx dropRampSetting: with no live analysis, the resolved drop saved in the document.
+  const dropRamp = effects.dropRampEnabled && saved?.dropRamp && beats.length > 1
+    ? { dropTime: doc.proState?.manualDropTime ?? saved.dropRamp.dropTime, beatSeconds: beatSecondsFrom(beats), config: DROP_RAMP } : null;
+  const assets = (doc.assets ?? []).filter((a: any) => media[a.id]).map((a: any) => ({ id: a.id, file: file(media[a.id]), kind: a.kind }));
+  return {
+    mainFile: media.__main__ ? file(media.__main__) : null,
+    assets,
+    placements,
+    tracks: doc.tracks ?? [],
+    baseCuts: effects.montageEnabled ? (baseCuts as BaseCut[]) : [],
+    // page.tsx renderMotion
+    motion: { beats, accents: saved?.accents ?? [], punch: PUNCH_PRESETS[effects.punchPreset], shake: SHAKE_PRESETS[effects.shakePreset], affectOverlays: false, energySections: active.length ? active : undefined },
+    grade: hasShaderEffect ? { params: gradeParams, beatDriven: true } : undefined,
+    transition: TRANSITION_PRESETS[effects.transitionType as keyof typeof TRANSITION_PRESETS],
+    dropRamp,
+    titles: doc.titles ?? [],
+    duration: doc.duration,
+    frameRate: settings.exportFrameRate,
+    maxDimension: settings.exportMaxDimension,
+    aspect: settings.aspect,
+    customSize: settings.customSize,
+    hardwareAcceleration: "no-preference", // app/video-delivery.ts
+  };
+}
+
+export async function render(cases: Array<{ name: string; document: Doc }>, media: Media) {
+  const results = [];
+  for (const item of cases) {
+    console.info(`Pro render: ${item.name}`);
+    const blob = await renderProject({ ...renderOptions(item.document, media), onProgress: () => {} });
+    if (!blob) throw new Error(`${item.name} returned no output`);
+    results.push({ name: item.name, bytes: Array.from(new Uint8Array(await blob.arrayBuffer())) });
+  }
+  return results;
+}
diff --git a/scripts/certify-engine-parity.mjs b/scripts/certify-engine-parity.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..925ab2736dfda6aec994339bf461cf60ad465f8b
--- /dev/null
+++ b/scripts/certify-engine-parity.mjs
@@ -0,0 +1,121 @@
+// Engine-parity certificate: render the SAME saved Pro documents through Pro's real
+// export (Electron/Chromium, renderProject) and through the native engine (exact
+// translation + AVFoundation/Core Image export), decode both MP4s with one ffmpeg,
+// and measure per-frame error. A baseline case compares each export with its source
+// footage, separating encoder noise from engine differences.
+//
+//   node scripts/certify-engine-parity.mjs            # measure and enforce tolerances
+//   node scripts/certify-engine-parity.mjs --measure  # measure only
+import { build } from "esbuild";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import { mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import ffmpeg from "ffmpeg-static";
+import electron from "electron";
