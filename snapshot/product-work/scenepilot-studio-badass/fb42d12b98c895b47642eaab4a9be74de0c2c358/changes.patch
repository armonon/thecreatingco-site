+        "    <marker>",
+        `      <comment>${xml(marker.comment ?? "")}</comment>`,
+        `      <name>${xml(marker.name)}</name>`,
+        `      <in>${inFrame}</in>`,
+        `      <out>${outFrame > inFrame ? outFrame : -1}</out>`,
+        "    </marker>",
+      ].join("\n");
+    });
