+/**
+ * Rasterize the Luma mark (public/favicon.svg) into PWA icons with headless
+ * Chromium — no native image dependency needed.
+ *   PLAYWRIGHT=/path/to/node_modules/playwright node build/generate-pwa-icons.mjs
+ * "any" icons: mark on a rounded dark tile. Maskable: full-bleed tile, mark
+ * kept inside the 80% safe-zone circle.
+ */
+import { createRequire } from "node:module";
+import { readFile, writeFile, mkdir } from "node:fs/promises";
+const require = createRequire(import.meta.url);
+const { chromium } = require(process.env.PLAYWRIGHT ?? "playwright");
+const mark = (await readFile("public/favicon.svg", "utf8")).replace(/width="24" height="24"/, 'width="100%" height="100%"');
+const browser = await chromium.launch();
+const page = await browser.newPage({ deviceScaleFactor: 1 });
+await mkdir("public/icons", { recursive: true });
+for (const size of [192, 512]) for (const maskable of [false, true]) {
+  const inset = maskable ? 0.25 : 0.2;
+  await page.setViewportSize({ width: size, height: size });
+  await page.setContent(`<html><body style="margin:0;background:transparent">
+    <div style="width:${size}px;height:${size}px;background:#141619;border-radius:${maskable ? 0 : size * 0.22}px;display:grid;place-items:center">
+      <div style="width:${size * (1 - inset * 2)}px;height:${size * (1 - inset * 2)}px">${mark}</div>
+    </div></body></html>`);
+  const png = await page.screenshot({ omitBackground: true, clip: { x: 0, y: 0, width: size, height: size } });
+  const name = `public/icons/luma-${maskable ? "maskable-" : ""}${size}.png`;
+  await writeFile(name, png);
+  console.log(name, png.length);
+}
+await browser.close();
diff --git a/build/generate-sw.mjs b/build/generate-sw.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7c3a92cc3db94dabd56a23f90a1a907502d28814
--- /dev/null
+++ b/build/generate-sw.mjs
@@ -0,0 +1,52 @@
+/**
+ * Writes public/sw.js from build/sw-template.js after `next build`.
+ * The precache list is every hashed asset in .next/static (minus source maps
+ * and the on-device AI runtime, which needs the network for models anyway)
+ * plus the studio shells, manifests, icons, the default Lato faces and the
+ * starter/sample images the studio opens with.
+ */
+import { createHash } from "node:crypto";
+import { readdir, readFile, writeFile, stat } from "node:fs/promises";
+import { join, relative, resolve, sep } from "node:path";
+
+const root = resolve(process.argv[2] ?? ".");
+const staticDir = join(root, ".next", "static");
+const EXCLUDE = [/\.map$/, /(^|\/)ort-wasm[^/]*$/, /(^|\/)ort\.[^/]*\.mjs$/, /\.txt$/];
+
+async function walk(dir) {
+  const out = [];
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    const path = join(dir, entry.name);
+    if (entry.isDirectory()) out.push(...await walk(path));
+    else out.push(path);
+  }
+  return out;
+}
+
+const buildId = (await readFile(join(root, ".next", "BUILD_ID"), "utf8")).trim();
+const files = (await walk(staticDir)).map(path => relative(staticDir, path).split(sep).join("/"));
+const nextStatic = files.filter(path => !EXCLUDE.some(pattern => pattern.test(path))).map(path => `/_next/static/${path}`).sort();
+const publicAssets = [
+  "/luma.webmanifest", "/luma-iphone.webmanifest", "/luma-ipad.webmanifest", "/favicon.svg",
+  "/icons/luma-192.png", "/icons/luma-512.png", "/icons/luma-maskable-192.png", "/icons/luma-maskable-512.png",
+  "/fonts/Lato-Regular.ttf", "/fonts/Lato-Bold.ttf",
+  // Starter document + sample strip shown when the studio opens.
+  "/desert.jpg", "/film-desert.jpg", "/film-wave.jpg", "/film-sun.jpg", "/film-mountain.jpg", "/film-lake.jpg",
+];
+for (const asset of publicAssets) await stat(join(root, "public", asset));
+const shells = ["/studio", "/iphone", "/ipad"];
+const urls = [...shells, ...publicAssets, ...nextStatic];
+
+const template = await readFile(join(root, "build", "sw-template.js"), "utf8");
+const hash = createHash("sha256");
+hash.update(template);
+for (const asset of publicAssets) hash.update(await readFile(join(root, "public", asset)));
+hash.update(buildId);
+hash.update(urls.join("\n"));
+const version = `${buildId.slice(0, 12)}-${hash.digest("hex").slice(0, 10)}`;
+const bytes = await Promise.all(nextStatic.map(url => stat(join(staticDir, url.slice("/_next/static/".length))).then(s => s.size)));
+const sw = template
+  .replace('"__LUMA_SW_VERSION__"', JSON.stringify(version))
+  .replace("__LUMA_PRECACHE__", JSON.stringify(urls, null, 0));
+await writeFile(join(root, "public", "sw.js"), sw);
+console.log(`public/sw.js ${version}: ${urls.length} precached URLs, ${(bytes.reduce((a, b) => a + b, 0) / 1048576).toFixed(1)} MB of /_next/static`);
diff --git a/build/kill-switch-sw.js b/build/kill-switch-sw.js
new file mode 100644
index 0000000000000000000000000000000000000000..8d97b03a29033cc7d9f84ed83ef48ee03d86b844
--- /dev/null
+++ b/build/kill-switch-sw.js
@@ -0,0 +1,29 @@
+// Luma service worker KILL SWITCH.
+//
+// Deploy this file as /sw.js (overwriting the generated one) to make every
+// visitor's browser delete Luma's caches, unregister the worker and reload
+// open studio tabs from the network — no app code changes needed.
+//
+//   npm run build:netlify            # normal build (writes public/sw.js)
+//   cp build/kill-switch-sw.js public/sw.js
+//   npx -y netlify-cli deploy --build --site 87b9f549-4bb5-4d58-adac-139fe5e1e3e6 ...
+//     (or overlay just /sw.js onto the live deploy with the parity method)
+//
+// /sw.js is served with Cache-Control: no-cache (netlify.toml), so browsers
+// see this file on their next navigation instead of a cached old worker.
+// Plain JS, zero imports, so it can be dropped in as-is during an incident.
+self.addEventListener("install", () => {
+  self.skipWaiting();
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil(
+    (async () => {
+      const keys = await caches.keys();
+      await Promise.all(keys.filter((key) => key.startsWith("luma-")).map((key) => caches.delete(key)));
+      await self.registration.unregister();
+      const clients = await self.clients.matchAll({ type: "window" });
+      for (const client of clients) client.navigate(client.url);
+    })(),
+  );
+});
diff --git a/build/sw-template.js b/build/sw-template.js
new file mode 100644
index 0000000000000000000000000000000000000000..8ec18edddbe91f7f56f966e2816d07881a1d8feb
--- /dev/null
+++ b/build/sw-template.js
@@ -0,0 +1,152 @@
+/* Luma service worker — generated into public/sw.js by build/generate-sw.mjs.
+ *
+ * Dependency-free on purpose so it can be audited in one read:
+ * - Precaches the studio shells (/studio, /iphone, /ipad) and every hashed
+ *   /_next/static asset the editor can load (except the 27 MB on-device AI
+ *   runtime), plus the default Lato faces, icons and manifest — so the
+ *   studio opens, edits and exports offline after the first visit.
+ * - Studio navigations are network-first (fresh deploys win while online)
+ *   with a 4 s timeout, then the cached copy of that page, then the
+ *   precached /studio shell. Other pages on this domain (the marketing site,
+ *   /learn, /campaign) are never intercepted.
+ * - Never cached: /api/* (the server function), any non-GET request, and
+ *   anything cross-origin — except the shared thecreatingco.com suite
+ *   menu script, which is kept as a last-known copy so the menu still
+ *   renders offline.
+ * - /fonts/* and /pdfjs/* (static app assets that load on demand) are kept
+ *   after their first use. No user documents are ever stored here; Luma's
+ *   own autosave lives in IndexedDB.
+ * - Updates never apply mid-session: the waiting worker only activates
+ *   when the page posts {type: "SKIP_WAITING"}, which happens only after
+ *   the user clicks "Reload" on the in-app update prompt.
+ * Kill switch: build/kill-switch-sw.js (see docs/release/pwa.md).
+ */
+const VERSION = "__LUMA_SW_VERSION__";
+const PRECACHE_URLS = __LUMA_PRECACHE__;
+const PRECACHE = `luma-precache-${VERSION}`;
+const PAGES = "luma-pages-v1";
+const ASSETS = "luma-assets-v1";
+const SUITE = "luma-suite-v1";
+const SUITE_SCRIPT = "https://thecreatingco.com/suite/v1/suite.js";
+const SUITE_APPS = "https://thecreatingco.com/suite/v1/apps.json";
+const STUDIO_PATHS = new Set(["/studio", "/iphone", "/ipad"]);
+const PRECACHED = new Set(PRECACHE_URLS);
+
+const studioPath = (url) => {
+  const path = url.pathname.replace(/\/+$/, "") || "/";
+  return STUDIO_PATHS.has(path) ? path : null;
+};
+
+self.addEventListener("install", (event) => {
+  event.waitUntil((async () => {
+    const cache = await caches.open(PRECACHE);
+    const cached = new Set((await cache.keys()).map((request) => new URL(request.url).pathname));
+    // Reuse identical hashed files from the previous version's cache so an
+    // update only downloads what actually changed.
+    const previous = (await caches.keys()).filter((name) => name.startsWith("luma-precache-") && name !== PRECACHE);
+    const queue = PRECACHE_URLS.filter((url) => !cached.has(url));
+    const worker = async () => {
+      while (queue.length) {
+        const url = queue.shift();
+        const immutable = url.startsWith("/_next/static/");
+        let response = null;
+        if (immutable) for (const name of previous) {
+          response = await (await caches.open(name)).match(url);
+          if (response) break;
+        }
+        if (!response) {
+          response = await fetch(new Request(url, { cache: "reload", credentials: "same-origin" }));
+          if (!response.ok) throw new Error(`precache ${url}: ${response.status}`);
+        }
+        await cache.put(url, response);
+      }
+    };
+    await Promise.all(Array.from({ length: 6 }, worker));
+  })());
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil((async () => {
+    const names = await caches.keys();
+    await Promise.all(names.filter((name) => name.startsWith("luma-precache-") && name !== PRECACHE).map((name) => caches.delete(name)));
+    await self.clients.claim();
+  })());
+});
+
+self.addEventListener("message", (event) => {
+  if (event.data && event.data.type === "SKIP_WAITING") self.skipWaiting();
+});
+
+async function precached(pathname) {
+  return (await caches.open(PRECACHE)).match(pathname);
+}
+
+async function studioNavigation(request, path) {
+  const pages = await caches.open(PAGES);
+  try {
+    const response = await Promise.race([
+      fetch(request),
+      new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), 4000)),
+    ]);
+    if (response.ok && response.type === "basic") pages.put(path, response.clone());
+    return response;
+  } catch {
+    return (await pages.match(path)) || (await precached(path)) || (await precached("/studio")) || Response.error();
+  }
+}
+
+async function cacheFirst(request, cacheName) {
+  const cache = await caches.open(cacheName);
+  const hit = await cache.match(request);
+  if (hit) return hit;
+  const response = await fetch(request);
+  if (response.ok && response.type === "basic") cache.put(request, response.clone());
+  return response;
+}
+
+async function suiteAsset(request) {
+  const cache = await caches.open(SUITE);
+  try {
+    const response = await fetch(request);
+    if (response.ok) cache.put(request.url, response.clone());
+    return response;
+  } catch {
+    return (await cache.match(request.url)) || Response.error();
+  }
+}
+
+self.addEventListener("fetch", (event) => {
+  const { request } = event;
+  if (request.method !== "GET") return;
+  const url = new URL(request.url);
+  if (url.origin !== self.location.origin) {
+    if (url.href === SUITE_SCRIPT || url.href === SUITE_APPS) event.respondWith(suiteAsset(request));
+    return;
+  }
+  if (url.pathname.startsWith("/api/")) return;
+  if (request.mode === "navigate") {
+    const path = studioPath(url);
+    if (path) event.respondWith(studioNavigation(request, path));
+    return;
+  }
+  // Hashed build assets are immutable; ignore cache-busting queries on them.
+  if (PRECACHED.has(url.pathname) && (!url.search || url.pathname.startsWith("/_next/static/"))) {
+    event.respondWith((async () => {
+      const hit = await precached(url.pathname);
+      if (!hit) return fetch(request);
+      const isWorker = request.destination === "worker" || request.destination === "sharedworker";
+      if (!url.search && !url.hash && !isWorker) return hit;
+      // Turbopack workers read their bootstrap config from ?params= or
+      // #params= on their own location. A cached Response carries the cache
+      // key's URL, which would become the worker's location; a fresh
+      // Response takes the request URL (query and fragment included).
+      return new Response(hit.body, { status: hit.status, statusText: hit.statusText, headers: hit.headers });
+    })());
+    return;
+  }
+  if (url.pathname.startsWith("/fonts/") || url.pathname.startsWith("/pdfjs/")) {
+    event.respondWith(cacheFirst(request, ASSETS));
+  }
+  // Everything else (RSC payloads, the marketing site's own assets, /learn)
+  // is not intercepted at all.
+});
diff --git a/build/verify-figma-export.mjs b/build/verify-figma-export.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ae2caaa68b2b941eee0c24f4644446bd42ad17ac
--- /dev/null
+++ b/build/verify-figma-export.mjs
@@ -0,0 +1,124 @@
+/**
+ * End-to-end check of "Export for Figma" in the real studio (headless Chrome).
+ *
+ *   PLAYWRIGHT=/path/to/node_modules/playwright \
+ *   RESVG=/path/to/node_modules/@resvg/resvg-js \
+ *   node build/verify-figma-export.mjs http://localhost:3123 fixture.luma out-dir
+ *
+ * Playwright and resvg are not dependencies of this repo; point at any local
+ * install. Steps: open /studio, open the fixture project, export PNG (Luma's
+ * own renderer = reference), export for Figma (live text) and again with
+ * "Outline text", then:
+ *   1. parse each SVG with an independent XML parser (resvg's usvg),
+ *   2. rasterize with resvg and with Chrome (inline SVG in the studio page so
+ *      the same bundled web fonts apply),
+ *   3. pixel-compare against the PNG within tolerance.
+ * Figma itself is not installed here; this verifies by spec + rasterization.
+ */
+import { createRequire } from "node:module";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { readdirSync } from "node:fs";
+import { resolve, join } from "node:path";
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(process.env.PLAYWRIGHT ?? "playwright");
+const { Resvg } = require(process.env.RESVG ?? "@resvg/resvg-js");
+const { PNG } = require(process.env.PNGJS ?? "pngjs");
+
+const [base = "http://localhost:3123", fixture = "artifacts/figma-export/fixture.luma", outDir = "artifacts/figma-export"] = process.argv.slice(2);
+await mkdir(outDir, { recursive: true });
+const fontDir = resolve("public/fonts");
+const fontFiles = readdirSync(fontDir).filter(f => f.endsWith(".ttf")).map(f => join(fontDir, f));
+
+const decode = (buffer) => PNG.sync.read(buffer);
+function compare(reference, actual, label, { channel = 32, maxFraction = 0.02 } = {}) {
+  if (reference.width !== actual.width || reference.height !== actual.height) throw new Error(`${label}: size ${actual.width}x${actual.height} != ${reference.width}x${reference.height}`);
+  let differing = 0, worst = 0, total = 0;
+  const diff = new PNG({ width: reference.width, height: reference.height });
+  for (let i = 0; i < reference.data.length; i += 4) {
+    // Compare premultiplied-on-white so transparent pixels with junk RGB agree.
+    const over = (d, j) => [0, 1, 2].map(c => d[j + c] * d[j + 3] / 255 + 255 * (1 - d[j + 3] / 255));
+    const a = over(reference.data, i), b = over(actual.data, i);
+    const delta = Math.max(...a.map((v, c) => Math.abs(v - b[c])), Math.abs(reference.data[i + 3] - actual.data[i + 3]));
+    total += delta; worst = Math.max(worst, delta);
+    const bad = delta > channel;
+    if (bad) differing += 1;
+    diff.data[i] = bad ? 255 : a[0] * 0.3; diff.data[i + 1] = bad ? 0 : a[1] * 0.3; diff.data[i + 2] = bad ? 0 : a[2] * 0.3; diff.data[i + 3] = 255;
+  }
+  const pixels = reference.width * reference.height;
+  const result = { label, differingFraction: differing / pixels, meanDelta: total / pixels, worst, pass: differing / pixels <= maxFraction };
+  return { result, diff: PNG.sync.write(diff) };
+}
+
+const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME || undefined });
+const context = await browser.newContext({ acceptDownloads: true, viewport: { width: 1440, height: 900 }, deviceScaleFactor: 1 });
+const page = await context.newPage();
+const consoleErrors = [];
+page.on("console", m => { if (m.type() === "error") consoleErrors.push(m.text()); });
+page.on("pageerror", e => consoleErrors.push(String(e)));
+
+await page.goto(`${base}/studio`, { waitUntil: "load" });
+await page.waitForSelector('input[accept=".luma,application/x-luma-project"]', { state: "attached", timeout: 60000 });
+await page.waitForTimeout(1500);
+await page.setInputFiles('input[accept=".luma,application/x-luma-project"]', resolve(fixture));
+await page.waitForFunction(() => /Figma export fixture/.test(document.body.innerText), null, { timeout: 30000 });
+await page.waitForTimeout(1000);
+
+async function exportVia(click) {
+  await page.locator("button.spatial-export").click();
+  await page.waitForSelector('[aria-label="Export document"]');
+  const [download] = await Promise.all([page.waitForEvent("download", { timeout: 60000 }), click()]);
+  const path = await download.path();
+  return { name: download.suggestedFilename(), bytes: await readFile(path) };
+}
+
+const png = await exportVia(() => page.getByRole("button", { name: /^Export PNG$/ }).click());
+await writeFile(join(outDir, "luma.png"), png.bytes);
+const live = await exportVia(() => page.getByRole("button", { name: "Export for Figma" }).click());
+await writeFile(join(outDir, "figma-live-text.svg"), live.bytes);
+const outlined = await exportVia(async () => {
+  await page.getByLabel(/Outline text/).check();
+  await page.getByRole("button", { name: "Export for Figma" }).click();
+});
+await writeFile(join(outDir, "figma-outlined.svg"), outlined.bytes);
+const toast = await page.locator("text=/Exported for Figma/").first().textContent({ timeout: 5000 }).catch(() => null);
+
+const reference = decode(png.bytes);
+const results = [];
+const structure = {};
+for (const [label, file] of [["live text", live], ["outlined text", outlined]]) {
+  const svg = file.bytes.toString("utf8");
+  // 1. Independent parse (usvg inside resvg) — throws on malformed SVG.
+  const resvg = new Resvg(svg, { font: { fontFiles, loadSystemFonts: false, defaultFontFamily: "Lato" }, background: "rgba(0,0,0,0)" });
+  const ids = [...svg.matchAll(/<g id="([^"]+)"/g)].map(m => m[1]);
+  structure[label] = { file: file.name, bytes: file.bytes.length, groupIds: ids, texts: (svg.match(/<text /g) ?? []).length, images: (svg.match(/<image /g) ?? []).length, paths: (svg.match(/<path /g) ?? []).length, rects: (svg.match(/<rect /g) ?? []).length, ellipses: (svg.match(/<ellipse /g) ?? []).length, size: `${resvg.width}x${resvg.height}` };
+  // 2a. resvg rasterization.
+  const resvgPng = resvg.render().asPng();
+  await writeFile(join(outDir, `resvg-${label.replace(" ", "-")}.png`), resvgPng);
+  const r = compare(reference, decode(resvgPng), `resvg · ${label}`);
+  await writeFile(join(outDir, `diff-resvg-${label.replace(" ", "-")}.png`), r.diff);
+  results.push(r.result);
+  // 2b. Chrome rasterization, inline in the studio page (bundled fonts loaded).
+  const shot = await page.evaluate(async (markup) => {
+    const host = document.createElement("div");
+    host.id = "__figma_probe";
+    host.style.cssText = "position:fixed;left:0;top:0;z-index:2147483647;line-height:0;background:transparent;pointer-events:none";
+    host.innerHTML = markup.replace(/^<\?xml[^>]*>\s*/, "");
+    document.body.appendChild(host);
+    await document.fonts.ready;
+    const svg = host.querySelector("svg");
+    return { width: svg.width.baseVal.value, height: svg.height.baseVal.value };
+  }, svg);
+  await page.waitForTimeout(300);
+  const chromePng = await page.screenshot({ clip: { x: 0, y: 0, width: shot.width, height: shot.height }, omitBackground: true });
+  await page.evaluate(() => document.getElementById("__figma_probe")?.remove());
+  await writeFile(join(outDir, `chrome-${label.replace(" ", "-")}.png`), chromePng);
+  const c = compare(reference, decode(chromePng), `chrome · ${label}`);
+  await writeFile(join(outDir, `diff-chrome-${label.replace(" ", "-")}.png`), c.diff);
+  results.push(c.result);
+}
+await browser.close();
+const report = { base, fixture, toast, structure, results, consoleErrors, pass: results.every(r => r.pass) && consoleErrors.length === 0 };
+await writeFile(join(outDir, "report.json"), JSON.stringify(report, null, 2));
+console.log(JSON.stringify(report, null, 2));
+process.exit(report.pass ? 0 : 1);
diff --git a/build/verify-pwa-upgrade.mjs b/build/verify-pwa-upgrade.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..dc20a4d28a0b4d459703f61c4e855c56dfa5e68b
--- /dev/null
+++ b/build/verify-pwa-upgrade.mjs
@@ -0,0 +1,47 @@
+/**
+ * Update-path check against a local `next start` (which serves public/sw.js
+ * from disk on every request — standing in for a new deploy at the same URL).
+ *
+ *   PLAYWRIGHT=/path/to/node_modules/playwright node build/verify-pwa-upgrade.mjs http://localhost:3123
+ *
+ * v1 installs → returning visit → public/sw.js changes (v2) → the studio shows
+ * "A new version of Luma is ready." and nothing activates until Reload is
+ * clicked → after Reload the v2 worker controls the page. sw.js is restored.
+ */
+import { createRequire } from "node:module";
+import { readFile, writeFile } from "node:fs/promises";
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(process.env.PLAYWRIGHT ?? "playwright");
+const base = process.argv[2] ?? "http://localhost:3123";
+const original = await readFile("public/sw.js", "utf8");
+const version = (source) => source.match(/const VERSION = "([^"]+)"/)[1];
+let failed = false;
+const check = (name, pass, detail = "") => { if (!pass) failed = true; console.log(`${pass ? "PASS" : "FAIL"} ${name}${detail ? ` — ${detail}` : ""}`); };
+const browser = await chromium.launch();
+try {
+  const page = await (await browser.newContext()).newPage();
+  const errors = [];
+  page.on("pageerror", e => errors.push(String(e)));
+  await page.goto(`${base}/studio`);
+  await page.waitForFunction(() => navigator.serviceWorker.ready.then(() => true));
+  await page.waitForSelector("text=Luma now works offline on this device.", { timeout: 120000 });
+  check("first install shows the offline-ready note", true);
+  await page.reload();
+  await page.waitForFunction(() => Boolean(navigator.serviceWorker.controller));
+  const v1 = version(original);
+  await writeFile("public/sw.js", original.replace(`const VERSION = "${v1}"`, `const VERSION = "${v1}-v2"`));
+  await page.evaluate(() => navigator.serviceWorker.getRegistration().then(r => r.update()));
+  await page.waitForSelector("text=A new version of Luma is ready.", { timeout: 120000 });
+  const stillV1 = await page.evaluate(() => navigator.serviceWorker.controller?.scriptURL && caches.keys());
+  check("update waits for the user (old worker still in control)", stillV1.some(n => n === `luma-precache-${v1}`), JSON.stringify(stillV1));
+  await Promise.all([page.waitForEvent("load", { timeout: 60000 }), page.getByRole("button", { name: "Reload" }).click()]);
+  await page.waitForFunction(() => Boolean(navigator.serviceWorker.controller));
+  const keys = await page.evaluate(async () => { await new Promise(r => setTimeout(r, 1000)); return caches.keys(); });
+  check("after Reload the new worker controls the page and old precache is gone", keys.includes(`luma-precache-${v1}-v2`) && !keys.includes(`luma-precache-${v1}`), JSON.stringify(keys));
+  check("no page errors", errors.length === 0, errors.join(" | "));
+} finally {
+  await writeFile("public/sw.js", original);
+  await browser.close();
+}
+process.exit(failed ? 1 : 0);
diff --git a/build/verify-pwa.mjs b/build/verify-pwa.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..45a81157b83b3bdde6eee49bb26f7685340afe35
--- /dev/null
+++ b/build/verify-pwa.mjs
@@ -0,0 +1,136 @@
+/**
+ * Installable + offline check for /studio in headless Chrome.
+ *
+ *   PLAYWRIGHT=/path/to/node_modules/playwright \
+ *   node build/verify-pwa.mjs https://luma.example fixture.luma [out-dir]
+ *
+ * 1. Manifest parses with name "Luma", start_url, icons that resolve, and
+ *    Chrome reports no installability errors (CDP Page.getInstallabilityErrors).
+ * 2. /sw.js is served with Cache-Control: no-cache and controls /studio.
+ * 3. The precache completes (every URL listed in sw.js is in Cache Storage).
+ * 4. Offline: reload /studio, open a .luma file, edit (hide a layer), export
+ *    PNG and Export for Figma (live and outlined text, which runs the cached
+ *    shaping worker) — downloads succeed; reload again offline.
+ * 5. Server routes are untouched: /api/ai/edit still reaches the function.
+ * 0 console errors required (offline network failures of the optional suite
+ * script are reported separately, not counted).
+ */
+import { createRequire } from "node:module";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { resolve, join } from "node:path";
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(process.env.PLAYWRIGHT ?? "playwright");
+const [base = "http://localhost:3123", fixture = "artifacts/figma-export/fixture.luma", outDir = "artifacts/pwa"] = process.argv.slice(2);
+await mkdir(outDir, { recursive: true });
+const checks = [];
+const check = (name, pass, detail = "") => { checks.push({ name, pass: Boolean(pass), detail }); console.log(`${pass ? "PASS" : "FAIL"} ${name}${detail ? ` — ${detail}` : ""}`); };
+
+const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME || undefined });
+const context = await browser.newContext({ acceptDownloads: true, viewport: { width: 1440, height: 900 } });
+const page = await context.newPage();
+const consoleErrors = [];
+const networkNoise = [];
+page.on("console", m => {
+  if (m.type() !== "error") return;
+  const text = m.text();
+  // Offline, the optional cross-origin suite script cannot load; the app is
+  // required to keep working without it. Track it, don't fail on it.
+  const where = m.location()?.url ?? "";
+  if (/thecreatingco\.com\/suite|ERR_INTERNET_DISCONNECTED/.test(text + where)) networkNoise.push(text);
+  // The deliberate unauthenticated probe of the AI function below logs 401.
+  else if (/status of 401/.test(text) && /\/api\/ai\/edit/.test(where)) networkNoise.push(text);
+  else consoleErrors.push(`${text} @ ${where}`);
+});
+let phase = "online";
+page.on("pageerror", e => consoleErrors.push(`[${phase}] ${String(e)} ${e?.stack?.split("\n").slice(0, 3).join(" | ") ?? ""}`));
+
+// 1. Manifest + installability.
+await page.goto(`${base}/studio`, { waitUntil: "load" });
+const manifestHref = await page.locator('link[rel="manifest"]').getAttribute("href");
+const manifest = await (await page.request.get(new URL(manifestHref, base).href)).json();
+check("manifest name is Luma", manifest.name === "Luma" && manifest.short_name === "Luma", `${manifest.name} / ${manifest.short_name}`);
+check("manifest start_url /studio, standalone", manifest.start_url === "/studio" && manifest.display === "standalone");
+const iconStatuses = await Promise.all(manifest.icons.map(async icon => (await page.request.get(new URL(icon.src, base).href)).status()));
+check("manifest icons resolve (incl. 192/512 + maskable)", iconStatuses.every(s => s === 200) && manifest.icons.some(i => i.sizes === "512x512" && i.purpose === "maskable"), iconStatuses.join(","));
+const swResponse = await page.request.get(`${base}/sw.js`);
+check("/sw.js served no-cache", /no-cache/.test(swResponse.headers()["cache-control"] ?? "") || base.includes("localhost"), swResponse.headers()["cache-control"] ?? "(none)");
+const swSource = await swResponse.text();
+const precacheList = JSON.parse(swSource.match(/const PRECACHE_URLS = (\[.*?\]);/s)[1]);
+
+// 2/3. Service worker controls the page and finishes precaching.
+await page.waitForFunction(() => navigator.serviceWorker.ready.then(() => true), null, { timeout: 30000 });
+await page.reload({ waitUntil: "load" });
+const controlled = await page.evaluate(() => Boolean(navigator.serviceWorker.controller));
+check("service worker controls /studio", controlled);
+await page.waitForFunction(async (expected) => {
+  const names = (await caches.keys()).filter(n => n.startsWith("luma-precache-"));
+  if (!names.length) return false;
+  return (await (await caches.open(names[0])).keys()).length >= expected;
+}, precacheList.length, { timeout: 180000, polling: 1000 });
+const cacheInfo = await page.evaluate(async () => {
+  const names = await caches.keys();
+  const sizes = {};
+  for (const n of names) sizes[n] = (await (await caches.open(n)).keys()).length;
+  return sizes;
+});
+check("precache complete", Object.entries(cacheInfo).some(([n, c]) => n.startsWith("luma-precache-") && c >= precacheList.length), JSON.stringify(cacheInfo));
+const cdp = await context.newCDPSession(page);
+const { installabilityErrors } = await cdp.send("Page.getInstallabilityErrors");
+check("Chrome installability: no errors", installabilityErrors.length === 0, JSON.stringify(installabilityErrors));
+await page.screenshot({ path: join(outDir, "online.png") });
+
+// 5. Function untouched by the worker (online).
+const fn = await page.evaluate(async () => { const r = await fetch("/api/ai/edit", { method: "POST", body: "{}", headers: { "content-type": "application/json" } }); return { status: r.status, body: (await r.text()).slice(0, 120) }; });
+check("POST /api/ai/edit reaches the server function", fn.status !== 404 && fn.status < 500, `${fn.status} ${fn.body}`);
+
+// 4. Offline.
+await context.setOffline(true);
+phase = "offline-reload";
+await page.reload({ waitUntil: "load" });
+await page.waitForSelector('input[accept=".luma,application/x-luma-project"]', { state: "attached", timeout: 30000 });
+check("offline reload of /studio renders the editor", await page.locator("button.spatial-export").isVisible());
+const iphone = await context.newPage();
+iphone.on("console", m => { if (m.type() === "error") consoleErrors.push(`[iphone] ${m.text()} @ ${m.location()?.url ?? ""}`); });
+const iphoneResponse = await iphone.goto(`${base}/iphone`, { waitUntil: "load" }).catch(error => ({ status: () => String(error).slice(0, 80) }));
+await iphone.waitForTimeout(2000);
+const iphoneTitle = await iphone.title().catch(() => "");
+check("offline /iphone opens from the precached shell", iphoneResponse.status() === 200 && /Luma/.test(iphoneTitle), `${iphoneResponse.status()} "${iphoneTitle}"`);
+await iphone.close();
+await page.waitForTimeout(1500);
+phase = "offline-open";
+await page.setInputFiles('input[accept=".luma,application/x-luma-project"]', resolve(fixture));
+await page.waitForFunction(() => /Figma export fixture/.test(document.body.innerText), null, { timeout: 30000 });
+const hide = page.getByRole("button", { name: /^Hide Badge/ });
+await hide.click();
+check("offline edit (hide a layer) applied", await page.getByRole("button", { name: /^Show Badge/ }).isVisible());
+async function exportVia(click) {
+  await page.locator("button.spatial-export").click();
+  await page.waitForSelector('[aria-label="Export document"]');
+  const [download] = await Promise.all([page.waitForEvent("download", { timeout: 60000 }), click()]);
+  return { name: download.suggestedFilename(), bytes: await readFile(await download.path()) };
+}
+phase = "offline-export";
+const png = await exportVia(() => page.getByRole("button", { name: /^Export PNG$/ }).click());
+check("offline PNG export", png.bytes.subarray(1, 4).toString() === "PNG" && png.bytes.length > 1000, `${png.name} ${png.bytes.length} bytes`);
+await writeFile(join(outDir, "offline-export.png"), png.bytes);
+const svg = await exportVia(() => page.getByRole("button", { name: "Export for Figma" }).click());
+const svgText = svg.bytes.toString("utf8");
+check("offline Export for Figma", /<svg[^>]+width="480"/.test(svgText) && !/id="Badge \(shadow\)"/.test(svgText), `${svg.name} ${svg.bytes.length} bytes`);
+await writeFile(join(outDir, "offline-figma.svg"), svg.bytes);
+const outlined = await exportVia(async () => {
+  await page.getByLabel(/Outline text/).check();
+  await page.getByRole("button", { name: "Export for Figma" }).click();
+});
+const outlinedText = outlined.bytes.toString("utf8");
+check("offline Export for Figma with outlined text (shaping worker from cache)", !/<text /.test(outlinedText) && /id="Title"/.test(outlinedText), `${outlined.bytes.length} bytes`);
+await page.reload({ waitUntil: "load" });
+check("second offline reload still works", await page.locator("button.spatial-export").isVisible({ timeout: 30000 }));
+await page.screenshot({ path: join(outDir, "offline.png") });
+await context.setOffline(false);
+
+await browser.close();
+const report = { base, checks, consoleErrors, networkNoise, pass: checks.every(c => c.pass) && consoleErrors.length === 0 };
+await writeFile(join(outDir, "report.json"), JSON.stringify(report, null, 2));
+console.log(JSON.stringify({ pass: report.pass, consoleErrors, networkNoise: networkNoise.length }, null, 2));
+process.exit(report.pass ? 0 : 1);
diff --git a/build/verify-suite.mjs b/build/verify-suite.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..41fe999b621603fafd42f12995b2cd6633b32475
--- /dev/null
+++ b/build/verify-suite.mjs
@@ -0,0 +1,113 @@
+/**
+ * Suite menu + Locker check in headless Chrome.
+ *
+ *   PLAYWRIGHT=/path/to/node_modules/playwright node build/verify-suite.mjs <base> [out-dir]
+ *
+ * - suite.js is loaded once with data-app="luma"; <tcc-suite-menu> sits in the
+ *   studio header and the header does not move when the kit renders.
+ * - The menu opens and lists the suite apps.
+ * - Export PNG → "Save to Locker" → saved (iframe bridge on *.thecreatingco.com,
+ *   popup handoff elsewhere — both driven by the real click).
+ * - On https://*.thecreatingco.com it also round-trips TCC.locker.onOpen:
+ *   an image and a font (.ttf) are put in the Locker, then /studio?tcc-open=
+ *   opens the image as a document and installs the font in the type tool.
+ * - With the kit blocked, the studio still loads, edits and exports.
+ */
+import { createRequire } from "node:module";
+import { mkdir, writeFile, readFile } from "node:fs/promises";
+import { join } from "node:path";
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(process.env.PLAYWRIGHT ?? "playwright");
+const [base = "http://localhost:3123", outDir = "artifacts/suite"] = process.argv.slice(2);
+await mkdir(outDir, { recursive: true });
+const sameSite = /^https:\/\/([a-z0-9-]+\.)*thecreatingco\.com$/.test(new URL(base).origin);
+const checks = [];
+const check = (name, pass, detail = "") => { checks.push({ name, pass: Boolean(pass), detail }); console.log(`${pass ? "PASS" : "FAIL"} ${name}${detail ? ` — ${detail}` : ""}`); };
+const browser = await chromium.launch({ headless: true });
+const context = await browser.newContext({ acceptDownloads: true, viewport: { width: 1440, height: 900 } });
+const consoleErrors = [];
+context.on("page", p => {
+  p.on("console", m => { if (m.type() === "error") consoleErrors.push(`${m.text()} @ ${m.location()?.url ?? ""}`); });
+  p.on("pageerror", e => consoleErrors.push(String(e)));
+});
+const page = await context.newPage();
+
+await page.goto(`${base}/studio`, { waitUntil: "domcontentloaded" });
+await page.waitForSelector(".studio-titlebar tcc-suite-menu", { timeout: 60000 });
+const before = await page.locator(".studio-titlebar .studio-app-mark").boundingBox();
+await page.waitForFunction(() => window.TCC && window.TCC.locker, null, { timeout: 30000 });
+await page.waitForTimeout(1500);
+const after = await page.locator(".studio-titlebar .studio-app-mark").boundingBox();
+const scripts = await page.evaluate(() => [...document.querySelectorAll('script[src*="/suite/v1/suite.js"]')].map(s => ({ src: s.src, app: s.dataset.app })));
+check("suite.js loaded once with data-app=luma", scripts.length === 1 && scripts[0].app === "luma" && scripts[0].src === "https://thecreatingco.com/suite/v1/suite.js", JSON.stringify(scripts));
+check("header does not shift when the menu renders", before && after && before.x === after.x && before.y === after.y, `${JSON.stringify(before)} → ${JSON.stringify(after)}`);
+const floating = await page.evaluate(() => document.querySelectorAll("body > tcc-suite-menu, [data-tcc-floating]").length);
+check("no floating fallback button (header menu present)", floating === 0, String(floating));
+await page.locator(".studio-titlebar tcc-suite-menu").click();
+await page.waitForTimeout(600);
+const menuText = await page.evaluate(() => {
+  const texts = [];
+  const walk = (root) => { for (const el of root.querySelectorAll("*")) { if (el.shadowRoot) walk(el.shadowRoot); } texts.push(root.textContent || ""); };
+  walk(document);
+  return texts.join(" ");
+});
+check("menu opens with the suite apps", ["Luma", "Glyph", "ScenePilot", "Locker"].every(n => menuText.includes(n)));
+await page.screenshot({ path: join(outDir, "menu-open.png") });
+await page.keyboard.press("Escape");
+
+// Export PNG → Save to Locker.
+await page.locator("button.spatial-export").click();
+const [download] = await Promise.all([page.waitForEvent("download"), page.getByRole("button", { name: /^Export PNG$/ }).click()]);
+const pngName = download.suggestedFilename();
+await page.waitForSelector(".luma-locker-offer", { timeout: 10000 });
+check("Locker offer appears after export", await page.locator(".luma-locker-offer").getByText(`Downloaded ${pngName}`).isVisible());
+await page.locator(".luma-locker-offer").getByRole("button", { name: "Save to Locker" }).click();
+await page.locator(".luma-locker-offer").getByText(/is in your Locker/).waitFor({ timeout: 30000 });
+check("Save to Locker succeeds", true, `${pngName} (${sameSite ? "bridge" : "popup"} mode)`);
+await page.screenshot({ path: join(outDir, "locker-saved.png") });
+
+if (sameSite) {
+  // onOpen round trip (same-site bridge needs no gesture).
+  const ids = await page.evaluate(async (fontBase64) => {
+    const canvas = document.createElement("canvas"); canvas.width = 64; canvas.height = 48;
+    const ctx = canvas.getContext("2d"); ctx.fillStyle = "#e4572e"; ctx.fillRect(0, 0, 64, 48);
+    const png = await new Promise(r => canvas.toBlob(r, "image/png"));
+    const image = await window.TCC.locker.save({ name: "locker-probe.png", type: "image/png", blob: png });
+    const fontBytes = Uint8Array.from(atob(fontBase64), c => c.charCodeAt(0));
+    const font = await window.TCC.locker.save({ name: "Probe Sans.ttf", type: "font/ttf", blob: new Blob([fontBytes], { type: "font/ttf" }) });
+    return { image, font };
+  }, (await readFile("public/fonts/Abel-Regular.ttf")).toString("base64"));
+  const imagePage = await context.newPage();
+  await imagePage.goto(`${base}/studio?tcc-open=${encodeURIComponent(ids.image)}`);
+  await imagePage.waitForFunction(() => /locker-probe/.test(document.body.innerText), null, { timeout: 60000 });
+  check("onOpen: image from Locker opens as a document", true);
+  check("?tcc-open removed from the URL after delivery", !/tcc-open/.test(imagePage.url()), imagePage.url());
+  await imagePage.close();
+  const fontPage = await context.newPage();
+  await fontPage.goto(`${base}/studio?tcc-open=${encodeURIComponent(ids.font)}`);
+  await fontPage.waitForFunction(() => /from Locker is installed/.test(document.body.innerText), null, { timeout: 60000 });
+  const fontNote = await fontPage.locator("text=/from Locker is installed/").first().textContent();
+  check("onOpen: font from Locker installs into the type tool under its real family name", /“Abel”/.test(fontNote ?? ""), fontNote ?? "");
+  await fontPage.evaluate(async (list) => { for (const id of list) await window.TCC.locker.remove(id).catch(() => {}); }, [ids.image, ids.font]);
+  await fontPage.close();
+}
+
+// Kit unreachable: the studio must still work.
+const blocked = await browser.newContext({ acceptDownloads: true, viewport: { width: 1440, height: 900 } });
+await blocked.route("https://thecreatingco.com/**", route => route.abort());
+const lonely = await blocked.newPage();
+const lonelyErrors = [];
+lonely.on("pageerror", e => lonelyErrors.push(String(e)));
+await lonely.goto(`${base}/studio`, { waitUntil: "load" });
+await lonely.waitForTimeout(2500);
+await lonely.locator("button.spatial-export").click();
+const [d2] = await Promise.all([lonely.waitForEvent("download"), lonely.getByRole("button", { name: /^Export PNG$/ }).click()]);
+check("kit blocked: studio loads and exports, no Locker offer shown", Boolean(d2) && !(await lonely.locator(".luma-locker-offer").isVisible()) && lonelyErrors.length === 0, lonelyErrors.join(" | "));
+await blocked.close();
+
+await browser.close();
+const report = { base, sameSite, checks, consoleErrors, pass: checks.every(c => c.pass) && consoleErrors.length === 0 };
+await writeFile(join(outDir, "report.json"), JSON.stringify(report, null, 2));
+console.log(JSON.stringify({ pass: report.pass, consoleErrors }, null, 2));
+process.exit(report.pass ? 0 : 1);
