+export function cssBlendFor(mode: string): { blend: CssBlendMode; exact: boolean } {
+  if (mode in DIRECT_BLENDS) return { blend: DIRECT_BLENDS[mode], exact: true };
+  return { blend: APPROXIMATE_BLENDS[mode] ?? "normal", exact: false };
+}
