diff --git a/app-logos.css b/app-logos.css
new file mode 100644
index 0000000000000000000000000000000000000000..b71eb8383f517bc44c7c2e51e39a526805296f97
--- /dev/null
+++ b/app-logos.css
@@ -0,0 +1,43 @@
+.cc-app-logo{display:inline-block!important;object-fit:contain!important;flex:none;max-width:100%;background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important}
+.mm-launch-item>.cc-app-logo{width:36px!important;height:36px!important;margin-bottom:4px}
+.mm-notable-icon:has(.cc-app-logo){background:transparent!important;box-shadow:none!important;border:0!important}
+.mm-notable-icon .cc-app-logo{width:88px!important;height:88px!important;padding:4px}
+.cc-logo-title{display:flex;align-items:center;gap:12px}
+.cc-logo-title .cc-app-logo{width:32px!important;height:32px!important}
+.cc-logo-eyebrow{display:flex;align-items:center;gap:14px}
+.cc-logo-eyebrow>.cc-app-logo{width:48px!important;height:48px!important}
+img.cc-existing-logo{object-fit:contain!important;padding:12px;aspect-ratio:1;max-height:260px}
+@media(max-width:600px){.cc-logo-eyebrow{gap:10px}.cc-logo-eyebrow>.cc-app-logo{width:36px!important;height:36px!important}}
+
+#creative-suite .cc-logo-title>.cc-app-logo{width:44px!important;height:44px!important}
+
+/* Homepage app identity tiles: one shared box treatment. */
+.momentium-home :is(#creative-suite,#other-apps) .cc-app-logo{
+ box-sizing:border-box!important;width:72px!important;height:72px!important;
+ padding:12px!important;background:#fafaf5!important;
+ border:1px solid #d5d7cc!important;border-radius:12px!important;
+ box-shadow:0 1px 2px rgb(28 34 25 / 5%)!important;
+}
+.momentium-home #other-apps .mm-notable-icon:has(.cc-app-logo){
+ width:72px!important;height:72px!important;padding:0!important;
+ background:transparent!important;border:0!important;border-radius:12px!important;
+ display:grid!important;place-items:center;
+}
+.momentium-home #creative-suite .cc-logo-title{gap:16px}
+.momentium-home #other-apps .mm-notable-icon:focus-visible{outline:3px solid #6750b8;outline-offset:4px}
+
+/* iOS-style app tiles: generous rounded squares, no outlined mini-box. */
+.momentium-home :is(#creative-suite,#other-apps) .cc-app-logo{
+ width:112px!important;height:112px!important;padding:20px!important;
+ border:0!important;border-radius:25px!important;
+ background:linear-gradient(145deg,#fff,color-mix(in srgb,var(--tool-tone,#cbd4ed) 24%,#fff))!important;
+ box-shadow:0 8px 20px rgb(24 30 42 / 12%),inset 0 1px 0 rgb(255 255 255 / 90%)!important;
+}
+.momentium-home #other-apps .mm-notable-icon:has(.cc-app-logo){
+ width:112px!important;height:112px!important;border-radius:25px!important;
+ filter:none!important;box-shadow:none!important;
+}
+.momentium-home #creative-suite .cc-logo-title>.cc-app-logo{
+ width:64px!important;height:64px!important;padding:11px!important;border-radius:15px!important;
+ box-shadow:0 4px 12px rgb(24 30 42 / 10%)!important;
+}
diff --git a/app-logos.js b/app-logos.js
new file mode 100644
index 0000000000000000000000000000000000000000..e50a9b4735100f93045eaea33be0e34d1c3d2af2
--- /dev/null
+++ b/app-logos.js
@@ -0,0 +1,36 @@
+/* Approved app identities. ScenePilot is intentionally excluded. */
+(()=>{
+ const ids=new Set('form luma stemdeck ghost librarian reclaim bounce locker sessions pocket-studio glyph-studio autocut captions board grade split key-bpm vox canvas pocket press mockups glyph cast'.split(' '));
+ const aliases={'form studio':'form','luma studio':'luma','ghost studio':'ghost','key & bpm':'key-bpm',keybpm:'key-bpm',mockup:'mockups'};
+ const key=name=>{const n=(name||'').trim().toLowerCase();return aliases[n]||n.replace(/\s+/g,'-')};
+ function image(id,size=36){const i=document.createElement('img');i.src='/assets/app-logos/'+id+'.svg';i.alt='';i.width=i.height=size;i.className='cc-app-logo';i.dataset.appLogo=id;i.decoding='async';return i}
+ function decorate(){
+  document.querySelectorAll('.mm-launch-item').forEach(card=>{
+   if(card.dataset.ccLogo)return;
+   let id=key(card.querySelector('.launch-app-name,h3,strong')?.textContent);
+   if(card.querySelector('a[href*="glyph-studio"]'))id='glyph-studio';
+   if(!ids.has(id))return;
+   const dot=card.querySelector('.mm-tool-dot');if(dot)dot.replaceWith(image(id));else card.prepend(image(id));card.dataset.ccLogo=id;
+  });
+  document.querySelectorAll('[data-mm-product],.ct-tool').forEach(card=>{
+   if(card.dataset.ccLogo)return;
+   const id=key(card.dataset.mmProduct||card.querySelector('h3')?.textContent);if(!ids.has(id))return;
+   const icon=card.querySelector('.mm-notable-icon');
+   if(icon)icon.replaceChildren(image(id,88));else{const h=card.querySelector('h3');if(h){h.classList.add('cc-logo-title');h.prepend(image(id,32))}}
+   card.dataset.ccLogo=id;
+  });
+  document.querySelectorAll('img[src*="/assets/notable/"],img[src="/assets/bounce-app-icon.svg"],img[src="/locker/icon.svg"]').forEach(i=>{
+   const fixed={'/assets/bounce-app-icon.svg':'bounce','/locker/icon.svg':'locker'}[i.getAttribute('src')]; if(fixed){i.src='/assets/app-logos/'+fixed+'.svg';i.classList.add('cc-existing-logo');return;}
+   const match=i.getAttribute('src').match(/\/([^/]+)\.(png|webp)$/);if(!match||!ids.has(match[1]))return;
+   i.src='/assets/app-logos/'+match[1]+'.svg';i.removeAttribute('srcset');i.classList.add('cc-existing-logo');
+  });
+  const product=key(location.pathname.match(/^\/products\/([^/]+)/)?.[1]);
+  if(ids.has(product)&&!document.querySelector('[data-cc-hero-logo]')){
+   const target=document.querySelector('.suite-eyebrow,.form-eyebrow,.tp-hero-copy .tp-eyebrow,.ph .eyebrow,.ph .overline');
+   if(target){const mark=image(product,48);mark.dataset.ccHeroLogo='';target.prepend(mark);target.classList.add('cc-logo-eyebrow')}
+  }
+ }
+ if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',decorate,{once:true});else decorate();
+ // Shared launchers may insert their tiles after the initial document parse.
+ let queued=false;new MutationObserver(records=>{if(queued||!records.some(r=>[...r.addedNodes].some(n=>n.nodeType===1&&!n.classList.contains('cc-app-logo'))))return;queued=true;requestAnimationFrame(()=>{queued=false;decorate()})}).observe(document.body,{childList:true,subtree:true});
+})();
