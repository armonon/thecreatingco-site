+.tcc-story-tab:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--story-accent) 70%, #fff 30%); }
+.tcc-story-tab[aria-selected="true"] { border-color: var(--story-accent); color: #fff; background: color-mix(in srgb, var(--story-accent) 19%, #111 81%); }
