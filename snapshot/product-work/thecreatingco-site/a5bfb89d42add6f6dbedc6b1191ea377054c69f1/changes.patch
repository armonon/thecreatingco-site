diff --git a/start/motion.css b/start/motion.css
new file mode 100644
index 0000000000000000000000000000000000000000..dc8370da601f8dd069081a4d2a1882a238cc0365
--- /dev/null
+++ b/start/motion.css
@@ -0,0 +1,44 @@
+body.start-motion .hero{position:relative;isolation:isolate;overflow:hidden;background:none}
+body.start-motion .hero:before{content:"";position:absolute;inset:-60px;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 22% 35%,#d8c6ffb3,transparent 48%),radial-gradient(ellipse at 80% 60%,#bcecdf99,transparent 45%);transform:translate3d(var(--drift-x,0px),var(--drift-y,0px),0);transition:transform 1s ease-out;animation:start-breathe 12s ease-in-out infinite alternate}
+@keyframes start-breathe{from{opacity:.65}to{opacity:1}}
+body.start-motion .panel{transition:box-shadow .3s ease,transform .3s ease}
+body.start-motion .panel:hover{box-shadow:0 18px 50px #49327512}
+body.start-motion .suite-images img{transition:transform .55s cubic-bezier(.2,.7,.2,1),box-shadow .4s}
+body.start-motion .suite-images:hover img:nth-child(even){transform:translateY(-10px) rotate(1deg)}
+body.start-motion .suite-images:hover img:nth-child(odd){transform:translateY(-5px) rotate(-1deg)}
+body.start-motion .motion-ready{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
+body.start-motion .motion-ready.is-visible{opacity:1;transform:none}
+body.start-motion .suite{position:relative}
+body.start-motion .suite .copy>a:after{content:"";position:absolute;inset:0;z-index:1;border-radius:inherit}
+body.start-motion .suite-images{position:relative;z-index:2}
+body.start-motion .suite:focus-within{outline:3px solid #6840bc;outline-offset:4px}
+@media(prefers-reduced-motion:reduce){::view-transition-old(root),::view-transition-new(root){animation:none}body.start-motion .hero:before{animation:none;transform:none;transition:none}body.start-motion .motion-ready{opacity:1;transform:none;transition:none}body.start-motion .panel,body.start-motion .suite-images img{transition:none}body.start-motion .suite-images:hover img:nth-child(n){transform:none}}
+
+/* Cross-browser navigation rather than relying on cross-document View Transitions. */
+body.suite-leaving{pointer-events:none}
+body.suite-leaving>main,body.suite-leaving>footer{animation:suite-exit .56s cubic-bezier(.4,0,.2,1) both}
+body.suite-arriving>main{animation:suite-enter .65s cubic-bezier(.2,.7,.2,1) both}
+@keyframes suite-exit{to{opacity:0;transform:translateY(-48px) scale(.98)}}
+@keyframes suite-enter{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}
+.motion-preference{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;padding:20px 24px 32px;font-size:13px;color:#555c50}
+.motion-preference button{min-height:44px;padding:10px 16px;border:1px solid #a9ae9f;border-radius:8px;background:transparent;color:#22271f;font:inherit;cursor:pointer}
+.motion-preference button[aria-pressed=true]{background:#e8e0fa;border-color:#6840bc}
+.motion-preference button:focus-visible{outline:3px solid #6840bc;outline-offset:3px}
+html.motion-reduced{scroll-behavior:auto!important}
+html.motion-reduced *,html.motion-reduced *::before,html.motion-reduced *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
+html.motion-reduced .motion-ready{opacity:1!important;transform:none!important}
+html.motion-reduced body.start-motion .hero:before,html.motion-reduced body.start-motion .suite-images img{transform:none!important}
+@media(prefers-reduced-motion:reduce){html,body{scroll-behavior:auto!important}body.suite-leaving,body.suite-arriving{animation:none!important}}
+.suite-scroll-exit{padding:40px 24px 64px;text-align:center;background:#e8e0fa;color:#292137}
+.suite-scroll-exit a{display:inline-flex;align-items:center;gap:14px;min-height:48px;font-size:24px;font-weight:650;color:inherit;text-decoration:none}
+.suite-scroll-exit p{font-size:13px;margin:12px 0 0;color:#5a5066}
+
+.suite-scroll-exit{--suite-pressure:0;position:relative;padding-bottom:80px;overscroll-behavior-y:contain}
+.suite-scroll-exit:after{content:"";display:block;width:180px;height:4px;margin:24px auto 0;background:#6840bc;transform:scaleX(var(--suite-pressure));transform-origin:left;transition:transform .18s ease-out;border-radius:4px}
+.suite-scroll-exit.is-ready a{transform:translateY(calc(var(--suite-pressure) * -10px));transition:transform .18s ease-out}
+.suite-transition-curtain{position:fixed;inset:0;z-index:10000;background:#e8e0fa;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;color:#38255b;animation:suite-curtain .56s cubic-bezier(.4,0,.2,1) both;pointer-events:none}
+.suite-transition-curtain span{font:600 12px Arial,sans-serif;letter-spacing:.12em}
+.suite-transition-curtain strong{font-size:clamp(32px,6vw,72px);font-weight:650;letter-spacing:-.04em}
+@keyframes suite-curtain{from{transform:translateY(100%);opacity:.5}to{transform:none;opacity:1}}
+html.motion-reduced .suite-scroll-exit.is-ready a{transform:none}
+@media(prefers-reduced-motion:reduce){body.suite-leaving>main,body.suite-leaving>footer,body.suite-arriving>main{animation:none!important}.suite-scroll-exit.is-ready a{transform:none}.suite-scroll-exit:after{transition:none}}
diff --git a/start/motion.js b/start/motion.js
new file mode 100644
index 0000000000000000000000000000000000000000..b11dac9d1e38d41d78c114c4ca29dc38c46aa2d7
--- /dev/null
+++ b/start/motion.js
@@ -0,0 +1,126 @@
+(() => {
+  const system = matchMedia('(prefers-reduced-motion: reduce)');
+  const key = 'createco-reduce-motion';
+  let preference = false;
+  try { preference = localStorage.getItem(key) === 'true'; } catch {}
+  const reduced = () => system.matches || preference;
+  const nodes = [...document.querySelectorAll('.panel,.mission')];
+  const toggle = document.querySelector('[data-motion-toggle]');
+  let observer;
+  function applyMotion() {
+    document.documentElement.classList.toggle('motion-reduced', reduced());
+    if (toggle) {
+      toggle.setAttribute('aria-pressed', String(reduced()));
+      toggle.disabled = system.matches;
+      toggle.textContent = reduced() ? 'Reduced motion: on' : 'Reduce motion';
+    }
+    const status = document.querySelector('[data-motion-status]');
+    if (status) status.textContent = system.matches ? 'Enabled by your device setting' : preference ? 'Saved for this browser' : 'Motion on · follows your device setting';
+    if (reduced()) {
+      observer?.disconnect();
+      nodes.forEach(node => node.classList.add('is-visible'));
+      document.body.classList.remove('suite-arriving', 'suite-leaving');
+    }
+  }
+  applyMotion();
+  system.addEventListener('change', applyMotion);
+  toggle?.addEventListener('click', () => {
+    preference = !preference;
+    try { localStorage.setItem(key, String(preference)); } catch {}
+    applyMotion();
+  });
+  // A short-lived marker limits top-reset and entrance motion to deliberate suite navigation.
+  if (location.pathname === '/' || location.pathname === '/index.html') {
+    let arrival = 0;
+    try { arrival = Number(sessionStorage.getItem('createco-suite-arrival')); sessionStorage.removeItem('createco-suite-arrival'); } catch {}
+    if (arrival && Date.now() - arrival < 15000 && !location.hash) {
+      const top = () => window.scrollTo({top:0,left:0,behavior:'instant'});
+      top(); window.addEventListener('pageshow', top, {once:true});
+      if (!reduced()) document.body.classList.add('suite-arriving');
+    }
+  }
+  if (!document.body.classList.contains('start-motion')) return;
+  if ('IntersectionObserver' in window && !reduced()) {
+    observer = new IntersectionObserver(entries => {
+      for (const entry of entries) if (entry.isIntersecting) {
+        entry.target.classList.add('is-visible'); observer.unobserve(entry.target);
+      }
+    }, {threshold:.06});
+    for (const node of nodes) if (node.getBoundingClientRect().top > innerHeight) {
+      node.classList.add('motion-ready'); observer.observe(node);
+    }
+  }
+  const hero = document.querySelector('.hero');
+  hero?.addEventListener('pointermove', event => {
+    if (reduced() || event.pointerType !== 'mouse') return;
+    const rect = hero.getBoundingClientRect();
+    hero.style.setProperty('--drift-x', `${((event.clientX-rect.left)/rect.width-.5)*35}px`);
+    hero.style.setProperty('--drift-y', `${((event.clientY-rect.top)/rect.height-.5)*24}px`);
+  }, {passive:true});
+  hero?.addEventListener('pointerleave', () => {
+    hero.style.setProperty('--drift-x','0px'); hero.style.setProperty('--drift-y','0px');
+  });
+  let leaving = false;
+  function enterSuite(href = '/') {
+    if (leaving) return;
+    leaving = true;
+    try { sessionStorage.setItem('createco-suite-arrival', String(Date.now())); } catch {}
+    const navigate = () => location.assign(href);
+    if (reduced()) { navigate(); return; }
+    const curtain = document.createElement('div');
+    curtain.className = 'suite-transition-curtain';
+    curtain.setAttribute('aria-hidden','true');
+    curtain.innerHTML = '<span>THECREATECO</span><strong>Momentium Suite</strong>';
+    document.body.append(curtain);
+    document.body.classList.add('suite-leaving');
+    setTimeout(navigate, 560);
+  }
+  const exit = document.querySelector('.suite-scroll-exit');
+  let bottomSince = 0, pressure = 0, touchY = 0;
+  const atBottom = () => document.documentElement.scrollHeight - innerHeight - scrollY <= 4;
+  function resetPressure() {
+    bottomSince = 0; pressure = 0;
+    exit?.style.setProperty('--suite-pressure','0');
+    exit?.classList.remove('is-ready');
+  }
+  function push(delta) {
+    if (leaving || document.querySelector('dialog[open]')) return;
+    if (delta <= 0 || !atBottom()) { resetPressure(); return; }
+    if (!bottomSince) { bottomSince = performance.now(); return; }
+    // Let the first scroll settle, then require an additional deliberate push.
+    if (performance.now() - bottomSince < 450) return;
+    pressure = Math.min(240, pressure + Math.min(delta,80));
+    exit?.style.setProperty('--suite-pressure', String(pressure / 240));
+    exit?.classList.toggle('is-ready', pressure > 0);
+    if (pressure >= 240) enterSuite();
+  }
+  addEventListener('wheel', event => {
+    push(event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? innerHeight : 1));
+  }, {passive:true});
+  addEventListener('touchstart', event => { touchY = event.touches[0]?.clientY || 0; }, {passive:true});
+  addEventListener('touchmove', event => {
+    const next = event.touches[0]?.clientY || 0;
+    push((touchY-next)*1.8); touchY=next;
+  }, {passive:true});
+  addEventListener('keydown', event => {
+    if (event.target.closest?.('input,textarea,select,button,a,[contenteditable="true"]')) return;
+    if (['End','PageDown','ArrowDown',' '].includes(event.key)) push(80);
+    if (['Home','PageUp','ArrowUp'].includes(event.key)) resetPressure();
+  });
+  addEventListener('scroll', () => {
+    if (!atBottom()) resetPressure();
+    else if (!bottomSince) bottomSince = performance.now();
+  }, {passive:true});
+  document.addEventListener('click', event => {
+    const link = event.target.closest?.('a[href]');
+    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target === '_blank' || link.hasAttribute('download')) return;
+    const target = new URL(link.href, location.href);
+    if (target.origin !== location.origin || target.pathname !== '/' || target.hash || target.search) return;
+    event.preventDefault(); enterSuite(target.href);
+  });
+  addEventListener('pageshow', event => {
+    leaving = false; resetPressure(); document.body.classList.remove('suite-leaving');
+    document.querySelector('.suite-transition-curtain')?.remove();
+    if (event.persisted) nodes.forEach(node => node.classList.add('is-visible'));
+  });
+})();
