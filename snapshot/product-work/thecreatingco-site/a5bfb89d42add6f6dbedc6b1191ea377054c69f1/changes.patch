+  letter-spacing: .13em;
+  text-transform: uppercase;
+}
+.tcc-story-heading h2 {
+  max-width: 720px;
+  margin: 0;
+  color: inherit;
+  font-size: clamp(2rem, 5vw, 4rem);
+  font-weight: 620;
+  line-height: .98;
+  letter-spacing: -.055em;
+}
+.tcc-story-heading > p:last-child {
+  max-width: 680px;
