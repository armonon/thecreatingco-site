+ .site-unified :is(.tp-subnav,.pr-nav){flex-wrap:wrap;gap:8px 16px}
+ .site-unified .cc-footer{grid-template-columns:1fr!important;padding:32px 20px 24px!important;gap:24px!important}
+ .site-unified .cc-footer nav{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:24px 20px!important}
+ .site-unified .cc-footer nav section:last-child{grid-column:1/-1}
+ .site-unified .cc-footer nav section:last-child a{width:fit-content}
+ .site-unified :is(.launch-actions,.ph-actions,.tp-actions){flex-wrap:wrap;gap:12px}
+ .site-unified :is(.hub-intro,.ct-directory-heading) p{line-height:1.65}
+ .site-unified .ql-clean .mm-launch-item{min-height:210px!important;aspect-ratio:auto!important}
+ .site-unified .mm-launch-dialog{max-height:calc(100dvh - 20px)!important}
+}
+@media(max-width:360px){.site-unified .cc-header{padding-inline:10px!important;gap:6px!important}.site-unified .cc-header .wordmark{font-size:19px!important}.site-unified .cc-header .mm-launch-button{padding-inline:10px!important}.site-unified main h1{font-size:34px!important}}
+@media(prefers-reduced-motion:reduce){.site-unified{scroll-behavior:auto}.site-unified :is(.cc-header,.cc-footer,.mm-launch-dialog,.mm-notable-card){transition:none!important;animation:none!important}}
+
+/* Keep section headings below both sticky navigation rows. */
+.site-unified:has(.pr-nav,.tp-subnav) main [id]{scroll-margin-top:calc(var(--cc-header-height) + 84px)!important}
+.site-unified .hub-intro>p br{display:block!important}
