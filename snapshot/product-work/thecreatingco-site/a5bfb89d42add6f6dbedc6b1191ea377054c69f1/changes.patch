title": "Forest landscape", "description": "Explore the prepared Forest landscape project in the real Form Studio workspace. Keep an editable .form or garment file with native Save.", "skills": "Terrain / displacement / landscape / STL", "level": "Explore", "firstMove": "Explore a surface variation and its export.", "url": "/learn/form/workshops/?lesson=terrain", "poster": "/assets/form-studies/terrain-perspective.jpg", "key": "form:terrain"}, {"product": "luma", "id": "cinema", "title": "Build a cinematic scene.", "description": "Combine the character and hooded scene from the two supplied boards. Paint in the atmosphere and compare moonlight with an amber grade.", "skills": "Mask painting / compositing / Curves / mood studies", "level": "Explore", "time": "7\u201310 min", "firstMove": "Use the first step in the real Luma lesson to change the prepared project.", "url": "/learn/luma/workshops/?workshop=cinema", "poster": "/assets/luma-workshops/cinema-example.jpg", "key": "luma:cinema"}, {"product": "form", "id": "dimensions", "title": "Make it your size", "description": "Explore the prepared Make it your size project in the real Form Studio workspace. Keep an editable .form or garment file with native Save.", "skills": "Dimensions / CAD / precision / geometry", "level": "First steps", "firstMove": "Enter a new dimension in the prepared design.", "url": "/learn/form/workshops/?lesson=dimensions", "poster": "/assets/after-hours/outputs/orbit-steel-render.png", "key": "form:dimensions"}, {"product": "luma", "id": "compose", "title": "Eight layers. Your composition.", "description": "Reorder the stack, move the imagery and edit the headline. Continue with this exact document in the next lesson.", "skills": "8 editable layers / layer order / placement / live text", "level": "First steps", "time": "5\u20137 min", "firstMove": "Select a layer, move it, then change the order of the eight-layer composition.", "url": "/learn/luma/workshops/?workshop=compose", "poster": "/assets/luma-workshops/compose-example.jpg", "key": "luma:compose"}, {"product": "form", "id": "history", "title": "See how it was made", "description": "Explore the prepared See how it was made project in the real Form Studio workspace. Keep an editable .form or garment file with native Save.", "skills": "History / sketch / extrude / bevel", "level": "First steps", "firstMove": "Inspect how the object\u2019s features build its shape.", "url": "/learn/form/workshops/?lesson=history", "poster": "/assets/after-hours/outputs/orbit-steel-render.png", "key": "form:history"}, {"product": "luma", "id": "effects", "title": "Same layers. A different feeling.", "description": "Continue your composition and explore all 27 blend modes, 17 layer effects and 15 editable smart filters.", "skills": "Blending / opacity / layer effects / smart filters / blend modes", "level": "Explore", "time": "6\u20139 min", "firstMove": "Keep your eight-layer composition and try a blend mode or layer effect.", "url": "/learn/luma/workshops/?workshop=effects", "poster": "/assets/luma-workshops/effects-example.jpg", "key": "luma:effects"}, {"product": "form", "id": "challenge", "title": "Three objects, one workflow", "description": "Explore the prepared Three objects, one workflow project in the real Form Studio workspace. Keep an editable .form or garment file with native Save.", "skills": "Clasp / ring / enclosure / CAD", "level": "Explore", "firstMove": "Try the measured workflow on another object.", "url": "/learn/form/workshops/?lesson=challenge", "poster": "/assets/after-hours/outputs/orbit-steel-render.png", "key": "form:challenge"}, {"product": "form", "id": "materials", "title": "Find the right finish", "description": "Explore the prepared Find the right finish project in the real Form Studio workspace. Keep an editable .form or garment file with native Save.", "skills": "Materials / finish / roughness / lighting", "level": "First steps", "firstMove": "Change the finish while keeping the shape.", "url": "/learn/form/workshops/?lesson=materials", "poster": "/assets/after-hours/outputs/orbit-steel-render.png", "key": "form:materials"}, {"product": "form", "id": "handoff", "title": "Keep the editable object", "description": "Explore the prepared Keep the editable object project in the real Form Studio workspace. Keep an editable .form or garment file with native Save.", "skills": "Save / project / export / PNG / STL", "level": "First steps", "firstMove": "Keep an editable project and test an export.", "url": "/learn/form/workshops/?lesson=handoff", "poster": "/assets/after-hours/outputs/orbit-steel-render.png", "key": "form:handoff"}]}</script><details class="secondary-reference"><summary>Explore the workflow &amp; tools<span>Open guide ↗</span></summary><div class="suite-origin"><section class="suite-section" id="suite-workflow" aria-labelledby="suite-workflow-heading"><div class="suite-section-heading"><p class="suite-eyebrow">01 / THE WORKFLOW</p><h2 id="suite-workflow-heading">Follow the sound.<br><span>Shape the session.</span></h2><p class="suite-section-intro">Move from the library into performance, arrangement and mixing. Hear each decision as you make it.</p></div><div class="suite-steps"><article><span class="suite-step-number">01</span><h3>Bring the music in.</h3><p>Import your audio or open the prepared session. Keep the song and its available stems together in the library.</p><small>Library / Audio import / Prepared stems</small></article><article><span class="suite-step-number">02</span><h3>Find your balance.</h3><p>Play the track, mute the drums, isolate the vocals and balance the parts. Use deck and mixer controls to shape the sound.</p><small>Stem lanes / Mute &amp; solo / Mixing</small></article><article><span class="suite-step-number">03</span><h3>Make your own edit.</h3><p>Place clips in the arranger, build a break and bring the song back. Keep a portable session and export your mix.</p><small>Arrangement / Clip editing / Project backup</small></article></div></section><section class="suite-features" id="suite-capabilities" aria-labelledby="suite-capabilities-heading"><div class="suite-feature-title"><p class="suite-eyebrow">02 / BUILT TO KEEP YOU MAKING</p><h2 id="suite-capabilities-heading">Live choices.<br><span>A mix that’s yours.</span></h2><p>Take the drums out. Try another cue. Build an opening, a drop and a return in the current Sattari-based studio.</p><a class="suite-text-link" href="#learn-studio">Find your starting point <span aria-hidden="true">↗</span></a></div><div class="suite-feature-list"><article><span class="suite-feature-number">01</span><div><p class="suite-eyebrow">Stem mixing</p><h3>Hear the parts.</h3><p>Control prepared vocal, drum, bass and music stems while the song plays. Mute, solo and balance the available tracks.</p></div></article><article><span class="suite-feature-number">02</span><div><p class="suite-eyebrow">Arrangement</p><h3>Shape the whole track.</h3><p>Work with a multitrack timeline, clip regions, loop ranges and locators to build a deliberate arrangement.</p></div></article><article><span class="suite-feature-number">03</span><div><p class="suite-eyebrow">Performance &amp; effects</p><h3>Give it your touch.</h3><p>Explore cues, performance pads and native effects. Compare treatments and control the master output in the same session.</p></div></article></div></section><section class="suite-fabric suite-section" id="suite-deeper" aria-labelledby="suite-deeper-heading"><div><p class="suite-eyebrow">03 / BEYOND THE FIRST MIX</p><h2 id="suite-deeper-heading">A good moment.<br><span>Make it repeatable.</span></h2><p class="suite-section-intro">Use the prepared music to learn a real performance workflow, then save the session so you can return to your version.</p><a class="suite-text-link" href="#learn-studio">Try it in StemDeck <span aria-hidden="true">↗</span></a></div><div class="suite-fabric-notes"><span class="suite-label">CURRENT SATTARI STUDIO · PREPARED AUDIO</span><dl><div><dt>Cue</dt><dd>Set a starting point and audition a cue sequence.</dd></div><div><dt>Arrange</dt><dd>Cut and position clips to create a break and a return.</dd></div><div><dt>Keep</dt><dd>Download a portable .sattari session and a supported mixdown.</dd></div></dl><p class="suite-fineprint">The examples include prepared separate stems. Muting these parts plays the supplied tracks; it does not perform new AI separation on an arbitrary song. Separation availability depends on the edition and configured services.</p></div></section></div></details><!-- PRODUCT-REFRESH:START --><!-- PRODUCT-REFRESH:END --><!-- STEM-PLAYGROUND:START --><!-- PRODUCT-LESSONS:START --><!-- PRODUCT-LESSONS:END --><!-- STEM-PLAYGROUND:END --><!-- PRODUCT-FEATURES:START --><section class="pf" id="product-features" aria-labelledby="pf-title" data-product-features="stemdeck" style="--pf-accent:#ffb05e"><div class="pf-intro"><div><p class="pf-eyebrow">INSIDE STEMDECK</p><h2 id="pf-title">What StemDeck can do.</h2><p class="pf-lede">Mix, arrange, perform and capture in StemDeck on Sattari.</p></div><p class="pf-total"><strong>33</strong><span>features to explore</span></p></div><aside class="pf-scope" aria-label="Edition and availability"><p><strong>Full product inventory. Web, native and experimental capabilities vary by edition.</strong> The primary web application is StemDeck at sattarimusic.com/studio. The older four-deck mixer remains a smaller legacy companion. The inline learning workspace teaches mixing with original recordings; native features below remain separately labeled. Sattari’s current studio identifies arrangement playback as a preview and distinguishes track-stem exports from AI separation.</p></aside><div class="pr-search"><label for="pr-feature-search">Find a capability</label><input id="pr-feature-search" type="search" data-pr-search placeholder="Search tools, workflows or editions" autocomplete="off" aria-describedby="pr-feature-status"><p id="pr-feature-status" data-pr-search-status role="status" aria-live="polite"></p></div><nav class="pf-jump" aria-label="Feature categories"><a href="#pf-stemdeck-1">StemDeck · perform and mix</a><a href="#pf-stemdeck-2">StemDeck · arrange and create</a><a href="#pf-stemdeck-3">StemDeck · capture and continue</a><a href="#pf-stemdeck-4">Native &amp; legacy editions · Load, cue &amp; mix</a><a href="#pf-stemdeck-5">Native &amp; legacy editions · Tempo, beat &amp; key</a><a href="#pf-stemdeck-6">Native &amp; legacy editions · Perform &amp; capture</a><a href="#pf-stemdeck-7">Native &amp; legacy editions · Recall &amp; browser mixing</a></nav><details class="pf-group" id="pf-stemdeck-1"><summary><span class="pf-number" aria-hidden="true">01</span><h3>StemDeck · perform and mix</h3><span class="pf-group-count">5 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Current Sattari studio</h4><span class="pf-edition">online</span></div><p>Open the current studio at sattarimusic.com/studio, with Library, Perform, Arrange and Mixer views.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Decks and existing stems</h4><span class="pf-edition">online</span></div><p>Import audio, control deck levels and work with available full-mix, drums, bass, music and vocal lanes. Existing stem controls are separate from AI separation.</p><p class="feature-availability">Available in the browser workshop. Initial editor and media loading require a network connection.</p><a class="pf-example-link" href="/products/stemdeck/?lesson=stems#learn-studio">Try this feature ↗</a></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Crossfader and deck grouping</h4><span class="pf-edition">online</span></div><p>Blend the A/C and B/D groups with selectable response curves.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Performance pads and global effects</h4><span class="pf-edition">online</span></div><p>Play one-shot pads and shape the performance with Echo and Space controls.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Master output and stem buses</h4><span class="pf-edition">online</span></div><p>Review output metering and control the master vocals, drums, bass, other and full-mix groups.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details><details class="pf-group" id="pf-stemdeck-2"><summary><span class="pf-number" aria-hidden="true">02</span><h3>StemDeck · arrange and create</h3><span class="pf-group-count">5 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Multitrack arrangement</h4><span class="pf-edition">online</span></div><p>Import audio, add tracks, copy deck audio into the arrangement and edit clips against the timeline grid.</p><p class="feature-availability">Available in the browser workshop. Initial editor and media loading require a network connection.</p><a class="pf-example-link" href="/products/stemdeck/?lesson=arrange#learn-studio">Try this feature ↗</a></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>MIDI and instruments</h4><span class="pf-edition">online</span></div><p>Add an instrument, work in the piano roll or beat sequencer, import MIDI and connect supported MIDI input.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Built-in effects racks</h4><span class="pf-edition">online</span></div><p>Add the browser editions of Sattari EQ, Comp, Echo, Space, Heat and Image. Native plugin hosting is a separate runtime.</p><p class="feature-availability">Available in the browser workshop. Initial editor and media loading require a network connection.</p><a class="pf-example-link" href="/products/stemdeck/?lesson=effects#learn-studio">Try this feature ↗</a></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Loop regions and locators</h4><span class="pf-edition">online</span></div><p>Set loop start and end, loop a selected clip and mark positions with locators.</p><p class="feature-availability">Available in the browser workshop. Initial editor and media loading require a network connection.</p><a class="pf-example-link" href="/products/stemdeck/?lesson=cues#learn-studio">Try this feature ↗</a></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Track automation</h4><span class="pf-edition">online</span></div><p>Shape supported track parameters over the course of an arrangement.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details><details class="pf-group" id="pf-stemdeck-3"><summary><span class="pf-number" aria-hidden="true">03</span><h3>StemDeck · capture and continue</h3><span class="pf-group-count">4 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Input and capture</h4><span class="pf-edition">online</span></div><p>Choose a microphone or interface, arm an input lane and use the available multitrack or WAV capture controls.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Mixdown and track stems</h4><span class="pf-edition">online</span></div><p>Export an arrangement mixdown or pre-master track stems with selectable range and filename. These track exports do not perform AI separation.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Portable project backup</h4><span class="pf-edition">online</span></div><p>Save a .sattari project containing supported session settings and its source audio, then reopen it in the studio.</p><p class="feature-availability">Available in the browser workshop. Initial editor and media loading require a network connection.</p><a class="pf-example-link" href="/products/stemdeck/?lesson=arrange#learn-studio">Try this feature ↗</a></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Local session continuity</h4><span class="pf-edition">online</span></div><p>Keep audio and session work on the current device, with recoverable takes and portable backups for handoff.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details><details class="pf-group" id="pf-stemdeck-4"><summary><span class="pf-number" aria-hidden="true">04</span><h3>Native &amp; legacy editions · Load, cue &amp; mix</h3><span class="pf-group-count">7 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Four-deck mixing</h4><span class="pf-edition">legacy companion</span></div><p>Load tracks into decks A–D.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Waveforms and transport</h4><span class="pf-edition">legacy companion</span></div><p>Inspect audio, play, stop, cue, rewind, and loop supported material.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Stem lanes</h4><span class="pf-edition">native</span></div><p>Control full mix, drums, bass, music, and vocals within a shared deck transport.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Optional stem separation</h4><span class="pf-edition">native/experimental</span></div><p>Use a configured local separator, with cached results and processing status.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Deck mixing</h4><span class="pf-edition">native</span></div><p>Gain trim, channel faders, three-band EQ, and filters.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Crossfader</h4><span class="pf-edition">legacy companion</span></div><p>Blend deck groups using an equal-power curve; grouping differs between editions.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Master controls</h4><span class="pf-edition">native</span></div><p>Master gain and a safety limiter.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details><details class="pf-group" id="pf-stemdeck-5"><summary><span class="pf-number" aria-hidden="true">05</span><h3>Native &amp; legacy editions · Tempo, beat &amp; key</h3><span class="pf-group-count">4 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Tempo controls</h4><span class="pf-edition">native</span></div><p>Editable source BPM and supported host-tempo synchronization.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Beat alignment</h4><span class="pf-edition">native/alpha</span></div><p>Host-grid synchronization and per-deck beat offsets.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Key analysis</h4><span class="pf-edition">native/alpha</span></div><p>Track-level key estimates and optional live-window analysis.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Pitch and key matching</h4><span class="pf-edition">native/alpha</span></div><p>Manual pitch changes, target keys, and an internal key-preserving playback path.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details><details class="pf-group" id="pf-stemdeck-6"><summary><span class="pf-number" aria-hidden="true">06</span><h3>Native &amp; legacy editions · Perform &amp; capture</h3><span class="pf-group-count">5 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Performance pads</h4><span class="pf-edition">native</span></div><p>Eight loadable one-shot pads with focused-window keyboard triggering.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Microphone/input</h4><span class="pf-edition">native</span></div><p>Input monitoring and gain controls.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Effects hosting</h4><span class="pf-edition">native/experimental</span></div><p>Sattari plugin-chain groundwork for decks, microphone, and master processing.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Performance recording</h4><span class="pf-edition">native</span></div><p>Record the performed master output to WAV.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Arrangement capture</h4><span class="pf-edition">native/alpha</span></div><p>Export event/arrangement information for reviewing a recorded session.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details><details class="pf-group" id="pf-stemdeck-7"><summary><span class="pf-number" aria-hidden="true">07</span><h3>Native &amp; legacy editions · Recall &amp; browser mixing</h3><span class="pf-group-count">3 features</span></summary><ul class="pf-feature-list"><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Session recall</h4><span class="pf-edition">native</span></div><p>Preserve supported settings and deck/pad file references.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Quick mix export</h4><span class="pf-edition">legacy companion</span></div><p>Render a 1–60-second stereo WAV from current cue points, levels, loops, and crossfade.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li><li class="pf-feature" data-feature-aliases=""><div class="pf-feature-heading"><h4>Local browser workflow</h4><span class="pf-edition">legacy companion</span></div><p>Load your own audio or original demo studies without uploading the audio.</p><p class="feature-availability">See release status for this edition. Offline operation is not confirmed for this capability.</p></li></ul></details></section><!-- PRODUCT-FEATURES:END --><div class="section" style="padding-block:0"></div><!-- STEM-GALLERY:START --><!-- STEM-GALLERY:END --><section class="scope-section section" id="browser"><div><p class="overline">YOUR BROWSER EDITION</p><h2>Your web edition.</h2><p>Use Library, Perform, Arrange and Mixer views in StemDeck. Mix decks, arrange audio and MIDI, add built-in effects, capture input and save a portable project.</p><details open><summary>Current limitations</summary><p>Arrangement playback is marked as a preview in the current Sattari studio. Browser effects are distinct from native plugin hosting. Track-stem export is not AI stem separation. Save a portable .sattari backup to keep your source audio with your session.</p></details></div><div class="try-card"><h3>One good first test</h3><ol><li><span>01</span>Open the current Sattari studio and import audio.</li><li><span>02</span>Explore Perform, then Arrange and the built-in effects.</li><li><span>03</span>Save a portable .sattari project and export your mix.</li></ol><a class="button accent primary-app" href="https://stemdeck.thecreatingco.com/studio">Open StemDeck</a><a href="/testing/?product=stemdeck#feedback">Send feedback</a></div></section><section class="section prose" id="sattari-labs"><p class="overline">SATTARI LABS</p><h2>Six new tools at sattarimusic.com.</h2><p>All six are public web alpha, built on the same Sattari site that hosts StemDeck Online.</p><h3>Split</h3><p>Separate a song into vocals, drums, bass and other stems on your own device, with mute/solo preview and WAV/ZIP export. The first run downloads a large (172&nbsp;MB) separation model, which is slow on CPU. Opens straight into StemDeck. <a href="https://sattarimusic.com/studio/split">Open Split <span aria-hidden="true">&#8599;</span></a> &middot; <a href="/products/split/">More about Split</a></p><h3>Key &amp; BPM</h3><p>Batch key and tempo detection with Camelot notation and CSV export. Half- and double-time results are possible on some tracks. <a href="https://sattarimusic.com/studio/keybpm">Open Key &amp; BPM <span aria-hidden="true">&#8599;</span></a> &middot; <a href="/products/key-bpm/">More about Key &amp; BPM</a></p><h3>Vox</h3><p>Record or drop in a vocal, pitch-correct it, and add a 3rd or 5th harmony; exports a mono dry vocal WAV, which can sound phasey. <a href="https://sattarimusic.com/studio/vox">Open Vox <span aria-hidden="true">&#8599;</span></a> &middot; <a href="/products/vox/">More about Vox</a></p><h3>Canvas</h3><p>Audio-reactive looping 9:16 visuals for Spotify Canvas or Reels, exported as MP4 or WebM. <a href="https://sattarimusic.com/studio/canvas">Open Canvas <span aria-hidden="true">&#8599;</span></a> &middot; <a href="/products/canvas/">More about Canvas</a></p><h3>Pocket</h3><p>A mobile-first beat and loop sketchpad; export WAV and stems, or send the sketch straight to StemDeck. <a href="https://sattarimusic.com/studio/pocket">Open Pocket <span aria-hidden="true">&#8599;</span></a> &middot; <a href="/products/pocket/">More about Pocket</a></p><h3>Press</h3><p>Build an artist EPK or link-in-bio page, with HTML and PDF export. <a href="https://sattarimusic.com/press">Open Press <span aria-hidden="true">&#8599;</span></a> &middot; <a href="/products/press/">More about Press</a></p></section><!-- PRODUCT-NEXT:START --><section class="pr-next" aria-labelledby="pr-next-title"><p class="pr-kicker">THE FOUR-PRODUCT CREATIVE SUITE</p><h2 id="pr-next-title">Keep the idea moving.</h2><div class="pr-cards"><a class="pr-card" href="/products/form/" style="--pr-tone:#d8ff3e"><h3>Form Studio</h3><p>Give your next idea a dimension.</p><span class="pr-card-label">Explore the product<b aria-hidden="true">↗</b></span></a><a class="pr-card" href="/products/luma/" style="--pr-tone:#ff83ba"><h3>Luma Studio</h3><p>Turn your images into a visual world.</p><span class="pr-card-label">Explore the product<b aria-hidden="true">↗</b></span></a><a class="pr-card" href="/products/scenepilot/" style="--pr-tone:#b8a3ff"><h3>ScenePilot</h3><p>Your footage. Your rhythm. Your film.</p><span class="pr-card-label">Explore the product<b aria-hidden="true">↗</b></span></a></div></section><!-- PRODUCT-NEXT:END --></main><footer class="mm-footer cc-footer"><div><a class="wordmark" href="/start/">thecreateco.</a><p>For whatever you are into next.</p></div><nav aria-label="Footer"><section aria-labelledby="footer-0"><h2 id="footer-0">Create</h2><a data-nav-key="suite" href="/#creative-suite">Creative Suite</a><a data-nav-key="apps" href="/tools/">Apps &amp; tools</a><a data-nav-key="learn" href="/learn/">Learn</a><a data-nav-key="locker" href="/locker/">Locker</a><a data-nav-key="work" href="/w