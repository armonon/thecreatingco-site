+.tcc-story-sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+.tcc-story-status[hidden] { display: none; }
+.tcc-product-story:not([data-enhanced="true"]) .tcc-story-layout { grid-template-columns: 1fr; }
+.tcc-product-story:not([data-enhanced="true"]) .tcc-story-frames { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,360px),1fr)); gap: 1rem; }
+.tcc-product-story:not([data-enhanced="true"]) .tcc-story-frame img { height: auto; max-height: 380px; }
+@keyframes tcc-story-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
+@media (max-width: 760px) {
+  .tcc-product-story { margin: 3rem 1rem; padding: 1.1rem; border-radius: 1.25rem; }
+  .tcc-story-layout { grid-template-columns: minmax(0,1fr); gap: .75rem; }
+  .tcc-story-frame { grid-template-rows: minmax(200px,auto) auto; border-radius: .95rem; }
+  .tcc-story-frame img { height: clamp(210px, 63vw, 390px); }
+  .tcc-story-copy { gap: 1.1rem; padding: 1rem; border-radius: .95rem; }
+  .tcc-story-heading { margin-bottom: 1.3rem; }
+  .tcc-story-heading h2 { font-size: clamp(2rem,10vw,3.25rem); }
+  .tcc-story-step h3 { font-size: 1.8rem; }
+  .tcc-story-controls { gap: .45rem; }
+  .tcc-story-tab { min-height: 48px; padding: .55rem; font-size: .74rem; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .tcc-story-frame img, .tcc-story-tab { transition: none; }
+  .tcc-story-frame:hover img, .tcc-story-tab:hover { transform: none; }
+  .tcc-story-step { animation: none; }
+}
