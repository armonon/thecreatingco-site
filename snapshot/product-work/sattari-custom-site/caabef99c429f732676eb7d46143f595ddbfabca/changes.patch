+          onChange={(event) => seek(Number(event.target.value))}
+        />
+        <span className="alab-time">
+          {formatTime(position)} / {formatTime(duration)}
+        </span>
+      </div>
+      {state.message && <p className="alab-note">{state.message}</p>}
+      <ul className="alab-lanes">
+        {lanes.map((lane) => {
