+}
+.lab-button.is-primary {
+  background: var(--lab-accent);
+  border-color: var(--lab-accent);
+  color: #15120a;
+}
+.lab-button:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+.lab-drop {
+  display: grid;
+  place-items: center;
+  gap: 6px;
+  text-align: center;
+  border: 1.5px dashed var(--lab-line);
+  border-radius: 12px;
