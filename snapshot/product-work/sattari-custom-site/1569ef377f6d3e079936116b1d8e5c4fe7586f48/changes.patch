+  min-height: 110px;
+  line-height: 1.5;
+}
+.lab-page input[type='range'] {
+  width: 100%;
+  accent-color: var(--lab-accent);
+}
+.lab-page input[type='color'] {
+  width: 44px;
+  height: 36px;
+  border: 1px solid var(--lab-line);
+  border-radius: 8px;
+  background: var(--lab-raised);
+  padding: 2px;
+}
+.lab-row {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  align-items: center;
+}
+.lab-grid-2 {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 10px;
+}
+.lab-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  min-height: 42px;
+  padding: 0 16px;
