+  });
+
+  it('refuses empty exports', () => {
+    expect(() => buildLiveSetXml({ bpm: 120, tracks: [] })).toThrow(/no stems/);
+    expect(() =>
+      buildLiveSetXml({
+        bpm: 120,
+        tracks: [{ name: 'x', file: 'x.wav', frames: 0, sampleRate: RATE }],
+      })
