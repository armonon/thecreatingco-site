+  color: var(--lab-text);
+}
+.lab-drop input[type='file'] {
+  position: absolute;
+  inset: 0;
+  opacity: 0;
+  cursor: pointer;
+}
+.lab-drop strong {
+  color: var(--lab-text);
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+.lab-status {
+  font-size: 14px;
+  color: var(--lab-muted);
+  min-height: 20px;
+}
+.lab-status.is-error {
+  color: #ff8a80;
+}
+.lab-segment {
+  display: inline-flex;
+  border: 1px solid var(--lab-line);
+  border-radius: 20px;
+  padding: 3px;
+  gap: 2px;
+  flex-wrap: wrap;
+}
+.lab-segment button {
+  border: 0;
+  background: transparent;
+  border-radius: 999px;
+  min-height: 34px;
+  padding: 0 12px;
+  cursor: pointer;
+  font-size: 13px;
+  color: var(--lab-muted);
+}
+.lab-segment button[aria-pressed='true'] {
+  background: var(--lab-accent-soft);
+  color: var(--lab-text);
+}
+
+/* ---- Canvas ---- */
+.lab-canvas-stage {
+  display: grid;
+  justify-items: center;
+  gap: 12px;
+}
+.lab-canvas-stage canvas {
+  width: min(100%, 405px);
+  aspect-ratio: 9 / 16;
+  height: auto;
+  border-radius: 16px;
+  border: 1px solid var(--lab-line);
+  background: #000;
+  display: block;
+}
+.lab-meters {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+  width: min(100%, 405px);
+  font-size: 12px;
+  color: var(--lab-muted);
+}
+.lab-meter {
+  display: grid;
+  gap: 4px;
+}
+.lab-meter i {
+  display: block;
+  height: 6px;
+  border-radius: 3px;
+  background: linear-gradient(90deg, var(--lab-accent) var(--fill, 0%), var(--lab-raised) 0);
+}
+.lab-swatches {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+.lab-swatch {
+  width: 34px;
+  height: 34px;
+  border-radius: 50%;
+  border: 2px solid transparent;
+  cursor: pointer;
+  padding: 0;
+}
+.lab-swatch[aria-pressed='true'] {
+  border-color: var(--lab-text);
+}
+
+/* ---- Pocket ---- */
+.lab-pocket .lab-shell {
+  max-width: 980px;
+}
+.pocket-transport {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  align-items: end;
+}
+.pocket-transport .lab-field {
+  width: 120px;
+}
+.pocket-play {
+  width: 56px;
+  height: 56px;
+  border-radius: 50%;
+  border: 0;
+  background: var(--lab-accent);
+  color: #15120a;
+  display: grid;
+  place-items: center;
+  cursor: pointer;
+}
+.pocket-grid {
+  display: grid;
+  gap: 6px;
+}
+.pocket-track {
+  display: grid;
+  grid-template-columns: 92px minmax(0, 1fr);
+  gap: 8px;
+  align-items: center;
+}
+.pocket-track-head {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 13px;
+  min-width: 0;
+}
+.pocket-track-head span {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.pocket-mute {
+  width: 28px;
+  height: 28px;
+  border-radius: 6px;
+  border: 1px solid var(--lab-line);
+  background: var(--lab-raised);
+  font-size: 11px;
+  font-weight: 700;
+  cursor: pointer;
+  color: var(--lab-muted);
+}
+.pocket-mute[aria-pressed='true'] {
+  background: #5a2a26;
+  color: #ffd2cc;
+}
+.pocket-steps {
+  display: grid;
+  grid-template-columns: repeat(var(--steps, 16), minmax(0, 1fr));
+  gap: 4px;
+}
+.pocket-step {
+  aspect-ratio: 1;
+  min-height: 30px;
+  border-radius: 6px;
+  border: 1px solid var(--lab-line);
+  background: var(--lab-raised);
+  cursor: pointer;
+  padding: 0;
+  font-size: 11px;
+  font-weight: 700;
+  color: #15120a;
+}
+.pocket-step.is-beat {
+  background: color-mix(in srgb, var(--lab-raised) 70%, var(--lab-text) 8%);
+}
+.pocket-step[aria-pressed='true'] {
+  background: var(--track-color, var(--lab-accent));
+  border-color: var(--track-color, var(--lab-accent));
+}
+.pocket-step.is-playhead {
+  box-shadow: 0 0 0 2px var(--lab-text) inset;
+}
+.pocket-bass-row .pocket-step {
+  aspect-ratio: auto;
+  min-height: 24px;
+}
+.pocket-bass-row .pocket-track-head {
+  font-size: 11px;
+  color: var(--lab-muted);
+  justify-content: flex-end;
+  padding-right: 6px;
+}
+.pocket-pages {
+  display: none;
+}
+.pocket-saved {
+  display: grid;
+  gap: 6px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.pocket-saved li {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 8px;
+  font-size: 14px;
+}
+@media (max-width: 640px) {
+  .pocket-pages {
+    display: inline-flex;
+  }
+  .lab-pocket .pocket-steps {
+    --steps: 8 !important;
+  }
+  .lab-pocket .pocket-step.is-off-page {
+    display: none;
+  }
+  .pocket-track {
+    grid-template-columns: 70px minmax(0, 1fr);
+  }
+  .pocket-step {
+    min-height: 38px;
+  }
+  .pocket-bass-row .pocket-step {
+    min-height: 30px;
+  }
+}
+
+/* ---- Press ---- */
+.lab-press .lab-workspace {
+  grid-template-columns: minmax(300px, 440px) minmax(0, 1fr);
+}
+.press-preview {
+  position: sticky;
+  top: 96px;
+  display: grid;
+  gap: 10px;
+}
+.press-preview iframe {
+  width: 100%;
+  height: min(78vh, 900px);
+  border: 1px solid var(--lab-line);
+  border-radius: 14px;
+  background: #fff;
+}
+.press-list {
+  display: grid;
+  gap: 10px;
+}
+.press-item {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto;
+  gap: 6px;
+  align-items: center;
+}
+.press-item.is-quote {
+  grid-template-columns: minmax(0, 1fr) auto;
+}
+.press-item.is-quote textarea {
+  grid-column: 1 / -1;
+}
+.press-remove {
+  width: 36px;
+  height: 36px;
+  border-radius: 8px;
+  border: 1px solid var(--lab-line);
+  background: var(--lab-raised);
+  cursor: pointer;
+  display: grid;
+  place-items: center;
+}
+.press-photo {
+  display: flex;
+  gap: 12px;
+  align-items: center;
+}
+.press-photo img {
+  width: 64px;
+  height: 64px;
+  object-fit: cover;
+  border-radius: 10px;
+}
+
+@media (max-width: 900px) {
+  .lab-workspace,
+  .lab-press .lab-workspace {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .press-preview {
+    position: static;
+  }
+}
+@media (max-width: 640px) {
+  .lab-page {
+    padding: 0 12px 56px;
+  }
+  .lab-shell {
+    padding-top: 92px;
+  }
+  .lab-panel {
+    padding: 14px;
+  }
+}
