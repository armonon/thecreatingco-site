+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 10px !important;
+  font-size: 14px;
+  font-weight: 600;
+}
+.alab-limits ul {
+  display: grid;
+  gap: 6px;
+  padding-left: 18px;
+  color: var(--alab-muted);
+  font-size: 13px;
+  line-height: 1.5;
+}
+.alab-siblings {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 12px;
+  margin-top: 18px;
+}
+.alab-siblings a {
+  display: grid;
+  gap: 4px;
+  padding: 14px 16px;
+  border: 1px solid var(--alab-line);
+  border-radius: 8px;
+  text-decoration: none;
+}
+.alab-siblings a:hover {
+  border-color: var(--alab-muted);
+}
+.alab-siblings a.is-current {
+  border-color: var(--alab-accent);
+}
+.alab-siblings strong {
+  font-size: 14px;
+}
+.alab-siblings span {
+  color: var(--alab-muted);
+  font-size: 13px;
+}
+@media (max-width: 760px) {
+  .alab-page {
+    padding: 0 14px 56px;
+  }
+  .alab-heading {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+  .alab-heading h1 {
+    font-size: 26px;
+  }
+  .alab-input-row {
+    grid-template-columns: 1fr;
+  }
+  .alab-lane {
+    grid-template-columns: 1fr auto 36px;
+  }
+  .alab-lane .alab-waveform {
+    grid-column: 1 / -1;
+    grid-row: 2;
+  }
+  .alab-lane input[type='range'] {
+    grid-column: 1 / -1;
+    grid-row: 3;
+  }
+}
+
+.alab-offline h2 {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 0 0 8px;
+  font-size: 15px;
+}
diff --git a/src/labs/audio/audioLabs.test.jsx b/src/labs/audio/audioLabs.test.jsx
