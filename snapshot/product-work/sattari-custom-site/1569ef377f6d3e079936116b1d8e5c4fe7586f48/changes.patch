+/* Wave-2 alpha tools (Canvas, Pocket, Press): one shared dark workspace in the
+   Sattari palette (near-black panels, warm gold accent), with a day variant. */
+.lab-page {
+  --lab-bg: #111213;
+  --lab-panel: #191b1d;
+  --lab-raised: #232628;
+  --lab-line: #34383b;
+  --lab-text: #f3f5f4;
+  --lab-muted: #a4acae;
+  --lab-accent: #d6b36d;
+  --lab-accent-soft: rgba(214, 179, 109, 0.16);
+  --lab-on: #00ff87;
+  position: relative;
+  z-index: 1;
+  min-height: calc(100vh - 88px);
+  background: var(--lab-bg);
+  color: var(--lab-text);
+  padding: 0 24px 72px;
+  color-scheme: dark;
+  font-family: Inter, sans-serif;
+  letter-spacing: 0;
+}
+[data-theme='day'] .lab-page {
+  --lab-bg: #f4f3ef;
+  --lab-panel: #ffffff;
+  --lab-raised: #ecebe6;
+  --lab-line: #d6d4cc;
+  --lab-text: #1b1b19;
+  --lab-muted: #5c5b55;
+  --lab-accent: #8a6a22;
+  --lab-accent-soft: rgba(138, 106, 34, 0.12);
+  --lab-on: #0a8a4f;
+  color-scheme: light;
+}
+.lab-page * {
+  box-sizing: border-box;
+  letter-spacing: 0;
+}
+.lab-page :is(h1, h2, h3, p) {
+  margin: 0;
+}
+.lab-page :is(button, input, select, textarea) {
+  font: inherit;
+  color: inherit;
+}
+.lab-page :is(a, button, input, select, textarea, summary):focus-visible {
+  outline: 2px solid var(--lab-accent);
+  outline-offset: 3px;
+}
+.lab-shell {
+  max-width: 1240px;
+  margin: 0 auto;
+  padding-top: 112px;
+  display: grid;
+  gap: 20px;
+}
+.lab-breadcrumb {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+.lab-breadcrumb-end {
+  display: inline-flex;
+  align-items: center;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  gap: 4px 16px;
+}
+.lab-install {
+  min-height: 36px;
+  padding: 0 14px;
+  border: 1px solid currentColor;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--lab-muted);
+  font: inherit;
+  font-size: 14px;
+  cursor: pointer;
+}
+.lab-breadcrumb a {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 44px;
+  color: var(--lab-muted);
+  text-decoration: none;
+  font-size: 14px;
+}
+.lab-breadcrumb a:hover {
+  color: var(--lab-text);
+}
+.lab-heading {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-end;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+.lab-eyebrow {
+  color: var(--lab-muted);
+  font-size: 13px;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+}
+.lab-heading h1 {
+  font-size: clamp(34px, 6vw, 56px);
+  line-height: 1.05;
+  font-weight: 650;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+.lab-badge {
+  font-size: 13px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  border: 1px solid var(--lab-accent);
+  color: var(--lab-accent);
+  border-radius: 999px;
+  padding: 4px 10px;
+}
+.lab-tagline {
+  margin-top: 8px !important;
+  color: var(--lab-muted);
+  max-width: 60ch;
+}
+.lab-private {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--lab-muted);
+  font-size: 14px;
+}
+.lab-limits {
+  border: 1px solid var(--lab-line);
+  border-radius: 14px;
+  background: var(--lab-panel);
+  padding: 14px 18px;
+  color: var(--lab-muted);
+  font-size: 14px;
+}
+.lab-limits summary {
+  cursor: pointer;
+  color: var(--lab-text);
+  font-weight: 600;
+  min-height: 28px;
+}
+.lab-limits ul {
+  margin: 10px 0 0;
+  padding-left: 18px;
+  display: grid;
+  gap: 6px;
+}
+
+/* ---- shared building blocks ---- */
+.lab-workspace {
+  display: grid;
+  grid-template-columns: minmax(280px, 380px) minmax(0, 1fr);
+  gap: 20px;
+  align-items: start;
+}
+.lab-panel {
+  background: var(--lab-panel);
+  border: 1px solid var(--lab-line);
+  border-radius: 14px;
+  padding: 18px;
+  display: grid;
+  gap: 14px;
+  min-width: 0;
+}
+.lab-panel h2 {
+  font-size: 15px;
+  font-weight: 650;
+}
+.lab-field {
