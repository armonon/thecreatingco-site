+      } catch (problem) {
+        setTake(null);
+        setError(problem.message);
+      }
+    },
+    [stopPlayback]
+  );
+  // A vocal sent from the Locker or another suite app (?tcc-open=).
+  useLockerOpen('vox', (entry) => {
