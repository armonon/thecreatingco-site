+            </div>
+            <label className="lab-row lab-field">
+              Accent
+              <input
+                type="color"
+                value={draft.accent}
+                onChange={(event) => set('accent', event.target.value)}
+              />
+            </label>
+          </div>
+        </div>
+
+        <div className="press-preview">
+          <div className="lab-row">
+            <button type="button" className="lab-button is-primary" onClick={downloadHtml}>
