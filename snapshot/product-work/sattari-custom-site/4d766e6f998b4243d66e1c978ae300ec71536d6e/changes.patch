+              ['booking', 'Booking email', 'email'],
+              ['management', 'Management email', 'email'],
+              ['press', 'Press email', 'email'],
+              ['phone', 'Phone', 'tel'],
+            ].map(([key, label, type]) => (
+              <label key={key} className="lab-field">
+                <span>{label}</span>
+                <input
+                  type={type}
+                  value={draft.contact[key]}
+                  onChange={(event) => setContact(key, event.target.value)}
