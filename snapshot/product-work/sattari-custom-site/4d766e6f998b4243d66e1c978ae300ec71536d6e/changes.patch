+            <input
+              type="text"
+              value={draft.name}
+              maxLength={80}
+              onChange={(event) => set('name', event.target.value)}
+            />
+          </label>
+          <label className="lab-field">
+            <span>Tagline</span>
+            <input
+              type="text"
+              value={draft.tagline}
+              maxLength={120}
+              placeholder="Genre · role · city"
+              onChange={(event) => set('tagline', event.target.value)}
