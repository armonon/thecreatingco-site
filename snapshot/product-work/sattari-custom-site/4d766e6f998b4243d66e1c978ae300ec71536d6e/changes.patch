+            />
+          </label>
+          <div className="press-photo">
+            {draft.photo && <img src={draft.photo} alt="" />}
+            <label className="lab-drop" style={{ flex: 1 }}>
+              <ImagePlus size={18} aria-hidden="true" />
+              <strong>{draft.photo ? 'Replace photo' : 'Add a photo'}</strong>
+              <input
+                type="file"
