+  align-items: center;
+  gap: 8px;
+  margin-bottom: 10px !important;
+  font-size: 14px;
+  font-weight: 600;
+}
+.alab-limits ul {
+  display: grid;
+  gap: 6px;
+  padding-left: 18px;
+  color: var(--alab-muted);
+  font-size: 13px;
