+    } catch (error) {
+      setFontError(error.message || 'Could not load this font.');
+    }
+  };
+
+  const handleMediaUpload = async (event) => {
+    const picked = event.target.files?.[0];
+    event.target.value = '';
+    if (!picked) return;
+    setMediaError('');
+    const url = URL.createObjectURL(picked);
