+      setMediaError(error.message || 'Could not load this file.');
+    }
+  };
+
+  const baseFileName = file ? baseName(file.name) : 'lyric-video';
+
+  const handleExportVideo = async () => {
+    if (!lines || !mono || !audioBuffer || exporting) return;
+    setExporting(true);
+    setExportError('');
