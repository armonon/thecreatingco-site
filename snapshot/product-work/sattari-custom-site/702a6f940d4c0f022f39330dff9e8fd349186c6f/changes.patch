+
+        {job && (
+          <section className="alab-card" aria-label="Song">
+            <div className="alab-card-head">
+              <div>
+                <h2 title={job.file.name}>{job.file.name}</h2>
+                <p className="alab-note">
+                  {job.duration ? formatTime(job.duration) : 'Not decoded yet'}
