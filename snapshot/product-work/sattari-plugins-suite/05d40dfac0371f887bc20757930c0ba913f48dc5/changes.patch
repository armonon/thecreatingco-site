+double SattariAutoPitchAudioProcessor::alignedPitchScale (double currentScale, int numSamples)
+{
+#if SATTARI_AUTOPITCH_HAS_SIGNALSMITH
+    const int size = (int) ssScaleHistory.size();
+    if (size == 0 || ssScaleDelaySamples <= 0)
+        return currentScale;
+
+    // Scale that was measured for the audio at the centre of this block,
+    // ssScaleDelaySamples ago. Blocks longer than twice the delay fall back to
+    // the newest value.
+    const int lookBack = ssScaleDelaySamples - numSamples / 2;
+    const double aligned = lookBack > 0 && lookBack < size
+        ? ssScaleHistory[(size_t) ((ssScaleWritePos - lookBack + size) % size)]
+        : currentScale;
+
+    for (int i = 0; i < juce::jmin (numSamples, size); ++i)
+    {
+        ssScaleHistory[(size_t) ssScaleWritePos] = currentScale;
+        ssScaleWritePos = (ssScaleWritePos + 1) % size;
+    }
+    return aligned;
+#else
+    juce::ignoreUnused (numSamples);
+    return currentScale;
+#endif
+}
