+bool SattariAutoPitchAudioProcessor::lowLatencyRequested() const
+{
+    const auto* p = apvts.getRawParameterValue ("lowLatency");
+    return p != nullptr && p->load() > 0.5f;
+}
+
+void SattariAutoPitchAudioProcessor::configureSignalsmith (bool lowLat)
+{
+#if SATTARI_AUTOPITCH_HAS_SIGNALSMITH
+    const int numCh = juce::jmax (1, getTotalNumOutputChannels());
+
+    // Live mode: small window for low latency (~23ms total at 44100Hz).
+    // Standard mode: larger window for higher quality studio correction.
+    if (lowLat)
+        ssStretch.configure (numCh, 3072, 768);
+    else
+        ssStretch.configure (numCh, 4096, 1024);
+
+    ssConfigured = true;
+    ssConfiguredLowLatency = lowLat;
+    ssStretch.reset();
+    // The pitch detector's frame ends at the newest sample, so what it
+    // measures is centred pitchFrameSize / 2 samples in the past already.
+    ssScaleDelaySamples = juce::jmax (0, ssStretch.inputLatency() - pitchFrameSize / 2);
+    ssScaleHistory.assign ((size_t) (ssScaleDelaySamples + juce::jmax (preparedBlockSize, 8192) + 1), 1.0);
+    ssScaleWritePos = 0;
+    ssOutput.setSize (numCh, preparedBlockSize);
+    ssInputPtrs.resize  ((size_t) numCh);
+    ssOutputPtrs.resize ((size_t) numCh);
+
+    reportedLatencySamples = ssStretch.inputLatency() + ssStretch.outputLatency();
+    setLatencySamples (reportedLatencySamples);
+#else
+    juce::ignoreUnused (lowLat);
+#endif
+}
+
+void SattariAutoPitchAudioProcessor::applyLowLatencyChange()
+{
+#if SATTARI_AUTOPITCH_HAS_SIGNALSMITH
+    // Low Latency used to be read only in prepareToPlay, so toggling it did
+    // nothing until the host re-prepared. Reconfigure as soon as it changes.
+    // This allocates on the audio thread, but only once per toggle.
+    const bool lowLat = lowLatencyRequested();
+    if (! ssConfigured || lowLat == ssConfiguredLowLatency)
+        return;
+    configureSignalsmith (lowLat);
+    resizeBypassDelay();
+#endif
+}
+
+void SattariAutoPitchAudioProcessor::processBlockBypassed (juce::AudioBuffer<float>& buffer, juce::MidiBuffer&)
+{
+    // JUCE's default bypass passes audio through undelayed while the host is
+    // still compensating for reportedLatencySamples, so a bypassed vocal would
+    // play early. Delay the dry signal by the same amount instead.
+    applyLowLatencyChange();
+    auto mainBuffer = getBusBuffer (buffer, false, 0);
+    const int length = bypassDelay.getNumSamples();
+    if (length <= 0)
+        return;
+
+    const int numChannels = juce::jmin (mainBuffer.getNumChannels(), bypassDelay.getNumChannels());
+    int pos = bypassDelayWritePos;
+    for (int ch = 0; ch < numChannels; ++ch)
+    {
+        auto* data = mainBuffer.getWritePointer (ch);
+        auto* line = bypassDelay.getWritePointer (ch);
+        pos = bypassDelayWritePos;
+        for (int i = 0; i < mainBuffer.getNumSamples(); ++i)
+        {
+            const float dry = data[i];
+            data[i] = line[pos];
+            line[pos] = dry;
+            pos = (pos + 1) % length;
+        }
+    }
+    bypassDelayWritePos = pos;
 }
 
