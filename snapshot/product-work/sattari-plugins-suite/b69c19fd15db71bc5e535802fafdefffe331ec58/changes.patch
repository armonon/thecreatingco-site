index 0000000000000000000000000000000000000000..1acfe65d94457cf72c10ad6bc95c21728510e393
--- /dev/null
+++ b/validation/accuracy_20260923/score_key.py
@@ -0,0 +1,25 @@
+import json, subprocess, sys, collections
+from pathlib import Path
+HERE=Path(__file__).parent; OUT=HERE/'synth_key'; SK=HERE.parents[1]/'build-live-integration/plugins/song-key/SongKeyRender'
+NAMES=["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]; FLAT={"Db":"C#","Eb":"D#","Gb":"F#","Ab":"G#","Bb":"A#"}
+def parse(s):
+    r,m=s.strip().split()[:2]; r=FLAT.get(r,r); return NAMES.index(r), m.lower().startswith('min')
+def rel(p,t):
+    (pr,pm),(tr,tm)=p,t
+    if p==t: return 'exact'
+    if pm==tm and (pr-tr)%12 in (5,7): return 'fifth'
+    if pm!=tm and ((not tm and (pr-tr)%12==9) or (tm and (pr-tr)%12==3)): return 'relative'
+    if pm!=tm and pr==tr: return 'parallel'
+    return 'other'
+if __name__ == '__main__':   # imported by score_autokey_rt.py for parse/rel only
+    man=json.load(open(OUT/'manifest.json')); res=[]; cats=collections.Counter(); bykind=collections.defaultdict(list)
+    for m in man:
+        out=subprocess.run([str(SK),'--analyse-file',str(OUT/'wav'/m['file'])],capture_output=True,text=True).stdout.strip().splitlines()
+        line=[l for l in out if '|' in l][-1] if any('|' in l for l in out) else ''
+        try: p=parse(line.split('|')[0])
+        except Exception: p=None
+        c=rel(p,parse(m['label'])) if p else 'no_result'
+        cats[c]+=1; bykind[m['kind']].append(c=='exact'); res.append({**m,'pred':line.split('|')[0].strip(),'cat':c})
+    json.dump(res,open(OUT/'score_songkey_file.json','w'),indent=1)
+    n=len(res); print('Sattari Key (file analysis):', cats['exact'],'/',n, f"= {100*cats['exact']/n:.1f}% exact |", dict(cats))
+    for k,v in bykind.items(): print(f'   {k}: {sum(v)}/{len(v)}')
diff --git a/validation/accuracy_20260923/settle.py b/validation/accuracy_20260923/settle.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac2c12f11ef7f16759d9d6a6ab3910d1dcf6f2b7
--- /dev/null
+++ b/validation/accuracy_20260923/settle.py
@@ -0,0 +1,28 @@
+import json, sys, numpy as np
+from synth_pitch import OUT, SR
+tag=sys.argv[1]; man=json.load(open(OUT/'manifest.json')); req_t=[]; out_t=[]
+for m in man:
+    tr=json.load(open(OUT/f"{m['name']}_{tag}.json")); fr=tr['frames']; B=tr['blockSize']
+    tc=np.array([f['timeSec']+B/SR-1024/SR for f in fr])
+    tgtc=np.array([(f['detectedMidi']*0+0) for f in fr])
+    mo=np.load(OUT/f"{m['name']}_{tag}.wav.crepe.npy")
+    for n in m['notes']:
+        t0=n['start']/SR; t1=n['end']/SR; off=n['offset_c']
+        # requested correction "right" when it is within 12c of -offset (the vibrato makes it wobble; use 3-frame median)
+        idx=np.where((tc>=t0)&(tc<=t1))[0]
+        rq=np.array([fr[i]['correctionCents'] if fr[i]['voiced'] else np.nan for i in idx])
+        # true instantaneous deviation is unknown per frame here; use target stability instead: requested target note == n.target
+        # approximate: time until |req + off| < 25 for 3 consecutive frames
+        ok=np.abs(rq+off)<25; rt=np.nan
+        for j in range(len(ok)-2):
+            if ok[j] and ok[j+1] and ok[j+2]: rt=tc[idx[j]]-t0; break
+        req_t.append(rt)
+        k0=int(t0*100); k1=int(t1*100); seg=mo[k0:k1]
+        ot=np.nan
+        for j in range(len(seg)-4):
+            w=seg[j:j+5]
+            if np.all(np.isfinite(w)) and abs(100*(np.mean(w)-n['target']))<10: ot=j/100; break
+        out_t.append(ot)
+r=np.array(req_t); o=np.array(out_t)
+print(tag, 'requested-correction settles: median', round(np.nanmedian(r)*1000), 'ms, p90', round(np.nanpercentile(r,90)*1000), 'ms | never', int(np.isnan(r).sum()))
+print(tag, 'output within 10c:           median', round(np.nanmedian(o)*1000), 'ms, p90', round(np.nanpercentile(o,90)*1000), 'ms | never', int(np.isnan(o).sum()))
