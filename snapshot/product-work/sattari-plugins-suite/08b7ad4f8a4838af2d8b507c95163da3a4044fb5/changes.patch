+// --- parameters -----------------------------------------------------------------
+void setParam (Proc& p, const juce::String& id, float value)
+{
+    auto* parameter = p.parameters().getParameter (id);
+    if (parameter == nullptr)
+    {
+        std::fprintf (stderr, "missing parameter: %s\n", id.toRawUTF8());
+        std::exit (2);
