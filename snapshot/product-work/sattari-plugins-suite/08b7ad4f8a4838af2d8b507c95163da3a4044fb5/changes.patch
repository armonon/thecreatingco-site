+    fr=tr['frames']; tb=np.array([f['timeSec']+B/SR-1024/SR for f in fr])
+    for (a,b,t,med) in r['notes']:
+        s,e=a+8,b-5
+        ci=mi[s:e]; ci=ci[np.isfinite(ci)]
