+NOTE_TO_SHARP = {"C": "C", "B#": "C", "C#": "C#", "DB": "C#", "D": "D", "D#": "D#", "EB": "D#",
+                 "E": "E", "FB": "E", "F": "F", "E#": "F", "F#": "F#", "GB": "F#", "G": "G",
+                 "G#": "G#", "AB": "G#", "A": "A", "A#": "A#", "BB": "A#", "B": "B", "CB": "B"}
