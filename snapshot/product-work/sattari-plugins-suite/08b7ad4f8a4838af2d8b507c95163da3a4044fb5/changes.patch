+int childCount (const juce::MemoryBlock& blob, const char* tag)
+{
+    auto xml = juce::AudioProcessor::getXmlFromBinary (blob.getData(), (int) blob.getSize());
+    int n = 0;
+    if (xml != nullptr)
+        for (auto* c : xml->getChildIterator())
+            n += c->hasTagName (tag);
+    return n;
+}
