+// A realistic vocal setting: C major, Natural, 100 %, speed 0.9 (the objective bench's CPU setting).
+void configureVocal (Proc& p)
+{
+    setParam (p, "keyRoot", 0.0f);
+    setParam (p, "scale", 0.0f);
