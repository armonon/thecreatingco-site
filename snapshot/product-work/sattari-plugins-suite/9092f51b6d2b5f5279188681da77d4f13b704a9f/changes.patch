+def parse_windows(items: list[str]) -> dict:
+    out = {}
+    for it in items or []:
+        try:
+            cid, rng_ = it.split("=", 1)
+            a, b = (float(v) for v in rng_.split(":"))
+        except ValueError:
+            die(f"--window expects clip_id=start:end seconds, got {it}")
+        out[cid] = (a, b)
+    return out
