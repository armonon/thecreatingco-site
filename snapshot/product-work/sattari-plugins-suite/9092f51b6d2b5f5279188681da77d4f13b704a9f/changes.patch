index 0000000000000000000000000000000000000000..a9317052024659a08fdbf22d0e3e4898dd3515a2
--- /dev/null
+++ b/validation/accuracy_20260923/synth_trace.py
@@ -0,0 +1,18 @@
+import json, sys, numpy as np
+from synth_pitch import OUT, core_centres, SR
+tag=sys.argv[1]; man=json.load(open(OUT/'manifest.json')); shown=0
+for m in man:
+    tr=json.load(open(OUT/f"{m['name']}_{tag}.json")); fr=tr['frames']; B=tr['blockSize']
+    mo=np.load(OUT/f"{m['name']}_{tag}.wav.crepe.npy"); mi=np.load(OUT/f"{m['name']}.wav.crepe.npy")
+    cs=core_centres(mo,m['notes'])
+    for i,(n,c) in enumerate(zip(m['notes'],cs)):
+        if not np.isfinite(c) or abs(100*(c-n['target']))<=15 or shown>=2: continue
+        shown+=1; t0=n['start']/SR; t1=n['end']/SR
+        print(f"{m['name']} note {i}: target {n['target']} true offset {n['offset_c']:+.1f}c, out centre {100*(c-n['target']):+.1f}c, dur {t1-t0:.2f}s")
+        for f in fr:
+            tc=f['timeSec']+B/SR-1024/SR
+            if t0<=tc<=t1 and int((tc-t0)*1000)%60<12:
+                k=int(tc*100)
+                det=f['detectedMidi']-f['correctionCents']/100-n['target'] if f['voiced'] else np.nan
+                print(f"   t+{(tc-t0)*1000:4.0f}ms in(CREPE) {100*(mi[k]-n['target']):+6.1f}  det {100*det:+6.1f}  tgt {f['detectedMidi']}  req {f['correctionCents']:+6.1f}  out {100*(mo[k]-n['target']):+6.1f}  conf {f['confidence']:.2f}")
+    if shown>=2: break
diff --git a/validation/accuracy_20260923/tiny_check.py b/validation/accuracy_20260923/tiny_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..0bb3a143ff253a198b9bd913acf4683e841aca7d
--- /dev/null
+++ b/validation/accuracy_20260923/tiny_check.py
@@ -0,0 +1,15 @@
+import time, numpy as np, torch, torchcrepe, librosa, soundfile as sf
+from csd_bench import tracks, section_notes, singer_f0, note_centre, WORK
+def crepe(y, model, hop):
+    y16=librosa.resample(y,orig_sr=48000,target_sr=16000)
+    p,per=torchcrepe.predict(torch.tensor(y16)[None],16000,hop_length=int(16000*hop),fmin=60,fmax=1100,model=model,decoder=torchcrepe.decode.viterbi,return_periodicity=True,batch_size=2048,device='mps')
+    per=torchcrepe.filter.median(per,3); p,per=p[0].numpy(),per[0].numpy()
+    return np.where(per>0.5, 69+12*np.log2(p/440), np.nan)
+for model,hop in [('tiny',0.01),('full',0.02)]:
+    d=[]; t0=time.time()
+    for stem in tracks('tune')[:4]:
+        y,_=sf.read(WORK/f'{stem}.wav',dtype='float32'); m=crepe(y,model,hop); tm=np.arange(len(m))*hop; t,mr=singer_f0(stem)
+        for s,e,tg in section_notes(stem):
+            a=note_centre(tm,m,s,e); r=note_centre(t,mr,s,e)
+            if np.isfinite(a) and np.isfinite(r): d.append(100*(a-r))
+    d=np.abs(d); print(f'{model} hop {hop}: vs annotation median {np.median(d):.2f}c p90 {np.percentile(d,90):.2f}c | {(time.time()-t0)/4:.0f}s per track')
diff --git a/validation/accuracy_20260923/trace_diag.py b/validation/accuracy_20260923/trace_diag.py
